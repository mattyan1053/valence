#!/usr/bin/env bash
# レビュー済み commit から head までの「手直し量」を数える。
#
#   bin/loop-fixup-lines <PR番号> <レビュー済み SHA> <head SHA>
#   → <数える行>\t<除外したテスト追加行>\t<除外した要求ぶんの行>
#
# ゲートはレビュー上限に達したあと、この値で「手直しの範囲か / 人の判断が要るか」を分ける。
#
# **全変更行で測ると、レビュー指摘への正しい対応を罰する。** 実際に PR #36 と #41 が
# 2 件続けて 87 行で人へ渡されたが、どちらも上限到達後に **master 自身がテストの追加を
# 要求した**結果として増えていた (#36 は 87 行中 43 行がテストの追加)。
# 危険なのは「レビューを受けていない**本体の**変更」であって、テストが増えることではない。
#
# **そのとき塞いだのは症状だった。** 「テストの追加を数えない」は、
# 「**要求された変更を数えている**」という原因のうちテストの部分だけを外したもので、
# 本体の行では同じことが起き続けた。実測で **4 件中 4 件** (#36 / #41 / #96 / #124) が
# 人の結論と食い違っている。**よく見たから止まる**という符号の逆転である。
#
#   丁寧にレビューする → 指摘が増える → 指摘どおり直した行が増える → ゲートが落ちる
#                                                              → 「レビュー不足」で人を呼ぶ
#
# **#124 は同じ PR の中で数字が変わった。** 2 回目のレビュー時点を基準にすると 89 行、
# 3 回目のレビューが届いた瞬間に 37 行。**変わったのは PR ではなくレビューの回数**だった。
#
# そこで数えるのは次のとおり。
#
#   本体ファイル (レビュースレッドあり) … 数えない (要求された変更)
#   本体ファイル (スレッドなし)         … 追加も削除も数える
#   テストファイル                      … **削除だけ**数える (追加は数えない)
#
# **要求の出どころは「その PR のレビュースレッド」1 つに決めてある。** 候補は他にもあるが
# (changes-requested の周期、通常コメント)、**位置を持つのはスレッドだけ**で、
# 他は「いつ」しか分からないので「どのファイルが要求されたか」を言えない。
#
# **解決済みかどうかで絞らない。** ゲートは未解決スレッドが 0 件でなければ通らないので、
# ここへ来る時点でスレッドはすべて解決済みである。未解決だけを見ると **除外は常に空**に
# なり、この判定は何もしないのと同じになる。
#
# **絞るのは「いつ付いた指摘か」である。** 「そのファイルに指摘が付いたことがある」で
# 除外すると緩すぎる。第 1 回で指摘して解決したファイルを **第 2 回のレビュー後に
# 大幅に書き換える**と、誰も見ていない変更が 0 行として扱われ、上限到達後のゲートを
# 素通りする。**除外してよいのは、いま測っている窓の中で要求されたものだけ**である。
#
# 窓は「レビュー済み commit から head まで」で、そこへ付いた指摘は **その commit か、
# その後に積んだ commit に対して**書かれている (`originalCommit`)。時刻ではなく
# **commit で突き合わせる**——時刻はレビューの投稿とコメントの生成で僅かにずれ、
# ずれた側へ倒れると **除外が黙って効かなくなる** (症状は「正しい PR がまた止まる」だけ)。
#
# **どの commit に付いたか分からないスレッドは除外に使わない** (印 -)。消えた commit を
# 指すものなどで、**分からないものを「要求された」へ倒さない**。
#
# **誰が付けた指摘かも見る。** 投稿者を見ないと、**PR の作成者が自分の変更ファイルへ
# インラインコメントを付けて resolve するだけで、そのファイルが丸ごと除外される**。
# 「レビューが要求した変更は数えない」が「**自分で要求すれば数えない**」に変わる。
# bin/loop-review-commits と bin/loop-gate が「誰のレビューか」を固定しているのと同じ理由で、
# ここでも固定する。**投稿者が読めないスレッドは除外に使わない** (印 - と同じ扱い)。
#
# ---- この判断の弱点 --------------------------------------------------------
#
# **見た側とマージを決める側が近づく。** 「レビューが要求したから数えない」を認めると、
# レビューする側の判断がそのままマージ可否を動かす。**判定の独立性が薄まる。**
#
# **それでも成立すると考える理由は、master がコードを書かないことである**
# (loop/README.md「自分が書いたものを自分で通すと、ゲートは形だけになる」)。
# 書く側 (worker) と見る側 (master / Codex) は分かれたままで、変わるのは
# **外部レビューが尽きたあとの扱い**だけである。**この前提が崩れたら、ここも崩れる。**
#
# **粒度はファイルである。** 指摘の付いたファイルへ無関係な変更を混ぜれば、この層は
# 見逃す。行単位で対応づける手はあるが、指摘への修正は指摘された行から離れた場所へ
# 入ることが多く (関数の抽出、早期リターン)、**行で縛ると正しい修正ほど落ちる**という
# いま直している症状をそのまま作り直すことになる。**ファイル単位が上限**で、
# 混ぜ込みは残る。歯止めはこの層ではなく、**未解決スレッドと master の要求** (ゲートの
# 条件 5 / 6) が持つ。
#
# ----------------------------------------------------------------------------
#
# **「テストファイルだから安全」とは扱わない。** 名前は中身を保証しないし、
# レビュー後に検証を消す変更は「守りを減らす」ので本体と同じ危険度がある。
# 数えないのは「守りを増やす側」だけである。テストの追加が壊れていれば CI が落ちる。
# **スレッドがあっても、テストの削除は数える。** 要求されたかどうかに関わらず、
# 守りが減ったことは見えなくならない。
#
# テストの判定は **パスの末尾が .test.ts** かどうかだけで行う (vitest の include と同じ形)。
# 名前に test を含むだけの本体ファイル (src/test-utils.ts など) を除外すると、
# **本体の変更が数から消える**。
#
# 数え方はここ (bash) で行い、gh の --jq には **ファイルごとの生の行数**しか出させない。
# 集計を gh 側に寄せると、テストは差し替えた gh が返す「あらかじめ数えた答え」を
# 受け取るだけになり、**数え方そのものを 1 つも検証できなくなる**。
#
#   exit 0 = 数えた
#   exit 1 = 取得できない / 読めない (呼び出し側は判定不能として扱う)
#   exit 2 = 使い方の誤り
#
# GraphQL の変数 ($endCursor) はシェルに展開させない。
# shellcheck disable=SC2016
set -uo pipefail

usage() {
  echo "使い方: bin/loop-fixup-lines <PR番号> <レビュー済み SHA> <head SHA>" >&2
  exit 2
}

[[ $# -eq 3 ]] || usage
readonly PR="$1"
readonly REVIEWED="$2"
readonly HEAD_SHA="$3"

[[ $PR =~ ^[0-9]+$ ]] || usage

# compare の URL に入る。パスやブランチ名を通すと、別の場所を比較しうる。
# 会話コメント由来の SHA は短縮形なので、7 桁から受ける。
for sha in "$REVIEWED" "$HEAD_SHA"; do
  [[ $sha =~ ^[0-9a-f]{7,40}$ ]] || {
    echo "[FAIL] SHA として読めません: $sha" >&2
    exit 2
  }
done

# --- 要求された変更の範囲 -----------------------------------------------------
# **レビュー用の bot の名前は書き写さない。** bin/loop-review-commits が正で、
# そこから取る (2 箇所に持つと、片方だけ直したときに違う相手を信用する)。
#
# 隣を引くのに `dirname` を使わない。**外部コマンドを足すと、テストが PATH を絞れなくなり**
# 「gh を呼ぶ前に落ちること」のような確認が書けなくなる (集計を bash だけで行うのと同じ理由)。
script_dir="${BASH_SOURCE[0]%/*}"
[[ $script_dir != "${BASH_SOURCE[0]}" ]] || script_dir="."
readonly script_dir
if ! REVIEW_BOT="$("$script_dir/loop-review-commits" --bot)" || [[ -z $REVIEW_BOT ]]; then
  echo "[FAIL] レビュー用の bot の名前を取得できません" >&2
  exit 1
fi
# GraphQL の author.login には `[bot]` が付かない。REST の形で来ても取り違えないよう
# **両方を同じ相手として扱う** (`[` はログイン名に使えないので、なりすませない)。
readonly REVIEW_BOT
readonly REVIEW_BOT_GRAPHQL="${REVIEW_BOT%\[bot\]}"

# レビュースレッドの付いたファイルを集める。**パスは @base64 のまま扱い、復号しない。**
# git のパスにはタブも改行も入り、**名前は PR 側で決められる**。生のまま並べると
# 1 件が複数行に割れて数が狂う (実測: 区切りを含む名前 1 件が 3 行に割れた)。
# 突き合わせは符号化した文字列同士で行うので、区切りを跨げない
# (bin/loop-gate が必須チェック名でしている形と同じ)。
#
# 1 行目に nodes の型、2 行目以降に "P<TAB>付いた commit<TAB>符号化したパス" を出させる。
# **型を出力に含める**のは、取得の失敗と「スレッド 0 件」を見分けるためである
# (どちらも本文が空になる)。0 件として続けると **この判定が静かに無効化され**、
# 症状は「正しい PR がまた止まる」だけになるので、壊れたことに誰も気づけない。
#
# --paginate と pageInfo を使う。件数を決め打ちすると、上限を超えた PR で
# **除外すべきファイルを見落として、正しい修正を数えてしまう**。
if ! threads_out="$(gh api graphql --paginate -f query='
query($owner: String!, $repo: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      baseRefName
      reviewThreads(first: 100, after: $endCursor) {
        pageInfo { hasNextPage endCursor }
        nodes { comments(first: 1) { nodes { author { login } originalCommit { oid } } } path }
      }
    }
  }
}' -F owner='{owner}' -F repo='{repo}' -F pr="$PR" \
  --jq '"R\t\((.data.repository.pullRequest.baseRefName) // "-")", "T\t\(.data.repository.pullRequest.reviewThreads.nodes | type)", (.data.repository.pullRequest.reviewThreads.nodes[]? | "P\t\((.comments.nodes[0].originalCommit.oid) // "-")\t\((.comments.nodes[0].author.login) // "-")\t\(.path | @base64)")' \
  2>/dev/null)"; then
  echo "[FAIL] PR #$PR のレビュースレッドを取得できません" >&2
  exit 1
fi

# スレッドは (付いた commit, 符号化したパス) の対で持つ。**窓の commit 一覧は差分の
# 取得で分かる**ので、どれを除外に使うかはそちらを読んでから決める。
thread_commits=()
thread_authors=()
thread_paths=()
seen_threads=0
base_ref=""
# ログイン名は英数字とハイフン (と bot の `[bot]`) しか取れない。**タブや改行は入らない**
# ので、パスと違って符号化せずに列へ出せる。形が違うものは弾く。
readonly LOGIN_PATTERN='([A-Za-z0-9._-]+(\[bot\])?|-)'
while IFS= read -r row; do
  [[ -n $row ]] || continue
  if [[ $row == R$'\t'* ]]; then
    # **base のブランチ名。** **ここで受け取るのは、スレッドと同じ 1 回で読むため**である
    # ——**別の呼び出しにすると、2 回の間に base が付け替えられたときに食い違う。**
    # **ref に使える文字だけを通す**（compare の URL に入る。SHA と同じ扱い）。
    base_ref="${row#R$'\t'}"
    [[ $base_ref =~ ^[A-Za-z0-9._/-]+$ ]] || base_ref=""
    continue
  fi
  if [[ $row == T$'\t'* ]]; then
    [[ $row == $'T\tarray' ]] || {
      echo "[FAIL] レビュースレッドの一覧を配列として読めません: ${row#T$'\t'}" >&2
      exit 1
    }
    seen_threads=1
    continue
  fi
  # 符号化されていれば [A-Za-z0-9+/=] しか来ない。形で弾く。
  [[ $row =~ ^P$'\t'([0-9a-f]{7,40}|-)$'\t'${LOGIN_PATTERN}$'\t'([A-Za-z0-9+/=]+)$ ]] || {
    echo "[FAIL] レビュースレッドのパスを読めません" >&2
    exit 1
  }
  thread_commits+=("${BASH_REMATCH[1]}")
  thread_authors+=("${BASH_REMATCH[2]}")
  thread_paths+=("${BASH_REMATCH[4]}")
done <<<"$threads_out"

if ((seen_threads == 0)); then
  echo "[FAIL] レビュースレッドの一覧を取得できません (nodes の型が返っていません)" >&2
  exit 1
fi

if [[ -z $base_ref ]]; then
  echo "[FAIL] PR #$PR の base ブランチを読めません" >&2
  exit 1
fi
readonly base_ref

# --- base から入った変更 -------------------------------------------------------
# **base を取り込むと、窓の差分に base のぶんが入る** (#299)。**それは別の PR として
# レビューされ、既に base に入っているもの**である——**手直しとして数えると、
# 中身が何も変わっていない PR が「人の判断が要ります」で止まる** (2026-08-15、#295 で実測)。
#
# **窓の側では外せない。** **レビュー済み commit は head の祖先**なので、
# **三点比較にしても merge-base はそこ**——**base のぶんは必ず出る。**
#
# **`base...head` の三点比較なら出てこない** (merge-base は取り込んだ base の commit)。
# **そこに出てこないファイルは、この枝が base から離れていない**ということなので、
# **未レビューの分岐は無い**——**数えない。**
#
# **粒度はファイルである**（この層のほかの判断と同じ）。**枝と base が同じファイルを
# 触っていれば、窓のぶんを丸ごと数える**——**混ざったら止まる側へ倒す。**
if ! branch_out="$(gh api "repos/{owner}/{repo}/compare/${base_ref}...${HEAD_SHA}" \
  --jq '"T\t\(.files | type)", (.files[]? | "B\t\(.filename | @base64)")' \
  2>/dev/null)"; then
  echo "[FAIL] base ($base_ref) から head までの差分を取得できません" >&2
  exit 1
fi

declare -A branch_only=()
seen_branch=0
while IFS= read -r row; do
  [[ -n $row ]] || continue
  if [[ $row == T$'\t'* ]]; then
    [[ $row == $'T\tarray' ]] || {
      echo "[FAIL] base から見た差分を配列として読めません: ${row#T$'\t'}" >&2
      exit 1
    }
    seen_branch=1
    continue
  fi
  [[ $row =~ ^B$'\t'([A-Za-z0-9+/=]+)$ ]] || {
    echo "[FAIL] base から見た差分のパスを読めません: $row" >&2
    exit 1
  }
  branch_only["${BASH_REMATCH[1]}"]=1
done <<<"$branch_out"

# **「取れなかった」を「全部 base 由来」に倒さない。** **手直し量が黙って 0 になり、
# ゲートはそれを「手直しの範囲」と読んでマージへ進む**（files の型を見るのと同じ理由）。
if ((seen_branch == 0)); then
  echo "[FAIL] base から見た差分を取得できません (files の型が返っていません)" >&2
  exit 1
fi

# --- 差分 ---------------------------------------------------------------------
# 1 行目に files の型、2 行目以降にファイルごとの行数を出させる。
#
# **2xx でも files が配列とは限らない** (フィールドの欠落・null・形式不正)。
# `.files[]?` だけだとどれもエラーにならず出力が空になり、**数えられなかったことが
# 「変更 0 行」として返る**。ゲートはそれを「手直しの範囲」と読んでマージへ進むので、
# **差分を判定できていないのに自動マージが通る**。「分からない」を「大丈夫」に丸めない。
#
# 型を出力の一部にしてあるのは、**判定をこのスクリプト側に置いてテストするため**でもある。
# --jq の中で弾くと、差し替えた gh が --jq を実行しない (コンテナに jq が無い) 以上、
# 「配列でなければ落ちる」ことを 1 つも確かめられない。
#
# **テストかどうかの判定は --jq の中で終わらせ、外へは true/false と数値、
# そして符号化したパスだけを出す。** 生の名前がどの層にも出てこないので、
# 区切りも末尾の空白も問題にならない。
# `.test.ts` はこの判定の定数なので、式へ literal で書ける (外部の値を差し込まない)。
#
# **窓の中の commit も同じ 1 回で受け取る** ("C<TAB>SHA")。どのスレッドを除外に使うかは
# これで決まる。別の呼び出しにすると、**2 回の間に積まれた commit で食い違う**。
# compare が返す commits は 250 件で切られるが、切られたぶんは除外に使われないだけなので
# **数え過ぎる側 (止まる側) に倒れる**。
# **この窓で作られたファイル ("N") と、ファイルごとの差分 ("D") も同じ 1 回で受け取る。**
# **新しいファイルにはスレッドが付きようがない**ので、**要求ぶんとして外れない**
# ——**規約どおりまとめると「広がった」に数えられる** (#204。#202 で踏んだ)。
#
# **「呼ばれている」は機械的に見える。** **要求されたファイルが、その名前を書いているか**
# である——**散文から「作れ」を読み取らない** (弱い) し、**`bin/loop-triage` の側に
# 「抽象化なら通す」を持たせない** (同じ判断が 2 箇所になる)。
#
# **判定は --jq に置かない** (#208 のレビュー)。**差し替えた gh は --jq を実行しない**
# (**コンテナに jq が無い**) ので、**式の中に意味を置くと、試験がその判定を 1 度も
# 通らない**——**「境界を見る」を外しても緑のまま**になる。**生の値だけを出させ、
# 数え方と同じく bash で判定する。**
if ! out="$(gh api "repos/{owner}/{repo}/compare/${REVIEWED}...${HEAD_SHA}" \
  --jq '"T\t\(.files | type)", (.commits[]? | "C\t\(.sha)"), (.files[]? | "F\t\(.filename | endswith(".test.ts"))\t\(.filename | @base64)\t\(.additions)\t\(.deletions)"), (.files[]? | select(.status == "added") | "N\t\(.filename | @base64)"), (.files[]? | "D\t\(.filename | @base64)\t\((.patch // "") | @base64)")' \
  2>/dev/null)"; then
  echo "[FAIL] レビュー済み commit から head までの差分を取得できません" >&2
  exit 1
fi

# 窓の commit を先に集める。**--jq が commits を files より前に出すので 1 回で足りる**が、
# 順序に頼らずに済むよう、集める走査と数える走査を分けてある。
declare -A window=()
while IFS= read -r row; do
  [[ $row == C$'\t'* ]] || continue
  sha="${row#C$'\t'}"
  [[ $sha =~ ^[0-9a-f]{7,40}$ ]] || {
    echo "[FAIL] 窓の中の commit を読めません: $sha" >&2
    exit 1
  }
  window["$sha"]=1
done <<<"$out"

# **この窓で作られたファイルと、ファイルごとの差分を集める。** 数える走査より前に読む
# (順序に頼らない。窓の commit と同じ形)。
declare -A added_files=()
declare -A patch_of=()
while IFS= read -r row; do
  case "$row" in
    N$'\t'*)
      [[ $row =~ ^N$'\t'([A-Za-z0-9+/=]+)$ ]] || {
        echo "[FAIL] 新しいファイルの名前を読めません: $row" >&2
        exit 1
      }
      added_files["${BASH_REMATCH[1]}"]=1
      ;;
    D$'\t'*)
      [[ $row =~ ^D$'\t'([A-Za-z0-9+/=]+)$'\t'([A-Za-z0-9+/=]*)$ ]] || {
        echo "[FAIL] 差分の中身を読めません: $row" >&2
        exit 1
      }
      patch_of["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
      ;;
  esac
done <<<"$out"

# 符号化された値を戻す。**行の解析には生の値を持ち込まない** (区切りで数が狂う) が、
# **突き合わせるときだけは中身が要る**。
decode() {
  printf '%s' "$1" | base64 -d 2>/dev/null
}

# **その差分の「追加行」が、このパスを呼んでいるか。**
#
# **部分文字列では足りない** (#208 のレビュー)。**patch は削除行もコンテキストも
# コメントも含む**ので、**`a` のような短い名前は、要求ファイルの差分に文字 `a` が
# 1 度出るだけで外れる**——**名前を短くするだけで第 3 層を抜けられる。**
#
# **2 つ重ねる。** **追加行だけを見る** (削除やコンテキストの言及は、呼んでいる証拠に
# ならない) のと、**境界を見る** (`x.ts` が `xats` に当たらない)。**片方では足りない。**
#
# **正規表現のメタ文字は escape しない。** **引用した部分は文字列として照合される**
# ので、`.` を含むパスでも当たらない (bash の `[[ =~ ]]` の性質)。
patch_mentions() {
  local path="$1" patch="$2" line
  while IFS= read -r line; do
    [[ $line == +* ]] || continue
    [[ $line == +++* ]] && continue
    line="${line#+}"
    [[ $line =~ (^|[^A-Za-z0-9._/-])"$path"($|[^A-Za-z0-9._/-]) ]] && return 0
  done <<<"$patch"
  return 1
}

# **要求されたファイルから呼ばれているか。** **呼び手が要求されていなければ数える**
# ——**そうしないと、無関係なファイルが名前を書くだけで外せる**
# (**網を外して緑にしない**)。
requested_by_reference() {
  local added="$1" by path
  [[ -n ${added_files[$added]-} ]] || return 1
  # **`$( )` は末尾の改行を全部落とす** (#208 のレビュー)。**git はファイル名に改行を
  # 許す**ので、**落とすとそこが抜け道になる**——**`large\n` が `large` に化けて、
  # 単語 `large` に当たる**。**番人を足して戻す。**
  path="$(
    decode "$added"
    printf x
  )"
  path="${path%x}"
  [[ -n $path ]] || return 1
  for by in "${!requested[@]}"; do
    [[ $by != "$added" ]] || continue
    patch_mentions "$path" "$(decode "${patch_of[$by]-}")" && return 0
  done
  return 1
}

# 除外に使うスレッドを決める。**レビュー済み commit そのものは compare の commits に
# 含まれない** (base は返らない) ので、明示的に含める。
# **前方一致で見る。** 会話コメント由来のレビュー済み SHA は短縮形である。
declare -A requested=()
for i in "${!thread_paths[@]}"; do
  on="${thread_commits[$i]}"
  by="${thread_authors[$i]}"
  [[ $on != "-" ]] || continue
  [[ $by == "$REVIEW_BOT" || $by == "$REVIEW_BOT_GRAPHQL" ]] || continue
  if [[ $on == "$REVIEWED"* || -n ${window[$on]-} ]]; then
    requested["${thread_paths[$i]}"]=1
  fi
done

# 集計は bash で行う。**外部コマンドは `base64` だけ**——**符号化を戻すのに要る**
# (コンテナに jq は無いので、判定を --jq へ寄せると試験が通らない。上記)。
counted=0
excluded_tests=0
excluded_requested=0
seen_type=0
while IFS= read -r row; do
  [[ -n $row ]] || continue
  if [[ $row == T$'\t'* ]]; then
    # 空の配列は正常 (同一 commit の compare は実際に files: [] を返す)。
    [[ $row == $'T\tarray' ]] || {
      echo "[FAIL] 差分のファイル一覧を配列として読めません: ${row#T$'\t'}" >&2
      exit 1
    }
    seen_type=1
    continue
  fi
  # 窓の commit と、新しいファイル・差分の中身は上の走査で読み終えている。
  [[ $row != C$'\t'* ]] || continue
  [[ $row != N$'\t'* ]] || continue
  [[ $row != D$'\t'* ]] || continue
  # 行ごと正規表現で受ける。IFS=タブ の read はタブが IFS の空白文字なので
  # **連続が 1 区切りに畳まれ、列が足りない行を正常な行として読む**。
  # 読めない行を 0 として数えると、**取得の壊れが「手直しが小さい」に化けて素通りする**。
  # テストかどうかは true/false のどちらかしか来ない。形も確かめる。
  [[ $row =~ ^F$'\t'(true|false)$'\t'([A-Za-z0-9+/=]+)$'\t'([0-9]+)$'\t'([0-9]+)$ ]] || {
    echo "[FAIL] 差分の行数を数値として読めません: $row" >&2
    exit 1
  }
  is_test="${BASH_REMATCH[1]}"
  path_b64="${BASH_REMATCH[2]}"
  additions="${BASH_REMATCH[3]}"
  deletions="${BASH_REMATCH[4]}"
  # **base から入っただけのファイルは、どの欄にも入れない** (#299)。**除外ではなく、
  # この PR の変更ではない**——**テストの削除も同じ**（消したのは別の PR である）。
  if [[ -z ${branch_only[$path_b64]-} ]]; then
    continue
  fi
  if [[ $is_test == "true" ]]; then
    ((counted += 10#$deletions, excluded_tests += 10#$additions))
  elif [[ -n ${requested[$path_b64]-} ]] || requested_by_reference "$path_b64"; then
    ((excluded_requested += 10#$additions + 10#$deletions))
  else
    ((counted += 10#$additions + 10#$deletions))
  fi
done <<<"$out"

# 型の行が来ていないなら、gh が何も返していないか出力の形が変わっている。
# **「ファイルが 1 件も無かった」と区別がつかないので、0 行として返さない。**
if ((seen_type == 0)); then
  echo "[FAIL] 差分のファイル一覧を取得できません (files の型が返っていません)" >&2
  exit 1
fi

printf '%s\t%s\t%s\n' "$counted" "$excluded_tests" "$excluded_requested"
exit 0
