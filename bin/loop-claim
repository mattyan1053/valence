#!/usr/bin/env bash
# `ready` の Issue を **1 つの周回だけが取る**ようにし、**着手中のものを誰が持っているか**を
# 記録する。
#
#   bin/loop-claim take   <Issue番号>   ready の Issue を取る
#   bin/loop-claim resume <Issue番号>   着手中の Issue を、自分が続けてよいか尋ねる
#   bin/loop-claim pr     <PR番号>      レビュー対応の前に、その PR を取る
#   bin/loop-claim mine   <PR番号>      その PR を自分の作業場が持っているか（読むだけ）
#   bin/loop-claim release <PR番号>     自分が取った PR の claim を返す
#   bin/loop-claim idle                 着手したまま実装が出ていない Issue を並べる
#
#   exit 0 = 取れた / 続けてよい
#   exit 1 = 取れなかった / 別の作業場が持っている → **次の Issue へ進む。待たない**
#   exit 2 = 判定できない / 使い方の誤り
#
# **label を付け替えるだけでは足りない。** 読んでから書くまでに間があるので、
# **両方が「空いている」と読んでから、両方が書ける**。症状は「同じ Issue の PR が 2 本」で、
# **どちらも正しく見える**ので、後から見ても取り合いだと分からない。
#
# **入口は 2 つある。** 手順書のステップ 4（`ready` を取る）だけでなく、
# ステップ 2.2（着手中の Issue を再開する）からも実装へ入れる。
# **2.2 は label しか見ていなかった**ので、`take` で取った直後——**ブランチができるまでの窓**——に
# 別の作業場が 2.2 を通ると、そこから重複が入る。だから `resume` も同じ記録を見る。
#
# **PR も同じ形で取る** (#203)。**#202 で worker がどこでもブランチを掴まなくなり、
# git の worktree 排他が偶然かけていた錠が外れた**——**掴んでいたときは、
# 「同じ PR を 2 人が直す」を git が止めていた。** **外れた錠を、設計として引き受け直す。**
#
# **PR 側は GitHub を読まない。** **持ち主は手元にしか無い**（下記）ので、
# **label のような GitHub 側の目印を足しても、取り合いは解けない。**
#
# **assignee では区別できない。** 周回はどれも同じ GitHub アカウントで動くので、
# 「誰が取ったか」を GitHub 側の値で表せない。**取り合いを解けるのは手元だけ**である。
# 持ち主は `bin/loop-lease` と同じ**作業場（worktree の根）**で表す。語彙を増やさない。
#
# **譲る側の決め方: 先にロックを取れた側が取り、後から入った側が譲る。**
# ロックは必ずどちらか一方が取るので、**両方が譲って誰も進まない**ことは起きない。
#
# **守れるのは、同じクローンを共有する周回まで。** 別のクローン・別のマシンで動く周回は
# 対象外である (`bin/loop-lease` と `bin/loop-stall` も同じ前提に立っている)。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# **入口を飛ばしていないか、ここでも確かめる**（#161）。**出口だけでは遅い**——
# 気づくのは終わったあとで、**その周回の直列化は既に効いていない**。
# **周回で最初に触るものが確かめれば、やり直せるうちに分かる**。
#
# **役を渡さない。** このスクリプトは master も worker も使うので、役を書き固めると
# **正常な周回のたびに偽の記録が積まれる**（`bin/loop-lease` の `check` を読むこと）。
# **止めない**（`|| true`）——気づける形は保ったまま、飛ばしにくくする。
"${BASH_SOURCE[0]%/*}/loop-lease" check || true

# ロックを待つ時間。**ここで行うのは GitHub との数往復だけ**なので短くてよい。
readonly LOCK_WAIT_SEC="${LOOP_CLAIM_LOCK_WAIT_SEC:-10}"

# 持ち主の記録を引き継ぐまでの時間。
#
# **記録が守るのは「取ってからブランチが見えるまで」の窓だけ**である。ブランチは
# 作業場をまたいで共有されるので、**ブランチができた後は 2.2 が自分で判定できる**。
# つまり期限は「その窓を覆えれば十分」で、長く持つ必要が無い。
#
# **短すぎると「2 つが同じものを実装する」を作り直し、長すぎると「落ちたら止まる」になる。**
# ここは**拾えるほうへ倒す**——窓の中で落ちた周回は**何も作っていない**ので、
# 引き継いでもやり直しになるだけで、失うものが無い。`bin/loop-lease` と同じ 30 分にして
# あるのは、**1 周が長引くより十分に長い**という同じ理由による。
readonly TTL_SEC="${LOOP_CLAIM_TTL_SEC:-1800}"

# 着手したまま実装が出ていないと見なすまでの時間 (#264)。
#
# **周回の数で測らない。** **`/loop` の間隔は設定で変わる**ので、**同じ「N 周」が
# 機械によって 10 分にも 3 時間にもなる**——**止める条件が、設定で動く。**
#
# **長いほうへ倒す。** **短くすると、いちばん長く考えている worker を止める**
# ——**この検出器が呼ぶのは人**なので、**偽陽性の代償は「人が来て、何も無い」**である。
# **実測では、取ってから PR が出るまで 1〜2 周（30〜60 分）**なので、**その 2〜4 倍**を取る。
# **積むのは master の周回ごと**で、**3 周続いて初めて `loop/STOP`** になる——
# **人が呼ばれるのは、さらに master 2 周ぶん後**である。
readonly IDLE_SEC="${LOOP_CLAIM_IDLE_SEC:-7200}"

usage() {
  echo "使い方: bin/loop-claim take <Issue番号>     ready の Issue を取る" >&2
  echo "        bin/loop-claim resume <Issue番号>   着手中の Issue を続けてよいか尋ねる" >&2
  echo "        bin/loop-claim pr <PR番号>          レビュー対応の前に PR を取る" >&2
  echo "        bin/loop-claim mine <PR番号>        その PR を自分の作業場が持っているか" >&2
  echo "        bin/loop-claim release <PR番号>     自分が取った PR の claim を返す" >&2
  echo "        bin/loop-claim audit                label と実態の食い違いを見つける" >&2
  echo "        bin/loop-claim idle                 着手したまま実装が出ていない Issue を並べる" >&2
  echo "        exit 0 取れた / exit 1 取れなかった（次の Issue へ進む）/ exit 2 判定不能" >&2
  exit 2
}

readonly ACTION="${1-}"
if [[ $ACTION == "audit" || $ACTION == "idle" ]]; then
  [[ $# -eq 1 ]] || usage
  ISSUE=""
else
  [[ $# -eq 2 ]] || usage
  ISSUE="$2"
  [[ $ACTION == "take" || $ACTION == "resume" || $ACTION == "pr" || $ACTION == "mine" ||
    $ACTION == "release" ]] || usage
  [[ $ISSUE =~ ^[0-9]+$ ]] || usage
fi
readonly ISSUE

for setting in LOCK_WAIT_SEC TTL_SEC IDLE_SEC; do
  if ! [[ ${!setting} =~ ^[0-9]+$ ]]; then
    echo "[FAIL] 設定: LOOP_CLAIM_${setting%_SEC}_SEC は 0 以上の整数（秒）で指定してください" >&2
    exit 2
  fi
done

# **git の共通ディレクトリに置く。** 作業場ごとに置くと、作業場が分かれた時点で
# 取り合いを検出できない——**それがこの Issue の前提**である (`bin/loop-lease` と同じ形)。
if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
  echo "[FAIL] 作業場の根を特定できません" >&2
  exit 2
fi
toplevel="$(cd "$toplevel" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] 作業場の根へ移動できません" >&2
  exit 2
}
readonly OWNER="$toplevel"
# **PR と Issue で置き場を分ける。** **同じ番号の Issue と PR は別のもの**で、
# **混ぜると、Issue を取った作業場が同じ番号の PR を直せなくなる**（逆も同じ）。
# **`audit` の走査は `valence-loop-claim-[0-9]*` を見る**ので、こちらは当たらない。
if [[ $ACTION == "pr" || $ACTION == "mine" || $ACTION == "release" ]]; then
  readonly RECORD="$common_dir/valence-loop-claim-pr-$ISSUE"
else
  readonly RECORD="$common_dir/valence-loop-claim-$ISSUE"
fi

labels_of() {
  gh issue view "$ISSUE" --json labels --jq '.labels[].name'
}

has_label() {
  local wanted="$1" line
  while IFS= read -r line; do
    [[ $line == "$wanted" ]] && return 0
  done <<<"$2"
  return 1
}

# **持ち主を書き残す。** 記録が無ければ、2.2 は「誰の作業か」を判定できない。
#
# **時刻は 2 つ書く** (#264)。**1 行目の 2 列目は「最後に触った時刻」**で、
# **周回のたびに新しくなる**（それが「持ち主が生きているか」を表す値である）。
# **2 行目は「着手した時刻」**で、**引き継いでも書き直さない**——**書き直すと、
# 「着手したまま実装が出ていない」を測れる値が、どこにも無くなる。**
#
# **1 行目には足さない** (#281 の周回で実測)。**記録は版をまたいで共有される**——
# **前の版は `read` で 1 行目だけを読み、2 列目が数字でなければ exit 2**（読めません）。
# **列を増やした瞬間、まだ入れ替わっていない作業場の `pr` / `resume` / `audit` が
# 全部「判定できない」へ倒れ**、**その PR を直す周回まで止まる**（#262 と同じ形）。
# **行を足すぶんには、前の版は読まないので何も起きない**（`bin/loop-lease` の
# 記録が 2 行 → 3 行と増えたときと同じ判断）。
#
# **引数で渡すのは呼ぶ側**である。**take だけが新しく決め**、**resume と pr は
# 読んだ値をそのまま渡す**——**「保つ」を既定にすると、`take` で書き忘れたときに
# 前の着手の時刻が残る。**
write_record() {
  local taken="${1-}"
  [[ -n $taken ]] || taken="$(date +%s)"
  printf '%s\t%s\n%s\n' "$OWNER" "$(date +%s)" "$taken" >"$RECORD" || {
    echo "[FAIL] #$ISSUE の持ち主を記録できません: $RECORD" >&2
    exit 2
  }
}

# 記録を読む。**前の書式（1 行だけ）で書かれたものも読む** (#264)。
#
# **記録はループを跨いで残る**ので、**書式を変えた周回の次に読むのは、前の形**である
# （`AGENTS.md` §5）。**着手した時刻が無ければ、触った時刻から数える**——
# **「着手はもっと前」という向きにしかずれない**ので、**早すぎる側へは倒れない。**
#
# **1 行目の余りは捨てる。** **列で持たせた版が短い間だけ存在した**ので、
# **その記録が共有ディレクトリに残っている**——**読めないと言って止まるより、
# 触った時刻へ倒れるほうがよい**（上と同じ向きである）。
read_record() {
  local record="${1:-$RECORD}"
  held_owner=""
  held_since=""
  held_taken=""
  [[ -f $record ]] || return 0
  {
    IFS=$'\t' read -r held_owner held_since _
    read -r held_taken
  } <"$record"
  if ! [[ $held_since =~ ^[0-9]+$ ]]; then
    return 1
  fi
  [[ $held_taken =~ ^[0-9]+$ ]] || held_taken="$held_since"
  return 0
}

# --- idle ----------------------------------------------------------------------
# **着手したまま実装が出ていない Issue を並べる** (#264)。
#
# **どの検査も「健全」と答える状態がある。** **作業ツリーは clean、ブランチも PR も
# 無く、`resume` は exit 0、`audit` も食い違いを見つけない**——**label と実態は
# 合っていて、手だけが動いていない**（**worker の context が尽きた**。2026-08-14 に実測）。
# **`no-work` にも当たらない**（**作業はある**）ので、**どこにも積まれない。**
#
# **見るのは「着手からの経過」と「実装が出ているか」の 2 つだけ**である。
#
# **`no-work` に相乗りさせない。** **意味が違う**——**あちらは着手できる作業が無い状態**で、
# **読んだ人が「作業が尽きた」と誤解する。**
#
# **本人の申告は待たない。** **申告できないほど尽きていたら積まれない**ので、
# **塞ぎたい当の場面で黙る**（#243 と同じ形）。**外から見えるものだけで決める。**
#
#   exit 0 = 1 件以上ある。**種別ごとに 1 行**
#            `stalled<TAB><Issue番号><TAB><着手からの秒数>`  実装が出ていない
#            `unowned<TAB><Issue番号>`                      着手中なのに記録が無い
#   exit 1 = 無い
#   exit 2 = 判定できない
if [[ $ACTION == "idle" ]]; then
  # **読むだけだが、ロックの中に置く。** **`take` / `resume` が書いている最中の記録を
  # 読まない**ため（**半分書けた記録は、着手した時刻が空に見える**）。
  exec 9>"$common_dir/valence-loop-claim.lock" || {
    echo "[FAIL] 取り合いのロックを作成できません" >&2
    exit 2
  }
  if ! flock -w "$LOCK_WAIT_SEC" 9; then
    # **ここは譲らない。** **数える側が「無かった」と答えると、検出器が黙って消える**
    echo "[FAIL] 取り合いのロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
    exit 2
  fi

  repo_ref="$(gh repo view --json owner,name --jq '.owner.login, .name')" || {
    echo "[FAIL] リポジトリを特定できません" >&2
    exit 2
  }
  mapfile -t repo_parts <<<"$repo_ref"
  readonly HERE="${repo_parts[0]-}/${repo_parts[1]-}"

  # **取れなかったものを「0 件」と読まない。** **読めないまま「動いている」と答えると、
  # この検出器だけが静かに消える**——**状態は健全に見えたまま**である。
  if ! in_progress="$(gh issue list --label in-progress --limit 200 --json number,labels \
    --jq '.[] | "\(.number)\t\([.labels[].name] | join(","))"')"; then
    echo "[FAIL] 着手中の Issue を読めません" >&2
    exit 2
  fi
  # **閉じる Issue は GitHub に訊く**（`audit` と同じ理由）。**本文を自分で解析すると、
  # `close` / `fixes` / `resolved` の書き分けを写すことになり、写した規則は必ずずれる。**
  if ! covered="$(gh pr list --state open --limit 200 --json number,closingIssuesReferences \
    --jq '.[].closingIssuesReferences[]
      | "\(.repository.owner.login)/\(.repository.name)\t\(.number)"')"; then
    echo "[FAIL] open PR が閉じる Issue を読めません" >&2
    exit 2
  fi

  # **報告に載せる直前に、直接読んで確かめる** (#281 のレビュー 2 周目)。
  #
  # **一覧（索引）は遅れる。** **同じ出口で `audit` が先に走り**、**「着手中でない」と
  # 直接読んで判断し、記録を消す**——**その数コマンド後にこちらが一覧を読むと、
  # 消えた記録の Issue がまだ並ぶ**（**マージした周回がいちばん踏みやすい**）。
  #
  # **偽陽性の代償は「人が来て、何も無い」だが、それは「たまに」の話**である。
  # **マージのたびに鳴るなら、次に来た人はまず検出器を疑う**——**そこでこの仕組みは死ぬ。**
  # **#264 が塞ぎに来たのは「気づけない」ほう**なので、**倒れる向きが逆になる。**
  #
  # **全件には投げない。** **絞ったあとの数件だけ**なので、往復は増えない。
  #
  # **読めなかったら「着手中でない」に倒さない。** **倒すと、読めないあいだ黙る**
  # ——**一覧の失敗を exit 2 にしているのと同じ原則である。**
  still_in_progress() {
    local number="$1" fresh
    if ! fresh="$(gh issue view "$number" --json labels --jq '.labels[].name')"; then
      echo "[FAIL] #$number の label を読み直せません" >&2
      exit 2
    fi
    has_label "in-progress" "$fresh" || return 1
    # **`blocked` も見直す。** **止められた直後に鳴らせない**（人の判断待ちである）
    ! has_label "blocked" "$fresh"
  }

  now="$(date +%s)"
  idle_found=0
  while IFS=$'\t' read -r number labels; do
    [[ $number =~ ^[0-9]+$ ]] || continue
    # **`blocked` は人の判断待ちである。** **手が止まっているのが正しい状態**なので、
    # 数えると**人が来るまで毎周回積み続ける**（`no-work` が `blocked` を含めるのと逆向きの理由）。
    has_label "blocked" "${labels//,/$'\n'}" && continue

    published=0
    while IFS=$'\t' read -r closed_repo closed; do
      # **このリポジトリのものだけを見る。** **他所の同じ番号を閉じる PR**（`Fixes owner/other#264`）
      # を数えると、**実装が出ていないのに「出ている」と読む**——**検出器が黙る側**である。
      [[ $closed_repo == "$HERE" && $closed == "$number" ]] || continue
      published=1
      break
    done <<<"$covered"
    ((published == 0)) || continue

    record="$common_dir/valence-loop-claim-$number"
    if [[ ! -f $record ]]; then
      # **飛ばさない** (#281 のレビュー)。**`take` は label を先に付ける**ので、
      # **その間に落ちれば「着手中なのに記録が無い」**——**`write_record` が
      # 失敗した場合も同じ**で、**どちらもこの Issue が捕まえたい壊れ方**である。
      #
      # **測れないことを、健全と同じ出口にしない。** **飛ばすと exit 1 になり、
      # 呼ぶ側は「無い」と読む**——**この検出器だけが静かに消える**（すぐ上で
      # `gh` の失敗を exit 2 へ倒しているのと、同じ原則である）。
      #
      # **`stalled` と混ぜない。** **原因が違い、人が次にやることも違う**——
      # **尽きた worker を見る**のか、**持ち主のいない着手を戻す**のか。
      still_in_progress "$number" || continue
      printf '%s\t%s\n' "unowned" "$number"
      idle_found=1
      continue
    fi
    if ! read_record "$record"; then
      echo "[FAIL] #$number の着手の記録を読めません: $record" >&2
      exit 2
    fi
    ((now - held_taken >= IDLE_SEC)) || continue
    still_in_progress "$number" || continue
    printf '%s\t%s\t%s\n' "stalled" "$number" "$((now - held_taken))"
    idle_found=1
  done <<<"$in_progress"

  ((idle_found == 1)) || exit 1
  exit 0
fi

# --- audit ---------------------------------------------------------------------
# **label と実態の食い違いを、状態から見つける。**
#
# **呼ぶ場所を散文で並べない。** **Issue の記録を返す口**を足して「マージしたとき」
# 「blocked へ落としたとき」…と列挙すると、**経路が増えたときに漏れる**
# （#92 で「通知を送る場面」の列挙が漏れたのと同じ形）。
# **`release` は PR の記録を持ち主が返す口**で、**これとは別物である** (#306 のレビュー)
# ——**呼ぶ場所は 1 つ（取り違えたと分かったとき）**で、**列挙にならない。**
# **どちらの食い違いも状態から機械的に決まる**ので、そちらを見る。
#
#   open PR が閉じる Issue が着手中でない … **人の判断が要る**（誰が持つべきか決められない）
#   記録が指す Issue が着手中でない       … **古い記録**。自動で解放してよい
if [[ $ACTION == "audit" ]]; then
  # **確認も付け替えも、`take` / `resume` と同じロックの中で行う。**
  # 外でやると、**移す前に `take` される**（読んでから書くまでの窓が、塞ぐ側に開く）。
  exec 9>"$common_dir/valence-loop-claim.lock" || {
    echo "[FAIL] 取り合いのロックを作成できません" >&2
    exit 2
  }
  if ! flock -w "$LOCK_WAIT_SEC" 9; then
    echo "[FAIL] 取り合いのロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
    exit 2
  fi

  # **一覧（検索）を通さない。** 付け替えた直後は古い値が返る（#101 で実測）。
  repo_ref="$(gh repo view --json owner,name --jq '.owner.login, .name')" || {
    echo "[FAIL] リポジトリを特定できません" >&2
    exit 2
  }
  mapfile -t repo_parts <<<"$repo_ref"
  open_prs="$(gh api graphql --paginate \
    -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" \
    -f query='query($owner:String!,$repo:String!,$endCursor:String){
      repository(owner:$owner,name:$repo){
        pullRequests(states:OPEN,first:50,after:$endCursor){
          pageInfo{hasNextPage endCursor}
          nodes{number}}}}' \
    --jq '.data.repository.pullRequests.nodes[].number')" || {
    echo "[FAIL] open PR を取得できません" >&2
    exit 2
  }

  mismatched=0
  while read -r pr; do
    [[ -n $pr ]] || continue
    # **閉じる Issue は GitHub に訊く。** 本文を自分で解析すると、
    # `close` / `fixes` / `resolved` … と**大文字小文字**まで写し取ることになり、
    # **写した規則は必ず本家からずれる**（#122 で `i` を落として踏んだ形）。
    # **人が手で作った PR は `Fixes #N` と書く**ので、
    # **この検査がいちばん必要な場面**で黙ることになる。
    # **リポジトリも一緒に取る。** closing keyword は `Fixes owner/other#73` のような
    # **別リポジトリ参照**も扱えるので、番号だけに潰すと**こちらの無関係な #73** を
    # 止めることになる。
    if ! closes="$(gh pr view "$pr" --json closingIssuesReferences \
      --jq '.closingIssuesReferences[] | "\(.repository.nameWithOwner)\t\(.number)"')"; then
      echo "[FAIL] PR #$pr が閉じる Issue を読めません" >&2
      exit 2
    fi
    while IFS=$'\t' read -r closed_repo closed; do
      [[ -n $closed ]] || continue
      # **このリポジトリのものだけを見る。** 他所の Issue は触れないし、触ってはいけない
      [[ $closed_repo == "${repo_parts[0]-}/${repo_parts[1]-}" ]] || continue
      if ! labels="$(gh issue view "$closed" --json labels --jq '.labels[].name')"; then
        echo "[FAIL] #$closed の label を読めません" >&2
        exit 2
      fi
      # **`in-progress` があるだけでは足りない。** `take` は **`ready` の有無だけ**を
      # 見るので、併存したまま通すと**別の作業場が取れる**。
      has_label "in-progress" "$labels" && ! has_label "ready" "$labels" && continue
      # **記録するだけでは防止にならない。** 次の周回で `take` できてしまい、
      # **進捗が出るとカウンタが消える**——**止めたかった当の出来事が記録を消す**。
      # **その 1 件だけを止める**（全ループは進める。#109 と同じ整理）。
      # **足し引きを 1 回で行う。** 分けると、**付いたのに外れていない**状態が作れる——
      # `take` は `ready` だけを見る（`blocked` は見ない）ので、
      # **止めたつもりで取られる**。1 回にまとめれば、その状態がそもそも作れない。
      # **`backlog` も外す。** 残すと master のステップ 6 が `ready` へ昇格させうる——
      # 「その 1 件だけを止める」が成立しない。
      edit_args=(--add-label blocked)
      has_label "ready" "$labels" && edit_args+=(--remove-label ready)
      has_label "backlog" "$labels" && edit_args+=(--remove-label backlog)
      if ! gh issue edit "$closed" "${edit_args[@]}" >/dev/null; then
        echo "[FAIL] #$closed を blocked へ移せません" >&2
        exit 2
      fi
      # **書いたら読み直す。** `gh` は**通らなくても成功を返しうる**（`take` が同じ理由で
      # 読み直している）。変わっていないのに「移しました」と言うと、
      # **ロックを離した後で取られる**。
      if ! moved="$(gh issue view "$closed" --json labels --jq '.labels[].name')"; then
        echo "[FAIL] #$closed の label を読み直せません" >&2
        exit 2
      fi
      if ! has_label "blocked" "$moved" || has_label "ready" "$moved" \
        || has_label "backlog" "$moved"; then
        echo "[FAIL] #$closed の label が変わっていません（止められていません）" >&2
        exit 2
      fi
      echo "[NG] PR #${pr} は #${closed} を閉じようとしていますが、着手中ではありません（blocked へ移しました）"
      mismatched=1
    done <<<"$closes"
  done <<<"$open_prs"

  # **古い記録は、その場で解放する。** 「誰も作業していないのに持ち主が居る」記録は、
  # 作業場が増えた瞬間に**再開を止める**（#82 の前に消しておきたい）。
  for record in "$common_dir"/valence-loop-claim-[0-9]*; do
    [[ -f $record ]] || continue
    number="${record##*valence-loop-claim-}"
    [[ $number =~ ^[0-9]+$ ]] || continue
    if ! labels="$(gh issue view "$number" --json labels --jq '.labels[].name')"; then
      echo "[FAIL] #$number の label を読めません" >&2
      exit 2
    fi
    if ! has_label "in-progress" "$labels"; then
      # **失敗を黙って成功にしない。** 消えていない記録は残り続け、
      # **別の作業場の再開を妨げる**（手順書 3.1 の掃除と同じ扱い）
      if ! rm -f "$record"; then
        echo "[FAIL] 古い記録を消せません: $record" >&2
        exit 2
      fi
      echo "[INFO] #${number} は着手中ではないので、古い記録を解放しました"
    fi
  done

  ((mismatched == 0)) || exit 1
  exit 0
fi

exec 9>"$common_dir/valence-loop-claim.lock" || {
  echo "[FAIL] 取り合いのロックを作成できません" >&2
  exit 2
}
# **待てなかったら譲る。** いま誰かが取っている最中なので、
# 「取れなかった」と同じ扱いにするのが安全側である（判定不能に倒すと、
# **取り合いのたびに周回が止まる**）。flock はプロセスが死ねば外れるので、居座らない。
if ! flock -w "$LOCK_WAIT_SEC" 9; then
  echo "[INFO] #$ISSUE: 別の周回が取っている最中です（${LOCK_WAIT_SEC} 秒待機）。譲ります" >&2
  exit 1
fi

# --- mine ----------------------------------------------------------------------
# **数えるのは自分の作業場のものだけ** (#85)。**`--author @me` は 2 人分を返す**ので、
# **そのまま数えると「1 人が同時に持つ PR は 1 本」に 2 人目のぶんで引っかかる**。
#
# **`pr` とは別の問いである。** **`pr` は「いま編集してよいか」**なので**持ち主が
# 生きているか**を見るが、**こちらは「誰の持ち物か」**——**PR は次の周回でレビュー対応する**ので、
# **周回をまたいで持ち主のままでなければならない。**
#
# **ここでは取らない** (#238 のレビュー 2 周目)。**記録が無いものは
# 「まだ誰のものでもない」**で、**数えない**（exit 1）。
#
# **数える側で取ると、先に走った作業場が記録の無い PR を全部取る**——
# **「両方の作業場が止まる」が「1 人が両方持って止まる」に置き換わるだけ**である
# （#184 の形が残る）。**取るのは空き枠のぶんだけ**で、**それは `pr` が 1 本ずつ行う**
# （手順書のステップ 2.1）。**残しておけば、別の作業場が 1 本目として取れる。**
#
# **読むだけだが、ロックの中に置く。** **`pr` と `take` が書いている最中の記録を
# 読まない**ため（**半分書けた記録は、持ち主が空に見える**）。
if [[ $ACTION == "mine" ]]; then
  [[ -f $RECORD ]] || exit 1
  IFS=$'\t' read -r held_owner _ <"$RECORD" || {
    echo "[FAIL] PR #$ISSUE の持ち主の記録を読めません: $RECORD" >&2
    exit 2
  }
  [[ -n $held_owner ]] || {
    echo "[FAIL] PR #$ISSUE の持ち主の記録が空です: $RECORD" >&2
    exit 2
  }
  [[ $held_owner == "$OWNER" ]] || exit 1
  exit 0
fi

# --- release --------------------------------------------------------------------
# **自分が取った PR の claim を返す** (#306 のレビュー)。
#
# **`pr` を `alive` へ寄せると、持ち主が周回を回している限り窓が開かない**
# ——**取り違えた claim は、その作業場が回さなくなるまで誰にも取り返せない**
# （**実測で踏んだ**。worker-b が #305 を取り違え、返す口が無かった）。
#
# **落ちた周回のぶんは、これまでどおり `alive` の窓が拾う**ので、**#237 が拒んだ
# 「自動で返す仕組み」とは別物**である——**返すのは持ち主だけ**で、**呼ぶのは
# 「取り違えたと分かったとき」の 1 箇所**である。
#
#   exit 0 = 返した（記録が無いときも 0）/ exit 1 = 別の作業場のもの / exit 2 = 判定できない
if [[ $ACTION == "release" ]]; then
  read_record || {
    echo "[FAIL] PR #$ISSUE の持ち主の記録を読めません: $RECORD" >&2
    exit 2
  }
  # **返す先が無いのは失敗ではない。** **取る前に返しても、周回を止めない**
  [[ -n $held_owner ]] || exit 0
  if [[ $held_owner != "$OWNER" ]]; then
    # **返せるのは自分のものだけ。** **他人のものを消せると、排他が意味を失う**
    echo "[INFO] PR #$ISSUE は別の作業場のものです（$held_owner）。返しません" >&2
    exit 1
  fi
  rm -f "$RECORD" || {
    echo "[FAIL] PR #$ISSUE の記録を消せません: $RECORD" >&2
    exit 2
  }
  echo "[INFO] PR #$ISSUE の claim を返しました" >&2
  exit 0
fi

# --- pr ------------------------------------------------------------------------
# **GitHub を読まずに決める。** **持ち主は作業場**で、**それは手元にしか無い**——
# **label を 1 つ足しても、同じアカウントの 2 つの作業場は区別できない。**
if [[ $ACTION == "pr" ]]; then
  read_record || {
    echo "[FAIL] PR #$ISSUE の持ち主の記録を読めません: $RECORD" >&2
    exit 2
  }

  if [[ -n $held_owner && $held_owner != "$OWNER" ]]; then
    # **時間で測らない** (#237 のレビュー)。**測れるのは「取ってからの経過」だが、
    # 知りたいのは「持ち主が生きているか」**である——**レビュー対応は `./task check` を
    # 回すので、動いているまま期限を超えうる**。**超えた瞬間に引き継がれると、
    # この経路が消しに来たもの（2 人が同じ PR を直す）が、期限の側から戻ってくる。**
    #
    # **心拍を 2 つ持たない。** **`bin/loop-lease` が既に測っている**ので、**そこへ訊く**。
    # 満たしたい性質は **生きている限り切れない / 落ちたら必ず切れる** で、
    # **どちらも lease 側の窓がそのまま担う。**
    #
    # **PR の記録そのものは期限で消えない** (#306 のレビュー)。**`read_record` も
    # `mine` も古さを見ていない**——**効いているのは `take` / `resume` の側だけ**である。
    # **だから返す口を別に置いた**（この上の `release`）——**取り違えた claim が、
    # 持ち主にも返せないまま残らないようにする。**
    #
    # **`resume` と同じ口へ訊く** (#306)。**前は `busy`（いま握っているか）で見ていた**
    # ——**`resume` は `alive`（周回を回しているか）**なので、**同じ作業場の生死に
    # 2 つの答えがあった**。**周回と周回の間にいるだけの worker から PR だけが取られ、
    # 取られた側は次の周回で自分の PR を直せない**（2.1 も 2.2 も exit 1 になる）。
    # **実測で踏んだ**（2026-08-15。`pr` は exit 0、`resume` は exit 1）。
    #
    # **寄せる先は `alive` である**（#296 / #298 / #303 でそちらへ寄せてきた）。
    # **落ちた作業場からは、これまでどおり引き継げる**——**周回の印が窓を過ぎれば
    # `alive` も 1 を返す**ので、**「誰も直せない」は作らない**（#296 が消しに来た形）。
    #
    # **識別子の組み立ては書き写さない**（作業場 → digest は lease が持っている。#159）
    # ——**`alive` は作業場のパスをそのまま受け取る。**
    #
    # **持ち主の作業場へは移らない** (#237 のレビュー)。**手順書は `bin/loop-claim` と
    # 相対で呼ぶ**ので、**移ってから `${BASH_SOURCE[0]%/*}` を解決すると
    # 「相手の作業場の `bin/loop-lease`」が走る**——**相手は `gh pr checkout` で PR の
    # head に入っている**ので、**その PR が書き換えた版を実行しうる**（#219 と同じ形）。
    # **壊れ方は静かで、`alive` の答えを変える PR が乗っていると、生きている持ち主を
    # 「走っていない」と読む**——**この経路が消しに来たものが、そこから戻ってくる。**
    #
    # **移る必要も無い。** **`alive` は共通ディレクトリの記録を読むだけ**で、
    # **同じ worktree 群なら、どこから呼んでも同じものが読める。**
    "${BASH_SOURCE[0]%/*}/loop-lease" alive "$held_owner"
    case "$?" in
      0)
        # **黙って飛ばさない。** **無言で譲ると、2 人居るのに 1 人で回っているように見える。**
        echo "[INFO] PR #$ISSUE は別の作業場が直しています（$held_owner）。触りません" >&2
        exit 1
        ;;
      1) ;; # 回っていない。下で引き継ぐ
      *)
        # **読めないなら取らない。** **判定不能は、取れた側でも取れなかった側でもない。**
        echo "[FAIL] PR #$ISSUE の持ち主（$held_owner）が動いているか判定できません" >&2
        exit 2
        ;;
    esac

    # **黙って奪わない。** 走っていない持ち主の記録は、終わった周回か落ちた周回の跡である。
    echo "[WARN] PR #$ISSUE の持ち主（$held_owner）の周回は走っていません。引き継ぎます" >&2
  fi

  # **自分のものでも書き直す**（動いていることの印である）。
  # **着手した時刻は持ち越す** (#264)——**書き直すのは「触った時刻」だけ**である。
  write_record "$held_taken"
  exit 0
fi

# ここから先はロックの中。**読み・書き・確認がひとつながりになる。**
if ! labels="$(labels_of)"; then
  echo "[FAIL] #$ISSUE の label を読めません" >&2
  exit 2
fi

case "$ACTION" in
take)
  if ! has_label "ready" "$labels"; then
    echo "[INFO] #$ISSUE は ready ではありません。別の周回が取ったとみなして譲ります" >&2
    exit 1
  fi

  if ! gh issue edit "$ISSUE" --remove-label ready --add-label in-progress >/dev/null; then
    echo "[FAIL] #$ISSUE の label を付け替えられません" >&2
    exit 2
  fi

  # **書いたら読み直して確かめる。** 付け替えが通らなくても `gh` は成功を返しうる。
  # 確かめずに進むと、**label は ready のまま実装が始まり**、次の周回が同じものを取る。
  if ! after="$(labels_of)"; then
    echo "[FAIL] #$ISSUE の label を読み直せません" >&2
    exit 2
  fi
  if has_label "ready" "$after" || ! has_label "in-progress" "$after"; then
    echo "[FAIL] #$ISSUE の label が変わっていません（取れたとみなしません）" >&2
    exit 2
  fi

  write_record
  ;;
resume)
  # **着手中のものだけを見る。** `ready` を 2.2 から横取りしない（取るのは `take` である）。
  if ! has_label "in-progress" "$labels"; then
    echo "[INFO] #$ISSUE は着手中ではありません。2.2 の対象ではないので触りません" >&2
    exit 1
  fi

  read_record || {
    echo "[FAIL] #$ISSUE の持ち主の記録を読めません: $RECORD" >&2
    exit 2
  }

  if [[ -n $held_owner && $held_owner != "$OWNER" ]]; then
    # **時間で測らない** (#296)。**測れるのは「claim を触ってからの経過」だが、
    # 知りたいのは「その作業場が周回を回しているか」**である——**PR を持つ worker は
    # `mine <PR番号>` からステップ 3 へ入り、`resume` を打たない**ので、
    # **生きていても記録だけ古くなる。** **2026-08-15 に実測で踏んだ**
    # （**worker-b が 3 分前に周回を始めているのに「5720 秒動いていません」と読んだ**）。
    #
    # **判定は `bin/loop-lease` が持っている**（`pr` と同じ考え方。#159 / #290）——
    # **周回の印は、返しても消えない**ので、**周回と周回の間でも「次に戻ってくる
    # 作業場」を生きていると読める**（**`busy` は握っている間しか見えない**）。
    #
    # **持ち主の作業場へは移らない** (#237 のレビュー。`pr` と同じ理由)。
    "${BASH_SOURCE[0]%/*}/loop-lease" alive "$held_owner"
    case "$?" in
      0)
        # **黙って飛ばさない。** **無言で譲ると、2 人居るのに 1 人で回っているように見える。**
        echo "[INFO] #$ISSUE は別の作業場が実装中です（$held_owner）。触りません" >&2
        exit 1
        ;;
      1) ;; # 回っていない。下で引き継ぐ
      *)
        # **読めないなら取らない。** **判定不能を「落ちた」に倒すと、生きている
        # 作業場から取り上げる**——**取り上げるより、待つほうが安い。**
        echo "[FAIL] #$ISSUE の持ち主（$held_owner）が周回を回しているか判定できません" >&2
        exit 2
        ;;
    esac
    # **黙って奪わない。** 回っていない持ち主の記録は、終わった周回か落ちた周回の跡である。
    echo "[WARN] #$ISSUE の持ち主（$held_owner）の周回は走っていません。引き継ぎます" >&2
  fi

  # **引き継いだら持ち主を書き換える。** 前の持ち主のまま残すと、
  # **次の周回でも誰でも引き継げる**ことになり、排他が 1 回きりになる。
  # 自分の作業を続けるときも書き直す（動いていることの印である）。
  #
  # **着手した時刻は持ち越す** (#264)。**引き継ぎでも書き直さない**——
  # **持ち主が代わっても、その Issue が着手されたのは最初の 1 回**である。
  write_record "$held_taken"
  ;;
esac
