#!/usr/bin/env bash
# `ready` の Issue を **1 つの周回だけが取る**ようにし、**着手中のものを誰が持っているか**を
# 記録する。
#
#   bin/loop-claim take   <Issue番号>   ready の Issue を取る
#   bin/loop-claim resume <Issue番号>   着手中の Issue を、自分が続けてよいか尋ねる
#
#   exit 0 = 取れた / 続けてよい
#   exit 1 = 取れなかった / 別の作業場が持っている → **次の Issue へ進む。待たない**
#   exit 2 = 判定できない / 使い方の誤り
#
# **label を付け替えるだけでは足りない。** 読んでから書くまでに間があるので、
# **両方が「空いている」と読んでから、両方が書ける**。症状は「同じ Issue の PR が 2 本」で、
# **どちらも正しく見える**ので、後から見ても取り合いだと分からない。
#
# **入口は 2 つある。** 手順書のステップ 4（`ready` を取る）だけでなく、
# ステップ 2.2（着手中の Issue を再開する）からも実装へ入れる。
# **2.2 は label しか見ていなかった**ので、`take` で取った直後——**ブランチができるまでの窓**——に
# 別の作業場が 2.2 を通ると、そこから重複が入る。だから `resume` も同じ記録を見る。
#
# **assignee では区別できない。** 周回はどれも同じ GitHub アカウントで動くので、
# 「誰が取ったか」を GitHub 側の値で表せない。**取り合いを解けるのは手元だけ**である。
# 持ち主は `bin/loop-lease` と同じ**作業場（worktree の根）**で表す。語彙を増やさない。
#
# **譲る側の決め方: 先にロックを取れた側が取り、後から入った側が譲る。**
# ロックは必ずどちらか一方が取るので、**両方が譲って誰も進まない**ことは起きない。
#
# **守れるのは、同じクローンを共有する周回まで。** 別のクローン・別のマシンで動く周回は
# 対象外である (`bin/loop-lease` と `bin/loop-stall` も同じ前提に立っている)。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# **入口を飛ばしていないか、ここでも確かめる**（#161）。**出口だけでは遅い**——
# 気づくのは終わったあとで、**その周回の直列化は既に効いていない**。
# **周回で最初に触るものが確かめれば、やり直せるうちに分かる**。
# **止めない**（`|| true`）——気づける形は保ったまま、飛ばしにくくする。
"${BASH_SOURCE[0]%/*}/loop-lease" check "worker" || true


# ロックを待つ時間。**ここで行うのは GitHub との数往復だけ**なので短くてよい。
readonly LOCK_WAIT_SEC="${LOOP_CLAIM_LOCK_WAIT_SEC:-10}"

# 持ち主の記録を引き継ぐまでの時間。
#
# **記録が守るのは「取ってからブランチが見えるまで」の窓だけ**である。ブランチは
# 作業場をまたいで共有されるので、**ブランチができた後は 2.2 が自分で判定できる**。
# つまり期限は「その窓を覆えれば十分」で、長く持つ必要が無い。
#
# **短すぎると「2 つが同じものを実装する」を作り直し、長すぎると「落ちたら止まる」になる。**
# ここは**拾えるほうへ倒す**——窓の中で落ちた周回は**何も作っていない**ので、
# 引き継いでもやり直しになるだけで、失うものが無い。`bin/loop-lease` と同じ 30 分にして
# あるのは、**1 周が長引くより十分に長い**という同じ理由による。
readonly TTL_SEC="${LOOP_CLAIM_TTL_SEC:-1800}"

usage() {
  echo "使い方: bin/loop-claim take <Issue番号>     ready の Issue を取る" >&2
  echo "        bin/loop-claim resume <Issue番号>   着手中の Issue を続けてよいか尋ねる" >&2
  echo "        bin/loop-claim audit                label と実態の食い違いを見つける" >&2
  echo "        exit 0 取れた / exit 1 取れなかった（次の Issue へ進む）/ exit 2 判定不能" >&2
  exit 2
}

readonly ACTION="${1-}"
if [[ $ACTION == "audit" ]]; then
  [[ $# -eq 1 ]] || usage
  ISSUE=""
else
  [[ $# -eq 2 ]] || usage
  ISSUE="$2"
  [[ $ACTION == "take" || $ACTION == "resume" ]] || usage
  [[ $ISSUE =~ ^[0-9]+$ ]] || usage
fi
readonly ISSUE

for setting in LOCK_WAIT_SEC TTL_SEC; do
  if ! [[ ${!setting} =~ ^[0-9]+$ ]]; then
    echo "[FAIL] 設定: LOOP_CLAIM_${setting%_SEC}_SEC は 0 以上の整数（秒）で指定してください" >&2
    exit 2
  fi
done

# **git の共通ディレクトリに置く。** 作業場ごとに置くと、作業場が分かれた時点で
# 取り合いを検出できない——**それがこの Issue の前提**である (`bin/loop-lease` と同じ形)。
if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
  echo "[FAIL] 作業場の根を特定できません" >&2
  exit 2
fi
toplevel="$(cd "$toplevel" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] 作業場の根へ移動できません" >&2
  exit 2
}
readonly OWNER="$toplevel"
readonly RECORD="$common_dir/valence-loop-claim-$ISSUE"

labels_of() {
  gh issue view "$ISSUE" --json labels --jq '.labels[].name'
}

has_label() {
  local wanted="$1" line
  while IFS= read -r line; do
    [[ $line == "$wanted" ]] && return 0
  done <<<"$2"
  return 1
}

# **持ち主を書き残す。** 記録が無ければ、2.2 は「誰の作業か」を判定できない。
write_record() {
  printf '%s\t%s\n' "$OWNER" "$(date +%s)" >"$RECORD" || {
    echo "[FAIL] #$ISSUE の持ち主を記録できません: $RECORD" >&2
    exit 2
  }
}

# --- audit ---------------------------------------------------------------------
# **label と実態の食い違いを、状態から見つける。**
#
# **呼ぶ場所を散文で並べない。** `bin/loop-claim release` を足して「マージしたとき」
# 「blocked へ落としたとき」…と列挙すると、**経路が増えたときに漏れる**
# （#92 で「通知を送る場面」の列挙が漏れたのと同じ形）。
# **どちらの食い違いも状態から機械的に決まる**ので、そちらを見る。
#
#   open PR が閉じる Issue が着手中でない … **人の判断が要る**（誰が持つべきか決められない）
#   記録が指す Issue が着手中でない       … **古い記録**。自動で解放してよい
if [[ $ACTION == "audit" ]]; then
  # **確認も付け替えも、`take` / `resume` と同じロックの中で行う。**
  # 外でやると、**移す前に `take` される**（読んでから書くまでの窓が、塞ぐ側に開く）。
  exec 9>"$common_dir/valence-loop-claim.lock" || {
    echo "[FAIL] 取り合いのロックを作成できません" >&2
    exit 2
  }
  if ! flock -w "$LOCK_WAIT_SEC" 9; then
    echo "[FAIL] 取り合いのロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
    exit 2
  fi

  # **一覧（検索）を通さない。** 付け替えた直後は古い値が返る（#101 で実測）。
  repo_ref="$(gh repo view --json owner,name --jq '.owner.login, .name')" || {
    echo "[FAIL] リポジトリを特定できません" >&2
    exit 2
  }
  mapfile -t repo_parts <<<"$repo_ref"
  open_prs="$(gh api graphql --paginate \
    -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" \
    -f query='query($owner:String!,$repo:String!,$endCursor:String){
      repository(owner:$owner,name:$repo){
        pullRequests(states:OPEN,first:50,after:$endCursor){
          pageInfo{hasNextPage endCursor}
          nodes{number}}}}' \
    --jq '.data.repository.pullRequests.nodes[].number')" || {
    echo "[FAIL] open PR を取得できません" >&2
    exit 2
  }

  mismatched=0
  while read -r pr; do
    [[ -n $pr ]] || continue
    # **閉じる Issue は GitHub に訊く。** 本文を自分で解析すると、
    # `close` / `fixes` / `resolved` … と**大文字小文字**まで写し取ることになり、
    # **写した規則は必ず本家からずれる**（#122 で `i` を落として踏んだ形）。
    # **人が手で作った PR は `Fixes #N` と書く**ので、
    # **この検査がいちばん必要な場面**で黙ることになる。
    # **リポジトリも一緒に取る。** closing keyword は `Fixes owner/other#73` のような
    # **別リポジトリ参照**も扱えるので、番号だけに潰すと**こちらの無関係な #73** を
    # 止めることになる。
    if ! closes="$(gh pr view "$pr" --json closingIssuesReferences \
      --jq '.closingIssuesReferences[] | "\(.repository.nameWithOwner)\t\(.number)"')"; then
      echo "[FAIL] PR #$pr が閉じる Issue を読めません" >&2
      exit 2
    fi
    while IFS=$'\t' read -r closed_repo closed; do
      [[ -n $closed ]] || continue
      # **このリポジトリのものだけを見る。** 他所の Issue は触れないし、触ってはいけない
      [[ $closed_repo == "${repo_parts[0]-}/${repo_parts[1]-}" ]] || continue
      if ! labels="$(gh issue view "$closed" --json labels --jq '.labels[].name')"; then
        echo "[FAIL] #$closed の label を読めません" >&2
        exit 2
      fi
      # **`in-progress` があるだけでは足りない。** `take` は **`ready` の有無だけ**を
      # 見るので、併存したまま通すと**別の作業場が取れる**。
      has_label "in-progress" "$labels" && ! has_label "ready" "$labels" && continue
      # **記録するだけでは防止にならない。** 次の周回で `take` できてしまい、
      # **進捗が出るとカウンタが消える**——**止めたかった当の出来事が記録を消す**。
      # **その 1 件だけを止める**（全ループは進める。#109 と同じ整理）。
      # **足し引きを 1 回で行う。** 分けると、**付いたのに外れていない**状態が作れる——
      # `take` は `ready` だけを見る（`blocked` は見ない）ので、
      # **止めたつもりで取られる**。1 回にまとめれば、その状態がそもそも作れない。
      # **`backlog` も外す。** 残すと master のステップ 6 が `ready` へ昇格させうる——
      # 「その 1 件だけを止める」が成立しない。
      edit_args=(--add-label blocked)
      has_label "ready" "$labels" && edit_args+=(--remove-label ready)
      has_label "backlog" "$labels" && edit_args+=(--remove-label backlog)
      if ! gh issue edit "$closed" "${edit_args[@]}" >/dev/null; then
        echo "[FAIL] #$closed を blocked へ移せません" >&2
        exit 2
      fi
      # **書いたら読み直す。** `gh` は**通らなくても成功を返しうる**（`take` が同じ理由で
      # 読み直している）。変わっていないのに「移しました」と言うと、
      # **ロックを離した後で取られる**。
      if ! moved="$(gh issue view "$closed" --json labels --jq '.labels[].name')"; then
        echo "[FAIL] #$closed の label を読み直せません" >&2
        exit 2
      fi
      if ! has_label "blocked" "$moved" || has_label "ready" "$moved" \
        || has_label "backlog" "$moved"; then
        echo "[FAIL] #$closed の label が変わっていません（止められていません）" >&2
        exit 2
      fi
      echo "[NG] PR #${pr} は #${closed} を閉じようとしていますが、着手中ではありません（blocked へ移しました）"
      mismatched=1
    done <<<"$closes"
  done <<<"$open_prs"

  # **古い記録は、その場で解放する。** 「誰も作業していないのに持ち主が居る」記録は、
  # 作業場が増えた瞬間に**再開を止める**（#82 の前に消しておきたい）。
  for record in "$common_dir"/valence-loop-claim-[0-9]*; do
    [[ -f $record ]] || continue
    number="${record##*valence-loop-claim-}"
    [[ $number =~ ^[0-9]+$ ]] || continue
    if ! labels="$(gh issue view "$number" --json labels --jq '.labels[].name')"; then
      echo "[FAIL] #$number の label を読めません" >&2
      exit 2
    fi
    if ! has_label "in-progress" "$labels"; then
      # **失敗を黙って成功にしない。** 消えていない記録は残り続け、
      # **別の作業場の再開を妨げる**（手順書 3.1 の掃除と同じ扱い）
      if ! rm -f "$record"; then
        echo "[FAIL] 古い記録を消せません: $record" >&2
        exit 2
      fi
      echo "[INFO] #${number} は着手中ではないので、古い記録を解放しました"
    fi
  done

  ((mismatched == 0)) || exit 1
  exit 0
fi

exec 9>"$common_dir/valence-loop-claim.lock" || {
  echo "[FAIL] 取り合いのロックを作成できません" >&2
  exit 2
}
# **待てなかったら譲る。** いま誰かが取っている最中なので、
# 「取れなかった」と同じ扱いにするのが安全側である（判定不能に倒すと、
# **取り合いのたびに周回が止まる**）。flock はプロセスが死ねば外れるので、居座らない。
if ! flock -w "$LOCK_WAIT_SEC" 9; then
  echo "[INFO] #$ISSUE: 別の周回が取っている最中です（${LOCK_WAIT_SEC} 秒待機）。譲ります" >&2
  exit 1
fi

# ここから先はロックの中。**読み・書き・確認がひとつながりになる。**
if ! labels="$(labels_of)"; then
  echo "[FAIL] #$ISSUE の label を読めません" >&2
  exit 2
fi

case "$ACTION" in
take)
  if ! has_label "ready" "$labels"; then
    echo "[INFO] #$ISSUE は ready ではありません。別の周回が取ったとみなして譲ります" >&2
    exit 1
  fi

  if ! gh issue edit "$ISSUE" --remove-label ready --add-label in-progress >/dev/null; then
    echo "[FAIL] #$ISSUE の label を付け替えられません" >&2
    exit 2
  fi

  # **書いたら読み直して確かめる。** 付け替えが通らなくても `gh` は成功を返しうる。
  # 確かめずに進むと、**label は ready のまま実装が始まり**、次の周回が同じものを取る。
  if ! after="$(labels_of)"; then
    echo "[FAIL] #$ISSUE の label を読み直せません" >&2
    exit 2
  fi
  if has_label "ready" "$after" || ! has_label "in-progress" "$after"; then
    echo "[FAIL] #$ISSUE の label が変わっていません（取れたとみなしません）" >&2
    exit 2
  fi

  write_record
  ;;
resume)
  # **着手中のものだけを見る。** `ready` を 2.2 から横取りしない（取るのは `take` である）。
  if ! has_label "in-progress" "$labels"; then
    echo "[INFO] #$ISSUE は着手中ではありません。2.2 の対象ではないので触りません" >&2
    exit 1
  fi

  held_owner=""
  held_since=""
  if [[ -f $RECORD ]]; then
    IFS=$'\t' read -r held_owner held_since <"$RECORD"
    if ! [[ $held_since =~ ^[0-9]+$ ]]; then
      echo "[FAIL] #$ISSUE の持ち主の記録を読めません: $RECORD" >&2
      exit 2
    fi
  fi

  if [[ -n $held_owner && $held_owner != "$OWNER" ]]; then
    now="$(date +%s)"
    if ((now - held_since < TTL_SEC)); then
      echo "[INFO] #$ISSUE は別の作業場が実装中です（$held_owner）。触りません" >&2
      exit 1
    fi
    # **黙って奪わない。** 期限切れの引き継ぎは、落ちた周回の跡である。
    echo "[WARN] #$ISSUE の持ち主（$held_owner）が $((now - held_since)) 秒前から動いていません。引き継ぎます" >&2
  fi

  # **引き継いだら持ち主を書き換える。** 前の持ち主のまま残すと、
  # **次の周回でも誰でも引き継げる**ことになり、排他が 1 回きりになる。
  # 自分の作業を続けるときも書き直す（動いていることの印である）。
  write_record
  ;;
esac
