#!/usr/bin/env bash
# 要求したレビューが返るまで、**その周回の中で**待つ。
#
#   exit 0 = 基準より新しいレビューが返った
#   exit 1 = 上限まで返らなかった (**正常な待ち。空転として数えない**)
#   exit 2 = 使い方の誤り / 設定の誤り / 判定不能
#
# **Codex はループの外にいて通知を送ってこない。** 周回で確認すると、
# レビューが 2 分で返っても気づくのは次の周回になる。ここで待てば周回を消費しない
# (sleep している間はトークンを使わないので、**回して確認するより安い**)。
#
# **上限は「1 回のツール呼び出しに収まる」こと**を優先して決める。長くしすぎると
# 呼び出し側が先に切られ、待った結果を受け取れない。返らなければ 1 で抜け、
# **次の周回で `bin/loop-review-budget` の判定に委ねる** (猶予の内側なら exit 3、
# 猶予を過ぎた未応答なら exit 1)。**待ち方を変えても、あちらは時刻で測るので判定は変わらない。**
#
# 「返った」の判定は `bin/loop-review-commits` に任せる。**応答は 3 通りあり
# (指摘あり / 会話コメント / 👍 だけ)、SHA を持たないものもある**ので、
# ここで数え方を作り直すと、きれいな PR ほど待ち続けることになる。
#
# **見るのは「応答が来たか」であって「レビューが成立したか」ではない** (#78)。
# **レビューできなかった応答** (「環境が無い」通知や中身の無い review) は
# **SHA を持たないので既定の出力から落ちる**——そちらを見ると、**応答が既に返って
# いるのに上限まで待つ**ことになり、**同じ周回でゲートへ戻る**という目的 (#72) が
# この経路では果たされない。**`--all` は応答の行 (印 `-`) も返す**ので、そこから取る。
#
# **口を増やさない。** `--all` は**回数と最後の応答時刻を 1 回の取得から導く**ために
# 既にある形で、**待つ側が必要とするものはそこに揃っている**。
#
# **レビュー済みの判定は変えない。** 数えるのは `bin/loop-review-budget` の仕事だが、
# **あちらも同じ `--all` を読む**（`bin/loop-review-budget:96`）——**担保は「別の出力を
# 見ていること」ではなく、第 3 列の分類**である。**待つ側は最後の行の時刻しか見ない**。
#
#   `answer` … 応答不能の通知。**回数に数えず**、通知として別に数える
#   `live`   … 現 head の祖先へのレビュー。**ここだけが回数になる**
#   `stale`  … rebase で消えた commit へのレビュー。回数に数えない
#
# **回数は許可制である**（`[[ $live == "live" ]] || continue`）。**知らない種別を
# 足しても、回数と head 一致は動かない**——**ただし `answer` 以外は「最後に応答が
# あった時刻」を動かす**ので、**未応答の判定（`pending`）には効く**。
#
# **種別を足すときに見るのはそこである**（#179）。**「応答はあったが何を見たか
# 分からない」を足すなら、`pending` を解くのは意図どおりでよいが、`answer` に
# 混ぜてはいけない**——**混ぜると応答不能の通知として数えられ、判定が変わる**。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# 待つ上限。**ツール呼び出しの制限より短くする。**
readonly MAX_SEC="${LOOP_AWAIT_REVIEW_MAX_SEC:-480}"

# 見に行く間隔。**忙しく回さない。** 待つこと自体が安いので、詰めても得が無い。
readonly INTERVAL_SEC="${LOOP_AWAIT_REVIEW_INTERVAL_SEC:-30}"

usage() {
  echo "使い方: bin/loop-await-review <PR番号> <基準時刻>" >&2
  echo "        基準時刻は要求を投げる前の最新レビューの時刻 (無ければ空文字)" >&2
  exit 2
}

[[ $# -eq 2 ]] || usage
# 数字だけを受け付ける。PR 番号以外が渡る経路を作らない。
[[ $1 =~ ^[0-9]+$ ]] || usage
readonly PR="$1"
readonly SINCE="$2"

if ! [[ $MAX_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_AWAIT_REVIEW_MAX_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
if ! [[ $INTERVAL_SEC =~ ^[0-9]+$ ]] || ((INTERVAL_SEC < 1)); then
  echo "[FAIL] 設定: LOOP_AWAIT_REVIEW_INTERVAL_SEC は 1 以上の整数（秒）で指定してください" >&2
  exit 2
fi

# 最新の**応答**の時刻を返す。無ければ空。
# **時刻は GitHub 側の値をそのまま使う。** こちらの時計と比べると、ずれた分だけ
# 「返っていないのに返った」または「返ったのに待ち続ける」になる。
latest_response_at() {
  local responses
  responses="$("$(dirname "$0")/loop-review-commits" --all "$PR")" || return 1
  printf '%s' "$responses" | tail -n 1 | cut -f1
}

# **締切は開始時に 1 回決める。** `sleep` の秒数だけを足すと、**毎回の確認 (GitHub API)
# にかかった時間が入らない**。API が遅いと「上限は守っているのに実時間はいくらでも伸びる」
# ことになり、**ツール呼び出しの制限より短く**という目的が果たせない。
readonly DEADLINE=$(($(date +%s) + MAX_SEC))

while :; do
  if ! latest="$(latest_response_at)"; then
    echo "[FAIL] PR #$PR の応答を読み取れません" >&2
    exit 2
  fi
  # ISO8601 (UTC, 固定長) なので文字列比較で時刻順になる。
  # **基準が空なら、1 件目が返った時点で返ったとみなす。**
  if [[ -n $latest && $latest > $SINCE ]]; then
    exit 0
  fi
  remaining=$((DEADLINE - $(date +%s)))
  ((remaining <= 0)) && break
  # **待つ前に、master が生きていることを記録する。** lease の期限は
  # 「最後に活動してからの経過」で測る (bin/loop-lease)。**master の時間はこの待ちに
  # 集中している**ので、ここで打たないと**待っている最中に期限が切れ**、別の master が
  # 引き継いでレビュー要求とマージ判定が並行する。
  #
  # **打つ場所は「長い区間の直前」だけに限る。** 増やすと、`bin/loop-handoff` で
  # 出口を 1 本にしたときと同じ「書き忘れる経路」が戻る。**いま長いのは 2 つだけ**——
  # `./task` のコマンドと、この待ち。**どちらも試験で押さえてある。**
  #
  # **打てなくても待つ。** ここで失敗して待ちを飛ばすと、**上限まで忙しく回る**。
  # 失敗は標準エラーに出るので、握りつぶしてはいない。
  "$(dirname "$0")/loop-lease" heartbeat master || true
  # **残りが間隔より短ければ、残りだけ待つ。** 超過して待つと上限の意味が無くなる。
  if ((remaining < INTERVAL_SEC)); then
    sleep "$remaining"
  else
    sleep "$INTERVAL_SEC"
  fi
done

echo "[WARN] PR #$PR のレビューは ${MAX_SEC} 秒では返りませんでした" >&2
echo "       この周回はここで終わります。次の周回で bin/loop-review-budget が判定します" >&2
exit 1
