#!/usr/bin/env bash
# 着手できる open PR を数える (#546)。
#
#   bin/loop-open-work < <open PR の一覧>
#
#   標準入力: 1 行 1 PR。`<PR番号><US><label><US><label>...`
#   標準出力: 着手できる PR の件数（1 行）
#
#   exit 0 = 数えた (0 件でも 0)
#   exit 2 = 入力を読めない / 使い方の誤り
#
# **人待ちの PR を数に入れない。** **`parked` + `awaiting-human` は、人の判断待ちで
# ループの中では解けない**——**master の手順書が `blocked` の Issue を数に入れないのと
# 同じ理由**である（**数を減らせるのは人だけ**）。
#
# **数に入れると、`no-work` が永久に通らない** (#546)。**人待ちの PR が 1 本あるだけで
# 「open PR が 0 件」が成立しなくなり**、**両方の手が空いていても `loop/STOP` は
# 置かれない**——**3 周で人を呼ぶ仕掛けが、呼ぶべき場面で働かない。**
#
# **`parked` だけは数に入れる。** **あれは先行 PR 待ちで、ループが解く**
# ——**外すと、先行 PR を待っているだけの周回で「尽きた」と数え始め**、
# **3 周で全ループが止まる。** **境目は `awaiting-human` が付いているかどうか**である。
#
# **数えるのはここだけ** (`AGENTS.md` §5)。**手順書へ書き写さない**——**写した側が
# 古くなっても、どちらも「正しく見える」。**
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

usage() {
  echo "使い方: bin/loop-open-work < <open PR の一覧>" >&2
  echo "        1 行 1 PR: <PR番号><US><label をカンマで繋いだもの>" >&2
  echo "        exit 0 = 数えた / exit 2 = 読めない" >&2
  exit 2
}

[[ $# -eq 0 ]] || usage

# 列の区切り。**タブを使わない**（`bin/loop-parked-issues` と同じ理由——**IFS の空白は
# 連続すると 1 区切りに畳まれ**、**label が 1 つも無い PR で列が左へずれる**）。
#
# **label も 1 つずつ列にする** (#550)。**カンマで繋いで部分一致で見ると、
# `parked,awaiting-human` という名前の label が付いたふつうの PR が、人待ちとして
# 数から消える**——**GitHub の label 名にはカンマを入れられる。**
#
# **`<US>` が label 名に入らないことは確かめていない。** **カンマよりは入りにくい**が、
# **入りうるなら、この形は穴を塞ぐのではなく狭めているだけ**である。**そう読むこと。**
#
# **ここだけ書式が違う。** **`bin/loop-handoff` / `bin/loop-parked-issues` /
# `bin/loop-silent-park` は label をカンマで繋いで渡している**——**揃えていないのは、
# 倒れた先の重さが違うから**である。**あちらの誤読は「保留の枠を数え間違える」**
# （**worker が 2 件目を取りうるだけで、`bin/loop-claim` が止める**）だが、
# **ここは `no-work` が積まれ、3 周で全ループが止まる。**
#
# **書式が 2 通りあること自体は、新しくない**——**`bin/loop-unlisted-issues` は
# label を 1 行ずつ渡している。** **共通のパーサは無く、どの口も呼ぶ側とだけ
# 書式を約束している**ので、**ここを厳しくしても他の口は壊れない。**
readonly FIELD=$'\037'

count=0

# **最後の行に改行が無くても読む**（`bin/loop-parked-issues` と同じ）——**PR が 1 本
# だけの周回は、まさにその 1 件である。** **読み終えたら空にする**——**空にしないと、
# 最後の 1 行を何度も数える。**
# **`read -ra` は、読めなかったときに配列を空にする**ので、**残った 1 行を
# 数え続けることはない**（**そこを確かめる試験がある**）。
while IFS="$FIELD" read -ra fields || ((${#fields[@]} > 0)); do
  number="${fields[0]-}"
  # **空行は飛ばす。** **一覧が 0 件のとき、呼ぶ側からは空文字が来る**
  [[ -n $number ]] || continue
  # **読めない行を 0 件へ倒さない。** **飲み込むと「作業が尽きた」に化け**、
  # **人待ちでもないのに人が呼ばれる**
  if ! [[ $number =~ ^[0-9]+$ ]]; then
    echo "[FAIL] PR 番号を読めません: $number" >&2
    exit 2
  fi

  # **1 つずつ、まるごと比べる**——**繋いでから部分一致で見ると、`parked-later` や
  # `parked,awaiting-human` という名前の label で判定が狂う。**
  parked=0
  human=0
  for label in "${fields[@]:1}"; do
    [[ $label == "parked" ]] && parked=1
    [[ $label == "awaiting-human" ]] && human=1
  done
  ((parked == 1 && human == 1)) || ((count++))
done

printf '%s\n' "$count"
exit 0
