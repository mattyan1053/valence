#!/usr/bin/env bash
# 自動 squash マージの直前に、7 条件を AND 評価する。
# **これが 0 を返さない限り、理由を問わず gh pr merge を実行してはならない。**
#
# 判定不能を合格として扱わない。失敗し得るコマンドはすべて明示的に判定する。
#
#   exit 0 = マージしてよい
#   exit 1 = マージしてはいけない (理由は標準出力)
#   exit 2 = 使い方の誤り / 設定の誤り
#
# -e は使わない。7 条件は途中終了させず最後まで評価し、末尾で AND 集計する。
# 1 つ落ちるたびに止めると、直すべき点を 1 周に 1 つしか知れずループが伸びる。
# -x も使わない。判定結果の出力にトレースが混ざるとゲートの読み取りを誤らせる。
# jq / GraphQL の変数 ($bot, $endCursor 等) はシェルに展開させない。値を文字列として
# 組み立てず --arg / -F で渡すことで、名前に $(...) や ' が混ざっても注入にならない。
# shellcheck disable=SC2016
set -uo pipefail

# **一覧を、呼ぶ側へ渡す** (#125)。**書き写させない**——`bin/loop-handoff` の指紋が
# ここと同値でないと、**必須でないチェックが落ちたまま必須が pass に変わったとき**、
# **ゲートは不合格 → 合格に変わるのに指紋が動かない**。**通知は抑止され続ける**ので、
# **マージできるようになった、まさにその瞬間に黙る**。
#
# **持っているのは `bin/loop-ci-status` である** (#206)。**判定と一覧を同じ側に置く**
# ——**2 箇所に持つと片方だけ直して食い違う** (#159 で踏んだ形)。ここは口だけを残す。
#
# **入口の確認より前に返す。** これは周回の判定ではなく**定数の問い合わせ**である——
# 後ろに置くと、**尋ねるたびに `bin/loop-lease check` が走り、偽の「飛ばした」が積まれる**。
if [[ ${1-} == "--required-checks" ]]; then
  exec "${BASH_SOURCE[0]%/*}/loop-ci-status" --required-checks
fi

# **入口を飛ばしていないか、ここでも確かめる**（#161）。**出口だけでは遅い**——
# 気づくのは終わったあとで、**その周回の直列化は既に効いていない**。
# **周回で最初に触るものが確かめれば、やり直せるうちに分かる**。
#
# **役を渡さない。** このスクリプトは master も worker も使うので、役を書き固めると
# **正常な周回のたびに偽の記録が積まれる**（`bin/loop-lease` の `check` を読むこと）。
# **止めない**（`|| true`）——気づける形は保ったまま、飛ばしにくくする。
"${BASH_SOURCE[0]%/*}/loop-lease" check || true

# 自動レビューを行う bot のログイン名。環境変数での差し替えを許さない。
# 差し替えられると、自分のアカウントでレビューを 1 つ出すだけでゲートを通過でき、
# レビュー要件が無意味になる。
# **レビュー用の bot の名前は書き写さない。** `bin/loop-review-commits` が正で、
# そこから取る (2 箇所に持つと、片方だけ直したときに違う相手を信用する)。
# **食い違ったときの症状は「正しい PR がまた止まる」だけ**なので、誰も気づけない (#135)。
#
# 隣を引くのに `dirname` を使わない。**外部コマンドを足すと、テストが PATH を絞れなくなる**。
bot_script_dir="${BASH_SOURCE[0]%/*}"
[[ $bot_script_dir != "${BASH_SOURCE[0]}" ]] || bot_script_dir="."
if ! REVIEW_BOT="$("$bot_script_dir/loop-review-commits" --bot)" || [[ -z $REVIEW_BOT ]]; then
  echo "[FAIL] レビュー用の bot の名前を取得できません" >&2
  exit 2
fi
readonly REVIEW_BOT

readonly MAX_FILES="${LOOP_MAX_FILES:-40}"
readonly MAX_LINES="${LOOP_MAX_LINES:-1500}"

usage() {
  echo "使い方: bin/loop-gate <PR番号>" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage
[[ $1 =~ ^[0-9]+$ ]] || usage
readonly PR="$1"

if ! [[ $MAX_FILES =~ ^[0-9]+$ ]] || ((MAX_FILES < 1)); then
  echo "[FAIL] 設定: LOOP_MAX_FILES は正の整数で指定してください" >&2
  exit 2
fi
if ! [[ $MAX_LINES =~ ^[0-9]+$ ]] || ((MAX_LINES < 1)); then
  echo "[FAIL] 設定: LOOP_MAX_LINES は正の整数で指定してください" >&2
  exit 2
fi

results=()
ok=1
fail() { results+=("[FAIL] $1"); ok=0; }
pass() { results+=("[ OK ] $1"); }

# --- 1. 判定対象 --------------------------------------------------------------
# open / draft でない / base が main であることを確認する。
# base を見ないと、別ブランチ宛ての PR を main 相当として扱ってしまう。
head_sha=""
# 取り出しは gh の --jq だけで行い、**外部の jq に依存しない**。
# 依存すると jq の無い環境 (開発コンテナ) でゲートを動かせず、
# **合否を決めるこのスクリプトだけテストが書けない** ことになる。
# 1 行 1 値で受ける。TSV を IFS=タブ で割ると連続タブが畳まれ、空の値で列がずれる。
if ! pr_fields="$(gh pr view "$PR" --json state,isDraft,baseRefName,headRefOid \
  --jq '[.state, (.isDraft | tostring), (.baseRefName // ""), (.headRefOid // "")] | .[]' \
  2>/dev/null)"; then
  fail "判定対象: PR #$PR の情報を取得できません"
else
  mapfile -t pr_values <<<"$pr_fields"
  state="${pr_values[0]-}"
  draft="${pr_values[1]-}"
  base="${pr_values[2]-}"
  head_sha="${pr_values[3]-}"
  if [[ $state != "OPEN" ]]; then
    fail "判定対象: PR #$PR は open ではありません ($state)"
  elif [[ $draft == "true" ]]; then
    fail "判定対象: PR #$PR は draft です"
  elif [[ $base != "main" ]]; then
    fail "判定対象: PR #$PR の base が main ではありません ($base)"
  elif [[ -z $head_sha || $head_sha == "null" ]]; then
    fail "判定対象: PR #$PR の head SHA を取得できません"
  else
    pass "判定対象: open / base=main / head=${head_sha:0:8}"
  fi
fi

# --- 2. 規模上限 --------------------------------------------------------------
if ! size_fields="$(gh pr view "$PR" --json changedFiles,additions,deletions \
  --jq '[.changedFiles, (.additions + .deletions)] | .[]' 2>/dev/null)"; then
  fail "規模上限: 差分の規模を取得できません"
else
  mapfile -t size_values <<<"$size_fields"
  files="${size_values[0]-}"
  lines="${size_values[1]-}"
  if ! [[ $files =~ ^[0-9]+$ && $lines =~ ^[0-9]+$ ]]; then
    fail "規模上限: 差分の規模を数値として読めません"
  elif ((files > MAX_FILES)); then
    fail "規模上限: 変更ファイル数 $files > $MAX_FILES。PR を割ってください"
  elif ((lines > MAX_LINES)); then
    fail "規模上限: 変更行数 $lines > $MAX_LINES。PR を割ってください"
  else
    pass "規模上限: ${files} files / ${lines} lines"
  fi
fi

# --- 3. GHA CI ----------------------------------------------------------------
# **判定は `bin/loop-ci-status` が持つ** (#206)。**`status` と `conclusion` は別の軸**で、
# **`gh pr checks` の `bucket` は `status` から導かれる**ので **`conclusion` が落ちる**——
# **実物が 105 分「pending」のまま止まり、master は毎周回「正しく何もしない」を選んだ。**
#
# **待つ / 人を呼ぶ / 直させる を、終了コードで分ける。** **文面で分けない**——
# **読む側が語を写すと、片方だけ変わって食い違う** (`bin/loop-stall` と同じ判断)。
ci_status=0
ci_out="$("${BASH_SOURCE[0]%/*}/loop-ci-status" "$PR")" || ci_status=$?
case "$ci_status" in
  0) pass "GHA CI: $ci_out" ;;
  1) fail "GHA CI: $ci_out" ;;
  3) fail "GHA CI: pending。$ci_out" ;;
  4) fail "GHA CI: pending のまま予算を超えました。$ci_out" ;;
  *) fail "GHA CI: 判定できません (bin/loop-ci-status が exit $ci_status)" ;;
esac

# --- 4. レビュー済み ----------------------------------------------------------
# Codex の応答は 3 通りある。指摘ありは review オブジェクト、指摘なしは会話コメントか
# 👍 リアクション。review だけを見ると、指摘ゼロの PR が「未レビュー」となり、
# きれいな PR ほどマージできなくなる。bin/loop-review-commits が 3 つとも吸収し、
# SHA が確定した行だけを返す。
#
# 原則は「現 head がレビュー済み」。ただしこれを無条件に必須にすると詰む。
# 上限到達後に指摘を直して push すると head が変わり、追加レビューは要求できないので
# 二度と通らない。「レビューが止まらない」を防ぐ上限が「永久にマージされない」を作る。
# そこで上限到達後は、レビュー済み commit から head までの差分が手直しの範囲に
# 収まっていれば通す。どちらの経路も必ず終わる。
readonly MAX_ROUNDS_GATE="${LOOP_MAX_REVIEW_ROUNDS:-2}"

# 手直し量は **全変更行ではなく、bin/loop-fixup-lines が数えた本体の行数**で測る
# (テストの追加行と、**レビューが要求したファイルの本体行**、そして **base を取り込んだ
# ぶん**を除く。理由はそちらのコメント)。
#
# **既定値 60 の根拠**（#134 で測り直した。**#126 の数え方に対する実測**である）。
#
# **数え方を変えたのは PR #132**（Issue #126 はその契機で、**Issue はマージ時刻を
# 持たない**——**開始点を特定できないと、同じ母集団を作れない**）。
# **その後にマージされた 26 件を、いまの数え方で測った。**
#
#   手直しが 0 行 … 11 件      いちばん多い（レビュー後に本体を触らずマージ）
#   1〜20 行      … 13 件
#   31 / 33 行    … 2 件（#137 / #166）**これが観測された最大**
#   60 行を超えた … **0 件**
#
# **止める側の実例は、いまも 0 件である。** 26 件すべてが上限に触れずに通っており、
# **「60 で困らなかった」までは言えるが、「60 が正しい」とは言えない**——
# **止めるべきものを通した可能性を、この数字は否定しない**。
#
# **人の結論と master の判断を混ぜない。** 元の錨 (#36 / #41) は**人が結論を出した
# 実例**から来ていたが、**#41 は後から「通してよかった」と分かっている** (#126)。
# **上の 26 件は master が判断したもの**で、**閾値を決めた側が、その閾値で下した判断を
# 根拠にする**形になるため、**独立した検証にはならない**。
#
# **それでも 60 を動かさない。** **下げる根拠も上げる根拠も無い**からである
# （観測の最大 33 行に対して 1.8 倍だが、**その比に意味は無い**）。
# **根拠の無い閾値を、別の根拠の無い閾値で置き換えても何も良くならない。**
#
# **次に測り直すとき**（錨がまた外れたとき）は、下をそのまま走らせる。**手で集めた表を
# 残さない**——**同じ手順で数え直せること**が、この値を動かす条件である。
#
# **こちらで数字を選ばない。** **取ってから絞ると、上限で古いほうから黙って落ちる**——
# **上側の錨を探しているのに、錨に近い実例から消える**（#180 で `--limit` を判定から
# 外したのと同じ理由）。**日時は検索側へ渡す。**
#
# **1 検索あたり 1000 件は GitHub の上限である**（`--paginate` でも越えない）。
# **超えたら、日時で期間を割って複数回に分ける**——**いまは 26 件なので分けていない。**
#
# **1 件でも取れなければ、表を作らない。** **`printf` は中が落ちても成功する**ので、
# **空欄のまま並んだ不完全な表が「正常な測り直し」として通る**——**落ちた PR が
# ちょうど大きい側だった可能性を、その表は否定しない**（#181 のレビュー 2 周目）。
# **この表はこの値を動かす唯一の根拠**なので、**欠けたまま出さない**。
#
# ---8<--- 測り直しの手順 ---
#   repo="$(gh repo view --json nameWithOwner --jq '.nameWithOwner')"
#   since="$(gh pr view 132 --json mergedAt --jq '.mergedAt')"
#   gh api --paginate -X GET search/issues \
#     -f q="repo:$repo is:pr is:merged merged:>$since" --jq '.items[].number' |
#     sort -n | while read -r pr; do
#       # **パイプに繋いだまま受けない。** `$?` が `cut` のものになり、取得の失敗が消える
#       reviewed_rows="$(bin/loop-review-commits "$pr")" || exit 1
#       reviewed="$(printf '%s\n' "$reviewed_rows" | tail -1 | cut -f2)"
#       head_sha="$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')" || exit 1
#       measured="$(bin/loop-fixup-lines "$pr" "$reviewed" "$head_sha")" || exit 1
#       printf '%s\t%s\n' "$pr" "$measured"
#     done || { echo "測れなかった PR がある。表は不完全なので使わない" >&2; exit 1; }
# ---8<--- ここまで ---
#
# **上側の錨に使えるのは、人が「これは通すべきでなかった」と結論した実例だけ**である。
# **それが 1 件も無い間は、この値に上側の根拠は無い**——**そう書いてあること自体が、
# 次に「厳しすぎる / 緩すぎる」と言われたときの出発点になる。**
readonly MAX_FIXUP_LINES="${LOOP_MAX_FIXUP_LINES:-60}"

if [[ -z $head_sha || $head_sha == "null" ]]; then
  fail "レビュー: head SHA が不明なため判定できません"
elif ! reviewed="$("$(dirname "$0")/loop-review-commits" "$PR")"; then
  fail "レビュー: レビュー済み commit を取得できません"
else
  rounds=0
  last_reviewed=""
  reviewed_head="no"
  # ヘルパーは <時刻><TAB><SHA> を時刻順で返す。最終行が最新のレビュー。
  # SHA だけを並べ替えると辞書順になり、最新を取り違えて手直し量を過大に見積もる。
  # 👍 だけの応答も bin/loop-review-head の記録で SHA が確定しているので、
  # 出どころによる場合分けは要らない。ここへ来る行はすべて信用してよい。
  while IFS=$'\t' read -r _ts sha; do
    [[ -n $sha ]] || continue
    ((rounds++))
    last_reviewed="$sha"
    # コメント由来は短縮 SHA なので前方一致で突き合わせる
    [[ $head_sha == "$sha"* ]] && reviewed_head="yes"
  done <<<"$reviewed"

  if ((rounds == 0)); then
    fail "レビュー: $REVIEW_BOT のレビューが 1 件もありません"
  elif [[ $reviewed_head == "yes" ]]; then
    pass "レビュー: 現 head に対するレビューあり (${rounds} 回)"
  elif ((rounds < MAX_ROUNDS_GATE)); then
    fail "レビュー: 現 head (${head_sha:0:8}) は未レビュー。レビューを要求してください (${rounds}/${MAX_ROUNDS_GATE})"
  elif ! fixup="$("$(dirname "$0")/loop-fixup-lines" "$PR" "$last_reviewed" "$head_sha")"; then
    fail "レビュー: レビュー済み commit から head までの差分を取得できません"
  else
    # <数える行><TAB><除外したテスト追加行><TAB><除外した要求ぶんの行>。
    # **行ごと正規表現で受ける。** IFS=タブ の read はタブが IFS の空白文字なので
    # 連続が畳まれ、**欄が空のときに列がずれる**。前方一致で削っていく形も、
    # **欄が増えたことに気づかないまま古い形を読み続ける**ので使わない
    # (3 欄目が常に 0 に見え、除外が効いていないことを検出できない)。
    if [[ $fixup =~ ^([0-9]+)$'\t'([0-9]+)$'\t'([0-9]+)$ ]]; then
      fixup_lines="${BASH_REMATCH[1]}"
      excluded_tests="${BASH_REMATCH[2]}"
      excluded_requested="${BASH_REMATCH[3]}"
      excluded="テスト追加 ${excluded_tests} 行 / レビューが要求した ${excluded_requested} 行は除外"
      if ((10#$fixup_lines > MAX_FIXUP_LINES)); then
        fail "レビュー: 上限 ${MAX_ROUNDS_GATE} 回に達したうえ、レビュー後の本体変更が ${fixup_lines} 行 > ${MAX_FIXUP_LINES} 行 (${excluded})。人の判断が要ります"
      else
        pass "レビュー: 上限到達。レビュー後の本体変更は ${fixup_lines} 行で手直しの範囲 (${excluded})"
      fi
    else
      fail "レビュー: 手直し量を数値として読めません"
    fi
  fi
fi

# --- 5. 未解決スレッド --------------------------------------------------------
# --paginate と pageInfo を使う。件数を決め打ちすると、上限を超えた PR で
# 未解決を見落とし、ブランチ保護で弾かれる SHA をマージしようとする。
if ! threads="$(gh api graphql --paginate -f query='
query($owner: String!, $repo: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      reviewThreads(first: 100, after: $endCursor) {
        pageInfo { hasNextPage endCursor }
        nodes { isResolved }
      }
    }
  }
}' -F owner='{owner}' -F repo='{repo}' -F pr="$PR" \
  --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null)"; then
  fail "未解決スレッド: 取得できません"
else
  total=0
  while IFS= read -r n; do
    [[ $n =~ ^[0-9]+$ ]] && ((total += n))
  done <<<"$threads"
  if ((total > 0)); then
    fail "未解決スレッド: $total 件。返信して resolve してください"
  else
    pass "未解決スレッド: 0 件"
  fi
fi

# --- 6. master の要求 ---------------------------------------------------------
# **master が通常コメントで返した要求は、レビュースレッドとして残らない。**
# 見ないままだと「これが済んだらマージする」と書いた直後に GATE PASS が出る
# (実際に PR #48 で起きた)。止めているのが master の記憶だけになるので、label で持つ。
"$(dirname "$0")/loop-open-requests" "$PR" >/dev/null
requests_status=$?
case $requests_status in
  0) pass "master の要求: なし" ;;
  1) fail "master の要求あり。満たしたか確認して master が label を外してください" ;;
  *) fail "master の要求: 判定できません" ;;
esac

# --- 7. 外出しした指摘の残量 --------------------------------------------------
# **既定を「Issue へ外出ししてマージ」にした以上、歯止めはここにしかない** (#73)。
#
# **外出しの経路だけで見ても効かない。** そこで止めても、次の周回は未解決スレッドが
# 無くなっているのでゲートが通り、**マージが 1 回遅れるだけ**になる (#103 のレビュー)。
# **マージの手前は全部ここを通る**ので、条件として持つ。
"$(dirname "$0")/loop-deferred-budget" >/dev/null
deferred_status=$?
case $deferred_status in
  0) pass "外出しした指摘: 上限内" ;;
  1) fail "外出しした指摘が溜まりすぎています。読み切ってから進めてください" ;;
  *) fail "外出しした指摘: 判定できません" ;;
esac

# --- 集計 ---------------------------------------------------------------------
printf '%s\n' "${results[@]}"
if ((ok == 1)); then
  echo
  echo "GATE PASS pr=$PR head=$head_sha"
  # gh pr merge を直接案内しない。master は detached HEAD の worktree で動くので、
  # --delete-branch のローカル後始末で落ち、マージが成功しても非ゼロが返る。
  # 案内する場所が古いと、ラッパーを用意しても呼ばれない。
  echo "マージは次で実行すること (成否は PR の state と head で判定される):"
  echo "  bin/loop-merge $PR $head_sha"
  exit 0
fi
echo
# **縮めて出さない。** この値は記録へ写される (`awaiting-worker:<PR番号>@<SHA>` など) ので、
# **縮むと合格の経路と別の長さになり、同じ head が別の識別子になる** (#145)。
# **`bin/loop-head same` に渡すのもこの値**である。
echo "GATE FAIL pr=$PR head=$head_sha"
exit 1
