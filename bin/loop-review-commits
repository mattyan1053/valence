#!/usr/bin/env bash
# 指定 PR について、Codex がレビューした commit を **時刻順** に 1 行 1 件で出す。
#
#   <ISO8601 の時刻><TAB><commit SHA>
#
# 古い順に並べる。呼び出し側は最終行を「最新のレビュー」として使える。
#
# Codex の応答は 3 通りある。**一部しか見ないと判定を誤る。**
#
#   指摘あり → review オブジェクト。commit_id を持つ (完全な SHA)
#   指摘なし → 会話コメント。本文に「Reviewed commit: `<短縮SHA>`」を含む
#   指摘なし → PR 本体への 👍 リアクションだけ。**SHA を持たない**
#
# これに加えて、**レビューできなかったときの応答**がある。会話コメント (「環境が無い」旨)
# でも、**中身の無い review オブジェクト**でも届く。どちらも要求への応答なので数に入れるが、
# レビューはしていないので SHA を持たない扱いにする (印 -)。数から落とすと記録が
# 消費されずに残り、あとから来た 👍 がそこへ吸われる。
#
# **「レビューした」の判定は commit_id の有無ではなく、本文にレビュー内容があるか**で行う。
# review オブジェクトである・commit_id を持つ、は応答の器の話でしかない。
#
# **rebase で消えた commit のレビューは数えない。** 保留した PR を再開するときは
# main を取り込み直すので head が変わり、それまでのレビューは **現 head の祖先ではない
# commit** を見たことになる。数えたままにすると、レビュー上限に達している PR が
# 「上限到達＋手直しが上限超え」で人の判断待ちになり、**保留した PR が二度と
# マージできない**。祖先かどうかは compare の status で機械的に分かる
# (ahead / identical = 祖先、behind / diverged = そうでない)。
#
# review だけを数えると、指摘ゼロの PR が「未レビュー」と判定され、
# **きれいな PR ほどマージできない**という逆転が起きる。実際に踏んだ。
#
# 👍 が何を見たのかは、応答側からは分からない。commit の日付から推定していた時期が
# あるが、committer date は push 時刻ではないので「そのとき見られていた head」である
# 保証が無く、**未レビューの変更をマージ可能にしてしまう**。
#
# そこで推定をやめ、**レビューが走る直前の head を先に記録しておく**
# (bin/loop-review-head)。応答は 3 種類まとめて時刻順に並べ、記録と **古い順に
# 1 対 1 で対応させる** (--pair)。時刻の前後だけで選ぶと、遅れて届いた 👍 が
# あとから積まれた新しい記録に結び付き、未レビューの head を通してしまう。
# 対応する記録が無い 👍 は **数えない** (安全側に倒す)。
# その PR は「レビュー 0 件」として扱われ、レビューを要求する経路へ進む。
#
# ここを通った行はすべて信用できる SHA を持つので、呼び出し側は出どころで
# 場合分けしない。**3 列目 (出どころ) は廃止した。**
#
# 時刻を落とすと別の事故になる。SHA だけを sort すると辞書順に並び、
# 「最新のレビュー」を取り違えて手直し量を過大に見積もる。呼び出し側が
# 最終レビュー時刻を必要とする場面もあるので、ここで一緒に返す。
#
# 出力される SHA は短縮形が混ざる。呼び出し側は前方一致で突き合わせること。
#
# **「レビューが有効か」と「応答があったか」は別の軸である。** rebase は前者だけを
# 無効にし、**過去の要求が応答された事実は消さない**。既定では有効なものだけを返し、
# `--all` を付けると祖先でない commit へのレビューも落とさずに返す。
# 呼び出し側は、回数と head 一致は既定の出力から、最後に応答があった時刻は `--all` から取る。
#
#   exit 0 = 取得できた (0 件のこともある)
#   exit 2 = 使い方の誤り / 取得不能
#
# 抽出は **gh の --jq** で行い、外部の jq に依存しない。依存が少ないほど、gh を
# 差し替えて判定だけをテストできる (bin/loop-merge と同じ理由)。
# フィルタへ値を文字列で埋め込まない。env 経由で渡すことで、名前に $(...) や ' が
# 混ざっても注入にならない。
# shellcheck disable=SC2016
set -uo pipefail

REVIEW_BOT="chatgpt-codex-connector[bot]"
export REVIEW_BOT
readonly REVIEW_BOT

usage() {
  echo "使い方: bin/loop-review-commits [--all] <PR番号>" >&2
  echo "  --all  rebase で消えた commit へのレビューも落とさずに出す" >&2
  exit 2
}

include_stale=0
if [[ ${1-} == "--all" ]]; then
  include_stale=1
  shift
fi
readonly include_stale

[[ $# -eq 1 ]] || usage
[[ $1 =~ ^[0-9]+$ ]] || usage
readonly PR="$1"

# gh api には --arg が無いので jq へパイプして渡す。
#
# **commit_id があることを「レビューした」と読まない。** レビューできなかった応答も
# commit_id 付きの review オブジェクトとして届く (本文が空、または「環境を作れ」の類)。
# それを数えると、**誰も見ていない head が「レビュー済み」になってマージされる**。
# 実際に踏んだ: 現 head に対する中身の無い review 1 件で reviewed_head=yes になった。
#
# 本物のレビューには必ず「Reviewed commit: `<SHA>`」の印がある (実データで確認)。
# 印が無いものは **要求への応答ではあるがレビューではない** ので、SHA を持たない
# 応答として印 - で返す。数から落とすと記録が消費されず行き止まりを作る。
if ! reviews="$(gh api --paginate "repos/{owner}/{repo}/pulls/$PR/reviews" \
  --jq 'map(select(.user.login == env.REVIEW_BOT and (.commit_id // "") != ""))
        | map("\(.submitted_at)\t" +
              (if ((.body // "") | test("Reviewed commit:"; "i")) then .commit_id else "-" end))
        | .[]' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR のレビューを取得できません" >&2
  exit 2
fi

# 会話コメントは 2 種類ある。どちらも **要求に対する応答** なので数に入れる。
#
#   「Reviewed commit: `<sha>`」… 指摘なしのレビュー。SHA を持つ
#   「環境が無い」旨の通知    … レビューできなかった。SHA を持たない (印 - で返す)
#
# 後者を落とすと、その応答が記録を消費しないまま残り、あとから来た 👍 が
# そこへ吸われて **現 head が永久にレビュー済みにならない**。
# bin/loop-review-budget は前から通知を応答として扱っており、定義を揃える。
if ! comments="$(gh api --paginate "repos/{owner}/{repo}/issues/$PR/comments" \
  --jq 'map(select(.user.login == env.REVIEW_BOT))
        | map(. as $c
              | (($c.body | capture("Reviewed commit:\\*{0,2}\\s*`(?<sha>[0-9a-f]{7,40})`"; "i").sha?)
                 // (if ($c.body | test("create an environment"; "i")) then "-" else empty end))
              | "\($c.created_at)\t\(.)")
        | .[]' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR のコメントを取得できません" >&2
  exit 2
fi

# 👍 リアクション。SHA を持たないので、時刻だけを取って空の SHA 欄で流す。
if ! reactions="$(gh api --paginate "repos/{owner}/{repo}/issues/$PR/reactions" \
  --jq 'map(select(.user.login == env.REVIEW_BOT and .content == "+1")
             | "\(.created_at)\t")
        | .[]' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR のリアクションを取得できません" >&2
  exit 2
fi

# 3 種類を時刻で昇順に並べて 1 本の応答列にする。ISO8601 は辞書順と時系列が一致する。
# **順序が結び付けの前提**なので、ここを崩さない (同時刻は安定ソートで入力順)。
#
# 応答が 1 件も無い PR は正常である (開いた直後など)。grep は一致なしで 1 を返し、
# pipefail がそれをパイプライン全体の失敗にするので、**1 だけ**を通す。
# `|| true` にすると grep 自体のエラー (2 以上) まで飲み込んでしまう。
responses="$(printf '%s\n%s\n%s' "$reviews" "$comments" "$reactions" \
  | { grep -E $'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\t]+\t([0-9a-f]{7,40}|-)?$' || (( $? == 1 )); } \
  | sort -s -k1,1)"

if ! paired="$(printf '%s' "$responses" | "$(dirname "$0")/loop-review-head" --pair "$PR")"; then
  echo "[FAIL] PR #$PR の応答をレビュー対象 head へ対応させられません" >&2
  exit 2
fi

rows="$(printf '%s' "$paired" \
  | grep -E $'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\t]+\t[0-9a-f]{7,40}$' || (( $? == 1 )))"

# --all は「応答があったか」を見るためのもの。有効性で絞らずそのまま返す。
if ((include_stale == 1)); then
  printf '%s' "$rows" | grep -E '.' || true
  exit 0
fi

# 現 head の祖先でない commit へのレビューを落とす。head を取れないときは
# 判定できないので失敗に倒す (数え落として「未レビュー」に見えるほうが安全)。
if ! head_sha="$(gh pr view "$PR" --json headRefOid --jq '.headRefOid' 2>/dev/null)" \
  || [[ -z $head_sha ]]; then
  echo "[FAIL] PR #$PR の head SHA を取得できません" >&2
  exit 2
fi

while IFS=$'\t' read -r ts sha; do
  [[ -n $sha ]] || continue
  if ! status="$(gh api "repos/{owner}/{repo}/compare/${sha}...${head_sha}" \
    --jq '.status' 2>/dev/null)" || [[ -z $status ]]; then
    echo "[FAIL] PR #$PR: $sha が現 head の祖先か判定できません" >&2
    exit 2
  fi
  # ahead = head が先に進んでいる (sha は祖先) / identical = 同じ commit
  [[ $status == "ahead" || $status == "identical" ]] || continue
  printf '%s\t%s\n' "$ts" "$sha"
done <<<"$rows"
exit 0
