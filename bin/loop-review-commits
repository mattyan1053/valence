#!/usr/bin/env bash
# 指定 PR について、Codex がレビューした commit を **時刻順** に 1 行 1 件で出す。
#
#   <ISO8601 の時刻><TAB><commit SHA>
#
# 古い順に並べる。呼び出し側は最終行を「最新のレビュー」として使える。
#
# Codex の応答は 3 通りある。**一部しか見ないと判定を誤る。**
#
#   指摘あり → review オブジェクト。commit_id を持つ (完全な SHA)
#   指摘なし → 会話コメント。本文に「Reviewed commit: `<短縮SHA>`」を含む
#   指摘なし → PR 本体への 👍 リアクションだけ。**SHA を持たない**
#
# これに加えて、**レビューできなかったときの応答**がある。会話コメント (「環境が無い」旨)
# でも、**中身の無い review オブジェクト**でも届く。どちらも要求への応答なので数に入れるが、
# レビューはしていないので SHA を持たない扱いにする (印 -)。数から落とすと記録が
# 消費されずに残り、あとから来た 👍 がそこへ吸われる。
#
# **「レビューした」の判定は commit_id の有無ではなく、本文にレビュー内容があるか**で行う。
# review オブジェクトである・commit_id を持つ、は応答の器の話でしかない。
#
# **rebase で消えた commit のレビューは数えない。** 保留した PR を再開するときは
# main を取り込み直すので head が変わり、それまでのレビューは **現 head の祖先ではない
# commit** を見たことになる。数えたままにすると、レビュー上限に達している PR が
# 「上限到達＋手直しが上限超え」で人の判断待ちになり、**保留した PR が二度と
# マージできない**。祖先かどうかは compare の status で機械的に分かる
# (ahead / identical = 祖先、behind / diverged = そうでない)。
#
# review だけを数えると、指摘ゼロの PR が「未レビュー」と判定され、
# **きれいな PR ほどマージできない**という逆転が起きる。実際に踏んだ。
#
# 👍 が何を見たのかは、応答側からは分からない。commit の日付から推定していた時期が
# あるが、committer date は push 時刻ではないので「そのとき見られていた head」である
# 保証が無く、**未レビューの変更をマージ可能にしてしまう**。
#
# そこで推定をやめ、**レビューが走る直前の head を先に記録しておく**
# (bin/loop-review-head)。応答は 3 種類まとめて時刻順に並べ、記録と **古い順に
# 1 対 1 で対応させる** (--pair)。時刻の前後だけで選ぶと、遅れて届いた 👍 が
# あとから積まれた新しい記録に結び付き、未レビューの head を通してしまう。
# 対応する記録が無い 👍 は **数えない** (安全側に倒す)。
# その PR は「レビュー 0 件」として扱われ、レビューを要求する経路へ進む。
#
# ここを通った行はすべて信用できる SHA を持つので、呼び出し側は出どころで
# 場合分けしない。**3 列目 (出どころ) は廃止した。**
#
# 時刻を落とすと別の事故になる。SHA だけを sort すると辞書順に並び、
# 「最新のレビュー」を取り違えて手直し量を過大に見積もる。呼び出し側が
# 最終レビュー時刻を必要とする場面もあるので、ここで一緒に返す。
#
# 出力される SHA は短縮形が混ざる。呼び出し側は前方一致で突き合わせること。
#
# **「レビューが有効か」と「応答があったか」は別の軸である。** rebase は前者だけを
# 無効にし、**過去の要求が応答された事実は消さない**。既定では有効なものだけを返し、
# `--all` を付けると祖先でない commit へのレビューも落とさずに、第 3 列へ live / stale を
# 添えて返す。
#
#   <ISO8601 の時刻><TAB><commit SHA>                  (既定)
#   <ISO8601 の時刻><TAB><commit SHA><TAB>live|stale   (--all)
#
# **両方の軸を 1 回の取得から導けるようにするため**である。呼び出し側が既定と `--all` を
# 2 回叩くと、その間に届いた応答で **片方だけ新しい食い違った組み合わせ**になり、
# レビュー上限を 1 回超えられてしまう。
#
#   exit 0 = 取得できた (0 件のこともある)
#   exit 2 = 使い方の誤り / 取得不能
#
# 抽出は **gh の --jq** で行い、外部の jq に依存しない。依存が少ないほど、gh を
# 差し替えて判定だけをテストできる (bin/loop-merge と同じ理由)。
# フィルタへ値を文字列で埋め込まない。env 経由で渡すことで、名前に $(...) や ' が
# 混ざっても注入にならない。
# shellcheck disable=SC2016
set -uo pipefail

REVIEW_BOT="chatgpt-codex-connector[bot]"
export REVIEW_BOT
readonly REVIEW_BOT

# **bot の投稿が「レビュー要求への応答」かを決める。**
#
# **ログイン名だけでは足りない。** 本文に `@codex` が混ざると、**レビューを頼んで
# いないのに bot が答える**——`AGENTS.md` にこの経路そのものが書いてある
# （**バッククォートで囲んでも拾われる**）。それを応答として数えると、
#
#   - **記録を消費する** → **古い head への 👍 が新しい記録に結び付き、
#     見ていない head が「レビュー済み」になる**（`bin/loop-review-head` が塞いだ穴）
#   - **`pending` を解除する** → **実際のレビューが処理中でも要求を重ねられる**
#
# **文言では見分けられない。** Codex の断り文句は、レビューでもタスクでも同じ形で返る。
# **見分けるのは引き金の側**である——**`@codex` の混入と、bot の投稿を対応させる**。
# 混入があれば、次の bot の投稿は**そのタスクへの応答**とみなして数えない。
#
# **判定できないときは数えない側へ倒す。** 数えて困るのは**未レビューが通る**側で、
# **誰も気づけない**。数えないで困るのは**もう 1 回要求する**側で、
# **`review-unanswered` が 3 周で人を呼ぶ**。
#
# **文言の列挙へは戻さない**（#159）。**未知の断り文句でも、混入が無ければ解ける。**
# **要求は「コメント全体がそれ」であること。** `AGENTS.md` が規則を持っている——
# **「レビューを要求するときだけ、コメントに単独で書く」**。
#
# **部分一致にすると、説明文の中の `@codex review` まで「要求」になる**——混入に
# 数えられないので、**そこから起きたタスクの応答が記録を消費する**（内側に同じ穴が残る）。
# **規則と判定が同じものを指す**ようにしておく。
readonly REVIEW_REQUEST='^@codex[[:space:]]+review$'
readonly CODEX_MENTION='@codex'

# コメント全体が要求そのものか。**本文は既に空白を 1 つへ畳んである**ので、
# 前後の空白だけを落として比べる。
is_request() {
  local body="${1#"${1%%[![:space:]]*}"}"
  body="${body%"${body##*[![:space:]]}"}"
  [[ ${body,,} =~ $REVIEW_REQUEST ]]
}

# **本物のレビューの印。** これだけが「レビューした」を表す。
#
# **文言を列挙しない。** 以前は「レビューでない応答」の文言を並べていて、
# **一覧から漏れたものが「応答が無かった」に落ちた**——`Something went wrong` がそれで、
# **`pending` が減らず再要求が永久に禁じられた**（実際に全ループが約 2 時間止まった）。
# **並べ忘れた値がどの分岐にも入らない**のは #90 と同じ形である。
#
# **反転させる。** bot の投稿は**すべて応答**として数え、**この印を持つものだけがレビュー**。
# そうすれば、**Codex が何を言っても応答は消費される**。
readonly REVIEWED_MARK='[Rr]eviewed [Cc]ommit:\*{0,2}[[:space:]]*`([0-9a-f]{7,40})`'

# **判定は bash に置く。** `gh --jq` の中に書くと、**gh を差し替えた試験からは
# 1 度も通らない**——スタブが「絞り込んだ後」を返すので、**判定を書き換えても緑のまま**になる
# （実際にそうなっていた）。
is_review() {
  [[ $1 =~ $REVIEWED_MARK ]]
}

# レビューの SHA。**印が無ければ「応答したがレビューではない」**（印 -）。
reviewed_sha() {
  if [[ $1 =~ $REVIEWED_MARK ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "-"
  fi
}

usage() {
  echo "使い方: bin/loop-review-commits [--all] <PR番号>" >&2
  echo "  --all      落とさずに出し、第 3 列へ live / stale / answer を添える" >&2
  echo "  --bot      レビュー用の bot のログイン名を出す" >&2
  exit 2
}

# **「誰のレビューか」の正をここに置く。** 他のスクリプトが判定に使うので、
# **書き写させない**——2 箇所に持つと、片方だけ直したときに
# **スクリプトごとに違う相手を信用する**ことになる。
#
# **GraphQL は `[bot]` を付けずに返す** (REST は付ける)。呼ぶ側が変換する。
if [[ ${1-} == "--bot" ]]; then
  [[ $# -eq 1 ]] || usage
  printf '%s\n' "$REVIEW_BOT"
  exit 0
fi

include_stale=0
if [[ ${1-} == "--all" ]]; then
  include_stale=1
  shift
fi
readonly include_stale

[[ $# -eq 1 ]] || usage
[[ $1 =~ ^[0-9]+$ ]] || usage
readonly PR="$1"

# gh api には --arg が無いので jq へパイプして渡す。
#
# **commit_id があることを「レビューした」と読まない。** レビューできなかった応答も
# commit_id 付きの review オブジェクトとして届く (本文が空、または「環境を作れ」の類)。
# それを数えると、**誰も見ていない head が「レビュー済み」になってマージされる**。
# 実際に踏んだ: 現 head に対する中身の無い review 1 件で reviewed_head=yes になった。
#
# 本物のレビューには必ず「Reviewed commit: `<SHA>`」の印がある (実データで確認)。
# 印が無いものは **要求への応答ではあるがレビューではない** ので、SHA を持たない
# 応答として印 - で返す。数から落とすと記録が消費されず行き止まりを作る。
if ! reviews_raw="$(gh api --paginate "repos/{owner}/{repo}/pulls/$PR/reviews" \
  --jq 'map(select(.user.login == env.REVIEW_BOT and (.commit_id // "") != ""))
        | map("\(.submitted_at)\t\(.commit_id)\t" + ((.body // "") | gsub("\\s+"; " ")))
        | .[]' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR のレビューを取得できません" >&2
  exit 2
fi
reviews="$(while IFS=$'\t' read -r at commit body; do
  [[ -n $at ]] || continue
  if is_review "$body"; then printf '%s\t%s\n' "$at" "$commit"; else printf '%s\t-\n' "$at"; fi
done <<<"$reviews_raw")"

# 会話コメントは 2 種類ある。どちらも **要求に対する応答** なので数に入れる。
#
#   「Reviewed commit: `<sha>`」… 指摘なしのレビュー。SHA を持つ
#   「環境が無い」旨の通知    … レビューできなかった。SHA を持たない (印 - で返す)
#
# 後者を落とすと、その応答が記録を消費しないまま残り、あとから来た 👍 が
# そこへ吸われて **現 head が永久にレビュー済みにならない**。
# bin/loop-review-budget は前から通知を応答として扱っており、定義を揃える。
# 現 head と PR 本文を **1 回で取る**。head は祖先の判定に、本文は引き金の判定に使う。
#
# **引き金は issue コメントだけではない。** **PR 本文に `@codex` が混ざると、
# 作成の数秒後に bot がタスクとして答える**（この PR 自身で起きた）。
# **本文は `issues/$PR/comments` に現れない**ので、**引き金が見えず、応答だけが見える**——
# **必ず消費側へ倒れる**。**見えない引き金がいちばん危ない向き**である。
#
# **レビュースレッドは見ない。** そこへの `@codex` の混入は**応答もスレッドへの返信**として
# 返るので、**引き金も応答も `issues/$PR/comments` には現れない**——**見えないもの同士**で、
# ここの数え方を狂わせない（実測で確認）。
if ! pr_view="$(gh pr view "$PR" --json headRefOid,body \
  --jq '[.headRefOid, ((.body // "") | gsub("\\s+"; " "))] | @tsv' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR の head SHA を取得できません" >&2
  exit 2
fi
IFS=$'\t' read -r head_sha pr_body <<<"$pr_view"
if [[ -z $head_sha ]]; then
  echo "[FAIL] PR #$PR の head SHA を取得できません" >&2
  exit 2
fi

# **bot だけを取らない。** 引き金（`@codex` の混入）と対応させるので、
# **誰が何を書いたか**を時刻順に見る必要がある。
if ! comments_raw="$(gh api --paginate "repos/{owner}/{repo}/issues/$PR/comments" \
  --jq '.[] | [.created_at, .user.login, ((.body // "") | gsub("\\s+"; " "))] | @tsv' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR のコメントを取得できません" >&2
  exit 2
fi

# 時刻順に見て、**混入と bot の投稿を対応させる**。
#
#   混入（`@codex` を含み、レビュー要求ではない）… 次の bot の投稿がその応答になる
#   bot の投稿                                    … 未対応の混入があればそれへ、無ければレビューへ
#
# **印を持つ投稿は、いつでもレビューである**（自分でそう名乗っている）。
comments=""
answers=""
# **本文の混入は、いちばん古い引き金である**（PR を作った時点で置かれている）
stray=0
if [[ ${pr_body,,} =~ $CODEX_MENTION ]] && ! is_request "$pr_body"; then
  ((stray++))
fi
while IFS=$'\t' read -r at login body; do
  [[ -n $at ]] || continue
  lowered="${body,,}"
  if [[ $login != "$REVIEW_BOT" ]]; then
    # **要求そのものは混入に数えない。** 数えると、要求のたびに応答が 1 つ食われる
    if [[ $lowered =~ $CODEX_MENTION ]] && ! is_request "$body"; then
      ((stray++))
    fi
    continue
  fi
  sha="$(reviewed_sha "$body")"
  if [[ $sha == "-" ]] && ((stray > 0)); then
    # **レビュー以外の Codex タスクへの応答。** 記録も `pending` も動かさない
    ((stray--))
    continue
  fi
  comments+="${at}"$'\t'"${sha}"$'\n'
  # **応答不能の通知だけを `answers` に入れる** (#361 のレビュー)。
  # **SHA を持つ応答は、`rows` の側で `live` / `stale` として出る**ので、
  # **ここにも入れると `--all` が同じ応答を 2 行で出す**——
  # **数える側（`bin/loop-review-budget`）が 1 回の往復を 2 回ぶん食う。**
  #
  # **時刻で突き合わせて落とす形にはしない。** **GitHub の時刻は秒までしかない**ので、
  # **SHA 付きの応答と、別の応答不能コメントが同じ秒に届くと、本物の通知まで落ちる**
  # ——**`notice` が過少になり、上限を超えて要求を再送できる**（#356 が塞いだ穴）。
  # **入れないほうを選べば、突き合わせ自体が要らない。**
  #
  # **`pending` は動かない。** **待つ側は `answer` 以外の行でも最後の応答時刻を取る**
  # ので、**SHA を持つ応答は `live` / `stale` の行から同じ時刻を取れる。**
  [[ $sha == "-" ]] && answers+="${at}"$'\n'
done <<<"$comments_raw"
comments="${comments%$'\n'}"
answers="${answers%$'\n'}"

# **器が違うだけで、同じ「レビューできなかった応答」である** (#178 のレビュー)。
# 上のループは **issue コメントしか見ない**ので、**中身の無い review オブジェクト**が
# 応答から落ちていた——**`--pair` は SHA を持たない応答を消費して出力しない**ので、
# **どこにも出てこない**。**待つ側は応答が届いているのに上限まで待つ** (#78)。
#
# **広げすぎない。** 足すのは**レビュー要求への応答で SHA を持たないもの**だけである。
# **混入した `@codex` への応答は入れない**（上のループが引き金と対応させて外している。
# #159 / #160）——**入れると、レビューが返っていないのに待ちが終わり**、
# 次のゲートで **`review-unanswered` が積まれる**（止まる側へ倒れる）。
review_notices="$(printf '%s' "$reviews" | { grep -E $'\t-$' || (($? == 1)); } | cut -f1)"
if [[ -n $review_notices ]]; then
  answers="${answers:+$answers$'\n'}$review_notices"
fi



# 👍 リアクション。SHA を持たないので、時刻だけを取って空の SHA 欄で流す。
if ! reactions="$(gh api --paginate "repos/{owner}/{repo}/issues/$PR/reactions" \
  --jq 'map(select(.user.login == env.REVIEW_BOT and .content == "+1")
             | "\(.created_at)\t")
        | .[]' 2>/dev/null)"; then
  echo "[FAIL] PR #$PR のリアクションを取得できません" >&2
  exit 2
fi

# 3 種類を時刻で昇順に並べて 1 本の応答列にする。ISO8601 は辞書順と時系列が一致する。
# **順序が結び付けの前提**なので、ここを崩さない (同時刻は安定ソートで入力順)。
#
# 応答が 1 件も無い PR は正常である (開いた直後など)。grep は一致なしで 1 を返し、
# pipefail がそれをパイプライン全体の失敗にするので、**1 だけ**を通す。
# `|| true` にすると grep 自体のエラー (2 以上) まで飲み込んでしまう。
responses="$(printf '%s\n%s\n%s' "$reviews" "$comments" "$reactions" \
  | { grep -E $'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\t]+\t([0-9a-f]{7,40}|-)?$' || (( $? == 1 )); } \
  | sort -s -k1,1)"

if ! paired="$(printf '%s' "$responses" | "$(dirname "$0")/loop-review-head" --pair "$PR")"; then
  echo "[FAIL] PR #$PR の応答をレビュー対象 head へ対応させられません" >&2
  exit 2
fi

rows="$(printf '%s' "$paired" \
  | grep -E $'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\t]+\t[0-9a-f]{7,40}$' || (( $? == 1 )))"

# **応答はあったが、何を見たか分からないもの** (#179)。**記録が `--unknown` だけの PR**
# （ループの外で作られた PR の初回自動レビュー）では、**👍 は記録を消費するが
# head へ結び付かない**——**落とすと、待つ側は応答が届いているのに上限まで待つ**。
#
# **`answer`（レビューできなかった応答）と混ぜない。** あちらは
# **`bin/loop-review-budget` が通知として数える**もので、**👍 はそれではない**。
# **ここは「返ってきた」だけを表し、レビューの回数にも通知にも入らない。**
acks="$(printf '%s' "$paired" \
  | { grep -E $'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\t]+\t-$' || (($? == 1)); } | cut -f1)"


out=""
while IFS=$'\t' read -r ts sha; do
  [[ -n $sha ]] || continue
  if ! status="$(gh api "repos/{owner}/{repo}/compare/${sha}...${head_sha}" \
    --jq '.status' 2>/dev/null)" || [[ -z $status ]]; then
    echo "[FAIL] PR #$PR: $sha が現 head の祖先か判定できません" >&2
    exit 2
  fi
  # ahead = head が先に進んでいる (sha は祖先) / identical = 同じ commit
  if [[ $status == "ahead" || $status == "identical" ]]; then
    live="live"
  else
    live="stale"
  fi
  if ((include_stale == 1)); then
    out+="${ts}"$'\t'"${sha}"$'\t'"${live}"$'\n'
  elif [[ $live == "live" ]]; then
    out+="${ts}"$'\t'"${sha}"$'\n'
  fi
done <<<"$rows"

# **`--all` は応答も返す。** 呼ぶ側が「レビューの回数」と「最後の応答時刻」を
# **2 回に分けて取ると、その間に着いた応答で「回数は古く、時刻は新しい」**になり、
# **同じ head が既にレビュー済みでも `pending` が解ける**。
# **両方を 1 回の取得から導けるようにしておく**（この仕組みの主題である）。
if ((include_stale == 1)); then
  # **`answers` に入るのは応答不能の通知だけ**である（上の組み立て）——
  # **SHA を持つ応答はここへ来ない**ので、**突き合わせて落とす処理は要らない。**
  while IFS= read -r at; do
    [[ -n $at ]] || continue
    out+="${at}"$'\t'"-"$'\t'"answer"$'\n'
  done <<<"$answers"
  # **待つのをやめてよいが、レビューは数えない** (#179)
  while IFS= read -r at; do
    [[ -n $at ]] || continue
    out+="${at}"$'\t'"-"$'\t'"ack"$'\n'
  done <<<"$acks"
fi

# 時刻順に並べ直す。**混ぜたぶんで順序が崩れない**ようにする
[[ -z $out ]] || printf '%s' "$out" | sort -s -k1,1
exit 0
