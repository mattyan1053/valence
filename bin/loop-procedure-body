#!/usr/bin/env bash
# **手順書の本体を、ディスクから読む** (#319)。
#
#   bin/loop-procedure-body <役>            本体を出す
#   bin/loop-procedure-body --entry <役>    入口を出す (#373)
#
#   exit 0 = 標準出力へ出した
#   exit 2 = 読めない（無い / 権限が無い / 使い方の誤り）——**この周回は何もせず終わる**
#   exit 3 = 読めたが、読み手が先に閉じた (#521)——**同じく何もせず終わる**
#
# **2 と 3 を分けてあるのは、記録から見分けるため**である (#521)。**どちらも
# 「捨てる」側**（入口の判定は `exit 0 以外`）だが、**同じ文言だと、手順書が
# 本当に壊れた日に、パイプで受けた周回のぶんが既に何度も積まれている。**
#
# **`/loop <間隔> /loop-worker` は、登録した時点の本文を cron で再生する。**
# **ディスクの `.claude/commands/loop-<役>.md` を毎回読み直すわけではない**ので、
# **手順書を直すたびに、走っているセッションの本文が古くなる**——
# **実測で 1 日 5 回、版ずれで周回が捨てられた。**
#
# **検出は正しい** (#241 / #243)。**変えるのは頻度である。**
# **入口だけを cron に運ばせ、本体はここから読む**——**入口はめったに変わらない**ので、
# **古い本文を運ばれても、中身は最新になる。**
#
# **読めなければ止まる。** **入口には本体が無い**ので、**「読めないまま進む」は
# 「手順の大半を飛ばす」ことと同じ**である——**黙って古い手順で走らせない。**
#
# **入口もここから読めるようにした** (#373)。**配られた本文が古いとき、呼び直しで
# 新しい版が届く保証は無い**（**実測で 2 回中 1 回**。#94）——**届かなければ、
# 人が来るまで動けない。** **読む先がディスクにあれば、その周回のうちに前へ進める。**
#
# **印の検査は捨てない** (#241 / #243 / #244)——**読み直した本文の印で `acquire` を
# 打ち直す**ので、**「古い手順で走り続ける」形にはならない**（**印の行も出す**）。
#
# **同じスクリプトに置くのは、仕事が同じだから**である（**ディスクから手順を読む**）
# ——**読めなかったときの倒し方も 1 つで済む。**
#
# **成功と失敗を、終了コードで分ける。** **本体が空でも出力は空**なので、
# **出力の有無で判断させない**（**読む側は終了コードを見る**）。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

readonly ROLES=(master worker)

usage() {
  echo "使い方: bin/loop-procedure-body <役>            本体を出す" >&2
  echo "        bin/loop-procedure-body --entry <役>    入口を出す" >&2
  echo "        役: ${ROLES[*]}" >&2
  echo "        exit 0 出した / exit 2 読めない / exit 3 読み手が先に閉じた" >&2
  exit 2
}

WANT_ENTRY=0
if [[ ${1-} == "--entry" ]]; then
  WANT_ENTRY=1
  shift
fi
readonly WANT_ENTRY

# **入口を飛ばしていないか、ここでも確かめる** (#386)。**周回で最初に触るのがここ**で、
# **入口を飛ばす周回は、たいてい「そのまま作業に入る」**——**受け口が無いと、記録は
# 「どこまで進んだか」で決まる。**
#
# **`--entry` では記録しない** (#373)。**あれは、印がずれた周回が lease を取る前に読む**
# ——**記録すると、正しく回復した周回が毎回「飛ばした」に数えられる。**
# **記録は診断**なので、**確実な偽物を混ぜない。**
#
# **役を渡さない**（`bin/loop-lease` の `check` を読むこと）。**止めない**（`|| true`）
# ——**ここで落とすと、回復できなくなる。**
((WANT_ENTRY == 1)) || "${BASH_SOURCE[0]%/*}/loop-lease" check || true

[[ $# -eq 1 ]] || usage

ROLE="$1"
known=0
for role in "${ROLES[@]}"; do
  [[ $ROLE == "$role" ]] && known=1
done
((known == 1)) || usage
readonly ROLE

# **スクリプトの隣から辿る。** **cwd からではない**——**このスクリプトが属する
# チェックアウトの手順**を読みたい（`bin/loop-procedure-stamp` と同じ理由。
# **入口の置き場所も、あちらと同じところを見る**）。
if ((WANT_ENTRY == 1)); then
  readonly DOC="${BASH_SOURCE[0]%/*}/../.claude/commands/loop-$ROLE.md"
  readonly WHAT="入口"
else
  readonly DOC="${BASH_SOURCE[0]%/*}/../loop/procedure/$ROLE.md"
  readonly WHAT="本体"
fi

if [[ ! -f $DOC ]]; then
  echo "[FAIL] 手順書の${WHAT}が見つかりません: $DOC" >&2
  exit 2
fi

cat "$DOC"
written=$?

# **読み手が先に閉じただけなら、そう言う** (#521)。
#
# **`| head -80` のように受けると、`cat` は `SIGPIPE`（128+13）で落ちる**——
# **手順書は読めている。** **それを「読めません」と言うと、本当に壊れた日
# （消えた・権限が無い）とまったく同じ文言と終了コードが記録に残る**ので、
# **その日に見分けが付かない**（#497 と同じ形——**原因を確かめずに 1 つに決める**）。
#
# **止める側へは倒したまま**である。**受け手は本体を最後まで受け取っていない**ので、
# **そのまま進むのは「手順の大半を飛ばす」**（冒頭の判断）——**変えるのは理由だけ。**
#
# **入口の判定（`exit 0 以外は捨てる`）は変えない** (#521)。**別の番号で返す**
# ——**捨てられることは同じで、記録から見分けられる。**
#
# **本体が 64 KiB より小さいと、そもそもここへ来ない**——**`cat` の 1 回の
# 書き込みがパイプの緩衝に収まり**、**受け手が閉じていても成功する。**
if ((written == 141)); then
  echo "[FAIL] 手順書の${WHAT}は読めましたが、読み手が先に閉じたので最後まで渡せません: $DOC" >&2
  echo "       パイプで受けないこと（絞るのは、最後まで受け取ってから）" >&2
  exit 3
fi

if ((written != 0)); then
  echo "[FAIL] 手順書の${WHAT}を読めません: $DOC" >&2
  exit 2
fi
