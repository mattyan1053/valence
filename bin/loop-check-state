#!/usr/bin/env bash
# **`./task check` が終わったかどうかを、記録として残す** (#375)。
#
#   bin/loop-check-state running <走りの id>            走り始めた
#   bin/loop-check-state finished <走りの id> <合否>    走り終えた
#   bin/loop-check-state --verdict                      いまの記録を読む
#   bin/loop-check-state --await                        走り終えるまで待って、合否を返す
#                                                       （5 = 書き手が居ない。待っても来ない）
#   bin/loop-check-state --durations                    積んだ所要時間を読む
#   bin/loop-check-state --overlaps                     重なった走りを読む
#
#   --verdict の終了コード:
#     0 = 緑 / 1 = 赤 / 2 = 読めない・使い方の誤り / 3 = まだ走っている / 4 = 記録が無い
#
# **2 つの作業場が、別々の日に同じ罠を踏んだ**——**「終わったこと」を読み違えた**
# （worker-1 は背景に回した起動側の完了通知を check の完了と読み、worker-2 は
# 完了通知と push を同じ流れで走らせて `status` を読まなかった）。
#
# **印そのものは正しい。** **`task` の `cmd_check` は `exec_app pnpm check` が返ってから
# `check-exit=<合否>` を出す**ので、**途中で殺されれば印は出ない**——
# **足りないのは、読む側を強いるもの**である（`AGENTS.md` §5。**判断を記憶に置かない**）。
#
# **`running` を先に書くのが要点である。** **殺された周回は `finished` を書けない**ので、
# **記録は「走っている」のまま残る**——**「終わっていない」と読める。**
#
# **走るたびに 1 つ置く** (#376 のレビュー。#130 と同じ形)。**1 つのファイルに
# 上書きすると、2 本走ったときに後から終わったほうが勝ち**、**まだ走っている側が
# 見えなくなる**——**「2 本走る」はこのリポジトリが既に前提にしている。**
#
# **`finished` という名前は、`done` を避けたもの**である——**`done` は bash の予約語**で、
# **引数に置くと ShellCheck がループの終わりとして読む**（SC1010）。
#
# **記録は作業場ごと**（`git rev-parse --git-dir`。**worktree ごとに分かれる**）
# ——**別の作業場の check は、こちらの commit の可否と関係が無い。**
#
# **所要時間は、別の口へ積む** (#391)。**走りの記録は次の走りが片付ける**ので、
# **そこに時刻を書くだけでは残らない**——**`valence-check-runs` へ 1 行足す。**
#
# **積む先だけは共有である** (#509)。**`./task check` が 2 本並走すると負荷で時間切れに
# なる**——**同じ機械の話**なので、**作業場ごとに分けて積むと、突き合わせる先が無い**
# （**重なったことが、人の報告にしか残らなかった**）。**行に作業場を書き**、
# **`--overlaps` が区間の交わりを読む。**
#
# **合否の記録（`valence-check-state.d`）は作業場ごとのまま**である——**別の作業場の
# check は、こちらの commit の可否と関係が無い。** **共有にするのは「速さ」だけ**で、
# **`--durations` はこの作業場のぶんだけを、これまでどおり 3 列で返す**
# （**読み手の意味を変えない**）。
#
# **前の版が `valence-check-durations` へ積んだぶんは、そのまま置いていく**
# （`AGENTS.md` §5）——**移し替えない。** **測るための記録**なので、
# **混ぜて読み違えるより、そこで途切れるほうが安い。**
#
# **走りの記録には、1 行目を変えずに行を足す**（`AGENTS.md` §5。**新しい書き手 →
# 古い読み手**）。**前の版の `--verdict` も `running` の片付けも `read -r ... <記録` で
# 1 行目しか読まない**ので、**2 行目以降は見えない**——**1 行目に列を足すと
# `finished 0 <時刻>` が「合否を読めません」で止まる**（#281 と同じ形）。
#
# **時刻が書けないことを、合否の記録と混ぜない** (#391 の完了条件)。**測るための
# 記録が落ちても、`./task check` は使える**——**言うだけにして、合否は残す。**
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

usage() {
  echo "使い方: bin/loop-check-state running <走りの id>          走り始めた" >&2
  echo "        bin/loop-check-state finished <走りの id> <合否>  走り終えた" >&2
  echo "        bin/loop-check-state --verdict                    いまの記録を読む" >&2
  echo "        bin/loop-check-state --await                      走り終えるまで待つ（5 待っても来ない）" >&2
  echo "        bin/loop-check-state --durations                  積んだ所要時間を読む" >&2
  echo "        bin/loop-check-state --overlaps                   重なった走りを読む" >&2
  echo "        --verdict: 0 緑 / 1 赤 / 2 読めない / 3 走っている / 4 記録が無い" >&2
  printf '        --durations: <始め>\\t<終わり>\\t<合否 または killed>（4 記録が無い）\n' >&2
  printf '        --overlaps: <重なった秒>\\t<作業場>\\t<作業場>（0 あり / 1 無い / 4 記録が無い）\n' >&2
  exit 2
}

[[ $# -ge 1 ]] || usage

if ! git_dir="$(git rev-parse --git-dir 2>/dev/null)" || [[ -z $git_dir ]]; then
  echo "[FAIL] git の作業ツリーの中に居るかどうかを読み取れません" >&2
  exit 2
fi
readonly STATE_DIR="$git_dir/valence-check-state.d"
# **積む先は共有** (#509)。**並走したことは、同じ機械の 2 つの作業場にまたがる**
# ——**分けて積むと、突き合わせる先が無い。**
if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
readonly RUNS="$common_dir/valence-check-runs"
# **どの作業場の走りか**（`bin/loop-claim` / `bin/loop-lease` と同じ引き方
# ——**持ち主の名前を 2 通り持たない**）。
if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
  echo "[FAIL] 作業場の根を特定できません" >&2
  exit 2
fi
toplevel="$(cd "$toplevel" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] 作業場の根へ移動できません" >&2
  exit 2
}
readonly WORKSPACE="$toplevel"
# **直近のぶんだけ残す**（`bin/loop-lease` の周回の長さと同じ形）。**際限なく足すと、
# 読むたびに重くなる**——**振れ幅を見るには、直近の何十回かで足りる。**
#
# **数えるのは作業場ごと** (#509)。**共有の記録を全体で切ると、隣の作業場が忙しい日に
# こちらの直近が押し出される**——**振れ幅を見る先が、他所の都合で消える。**
readonly RECENT_RUNS=10
# ロックを待つ秒数。**試験で短くできるようにしてある**（`bin/loop-lease` と同じ形）
readonly LOCK_WAIT_SEC="${LOOP_CHECK_STATE_LOCK_WAIT_SEC:-10}"
if ! [[ $LOCK_WAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_CHECK_STATE_LOCK_WAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
# `--await` が次に読むまで待つ秒数。**試験で短くできるようにしてある**（上と同じ形）
readonly AWAIT_SEC="${LOOP_CHECK_STATE_AWAIT_SEC:-15}"
if ! [[ $AWAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_CHECK_STATE_AWAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi

now_epoch() { date +%s; }

# 所要時間を 1 行積む。**落ちても、この check は止めない**（合否の記録とは別物）。
#
# **読んで、足して、書き戻す**ので、**2 本が同時に終わると 1 行落ちうる**
# ——**`flock` で直列にする**（**測るための記録なので、待たせても誰も止まらない**）。
append_duration() {
  local started="$1" ended="$2" result="$3" all=() kept=() others=() line row_workspace
  [[ $started =~ ^[0-9]+$ ]] || return 1
  # **`2>/dev/null` は、まとまりの中で掛ける** (#445 で踏んだ。`bin/loop-handoff` と
  # 同じ形)。**`exec` に直接付けると、標準エラーそのものが以後ずっと `/dev/null` へ
  # 向く**——**この口を通ったあとの `[WARN]` が、丸ごと消える。**
  { exec 8>"$RUNS.lock"; } 2>/dev/null || return 1
  flock -w "$LOCK_WAIT_SEC" 8 || {
    exec 8>&-
    return 1
  }
  if [[ -f $RUNS ]]; then
    mapfile -t all <"$RUNS" 2>/dev/null || all=()
  fi
  # **こちらのぶんと、他所のぶんを分けて数える** (#509)——**切るのは自分のぶんだけ。**
  for line in "${all[@]}"; do
    row_workspace="${line%%$'\t'*}"
    if [[ $row_workspace == "$WORKSPACE" ]]; then
      kept+=("$line")
    else
      others+=("$line")
    fi
  done
  kept+=("$(printf '%s\t%s\t%s\t%s' "$WORKSPACE" "$started" "$ended" "$result")")
  # **数より短いときに切り出さない。** **要素数を超える負の開始位置は空になる**
  # ——**積んだ行が丸ごと消える**（**測るための記録が、静かに空のままになる**）
  ((${#kept[@]} <= RECENT_RUNS)) || kept=("${kept[@]: -RECENT_RUNS}")
  if ! { printf '%s\n' ${others[@]+"${others[@]}"} "${kept[@]}" >"$RUNS.tmp" 2>/dev/null \
    && mv -f "$RUNS.tmp" "$RUNS" 2>/dev/null; }; then
    rm -f "$RUNS.tmp" 2>/dev/null
    exec 8>&-
    return 1
  fi
  exec 8>&-
}

# その走りの記録に残っている「始めた時刻」。**無ければ空**（**作り話で埋めない**）。
started_at_of() {
  local record="$1" second
  # **1 行目は読み飛ばす**（`_` で受ける。**名前を付けると「使うつもりだった」に見える**）
  { read -r _; read -r second; } <"$record" 2>/dev/null
  [[ $second =~ ^[0-9]+$ ]] || second=""
  printf '%s' "$second"
}

# **その記録を終わらせられる側が、まだ居るか** (#555 のレビュー)。
#
# **`finished` を書けるのは、その走りの側だけ**である——**書き手が居なければ、
# 待っても永久に来ない。** **殺された走りの記録は「走っている」のまま残る**
# （**片付けるのは次の `running`** なので、**打ち直すまで残る**）。
#
# **`--running-elsewhere` を PID で見なかったのと矛盾しない** (#549)——**あちらの問いは
# 「仕事が動いているか」**で、**PID が消えてもコンテナの中は走り続ける。**
# **こちらの問いは「この記録が終わるか」**で、**終わらせられるのは書き手だけ**である。
#
# **分からないものは、居る側へ倒す**（`running` の片付けと同じ）——**数字でない id は
# 生き死にを決められない。** **待つのをやめるほうへ倒すと、走っているものを見捨てる。**
writer_alive() {
  local record kind id
  for record in "$STATE_DIR"/*; do
    [[ -f $record ]] || continue
    read -r kind _ <"$record" 2>/dev/null || continue
    [[ $kind == "running" ]] || continue
    id="${record##*/}"
    [[ $id =~ ^[0-9]+$ ]] || return 0
    kill -0 "$id" 2>/dev/null && return 0
  done
  return 1
}

# **id はファイル名になる。** **区切りやパスを含む値を受けない**
valid_id() {
  [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]]
}

case "$1" in
  running)
    if [[ $# -ne 2 ]] || ! valid_id "$2"; then usage; fi
    mkdir -p "$STATE_DIR" || {
      echo "[FAIL] check の記録を置けません: $STATE_DIR" >&2
      exit 2
    }
    # **前の合否は捨てる** (#376 のレビュー)。**木はもう変わっている**ので、
    # **前の周回の緑で、いまの commit を通さない。**
    #
    # **殺された周回の跡も、ここで片付ける。** **`finished` を書けずに終わった記録は
    # 残り続ける**ので、**放っておくと何度走らせても「走っている」のまま**になり、
    # **commit が永久に止まる**（#184 の形——**直しに行く経路が閉じ込められる**）。
    #
    # **生きているかは PID で見る。** **id は `./task` の PID である**（`task` が
    # そう渡す）——**生きていない PID の記録は、走っている周回のものではありえない。**
    # **数字でない id は、そう決められない**ので**残す**（**消すほうへ倒さない**）。
    started="$(now_epoch)"
    # **判定・取得・削除を、1 つのロックの中でやる** (#392 のレビュー。`record_missing`
    # と同じ形)。**「死んでいると判った」から「消した」までの間にもう 1 本が同じ記録を
    # 見ると、両方が `killed` を積む**——**水増しされるのは「切られやすさ」**で、
    # **測るために作った数そのもの**である。
    #
    # **追記の口（`$RUNS.lock`）とは別の口を使う**——**同じ口だと、
    # `append_duration` が自分の待ちに入る。**
    #
    # **取り損ねても、片付けは進む** (#184)。**握れなかったときは積まない**
    # ——**握っている側が積む**ので、**落ちるのは「二重に数える」側ではない。**
    measure_killed=1
    # **ここも、まとまりの中で掛ける** (#445)——**下の `[WARN]` は、この行より後**である
    { exec 7>"$STATE_DIR.lock"; } 2>/dev/null || measure_killed=0
    ((measure_killed == 0)) || flock -w "$LOCK_WAIT_SEC" 7 || measure_killed=0
    for old in "$STATE_DIR"/*; do
      [[ -f $old ]] || continue
      read -r kind _ <"$old" 2>/dev/null || continue
      if [[ $kind == "finished" ]]; then
        rm -f "$old"
        continue
      fi
      old_id="${old##*/}"
      [[ $old_id =~ ^[0-9]+$ ]] || continue
      kill -0 "$old_id" 2>/dev/null && continue
      # **殺された走りも積む** (#391)。**切られた走りが残らないと、切られやすさを
      # 測れない**——**実害はそこで出ている**（**道具の 10 分制限**）。
      # **終わりの時刻は「片付けた時刻」**なので、**合否の代わりに `killed` と書く**
      # ——**所要時間として読ませない。**
      old_started="$(started_at_of "$old")"
      if ((measure_killed == 1)) && [[ -n $old_started ]]; then
        append_duration "$old_started" "$started" killed ||
          echo "[WARN] 殺された走りの所要時間を積めません: $RUNS" >&2
      fi
      rm -f "$old"
    done
    exec 7>&-
    # **2 行目に始めた時刻**（**1 行目は前の版が読む**ので動かさない）
    printf 'running\n%s\n' "$started" >"$STATE_DIR/$2" || {
      echo "[FAIL] check の記録を書き込めません: $STATE_DIR/$2" >&2
      exit 2
    }
    ;;
  finished)
    # **合否は数字である。** **数字以外を受けると、読む側が「知らない形」で止まる**
    if [[ $# -ne 3 ]] || ! valid_id "$2" || [[ ! $3 =~ ^[0-9]+$ ]]; then usage; fi
    mkdir -p "$STATE_DIR" || {
      echo "[FAIL] check の記録を置けません: $STATE_DIR" >&2
      exit 2
    }
    ended="$(now_epoch)"
    # **始めた時刻は、その走りの記録から引き継ぐ**（**書けていなければ空のまま**
    # ——**分からないものを、いまの時刻で埋めない**）
    started=""
    [[ ! -f $STATE_DIR/$2 ]] || started="$(started_at_of "$STATE_DIR/$2")"
    printf 'finished %s\n%s\n%s\n' "$3" "$started" "$ended" >"$STATE_DIR/$2" || {
      echo "[FAIL] check の記録を書き込めません: $STATE_DIR/$2" >&2
      exit 2
    }
    # **積めなくても、合否は残っている**——**この check を落とさない** (#391)
    [[ -z $started ]] || append_duration "$started" "$ended" "$3" ||
      echo "[WARN] 所要時間を積めません: $RUNS" >&2
    ;;
  --durations)
    [[ $# -eq 1 ]] || usage
    # **「無い」と「読めない」を混ぜない**（`--verdict` と同じ語彙）
    [[ -s $RUNS ]] || exit 4
    # **この作業場のぶんだけを、これまでどおり 3 列で出す** (#509)——**共有にしたのは
    # 積む先**で、**「所要時間」の意味は変えない**（**他所の速さと混ぜない**）。
    mine=""
    mine="$(awk -F'\t' -v me="$WORKSPACE" '$1 == me { print $2 "\t" $3 "\t" $4 }' "$RUNS")" || {
      echo "[FAIL] 所要時間の記録を読めません: $RUNS" >&2
      exit 2
    }
    [[ -n $mine ]] || exit 4
    printf '%s\n' "$mine"
    ;;
  --overlaps)
    [[ $# -eq 1 ]] || usage
    # **重なったことを、人の報告に頼らずに読む** (#509)。
    #
    # **同じ作業場どうしは数えない**——**殺された走りの「終わり」は片付けた時刻**なので、
    # **次の走りと必ず重なって見える**（**負荷の話ではなく、片付けの跡である**）。
    #
    # **切られた走りは、区間として読まない**（**同じ理由**）。**終わりが片付けた時刻**
    # なので、**次の走りまでの何十分かが、まるごと「重なっていた」に化ける。**
    # **切られたこと自体は `--durations` に残る**——**ここで見るのは、
    # 終わりまで走った 2 本が本当に重なったか**である。
    [[ -s $RUNS ]] || exit 4
    overlapping=""
    overlapping="$(awk -F'\t' '
      # **数え始めを 0 に置く。** **awk の未初期化は空文字**なので、**添字にすると
      # 1 本目が `workspace[""]` へ入り**、**0 番を読む側からは消える**（**実際に踏んだ**）。
      BEGIN { n = 0 }
      $4 == "killed" { next }
      $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
        workspace[n] = $1; from[n] = $2; to[n] = $3; n++
      }
      END {
        for (i = 0; i < n; i++) {
          for (j = i + 1; j < n; j++) {
            if (workspace[i] == workspace[j]) { continue }
            begin = from[i] > from[j] ? from[i] : from[j]
            end = to[i] < to[j] ? to[i] : to[j]
            if (end <= begin) { continue }
            print (end - begin) "\t" workspace[i] "\t" workspace[j]
          }
        }
      }' "$RUNS")" || {
      echo "[FAIL] 走りの記録を読めません: $RUNS" >&2
      exit 2
    }
    [[ -n $overlapping ]] || exit 1
    printf '%s\n' "$overlapping"
    ;;
  --await)
    [[ $# -eq 1 ]] || usage
    # **切られた走りを、打ち直さずに拾う** (#552)。
    #
    # **単独の `./task check` が外側の 10 分に届くようになった**（**実測 670 / 698 秒**）。
    # **切られても、コンテナの中は走り続ける**（#528）——**そこで打ち直すと、
    # 同じものを 2 度走らせる**（**1 周ぶん余計**）。**付き直せば、待つだけで済む。**
    #
    # **速くはしない。** **切られた結果を変えるだけ**である
    # ——**時間を判定に使わない**（#131 / #552 の「踏んではいけないところ」）。
    #
    # **待つ側が切られても、失うものは無い**——**もう一度打てばよい**（**走りは
    # コンテナの中で続いている**）。
    while :; do
      # **判定は `--verdict` が持つ**（`AGENTS.md` §5。**2 箇所に持たない**）
      "$0" --verdict
      verdict=$?
      ((verdict == 3)) || exit "$verdict"
      # **書き手が居なくなったら、待っても来ない** (#555 のレビュー)。
      # **上限を秒で置かない**——**時間を判定に使わない**（#131 / #552）ので、
      # **返るか返らないかを時間で決めない。** **見るのは「終わらせられる側が
      # 居るか」**である。
      writer_alive || exit 5
      sleep "$AWAIT_SEC"
    done
    ;;
  --verdict)
    [[ $# -eq 1 ]] || usage
    # **記録が無いのは「赤」ではない**——**打っていないだけ**である
    [[ -d $STATE_DIR ]] || exit 4
    found=0
    worst=0
    for record in "$STATE_DIR"/*; do
      [[ -f $record ]] || continue
      found=1
      if ! read -r kind value <"$record"; then
        echo "[FAIL] check の記録を読めません: $record" >&2
        exit 2
      fi
      case "$kind" in
        # **走っているものが 1 つでもあれば、そこで決まり**である
        # ——**終わったものの合否より、いま走っていることが強い。**
        running) exit 3 ;;
        finished)
          [[ $value =~ ^[0-9]+$ ]] || {
            echo "[FAIL] check の記録の合否を読めません: $record" >&2
            exit 2
          }
          # **赤が 1 つでもあれば赤**（**重なった 2 本のうち片方が落ちている**）
          ((value == 0)) || worst=1
          ;;
        *)
          echo "[FAIL] check の記録が読めない形です: $record" >&2
          exit 2
          ;;
      esac
    done
    ((found == 1)) || exit 4
    exit "$worst"
    ;;
  *) usage ;;
esac
