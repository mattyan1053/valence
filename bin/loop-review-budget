#!/usr/bin/env bash
# 追加のレビュー要求 (@codex review) を出してよいかを判定する。
#
# レビューを回し続けてトークンを溶かす事故を、モデルの自制ではなく機械的に防ぐ。
# 判定不能は「要求してはいけない」に倒す。浪費を防ぐ側が安全側だからである。
#
#   exit 0 = 要求してよい
#   exit 1 = 要求してはいけない (**空転として数える対象**)
#   exit 2 = 使い方の誤り / 判定不能
#   exit 3 = まだ要求しない (**正常な待ち。空転として数えない**)
#
# 1 と 3 を分けるのは、呼び出し側が「待ち続けていること」を空転として記録するためである。
# 猶予の内側は正常な状態で、これを数えると **健全な PR が周回の間隔しだいで
# loop/STOP に到達する**。猶予は 2 つあり、どちらも時刻で測る (周回数で測らない)。
#
#   PR を開いた直後      … 自動で入る初回レビューを待つ (LOOP_INITIAL_REVIEW_GRACE_MIN)
#   要求してから応答まで … 返るのを待つ (LOOP_PENDING_REVIEW_GRACE_MIN)
#
# 文言ではなく終了コードで区別できるようにしてある
# (手順書は「終了コードで分岐する」と決めている)。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
# -x も使わない。判定結果にトレースが混ざると読み取りを誤らせる。
# jq / GraphQL の変数 ($bot, $endCursor 等) はシェルに展開させない。値を文字列として
# 組み立てず --arg / -F で渡すことで、名前に $(...) や ' が混ざっても注入にならない。
# shellcheck disable=SC2016
set -uo pipefail

# 自動レビューを行う bot のログイン名。環境変数で差し替えられないようにする。
# 差し替えられると、自分のアカウントでレビューを 1 つ出すだけで
# 「現 head はレビュー済み」を捏造でき、レビュー要件が無意味になる。
readonly REVIEW_BOT="chatgpt-codex-connector[bot]"

# 1 つの PR に対して許すレビューの回数。
# 上限に達したら、未解決が残っていても追加のレビューは要求しない。
# その場合は打ち切り基準 (AGENTS.md) に従って判断するか、人へエスカレーションする。
readonly MAX_ROUNDS="${LOOP_MAX_REVIEW_ROUNDS:-2}"

# PR を開くと自動で 1 度レビューが入る。それが届く前に要求を投げると、
# 同じ内容を二重にレビューさせることになる。開いた直後は黙って待つ。
readonly INITIAL_GRACE_MIN="${LOOP_INITIAL_REVIEW_GRACE_MIN:-10}"

# 要求してから応答が返るまでの猶予。**周回の速さから独立して判定するため**にある。
# 「何周待ったか」で異常を決めると、閾値がレビューの遅さではなく master の
# ポーリング間隔で決まり、`/loop 1m` で回すだけで健全な PR が止まる。
# 要求コメントの時刻は GitHub 側にあるので、そこからの経過時間で測る。
readonly PENDING_GRACE_MIN="${LOOP_PENDING_REVIEW_GRACE_MIN:-30}"

usage() {
  echo "使い方: bin/loop-review-budget <PR番号>" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage
# 数字だけを受け付ける。PR 番号以外が渡る経路を作らない。
[[ $1 =~ ^[0-9]+$ ]] || usage
readonly PR="$1"

if ! [[ $MAX_ROUNDS =~ ^[0-9]+$ ]] || ((MAX_ROUNDS < 1)); then
  echo "[FAIL] 設定: LOOP_MAX_REVIEW_ROUNDS は 1 以上の整数で指定してください" >&2
  exit 2
fi
if ! [[ $PENDING_GRACE_MIN =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_PENDING_REVIEW_GRACE_MIN は 0 以上の整数で指定してください" >&2
  exit 2
fi

# --- PR の head SHA -----------------------------------------------------------
if ! head_sha="$(gh pr view "$PR" --json headRefOid --jq '.headRefOid' 2>/dev/null)" \
  || [[ -z $head_sha ]]; then
  echo "[FAIL] PR #$PR の head SHA を取得できません" >&2
  exit 2
fi

# --- Codex がレビュー済みの commit ---------------------------------------------
# 指摘ありは review オブジェクト、指摘なしは会話コメントで返る。両方を数える。
#
# **2 つの軸を分けて取る。** rebase は「レビューが現 head を覆っているか」だけを
# 無効にし、**過去の要求が応答された事実は消さない**。同じ列から両方を導くと、
# 保留した PR を rebase した瞬間に応答済みの要求まで未応答へ戻り、
# **再レビューを要求できないまま詰む**。
# **取得は 1 回だけ。** 2 回叩くと、その間に応答が届いたときに「回数は古く、
# 最後の応答時刻は新しい」という食い違った組み合わせで判定してしまい、
# **レビュー上限を 1 回超えられる**。同じスナップショットから両方を導く。
if ! responses="$("$(dirname "$0")/loop-review-commits" --all "$PR")"; then
  echo "[FAIL] PR #$PR のレビュー済み commit を取得できません" >&2
  exit 2
fi

rounds=0
reviewed_head="no"
last_at=""
notice=0
notice_at=""
while IFS=$'\t' read -r ts sha live; do
  [[ -n $sha ]] || continue
  # **レビューではない応答**（第 3 列が `answer`）。**同じ取得に混ざって返る**ので、
  # 「回数」と「最後の応答時刻」が食い違わない。**判定は `bin/loop-review-commits`
  # が持つ**（引き金との対応付けを含む）——ここで真似ると 2 箇所に持つことになる。
  if [[ $live == "answer" ]]; then
    ((notice++))
    [[ $ts > $notice_at ]] && notice_at="$ts"
    continue
  fi
  # 最後に応答があった時刻は **rebase で消えたものも含めて** 取る。
  # これを落とすと「応答済みの古い要求」まで未応答として数えてしまう。
  last_at="$ts"
  # 回数と head 一致は「有効なレビュー」だけを見る (rebase で消えたものは数えない)。
  [[ $live == "live" ]] || continue
  ((rounds++))
  # 👍 だけの応答も bin/loop-review-head の記録で SHA が確定しているので、
  # gate と同じ基準で扱う。出どころによる場合分けは要らない。
  [[ $head_sha == "$sha"* ]] && reviewed_head="yes"
done <<<"$responses"

# --- 会話コメント -------------------------------------------------------------
# 「受け取ったレビュー」だけを数えると、レビューが返ってこない場合に上限へ到達せず、
# 要求だけを毎周投げ続ける。実際にレビュー機能が使えない状態を踏んだ。
# 投げた要求と、bot からの応答不能通知も数える。
#
# **集計は jq に寄せない。** 開発コンテナに `jq` が無いので、依存したままだと
# **判定を持つこのスクリプトだけテストが書けない**（`bin/loop-gate` と同じ理由で、
# **合否を決めるところほど検証できる形にしておく**）。gh の `--jq` には
# **1 行 1 コメントの生の値**だけを出させ、数えるのはここで行う。
if ! comments="$(gh api --paginate "repos/{owner}/{repo}/issues/$PR/comments" \
  --jq '.[] | [.created_at, .user.login, (.body | gsub("\\s+"; " "))] | @tsv')"; then
  echo "[FAIL] PR #$PR のコメントを取得できません" >&2
  exit 2
fi

# 未応答の要求と、応答不能の通知を数える。
# **時刻の比較は文字列で足りる**（ISO 8601 は辞書順と時刻順が一致する）。
pending=0
pending_at=""
requests=()
while IFS=$'\t' read -r at login body; do
  [[ -n $at ]] || continue
  # **小文字へ畳んでから比べる。** 元は jq の `test(…; "i")` で大文字小文字を
  # 無視していた。bash の `=~` は区別するので、**畳まないと `@Codex Review` を
  # 取りこぼす**——そのとき「要求済みで未応答」が見えず、**要求を重ねる**。
  lowered="${body,,}"
  if [[ $login != "$REVIEW_BOT" ]] && [[ $lowered =~ @codex[[:space:]]+review ]]; then
    requests+=("$at")
  fi
done <<<"$comments"



# **直近のレビューより後の要求だけが「未応答」である。**
# bot の応答は SHA を持たないことがある（環境が無い・エラー・その他）ので**レビュー扱いには
# できない**が、**要求に対する応答ではある**。これを消化しないと、元の要求が永久に未応答と
# して残り、原因を直しても再要求できなくなる。**応答より前の要求は応答済みとみなす。**
answered_at="$last_at"
if [[ -n $notice_at && ( -z $answered_at || $notice_at > $answered_at ) ]]; then
  answered_at="$notice_at"
fi
for at in ${requests+"${requests[@]}"}; do
  [[ -n $answered_at && ! $at > $answered_at ]] && continue
  ((pending++))
  [[ $at > $pending_at ]] && pending_at="$at"
done

echo "pr=$PR head=${head_sha:0:8} rounds=$rounds max=$MAX_ROUNDS reviewed_head=$reviewed_head pending=$pending"

# --- 判定 ---------------------------------------------------------------------
# 現 head が既にレビュー済みなら、再要求は純粋な浪費でしかない。
# 何も変わっていないものを二度レビューさせない。これが浪費を止める本丸。
if [[ $reviewed_head == "yes" ]]; then
  echo "[NO] 現 head は既にレビュー済み。push してからでないと要求しない"
  exit 1
fi

# 直近のレビュー以降に投げた要求が未応答なら、重ねて投げない。
# レビューが遅いのか、そもそも応答できない状態なのかは区別できないが、
# どちらでも「待つ」が正しい。
#
# **待ち続けていることの検出はここではしない。** 呼び出し側 (master の手順 3.2) が
# 未解決スレッドの有無まで見て、`review-unanswered:<PR番号>@<SHA>` を記録する。
# 識別子に head SHA が入るので、push で前へ進んだ周回は数え直される。
if ((pending > 0)); then
  # 猶予の内側は「正常な待ち」。空転として数えさせない (exit 3)。
  # ここを周回数で数えると、閾値が master のポーリング間隔で決まってしまう。
  if [[ -n $pending_at ]]; then
    requested_epoch="$(date -d "$pending_at" +%s 2>/dev/null || echo "")"
    if [[ -n $requested_epoch ]] \
      && (($(date +%s) - requested_epoch < PENDING_GRACE_MIN * 60)); then
      echo "[WAIT] 要求から ${PENDING_GRACE_MIN} 分の猶予内 ($pending_at)。返るのを待つ"
      exit 3
    fi
  fi
  echo "[NO] 要求済みで未応答 ($pending 件)。返るまで待つ。重ねて要求しない"
  # 応答不能の通知が来ているなら、待っても返らない。原因を添える。
  # ただし通知の有無だけで塞がない。環境を直しても古いコメントは PR に残るため、
  # それを判定に使うと復旧後も永久に要求できなくなる。
  if ((notice > 0)); then
    echo "     直近に「環境が無い」旨の通知が出ている。投稿本文に codex への"
    echo "     メンションを literal で含めていないか確認する (AGENTS.md 参照)"
  fi
  exit 1
fi

# 初回の自動レビューを待つ。猶予を過ぎても来ないなら、こちらから要求してよい。
if ((rounds == 0)); then
  if ! created_at="$(gh pr view "$PR" --json createdAt --jq '.createdAt' 2>/dev/null)" \
    || [[ -z $created_at ]]; then
    echo "[FAIL] PR #$PR の作成時刻を取得できません" >&2
    exit 2
  fi
  created_epoch="$(date -d "$created_at" +%s 2>/dev/null || echo "")"
  now_epoch="$(date +%s)"
  if [[ -n $created_epoch ]] && ((now_epoch - created_epoch < INITIAL_GRACE_MIN * 60)); then
    # まだ誰にも何も要求していない。空転ではないので 3 で返す。
    echo "[WAIT] PR を開いた直後。自動で入る初回レビューを待つ (${INITIAL_GRACE_MIN} 分)"
    exit 3
  fi
fi

if ((rounds >= MAX_ROUNDS)); then
  echo "[NO] レビュー回数が上限 ($MAX_ROUNDS) に達している。これ以上は要求しない"
  echo "     未解決が残る場合は打ち切り基準で判断するか、人へエスカレーションする"
  exit 1
fi

echo "[OK] レビューを要求してよい (${rounds}/${MAX_ROUNDS} 回目)"
exit 0
