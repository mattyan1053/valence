#!/usr/bin/env bash
# 「次に来るレビューが対象にする head SHA」を記録し、あとで引けるようにする。
#
#   bin/loop-review-head <PR番号> <head SHA>          記録する
#   bin/loop-review-head --unknown <PR番号> <時刻>    SHA の分からない実行を記録する
#   bin/loop-review-head --list <PR番号>              記録を古い順に出す
#   bin/loop-review-head --pair <PR番号>              応答を記録へ対応させる (標準入力)
#
# Codex の応答のうち **👍 リアクションは SHA を持たない**。何をレビューしたのかを
# 応答側から知る手段が無いので、以前は commit の日付から推定していた。committer date は
# push 時刻ではないため、推定した commit が「そのとき見られていた head」である保証が無く、
# **未レビューの変更をマージ可能にしてしまう**。かといって推定を捨てると、👍 だけで返る
# PR が永久にマージできない。推定を足したり引いたりするたびに新しい詰みが出ていた。
#
# 出どころは応答側ではなく **こちら側** にある。レビューが走る直前の head を先に
# 書いておけば、あとから来た応答が何を見たかは確定する。推定が要らなくなる。
#
# 記録するのは 2 箇所。
#
#   PR を作った直後 (worker)      … 自動で入る初回レビューの対象
#   レビューを要求する直前 (master) … その要求に対する応答の対象
#
# ループの外で作られた PR には、作成時の記録が無い。自動レビューは **すべての PR で
# 1 回走る** ので、記録の無い実行が 1 件残る。その応答 (👍) を「未消費の最も古い記録」へ
# 寄せると、**見てもいない新しい head がレビュー済みになる**。
#
# かといって、あとから作成時 head を埋めることはできない。master がその PR を最初に
# 見た時点の head は、作成時のものとは限らないためである (間の push で動きうる)。
# **分からないものを分かった風に埋めない。** --unknown は「SHA の分からない実行が
# ここにあった」ことだけを記録し、対応した応答を **結び付けずに消費する**。
#
# **時刻の前後だけでは対応は決まらない。** 応答は遅れて届くことがあり、その間に
# 新しい記録が積まれる。「その時刻以前で最も新しい記録」を選ぶと、遅れて届いた 👍 が
# **まだレビューされていない新しい head に結び付き、未レビューのままマージ可能になる**。
#
# そこで --pair は、記録と応答を **古い順に 1 対 1 で対応させる** (消費する)。
#
#   SHA を持つ応答 … その SHA をそのまま使い、一致する記録を 1 件消費する
#   SHA が無い応答 … **まだ消費されていない最も古い記録**のうち、応答より前のものに
#                    結び付ける。無ければ結び付けない (安全側に倒す)
#
# 消費する側を古いほうから取るので、対応がずれても新しい head へ寄ることがない。
# 記録が足りない (応答のほうが多い) ときは、余った応答を捨てる。
#
# 記録先は git の共通ディレクトリ配下。worktree をまたいで同じ場所を指すので、
# master と worker が別ツリーにいても同じ記録を見る。作業ツリーの外なので
# コミットもされない (bin/loop-stall と同じ置き方)。
#
#   exit 0 = 記録した / 一覧を出した (0 件のこともある)
#   exit 2 = 使い方の誤り / 記録不能
#
set -uo pipefail

usage() {
  echo "使い方: bin/loop-review-head <PR番号> <head SHA>          記録する" >&2
  echo "       bin/loop-review-head --unknown <PR番号> <時刻>    SHA 不明の実行を記録する" >&2
  echo "       bin/loop-review-head --list <PR番号>              記録を古い順に出す" >&2
  echo "       bin/loop-review-head --pair <PR番号>              応答を対応させる (標準入力)" >&2
  exit 2
}

# SHA の分からない実行を表す印。記録の場所は埋めるが、結び付けには使わない。
readonly UNKNOWN_SHA="-"

at=""
if [[ ${1-} == "--unknown" ]]; then
  [[ $# -eq 3 ]] || usage
  mode="record"
  pr="$2"
  sha="$UNKNOWN_SHA"
  at="$3"
elif [[ ${1-} == "--list" || ${1-} == "--pair" ]]; then
  [[ $# -eq 2 ]] || usage
  mode="${1#--}"
  pr="$2"
  sha=""
else
  [[ $# -eq 2 ]] || usage
  mode="record"
  pr="$1"
  sha="$2"
fi
readonly mode pr sha at

# PR 番号はファイル名になる。数字だけに絞ってパス操作を成立させない。
[[ $pr =~ ^[0-9]+$ ]] || {
  echo "[FAIL] PR 番号は数字で指定してください: $pr" >&2
  exit 2
}

# ブランチ名や短すぎる値を記録すると、head との前方一致が誤爆する。
if [[ $mode == "record" && $sha != "$UNKNOWN_SHA" ]] && ! [[ $sha =~ ^[0-9a-f]{7,40}$ ]]; then
  echo "[FAIL] head SHA として読めません: $sha" >&2
  exit 2
fi

# 応答の時刻と直接比べるので、書式が違うものを入れない。**記録する時刻は
# レビューが走った時刻** (PR の作成時刻など) であって、記録した時刻ではない。
# 記録した時刻にすると、応答より後になって「応答より前の記録」から外れる。
if [[ -n $at ]] && ! [[ $at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
  echo "[FAIL] 時刻は ISO8601 の UTC (例 2026-08-08T12:00:00Z) で指定してください: $at" >&2
  exit 2
fi

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
# --git-common-dir は worktree からだと相対パスを返すことがある。
common_dir="$(cd "$common_dir" 2>/dev/null && pwd)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
readonly STORE="$common_dir/valence-loop-review-heads"
readonly FILE="$STORE/$pr"

# 記録を古い順に出す。追記順が時刻順だが、壊れた行を混ぜないために書式で絞る。
# 同じ秒に 2 件入ることがあるので -s で安定ソートし、追記順を保つ。
read_records() {
  [[ -f $FILE ]] || return 0
  grep -E $'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\t([0-9a-f]{7,40}|-)$' "$FILE" \
    | sort -s -k1,1
}

if [[ $mode == "pair" ]]; then
  # 記録を先に読み、続けて標準入力の応答を処理する。消費済みの記録は使い回さない。
  # SHA の突き合わせは前方一致 (会話コメント由来は短縮 SHA)。
  # 記録と応答を 1 本のストリームにして種別を先頭列に置く。2 ファイルを NR == FNR で
  # 分けると、**記録が 0 件のときに応答の 1 行目を記録として食う**。
  {
    read_records | awk '{ print "R\t" $0 }'
    awk '{ print "A\t" $0 }'
  } | awk -F'\t' -v unknown="$UNKNOWN_SHA" '
    $1 == "R" { at[++n] = $2; sha[n] = $3; used[n] = 0; next }
    {
      if ($3 != "") {
        matched = 0
        for (i = 1; i <= n; i++) {
          if (!used[i] && (index(sha[i], $3) == 1 || index($3, sha[i]) == 1)) {
            used[i] = 1
            matched = 1
            break
          }
        }
        # どの記録とも一致しないなら、SHA の分からない実行への応答である
        # (ループ外で作られた PR の自動レビューが SHA 付きで返った場合など)。
        # ここで消費しないと印が残り、**次の SHA 無しの応答がそこへ吸われて、
        # 実際の head の記録が未消費のまま残る** (現 head が永久にレビュー済みに
        # ならず、再要求もできない行き止まりになる)。
        if (!matched) {
          for (i = 1; i <= n; i++) {
            if (!used[i] && sha[i] == unknown && at[i] <= $2) { used[i] = 1; break }
          }
        }
        print $2 "\t" $3
        next
      }
      for (i = 1; i <= n; i++) {
        if (!used[i] && at[i] <= $2) {
          used[i] = 1
          # SHA の分からない実行に当たった応答は、消費するだけで結び付けない。
          # ここで次の記録へ送ると、見てもいない head がレビュー済みになる。
          if (sha[i] != unknown) { print $2 "\t" sha[i] }
          break
        }
      }
    }
  '
  exit 0
fi

if [[ $mode == "list" ]]; then
  # 記録が無いのは異常ではない (まだ 1 度も走っていない PR)。空を返す。
  [[ -f $FILE ]] || exit 0
  read_records
  exit 0
fi

mkdir -p "$STORE" || {
  echo "[FAIL] 記録先を作成できません: $STORE" >&2
  exit 2
}

# 応答の時刻 (GitHub API は UTC の ISO8601) と直接比べられる形で持つ。
now="${at:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
printf '%s\t%s\n' "$now" "$sha" >> "$FILE" || {
  echo "[FAIL] 記録を書き込めません: $FILE" >&2
  exit 2
}

echo "review head recorded pr=$pr sha=${sha:0:8} at=$now"
exit 0
