#!/usr/bin/env bash
# **このリポジトリの bash を lint する** (#377)。
#
#   bin/lint-shell          lint する（shellcheck を呼ぶ）
#   bin/lint-shell --list   対象を 1 行ずつ出す（読むだけ）
#
#   exit 0 = 指摘なし / exit 1 = 指摘あり / exit 2 = 走らせられない・使い方の誤り
#
# **`bin/` は lint の外にあった。** **見ていたのは `task` と `docker-entrypoint.sh` の
# 2 つだけ**で、**このループの中身——lease・停止カウンタ・ゲート・出口——は
# 1 つも入っていなかった**（**実測: PR #376 で `task` を触ったから SC1010 を拾えた**）。
#
# **一覧を書き写さない。** **`bin/` に置かれた bash は全部見る**——**書き写すと、
# 次に足したスクリプトが黙って外れる**（`AGENTS.md` §5）。**除ける唯一のものは
# 試験（`*.test.ts`）**で、**あれは bash ではない。**
#
# **shellcheck が無ければ落ちる。** **skip は緑に見える**（#210）——**入っていない
# 環境で「指摘なし」と答えると、見ていないことが緑として記録される。**
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

usage() {
  echo "使い方: bin/lint-shell          lint する" >&2
  echo "        bin/lint-shell --list   対象を並べる" >&2
  exit 2
}

[[ $# -eq 0 || ($# -eq 1 && $1 == "--list") ]] || usage

# **スクリプトの隣から辿る。** **cwd からではない**（`bin/loop-procedure-body` と同じ理由）。
readonly ROOT="${BASH_SOURCE[0]%/*}/.."

targets() {
  # **入口の 2 つ**（開発の入口。壊れると何も動かせなくなる）
  printf '%s\n' "$ROOT/task" "$ROOT/docker-entrypoint.sh"
  # **`bin/` の中身**（**試験は bash ではないので除く**）
  local path
  for path in "$ROOT"/bin/*; do
    [[ -f $path ]] || continue
    [[ $path != *.test.ts ]] || continue
    printf '%s\n' "$path"
  done
}

if [[ ${1-} == "--list" ]]; then
  targets
  exit 0
fi

# **呼ぶものを差し替えられるようにしておく**——**試験は「無いときに落ちる」を
# 見たい**が、**入っている環境と入っていない環境の両方で走る**（#210 の向き）。
readonly SHELLCHECK="${LOOP_SHELLCHECK:-shellcheck}"

if ! command -v "$SHELLCHECK" >/dev/null 2>&1; then
  echo "[FAIL] shellcheck がありません。lint できないので止めます" >&2
  echo "       CI では runner に入っています（.github/workflows/audit.yml）" >&2
  echo "       手元で見るなら、コンテナ経由で打てます:" >&2
  echo "         docker run --rm -v \"\$PWD:/mnt\" -w /mnt koalaman/shellcheck:stable \\" >&2
  echo "           --shell=bash \$(bin/lint-shell --list)" >&2
  exit 2
fi

# **読み切らずに終わる相手へ、パイプで流している箇所を見つける** (#742)。
#
# **守りたいのは「パイプの右が読み切らずに終わる」**で、**`grep -q` はその一例**である
# （#742 のコメント。**数える語を `grep -q` にすると、範囲はその語で決まる**
# ——**`awk '…{exit}'` と `head` を落としていた**）。
#
# **右が先に閉じると、左は SIGPIPE で死に、終了コードは 141。** **`set -o pipefail` を
# 張っていると、パイプ全体が非ゼロ**になり、**「当たった」が「落ちた」として読まれる**
# ——**判定が裏返る。**
#
# **実測（#742）**: **4 worktree ぶんの一覧で 300 回中 3 回。** **`task loop:worker:paths`
# が master の作業場を worker として並べ**、**`bin/loop-cadence` が「止まっている
# セッションを起こせ」と言った**（**そこに worker は居ない**）。**間欠なので、
# 出たときのログしか残らない。**
#
# **shellcheck には SIGPIPE の規則が無い**ので、ここで見る。
#
# **`<<<` から読む形は通す**——**パイプを通らないので SIGPIPE を受けない。**
# **読み切る形も通す**（**`-q` の無い `grep`**、**`exit` の無い `awk`**）
# ——**入力が増えても受けない**（**最後まで読むので、書き手より先に閉じない**）。
# **これが「このままでよい」と決めた側の理由**である (#742 の完了条件)
# ——**`task` の `loop:stop:paths` と `bin/loop-review-head` の `awk` がその形。**
# **注釈は見ない**（**このリポジトリは理由を厚く書く**ので、**説明の中の
# `| grep -q` で落とすと、直した説明そのものが引っかかる**）。
#
# **パイプは、空白を置いた `|` だけを見る**——**`printf 'pr=%s|head=%s'` は
# パイプではない**（#742 のコメント。**広げた走査がこれを拾った**）。
#
# **分けているのは道具ではなく入力の大きさ** (#742 のコメントの訂正)。
# **`awk` は読み込みをまとめるから安全、という逃げ道は無い**——**測り直したら
# 5 つの道具すべてが 1〜3/1000 に揃った**（**`0/500` は「率が 0.6% 以下」までしか
# 言っていない。回数が足りていなかっただけ**）。
#
# **事実に合う言い方はこれである**: **入力が長くなれば必ず倒れる。いまは短いので稀。**
# **「いま 0/500 だから安全」とは書かない。**
# **その段が読み切らずに終わるなら、`REASON` に理由を入れる**（**終わらないなら空**）。
#
# **返り値ではなく変数で返す** (#743 の実装で踏んだ)——**`$( )` は 1 行ごとに
# プロセスを起こす**ので、**47000 行を走査すると `./task check` が目に見えて遅くなる。**
#
# **`awk` の `exit` は、プログラムの中だけを見る** (#743 のレビュー)
# ——**`awk '{print}' || exit 1` はシェル側の後始末**で、**awk は読み切る。**
# **範囲を絞らないと、ふつうのエラー処理を足しただけで赤くなる。**
REASON=""
closes_early() {
  local stage="$1" program
  REASON=""
  if [[ $stage =~ ^[[:space:]]*grep([[:space:]]+-[a-zA-Z]*q) ]]; then
    REASON="grep -q（当たった時点で終わる）"
  elif [[ $stage =~ ^[[:space:]]*head([[:space:]]|$) ]]; then
    REASON="head（先頭だけ読む）"
  elif [[ $stage =~ ^[[:space:]]*awk[^\']*\'([^\']*)\' ]]; then
    program="${BASH_REMATCH[1]}"
    [[ $program == *exit* ]] && REASON="awk … exit（途中で抜ける）"
  fi
}

# **コメントを落として `CODE` に入れる。** **`#` は語の先頭に来たときだけコメントの
# 始まり**である (#743 のレビュー)——**最初の `#` で切ると、`$#` や `${x#pat}` や
# 文字列の中の `#` でも切れ**、**その後ろにあるパイプが見えなくなる**
# （**守ろうとしている側の穴**）。
CODE=""
strip_comment() {
  local rest="$1" out="" head
  while [[ $rest == *"#"* ]]; do
    head="${rest%%#*}"
    # **行頭の `#` か、空白のあとの `#`** ——**そこから先はコメント**
    if [[ -z $out$head || $head =~ [[:space:]]$ ]]; then
      CODE="$out$head"
      return
    fi
    out+="$head#"
    rest="${rest#*#}"
  done
  CODE="$out$rest"
}

early_closing_pipe() {
  local found=0 path line
  for path in "$@"; do
    # **前の行はファイルごとに忘れる** (#743 のレビュー)——**持ち越すと、
    # **A の最後の行が `|` で終わっているときに、B の 1 行目が「パイプの右」になる。**
    local number=0 previous=""
    while IFS= read -r line; do
      number=$((number + 1))
      local code reason="" rest stage
      strip_comment "$line"
      code="$CODE"
      # **前の行が `|` で終わっていれば、この行は右側の段そのもの**である。
      if [[ $previous =~ [[:space:]]\|[[:space:]]*$ ]]; then
        closes_early "$code"
        reason="$REASON"
      fi
      # **段ごとに見る** (#743 のレビュー)——**最初の `|` から先をまとめて 1 つと
      # 読むと、`printf … | sort | head -n 1` の `head` が隠れる。**
      #
      # **`||` は論理和なので、退避してから割る。** **区切るのは空白を置いた `|` だけ**
      # ——**`printf 'pr=%s|head=%s'` の `|` はパイプではない**（#742 のコメント）。
      rest="${code//||/$'\x01'}"
      while [[ -z $reason && $rest == *" |"* ]]; do
        rest="${rest#*" |"}"
        stage="${rest%%" |"*}"
        closes_early "${stage//$'\x01'/||}"
        reason="$REASON"
      done
      if [[ -n $reason ]]; then
        echo "[FAIL] パイプの右が読み切らずに終わります（SIGPIPE で判定が裏返る）: $path:$number" >&2
        echo "       $line" >&2
        echo "       $reason" >&2
        echo "       変数へ受けてから <<< で渡すか、読み切る形にしてください（#742）" >&2
        found=1
      fi
      previous="$code"
    done <"$path"
  done

  return "$found"
}

mapfile -t files < <(targets)

status=0
early_closing_pipe "${files[@]}" || status=1
"$SHELLCHECK" --shell=bash "${files[@]}" || status=1
exit "$status"
