#!/usr/bin/env bash
# 停止識別子ごとに記録された回数を数え、上限に達したら全ループを止める。
#
#   bin/loop-stall <停止識別子>
#
# 「同じ状態で 3 周続いたら止める」をモデルの記憶に任せると、セッションを
# またいだ時点で忘れて空転し続ける。**回数はディスクに持つ。**
#
# 記録先は git の共通ディレクトリ配下。worktree をまたいで同じ場所を指すので、
# master と worker が別ツリーにいても同じカウンタを見る。作業ツリーの外なので
# コミットもされない。
#
#   exit 0 = まだ上限に達していない (呼び出し側はそのまま停止してよい)
#   exit 1 = 上限に達した。全ループを止めた
#   exit 2 = 使い方の誤り / 判定不能
#
set -uo pipefail

# **生きている作業場**。**周回の印と、その作業場の窓を、同じ 1 つの走査で取る** (#144)。
#
# 読み手は 2 つある。**上限**（同時に走るループの数。すぐ下）と、**数え方**
# （worker が同じ周回の中かどうか。ずっと下）である。**生死の判定を 2 箇所に持つと、
# 片方だけ直して食い違う**ので、**歩くのはここ 1 回だけ**にする (#239 のレビュー)。
declare -A alive_scopes=() scope_started_at=() scope_windows=() scope_name_of=()

# **数えられなかったことを、0 件と混ぜない** (#304)。**空なら数えられている。**
#
# **倒れる先が両方とも「気づけない側」だった**——**上限は下限の 3 に張り付き**
# （**正常時と同じ見た目**）、**`--alive-workers` は 0 を返す**（**呼ぶ側は手 1 本へ倒す**）。
# **どちらも「止まらない」「渡さない」で、症状が出ない。**
alive_scan_failed=""

# **数える単位を「相手の周回」にする。**
#
# 第 4 層は master の周回で数えるが、**前へ進めるのは worker の周回**である。
# master は何倍も速く回るので、**指摘の修正に master の何周ぶんもかかる作業は
# 必ず止まる** (実測で 5 回。5 回とも worker は 1 周も終えておらず、5 回とも人が
# 手で再開した)。**難しい指摘ほど踏む**——レビューが良い仕事をするほど罰される (#126)。
#
# **見るのは「worker の周回が動いているか」であって「誰かが `./task` を叩いたか」ではない。**
# 心拍 (bin/loop-lease の活動の記録) は **人が worker の作業場で `./task` を叩いても
# 新しくなる**ので、**worker が死んだあとも「作業中」に見え続ける**。それを使うと
# **カウンタが永久に止まる**——**第 4 層が黙って死ぬ側**の壊れ方である。
#
# **周回だけが出せる信号を使う。** `bin/loop-lease acquire` が書く印 (ROUNDS) は
# **周回の開始でしか動かない**。人が `./task` を叩いても動かない。
#
#   印が動いた           … 1 周終えて次が始まった → **数える**
#   印が同じで、まだ窓の内 … その周回が続いている   → **数えない**
#   印が窓より古い       … 周回が始まっていない     → **数える** (worker が死んだ場合もここ)
#
# **窓は書き写した閾値ではない。** `bin/loop-lease` が release のたびに残す
# **いちばん長かった周回の実測**の 2 倍を使う (記録が無ければ lease の期限で代用)。
# **1 周が長い機械では窓も広がる**ので、**長い周回の途中で止められない**。
#
# **worker の作業ツリーは読まない。** 見るのは worker 自身が git の共通ディレクトリへ
# 書いた記録だけである。master が相手の作業場を覗く形にすると、
# 「GitHub を唯一の正とする」という設計に穴が開く。
# **数えられなかったなら、そう言う** (#304)。**0 件へ倒さない**（`AGENTS.md` §5）。
#
# **途中まで数えた結果も残さない** (#308 のレビュー)。**時刻の窓のぶんは走査の前半で
# 既に入っている**ので、**理由を立てるだけでは部分集合が生き残る**——**上限も、
# 周回が動いているかの判定も、その部分集合を「全員」と読む**（**欠けた作業場が
# 止まっていても、残ったほうが進めば「全員進んだ」になる**）。
fail_scan() {
  alive_scopes=()
  scope_started_at=()
  scope_windows=()
  scope_name_of=()
  alive_scan_failed="$1"
  return 1
}

scan_alive_scopes() {
  local common_dir="$1" script_dir="$2"
  local lease_ttl scope scope_rounds scope_started scope_window seconds len now_epoch
  local scope_name scope_workspace
  local shared_window running_scopes
  if [[ -z $script_dir || ! -x "$script_dir/loop-lease" ]]; then
    fail_scan "bin/loop-lease を実行できません（${script_dir:-スクリプトの場所が不明}）"
    return 1
  fi
  if ! lease_ttl="$("$script_dir/loop-lease" ttl 2>/dev/null)" ||
    [[ ! $lease_ttl =~ ^[0-9]+$ ]]; then
    fail_scan "bin/loop-lease ttl を読めません"
    return 1
  fi

  # **始めた周回の印。** lease と違って返しても消えないので、
  # **周回と周回の間でも「どの周回まで始めたか」が読める**。
  # **作業場ごとに、前回からの進みを見る** (#144)。**最大値を取ると、無関係な worker が
  # 周回を始めるたびに数が進む**——**PR を直している worker が同じ長い周回にいても、
  # 別 worker の 3 周だけで全ループを誤停止しうる。**
  #
  # **最小値でも足りない** (#200 のレビュー)。**最小値を持っていた作業場が動けば
  # それだけで動く**ので、**開始時刻がずれていると、片方が 2 周・もう片方が 1 周でも
  # 上限に達する**。**「いちばん遅い値が動いたか」は「全員が動いたか」ではない。**
  #
  # **担当を突き止めない。** **どの作業場がどの PR を見ているかは、ここからは分からない**
  # （PR 番号から作業場を引くには GitHub が要る）。**代わりに「全員が新しい周回を
  # 始めたか」を見る**——**担当している作業場も必ずその中にいる**ので、
  # **無関係な周回だけでは進まない。**
  #
  # **止まらなくなる形にはしない。** **見るのは生きている作業場だけ**なので、
  # **周回を始めなくなった作業場は、その窓を過ぎた時点で外れる**（すぐ下と同じ判定）。

  # 窓 = いちばん長かった周回 × 2。**実測が無ければ lease の期限で代用する。**
  #
  # **生きている作業場のものだけを見る** (#175 のレビュー)。記録は**作業場ごと**にあり
  # (scope はパスから作る)、**書き換えるのはその作業場の周回だけ**である——
  # **長い周回を記録した作業場が使われなくなると、その値は誰も更新しない**ので、
  # **別の作業場で何周しても落ちず、窓は永久に広いまま**になる。
  # **この機械には既に worker 役の scope が 2 つある**ので、**#82 を待たずに踏む。**
  #
  # **1 つに絞らない**（いちばん新しい周回の作業場だけ、にはしない）。
  # **軽い Issue の作業場が新しく、重い Issue の作業場が少し古い**とき、
  # **重いほうが窓の外へ出る**——**長い周回の途中で止めない**という性質を壊す。
  #
  # **生死は「周回の印」で見る。活動の記録は使えない**（このすぐ上に書いてある）——
  # **`./task` は lease の有無に関係なく毎回 heartbeat を打つ**ので、
  # **使われなくなった作業場で人が 1 回叩けば、長い実測が窓へ戻る**。
  # **周回の開始でしか動かない印**だけが、周回が生きていることを表す。
  #
  # **期限は「その作業場自身の窓」で測る。** lease の期限で一律に切ると、
  # **30 分を超える周回の途中にある作業場が「死んだ」に落ちる**——
  # **いちばん守りたい場面で窓が縮む**という、向きが逆の壊れ方になる。
  # **新しい閾値は作っていない**（**下と同じ式・同じ既定**を、作業場ごとに当てるだけ）。
  #
  # **消さない**のも意図的である（**削除は戻せない**）。読むときに外すだけにする。
  now_epoch="$(date +%s)"
  for scope_rounds in "$common_dir"/valence-loop-rounds-worker*; do
    [[ -f $scope_rounds ]] || continue
    scope_started=""
    scope_workspace=""
    # **2 行目は作業場**（#385。**lease の 3 行目と同じ形**）
    { read -r scope_started; read -r scope_workspace; } <"$scope_rounds" 2>/dev/null
    [[ $scope_started =~ ^[0-9]+$ ]] || continue
    scope_name="${scope_rounds##*/valence-loop-rounds-}"
    # **鍵は作業場である** (#385 のレビュー)。**名前は版で変わる**——**名前を鍵にすると、
    # 名前の作り方が変わった直後、1 つの作業場が 2 つの scope として数えられる。**
    #
    # **持ち主の書かれていない印は、作業場として数えない。** **前の版が置いた印は
    # 名前でしか持ち主を言わず、その名前を読めない版から見ると誰のものか分からない**
    # ——**「別の作業場」と決めると、手の数が水増しされ**、**その印は二度と進まないので
    # `all_scopes_advanced` が永久に `1` を返す**（**停止カウンタが黙って止まる**）。
    # **数えないほうへ倒す**——**手は 1 本少なく見え、停止はこれまでどおり数えられる。**
    #
    # **`,` と `=` を含む作業場は、名前を鍵のままにする**——**この記録は
    # `<鍵>=<時刻>` を `,` で並べる**ので、**鍵に混ぜると読み直せなくなる**
    # （**読めない印は「初めて見た」に倒れ、その識別子は数え始められない**）。
    [[ -n $scope_workspace ]] || continue
    scope="$scope_workspace"
    [[ $scope != *[,=]* ]] || scope="$scope_name"
    # **実測が無い作業場もいる**（一度も返していない）。**そのときは既定の窓で見る**
    # ——**実測の記録は印と同じ名前で置かれている**ので、**引くのは名前のほうである。**
    seconds=""
    len="$common_dir/valence-loop-roundlen-$scope_name"
    if [[ -f $len ]]; then
      read -r seconds <"$len" 2>/dev/null || seconds=""
      [[ $seconds =~ ^[0-9]+$ ]] || seconds=""
    fi
    scope_window="$lease_ttl"
    if [[ -n $seconds ]]; then
      scope_window=$((seconds * 2))
      ((scope_window >= lease_ttl)) || scope_window="$lease_ttl"
    fi
    # **同じ作業場の印が 2 つあるなら、新しいほうを採る**（**名前が変わった直後は
    # 前の名前の印も残っている**——**古いほうで上書きすると、進んでいないように見える**）
    if [[ -n ${scope_started_at[$scope]-} ]] &&
      ((scope_started_at[$scope] >= scope_started)); then
      scope_name_of["$scope_name"]="$scope"
      continue
    fi
    scope_started_at["$scope"]="$scope_started"
    scope_windows["$scope"]="$scope_window"
    scope_name_of["$scope_name"]="$scope"
    ((now_epoch - scope_started < scope_window)) || continue
    alive_scopes["$scope"]="$scope_started"
  done

  # **握っている lease は、時刻の窓より先に見る** (#303 のレビュー)。
  #
  # **印は「周回を*始めた*時刻」しか言わない**——**途中では動かず、実測は `release`
  # まで書かれない**ので、**初めての周回と、過去より長い周回は、走っている最中に
  # 窓から出る**（`./task loop:worker:add` の直後がまさにそれ）。**落ちる先が悪い**：
  # **`bin/loop-handoff` の手の本数が減り、空いている worker を起こさなくなる**（#302）。
  #
  # **判定は足さない。** **期限は `bin/loop-lease` が 1 箇所で持っている**
  # （`alive` は #298 で同じ形にした）——**ここは並べてもらって混ぜるだけ**である。
  #
  # **印が読めなかった作業場は、ここでも数えない。** **時刻が無いと「前回から進んだか」
  # を言えない**（`all_scopes_advanced`）ので、**基準を作り話で埋めない。**
  #
  # **終了コードを受ける** (#308 のレビュー)。**process substitution の中で呼ぶと、
  # 落ちても `while` は 0 行を読んだだけに見える**——**握ったまま窓を越えた作業場が
  # 丸ごと欠けても、`--alive-workers` は少ない件数を exit 0 で返していた**
  # （**この PR が消しに来た「判定不能を 0 に倒す」が、隣の呼び出しに残っていた**）。
  if ! running_scopes="$("$script_dir/loop-lease" running worker 2>/dev/null)"; then
    fail_scan "bin/loop-lease running worker を読めません"
    return 1
  fi
  # **`running` が並べるのは lease の名前**である——**印と同じ作り方の名前**なので、
  # **走査で作った対応表で作業場へ引き直す** (#385)。**印が無い作業場は、これまでどおり
  # 数えない**（**時刻が無いと「前回から進んだか」を言えない**）。
  while read -r scope; do
    [[ -n $scope ]] || continue
    scope="${scope_name_of[$scope]-}"
    [[ -n $scope ]] || continue
    alive_scopes["$scope"]="${scope_started_at[$scope]}"
  done <<<"$running_scopes"

  # **生きている作業場の実測は、自分のでなくても効かせる**（#200 のレビュー 3 周目）。
  # **自分の実測が短い作業場は、長い周回の途中で自分の窓から出る**——
  # **いちばん守りたい場面（#129 / #142 の「長い周回の途中で止めない」）で
  # 窓が縮む**という、向きが逆の壊れ方になる。**新しい閾値は作らない**——
  # **上と同じ式・同じ既定**を、いちばん広い窓で当て直すだけである。
  #
  # **広げても戻らない。** **この窓で生き返る作業場は、自分の窓が既に
  # それより狭い**（狭いから落ちた）ので、**最大を押し上げない。**
  shared_window="$lease_ttl"
  for scope in "${!alive_scopes[@]}"; do
    ((scope_windows[$scope] > shared_window)) && shared_window="${scope_windows[$scope]}"
  done
  for scope in "${!scope_started_at[@]}"; do
    [[ -z ${alive_scopes[$scope]-} ]] || continue
    ((now_epoch - scope_started_at[$scope] < shared_window)) || continue
    alive_scopes["$scope"]="${scope_started_at[$scope]}"
  done
}

# 停止識別子の正はここ。`.claude/commands/loop-*.md` の判定箇所は、識別子を
# 別途一覧にせずこの表を引く (bin/loop-stall --list)。
#
# 一覧を 2 箇所に持つと、片方だけ直したときに表記がゆれる。数え方は文字列一致
# なので、周回ごとに違う綴りで呼ばれると **別状態として数え直し、3 周続いても
# 止まらない**。空転検出を機械化した意味が消えるため、ここに無い識別子は弾く。
#
#   <識別子の書式>|<どういう場面か>
#
# 書式のプレースホルダはそのまま検査用の正規表現になる (spec_to_regex)。
# 表示と検査が同じ文字列から出るので、片方だけずれることがない。
readonly STOP_IDS=(
  "dirty|worker: 作業ツリーが dirty"
  "main-sync-failed|両方: origin/main への追随に失敗 (どちらも origin/main へ detach する)"
  "wrong-branch:<PR番号>|worker: PR の head ブランチに切り替わっていない"
  "too-many-own-prs:<件数>|worker: この作業場の open PR が 2 件以上 (全体で 2 本・1 人 1 本)"
  "local-ci-failed:<PR番号>|worker: ./task check が通らない"
  # **「分からない」を「赤」と混ぜない** (#147)。`./task check` が途中で殺されると
  # **終了コードが取れないまま、出力だけが緑に見える**——**通らなかった**のではなく
  # **合否が分からない**状態である。
  #
  # **押し通してよいが、記録は残す。** 3 周続くなら**この機械では `./task check` が
  # 実行制限に収まらない**ということで、**人の判断が要る**（避ける方向は #131 / #133）。
  # **PR より前に起きる**ので Issue 番号で数える。
  "local-ci-unknown:<Issue番号>|worker: ./task check の合否が分からない (途中で殺された)"
  "implementation-blocked:<Issue番号>|worker: blocked にして人へ渡した (完了条件を満たせない / PR が人手で閉じられた)"
  # **着手したのに実装が出ないまま時間が過ぎている状態** (#264)。**どの検査も健全と
  # 答える**——**作業ツリーは clean、ブランチも PR も無く、`resume` も `audit` も通る**。
  # **`no-work` とは違う**（**作業はある。手が動かないだけ**）ので、相乗りさせない。
  #
  # **`WORKER_FIXES` には入れない。** **塞ぎたいのは「worker が周回を回しながら
  # 何も出さない」状態**なので、**worker の周回を猶予にすると、当の場面で永久に
  # 数えられない**（`head-moved` とは主体が同じでも向きが逆である）。
  #
  # **Issue 番号を入れる。** **変われば前へ進んだ**ことを表す（時刻のように毎回
  # 変わる値ではない）。
  "implementation-stalled:<Issue番号>|master: 着手したまま実装が出ていない (worker が尽きた / 落ちた)"
  # **着手中なのに、誰が取ったかの記録が無い状態** (#281 のレビュー)。**`take` は
  # label を先に付ける**ので、**その間に落ちれば必ずこうなる**（`write_record` の
  # 失敗も同じ）。**上と分ける**——**原因が違い、人が次にやることも違う**
  # （**尽きた worker を見る**のか、**持ち主のいない着手を戻す**のか）。
  #
  # **測れないことを、健全と同じ出口にしない。** 名前が無いと、**この状態は
  # 「実装は出ている / まだ早い」と同じ答えになる**（`head-lookup-failed` を
  # `head-moved` と分けたのと同じ理由）。
  "claim-record-missing:<Issue番号>|master: 着手中なのに着手の記録が無い (take が途中で落ちた)"
  "publish-failed:<Issue番号>|worker: push / PR 作成に失敗"
  "too-many-ready:<件数>|両方: ready の Issue が 3 件以上ある (上限は 2 件)"
  "procedure-stale|両方: 配られた手順書がディスクより古い (呼び直しても直らなかった)"
  # **手順が入れ替わって周回を捨てた** (#367)。**捨てた周回はどこにも残らない**
  # ——**打ち切りは `main-sync-failed` を消して終わる**（前へ進んだ証拠があるため。#266）
  # ので、**`bin/loop-stall` は「始めたばかり」と答え、外からは健全に見える。**
  #
  # **止める判断は変えない。** **古い手順で走り続けるより捨てるほうが安全**である
  # ——**足したのは「捨てたことが分かる」側だけ**で、**続いたときに人が呼ばれる。**
  #
  # **`WORKER_FIXES` には入れない。** **解くのは worker の push ではなく、
  # 手順を直す PR が途切れること**である。**続く間は数え続けてよい。**
  "procedure-churn|worker: 手順が入れ替わって周回を捨てた (続くと実装が進まない)"
  "wrong-worktree|master: worker の作業ツリーにいる"
  # **どちらの役も打つ。** 「一覧の失敗を 0 件として読む」は master 側で 4 箇所直したが、
  # **worker の手順には残っていた** (#136)。**同じ状態には同じ名前**なので分けない
  # (#128)——**主体ではなく状態で名前を決める**。
  #
  # **両方が同時に失敗するのは、実際に GitHub が落ちているとき**である。
  # そのとき**早く 3 周へ届く**のは正しい向きで、**どちらのループも進めない**。
  "pr-lookup-failed|両方: open PR の一覧を取得できない"
  "issue-lookup-failed|両方: Issue の一覧やコメントを読み取れない (label を触らずに止める)"
  "gate-misconfigured:<PR番号>|master: bin/loop-gate が exit 2"
  "review-budget-unknown:<PR番号>|master: 3.2 でレビューの判定ができない (予算・一覧の取得)"
  "merge-failed:<PR番号>@<SHA>|master: マージに失敗"
  "review-exhausted:<PR番号>@<SHA>|master: 人の判断待ち (レビュー上限に達し手直しも上限超え / 保留にできなかった)"
  "review-unanswered:<PR番号>@<SHA>|master: レビューが返らず、マージも再要求もできない"
  # **1 つの状態に 1 つの名前。** 以前は「優先度 1 / 2 の指摘が残っている」と
  # 「出した要求が満たされていない」を別の名前で数えていたが、**どちらも
  # 「worker の対応を待っている」**である。**`changes-requested` が付いているかは、
  # 待っている状態の性質ではなく、master がその周回までに何をしたか**なので、
  # **label を付けた瞬間に同じ膠着が別の名前になり、カウンタが割れた**（#128。実測）。
  # **第 4 層は文字列一致で数える**ので、割れると**3 周に届かず沈黙する**。
  #
  # **選び方を決めるのではなく、名前を 1 つにした。** 選び方を自動化しても
  # **選ぶ対象が 2 つあることは変わらず**、**master の操作で名前が変わる余地が残る**。
  # head SHA は残す——**変われば前へ進んだ**を表す値なので、変わってよい。
  "awaiting-worker:<PR番号>@<SHA>|master: worker の対応を待っている (指摘が残っている / 出した要求が満たされていない)"
  "ci-pending:<PR番号>@<SHA>|master: CI の検査が決着しないまま予算 (workflow の timeout-minutes) を超えた"
  # **`ci-pending` と分ける** (#297)。**「決着しない」と「作られていない」は別の状態**で、
  # **同じ識別子に混ぜると、原因の違う 2 つが 1 つのカウンタで 3 周に届く**——
  # **人が来たときに、どちらを見ればよいか分からない。**
  "ci-missing:<PR番号>@<SHA>|master: 必須チェックが 1 件も作られないまま猶予を過ぎた (GitHub 側が起動していない)"
  # 件数を付けない。着手できる状態が 1 つでもあればこの識別子を使わないので、
  # 付けられる数はどれも 0 で、**状態が同じなのに毎回変わる値**にしかならない。
  # blocked だけがある状態もここに含める (人の判断待ちで、ループの中では解けない)。
  # **push されたのに PR が無いブランチ** (#148)。**ループでは救うか捨てるかを
  # 判定できない**ので**人へ渡す**——**自動で消さない**（中身が要るかもしれない）。
  #
  # **消し残り（終わった PR のブランチ）はここで数えない。** そちらは**掃除してよい**もので、
  # **master がその周回で消せる**——**同じ名前にすると、消せるものが人を呼ぶ**。
  #
  # **ブランチ名を入れる。** 別のブランチで起きたら数え直すのが正しく、
  # **名前は状態が同じなら変わらない**（時刻のように毎回変わる値ではない）。
  "stray-branch:<ブランチ>|master: push されたのに PR が無いブランチがある (人へ渡す)"
  # **どの一覧にも出てこない open Issue** (#325)。**状態 label が 1 つも無いと、
  # master のステップ 6 にも worker にも見えない**——**#319 で実際に起きた**
  # （`in-progress` を外した先が無かった）。
  #
  # **全部の検査が「健全」と答える。** **`audit` も `handoff` も label と PR の
  # 食い違いを見るもの**で、**label が無いことは食い違いではない**——
  # **空転として数えられないまま、作業が誰にも呼ばれずに置かれる。**
  #
  # **どこへ戻すかは中身を読まないと決まらない**ので、**master が付け直さずに人を呼ぶ。**
  #
  # **Issue 番号を入れる。** 別の Issue で起きたら数え直すのが正しく、
  # **番号は状態が同じなら変わらない**（時刻のように毎回変わる値ではない）。
  "unlisted-issue:<Issue番号>|master: どの一覧にも出てこない open Issue がある (状態 label が 1 つも無い)"
  "no-work|master: 着手できる作業が無い (open PR / ready / in-progress が 0 件で、昇格できる backlog も無い)"
  # 件数を付けない。**溜まるほど件数が変わる**ので、付けると連続回数が数え直しになり、
  # 3 周続いても止まらない (`bin/loop-deferred-budget` が件数を出す)。
  "deferred-overflow|master: 外出しした指摘が溜まりすぎている (deferred-finding が上限超え)"
  # **周回の途中で head が動いた状態**（`bin/loop-head same` の exit 1）。
  # **その周回の判断は記録しない**（評価したのは、もう head ではない commit）。
  #
  # **head SHA を付けない。** ずれるたびに評価した head は違うので、付けると
  # **毎回別状態として数え直され、3 周に届かない**。**ここで数えたいのは
  # 「同じ PR で、ずれが続いていること」**——worker が push し続ける間 master が
  # 判断できない状態は、3 周続いたら人を呼ぶ側に置く。
  "head-moved:<PR番号>|master: 周回の途中で PR の head が動いた (worker の push)"
  # **head を読めない状態**（`bin/loop-head same` の exit 2）。**上と分けてある。**
  #
  # **主体が違う。** 動かすのは worker だが、**読めない原因は gh / 認証 / GitHub** で、
  # **worker の push では解けない**。**同じ名前にまとめて `WORKER_FIXES` へ入れると、
  # worker が元気な間ずっと数えられない** (#145 のレビュー 2 周目。実際にそうしていた)。
  # **#128 は「同じ状態には同じ名前」だったが、これは逆に「違う状態には違う名前」**である。
  "head-lookup-failed:<PR番号>|master: PR の head を読み取れない (gh / 認証 / GitHub。worker では解けない)"
  # label と実態が食い違っている状態。**「送るものが無い」と混ぜない**ために別で数える。
  # PR 番号を入れるので、別の PR で起きたら数え直される。
  "handoff-mismatch:<PR番号>|両方: 未解決スレッドがあるのに changes-requested が無い"
  # 着手中でない Issue を閉じようとする open PR がある状態。**誰が持つべきかは
  # 状態から決められない**ので、人へ渡す（古い記録のほうは自動で解放される）。
  "claim-mismatch:<Issue番号>|master: 着手中でない Issue を閉じる open PR がある"
)

# **worker が動いて解く状態。** 第 4 層の数え方をここだけ変える (下の counted を参照)。
#
# **識別子ごとに主体が違う。** たとえば review-unanswered は「Codex が返さない」ので、
# **worker が元気に別の周回をまわしていても解けない**。「worker が動いているから待つ」と
# 読むのは主体が違うので、**worker が主体のものだけに効かせる**。
#
# **STOP_IDS とは別の軸**なので別に持つ (あちらは「誰が記録するか」で、これは
# 「誰が解くか」)。**綴りがずれると黙って効かなくなる**ので、
# 一覧に無い綴りが混ざっていないことを試験で押さえてある。
readonly WORKER_FIXES=(
  "awaiting-worker"
  # **head が動く原因は、worker が push したことである** (#145)。つまり
  # **この停止が起きているとき、worker はほぼ必ず動いている**——
  # **master の周回ごとに数えると、worker が元気に push している間に 3 周で止まる**。
  # **狙いは保たれる**: worker の周回ごとに 1 ずつ数えるので、
  # **push し続ける間 master が判断できない**なら 3 周で人を呼ぶ。
  #
  # **`head-lookup-failed` は入れない。** そちらは gh / 認証 / GitHub が主体で、
  # **worker が何周まわしても解けない** (`review-unanswered` と同じ側)。
  "head-moved"
)

# **その作業場の状態を表す識別子** (#239)。**カウンタを作業場ごとに分ける。**
#
# **1 つのファイルに全部を入れると、2 人目を走らせた瞬間に検出器が黙る**——
# **A が同じところで止まっている間に B が進んで `--reset` を呼ぶと、A のぶんまで毎回消え、
# 3 周に永久に届かない**（**症状は「止まらない」**なので、**気づく手立てが無い**）。
#
# **分ける基準は「誰の状態か」**である。**`no-work` や `too-many-ready` は
# ループ全体の状態**（誰が進んでも数え直してよい）だが、**`local-ci-failed` は
# その作業場の状態**——**別の作業場が進んでも、こちらは何も解決していない。**
#
# **`main-sync-failed` と `procedure-stale` もここに入る。** **作業ツリーも、
# 配られた手順書も作業場ごと**である（**両方の役が打つが、打つ理由は自分の側にある**）。
#
# **入れると 2 つ変わる** (#368 のレビュー)。**記録の置き場所**が共有の
# `valence-loop-stall` から `valence-loop-stall-<作業場>` へ移り、**`--reset` の効く範囲**が
# その作業場だけになる——**引数無しの `--reset` も、共有と「打った側の」作業場しか消さない。**
# **だから、他人の前進では消えない。**
readonly WORKSPACE_SCOPED=(
  "dirty"
  "main-sync-failed"
  "procedure-stale"
  # **`procedure-stale` と原因も主体も同じ** (#368 のレビュー)——**その作業場の入口が、
  # その作業場の周回を捨てたこと**である。**共有のままだと消える経路が 2 つ残る**:
  # **もう 1 人の worker が出口を通る**（こちらは 1 度も進んでいないのに消える）と、
  # **master が手順 PR をマージして `--reset` を打つ**。
  # **#367 が狙っているのは「手順 PR のマージと打ち切りが交互に続く」形**なので、
  # **master が進むたびに消えると、狙った場面でだけ鳴らない。**
  "procedure-churn"
  "wrong-branch"
  "too-many-own-prs"
  "local-ci-failed"
  "local-ci-unknown"
  "implementation-blocked"
  "publish-failed"
)

usage() {
  echo "使い方: bin/loop-stall <停止識別子>" >&2
  echo "       bin/loop-stall --reset [<識別子>]  周回が前へ進んだときに呼ぶ" >&2
  echo "                                     識別子を渡すと、そのぶんだけ消す" >&2
  echo "       bin/loop-stall --resumed      人が再開したときに呼ぶ（./task loop:resume が通す）" >&2
  echo "       bin/loop-stall --list         使える識別子を一覧する" >&2
  echo "       bin/loop-stall --alive-workers  周回を回している worker の作業場の数（読むだけ）" >&2
  echo "  識別子は一覧にあるものだけ。書式まで一致しないと受け付けない" >&2
  exit 2
}

# 桁を揃えない。printf の幅指定はバイト数で数えるので、書式に混じる日本語の
# ぶんだけ列がずれ、揃えたつもりの表示が崩れる。
print_stop_ids() {
  local entry
  for entry in "${STOP_IDS[@]}"; do
    printf '%s  —  %s\n' "${entry%%|*}" "${entry#*|}"
  done
}

# 書式を検査用の正規表現へ変換する。未知のプレースホルダが残ったら失敗させる。
# 置換し損ねた `<...>` をそのまま正規表現にすると、意図しない文字列まで通る。
spec_to_regex() {
  local re="$1"
  # 置換文字列を直書きしない。`}` が ${...} を閉じてしまい、余った `}` が
  # 正規表現の末尾に残る (どの識別子にも一致しなくなる)。
  local sha_re='[0-9a-f]{7,40}'
  re="${re//<PR番号>/[0-9]+}"
  re="${re//<Issue番号>/[0-9]+}"
  re="${re//<件数>/[0-9]+}"
  re="${re//<SHA>/$sha_re}"
  # ブランチ名。**`/` も `.` も入る**（`feat/x.y`）。**空白は入らない**ので、
  # **空白以外の 1 文字以上**で受ける（**`<` `>` は git が禁じている**）。
  re="${re//<ブランチ>/[^[:space:]]+}"
  [[ $re == *"<"* || $re == *">"* ]] && return 1
  printf '%s' "$re"
}

id_is_known() {
  local entry spec re
  for entry in "${STOP_IDS[@]}"; do
    spec="${entry%%|*}"
    if ! re="$(spec_to_regex "$spec")"; then
      echo "[FAIL] 内部エラー: 識別子の書式を検査できません: $spec" >&2
      exit 2
    fi
    # $re はパターンとして展開させる。ここを引用符で囲むとリテラル一致になる。
    [[ $1 =~ ^$re$ ]] && return 0
  done
  return 1
}

# **`--reset` だけは 2 つ目を取る** (#266)。**消す対象を、前へ進んだぶんに限る**ため。
[[ $# -eq 1 || ($# -eq 2 && $1 == "--reset") ]] || usage
readonly ID="$1"
readonly RESET_ID="${2-}"

if [[ $ID == "--list" ]]; then
  print_stop_ids
  exit 0
fi

# 識別子はファイル名の一部にしないが、**制御文字・改行・空白**が混ざるものは受けない
# (記録は**タブ区切りの行**なので、混ざると列が壊れる)。
#
# **許す文字を並べない。** 並べると**同じファイルの中で 2 つの検査が違う幅を見る**ことに
# なり、**内側 (書式の `<ブランチ>`) を広げても外側が先に立って弾く** (#148 のレビュー)。
# **`feat/a+b` は git が受け付けるのに記録できず**、**見つけたのに人へ渡らない**——
# **`exit 2` は「記録できていない」なので 3 周の経路にも乗らない**。
#
# **目的をそのまま書く。** git も**空白と制御文字を含む ref 名は受け付けない**ので、
# **git が通す名前はここも通る**。
[[ $ID == "--reset" || $ID == "--resumed" || $ID == "--alive-workers" ]] ||
  [[ $ID =~ ^[^[:cntrl:][:space:]]+$ ]] || {
  echo "[FAIL] 識別子に使えない文字が含まれています (bin/loop-stall --list)" >&2
  exit 2
}

# 綴りの検査はカウンタを触る前に行う。ゆれた識別子で 1 度でも書き込むと、
# そこで連続回数が切れてしまう。
# **消す対象も、綴りを先に見る** (#266)。**ゆれた識別子で「消えたつもり」を作らない**
# ——**消せていないのに進むと、次の周回が古い数から続ける。**
if [[ -n $RESET_ID ]] && ! id_is_known "$RESET_ID"; then
  echo "[FAIL] 未知の停止識別子: $RESET_ID" >&2
  echo "       使えるのは次のものだけ:" >&2
  print_stop_ids | sed 's/^/       /' >&2
  exit 2
fi

if [[ $ID != "--reset" && $ID != "--resumed" && $ID != "--alive-workers" ]] && ! id_is_known "$ID"; then
  echo "[FAIL] 未知の停止識別子: $ID" >&2
  echo "       使えるのは次のものだけ:" >&2
  print_stop_ids | sed 's/^/       /' >&2
  exit 2
fi

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
# --git-common-dir は worktree からだと相対パスを返すことがある。
# **物理パス (pwd -P) で解決する。** 既定の pwd はシンボリックリンクを保った論理パスを
# 返すので、同じ .git でも到達経路が違うだけで文字列が一致しなくなる。
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
# スクリプトのある場所。**ここで決める**——**上限も、数え方も、`bin/loop-lease` へ
# 訊いてから決まる**ので、**両方より前に要る**（#239 のレビュー）。
# 失敗した代入で変数を壊さない。`var="$(cmd)"` は cmd が失敗しても空を代入するので、
# それをフォールバックの入力に使うと `cd ""` になる。**これは成功して cwd を返す**ため、
# 「同じリポジトリの worktree」が「別のリポジトリ」に化ける。実際に踏んだ。
#
# **外の道具では引かない** (#304)。**`dirname` が引けないと、まさにその `cd ""` になる**
# ——**cwd を指したまま `-x "$script_dir/loop-lease"` が偽になり、黙って 0 件へ倒れる**
# （**PR #303 の試験で実際に踏んだ**）。**同じファイルの `scope` は既にこの形**である。
script_dir="${BASH_SOURCE[0]%/*}"
[[ $script_dir != "${BASH_SOURCE[0]}" ]] || script_dir="."
script_dir="$(cd "$script_dir" 2>/dev/null && pwd -P)" || script_dir=""

# **生きている作業場を、ここで 1 回だけ数える。** 読み手は上限と数え方の 2 つで、
# **どちらも同じ生死を見る**（#239 のレビュー）。
scan_alive_scopes "$common_dir" "$script_dir" || true

# **数えた結果を、外へ 1 つの口から出す** (#302)。**`bin/loop-handoff` は
# 「手が何本あるか」を知りたいだけ**で、**同じ生死を 2 箇所で数えると、
# 片方だけ直したときに食い違う**（`AGENTS.md` §5）。**読むだけ**である。
if [[ $ID == "--alive-workers" ]]; then
  # **数えられなかったなら、件数を答えない** (#304)。**0 を返すと、呼ぶ側からは
  # 「本当に誰も回していない」と区別が付かない**——**判定不能は判定不能で返す。**
  if [[ -n $alive_scan_failed ]]; then
    echo "[WARN] alive-workers=unknown 生きている作業場を数えられません（$alive_scan_failed）" >&2
    exit 2
  fi
  printf '%s\n' "${#alive_scopes[@]}"
  exit 0
fi

# 上限。**同時に走るループの数から決める** (#239)。
#
# **安全な下限は「同時に走るループ数 + 1」**である——**`loop:resume` の直後、
# 冒頭の STOP 検査を通過した周回がそれぞれ同じ停止を積むと、再開した瞬間にまた止まる。**
# **数を書き写さない**（`AGENTS.md` §5）——**作業場が増えれば、上限も増える。**
#
# **走っているループの数は、周回の印から数える**（`bin/loop-lease acquire` が書く）
# ——**master が 1 つと、いま周回を回している worker の作業場**である。
# **3 を下回らない**（**1 人で回している間は、これまでと同じ**）。
#
# **数えるのは生きている作業場だけ** (#239 のレビュー)。**印は消さない設計**で、
# **`./task loop:worker:remove` も消さない**——**存在だけを見ると、作業場を作って
# 消すたびに上限が 1 増え、二度と減らない**（**過去に 5 つ使った環境では、1 人で
# 回していても上限 6**）。**症状は「止まらない」**なので、**気づく手立てが無い。**
#
# **上限は共通ディレクトリが分かってから決める**（周回の印を数えるため）。
# **設定で渡されたらそれが正**——**試験と、人が絞りたいときのため**である。
if [[ -n ${LOOP_MAX_STALL_REPEATS-} ]]; then
  MAX_REPEATS="$LOOP_MAX_STALL_REPEATS"
else
  # **数えられなかったことを、下限に隠さない** (#304)。**下限の 3 は正常時にも出る値**
  # なので、**黙って落ちると「上限が 3 のまま」としか見えない**——**止めるほどではない
  # （3 でも動く）が、言わないと次に同じ形が出ても気づけない。**
  if [[ -n $alive_scan_failed ]]; then
    echo "[WARN] alive-workers=unknown 上限を生きている作業場から決められません（$alive_scan_failed）。下限で続けます" >&2
  fi
  # 走っているループ = master 1 つ + 生きている worker の作業場。上限はそれに 1 を足す
  MAX_REPEATS=$((1 + ${#alive_scopes[@]} + 1))
  ((MAX_REPEATS >= 3)) || MAX_REPEATS=3
fi
readonly MAX_REPEATS
if ! [[ $MAX_REPEATS =~ ^[0-9]+$ ]] || ((MAX_REPEATS < 1)); then
  echo "[FAIL] 設定: LOOP_MAX_STALL_REPEATS は 1 以上の整数で指定してください" >&2
  exit 2
fi

readonly STATE="$common_dir/valence-loop-stall"

# **この作業場ぶんのカウンタ** (#239)。**単位の作り方は `bin/loop-lease` が持っている**
# ので、そこへ訊く——**書き写すと、片方だけ直して食い違う**（#159 の形）。
#
# **役ではなく作業場で分ける。** **worker の scope は作業場そのもの**（`master` は
# 1 つしか無いので、分ける単位としては worker 側の作り方が正）——**master の worktree で
# 呼んでも、そこの作業場を指す名前が返る。**
#
# **分からなければ数えない。** **共有側へ倒すと、この Issue が消しに来た形へ戻る**
# ——**判定不能は、記録できたことにしない。**
if ! workspace_scope="$("${BASH_SOURCE[0]%/*}/loop-lease" scope worker 2>/dev/null)" \
  || [[ -z $workspace_scope ]]; then
  echo "[FAIL] この作業場を表す名前を作れません（bin/loop-lease scope worker）" >&2
  exit 2
fi
readonly LOCAL_STATE="$common_dir/valence-loop-stall-$workspace_scope"

# その識別子を数えるファイル。**ループ全体の状態は共有し、作業場の状態は分ける。**
state_file() {
  local id="${1%%:*}" kind
  for kind in "${WORKSPACE_SCOPED[@]}"; do
    [[ $id == "$kind" ]] && {
      printf '%s' "$LOCAL_STATE"
      return 0
    }
  done
  printf '%s' "$STATE"
}
# **人が再開したときに、上限へ達していた識別子を積む。** 「同じところで何度目か」を
# 出すためのもので、**カウンタとは別に持つ**（--reset で消えると、繰り返しが見えなくなる）。
readonly RESUMED="$common_dir/valence-loop-resumed"

# **この作業場が STOP を配ったという印** (#239 のレビュー 2 周目)。
#
# **版をまたいで再開されると、この作業場だけが出られなくなる。** **前の版の
# `--resumed` は共有カウンタしか消さない**が、**STOP は全 worktree から消す**
# ——**作業場ごとのカウンタは前の版から見えない**ので、**上限のまま残り、
# 次の 1 回で即座に止め直す**（`AGENTS.md` §5 の「新しい書き手 → 古い読み手」。
# **「足すなら古い読み手は見ない」が効かない**——**古い読み手の仕事が
# 「全部消すこと」だから**である）。
#
# **前の版に何かをさせない。** **手がかりは STOP そのもの**である——
# **配ったはずの STOP が無いなら、誰かが再開した**（**どの版が消したかも、
# 人が手で消したかも問わない**。**版をまたぐ約束が要らない**）。
#
# **印が要るのは、`exit 3` と見分けるため**である。**上限に達したが配れなかった**とき、
# **STOP は無いのにカウンタは上限**という同じ形になる——**そこで消すと、
# 人を呼ぶべき状態が黙って消える。**
#
# **共有ファイルの有無は合図にしない。** **前の版は `--reset`（対象なし）でも
# `$STATE` を消す**ので、**普通の前進が再開に化ける**——**この作業場のカウンタが
# 他人の前進で消え、分けた意味が無くなる。**
readonly STOPPED_MARK="$common_dir/valence-loop-stopped-$workspace_scope"

# **master と worker は同じカウンタを、同じ周期で書きうる。** 読んでから書くまでを
# 排他しないと、後から書いた側が相手の増分を消す (lost update)。記録が増えないまま
# 周回だけ進むので、**どちらの識別子も上限に届かず第 4 層が効かなくなる**。
# 排他しないほうへ倒れると気づけないので、**取れないときは数えずに失敗する**。
readonly LOCK_WAIT_SEC="${LOOP_STALL_LOCK_WAIT_SEC:-10}"
if ! [[ $LOCK_WAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_STALL_LOCK_WAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
exec 9>"$STATE.lock" || {
  echo "[FAIL] 停止カウンタのロックを作成できません: $STATE.lock" >&2
  exit 2
}
if ! flock -w "$LOCK_WAIT_SEC" 9; then
  echo "[FAIL] 停止カウンタのロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
  echo "       数えずに終わります。記録が飛ぶより止まらないほうが分かりにくいためです" >&2
  exit 2
fi

# 止める対象は **カウンタと同じリポジトリ**。スクリプトの位置から相対で `./task` を
# 引くと、cwd のリポジトリで数えているのに別のリポジトリを止めることになる。
# 実際に踏んだ: 使い捨てのリポジトリで数え方を確かめただけで、実リポジトリの
# master と worker が両方停止した。**検証のたびに本番が止まる形にしない。**
#
# ただし cwd 側の `task` を実行可能だからといって実行してはいけない。`-x` は
# 「Valence のタスクランナーである」ことを何も保証せず、**別のリポジトリが用意した
# 任意のコードを動かす**ことになる。**同じリポジトリのときだけ実行する。**
if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
  echo "[FAIL] 作業ツリーの根を特定できません" >&2
  exit 2
fi
readonly TASK="$toplevel/task"

# スクリプトのあるリポジトリ。cwd 側と同一かを共通ディレクトリで突き合わせる
# (worktree どうしでも共通ディレクトリは一致する)。
# 比較する両側とも物理パスに揃える。片方だけでは同じ問題が残る。
#
# **rev-parse --git-common-dir の返り方は場所で変わる。** 通常のリポジトリでは
# 相対パス (.git / ../.git)、**リンクされた worktree では絶対パス**を返す。
# 両方を通さないと、master (worktree で動く) だけ判定が壊れる。
#
# **`script_dir` は上で決めてある**（上限を決めるより前に要るため）。
script_common_dir=""
if [[ -n $script_dir ]]; then
  if raw_common_dir="$(git -C "$script_dir" rev-parse --git-common-dir 2>/dev/null)" \
    && [[ -n $raw_common_dir ]]; then
    # 相対パスならスクリプトの位置から解決する。絶対パスはそのまま使う。
    [[ $raw_common_dir == /* ]] || raw_common_dir="$script_dir/$raw_common_dir"
    if resolved="$(cd "$raw_common_dir" 2>/dev/null && pwd -P)" && [[ -n $resolved ]]; then
      script_common_dir="$resolved"
    fi
  fi
fi
readonly script_common_dir

# 進捗があった周回は数え直す。これが無いと、同じエラーが 2 回起きたあと何周
# 正常に進んでも、後日の独立した 1 回を「3 周連続」と数えて全ループを止める。
if [[ $ID == "--reset" ]]; then
  # **識別子を渡さなければ、これまでどおり全部消す**（ステップ 5 の
  # 「何であれ状態が動いたら呼ぶ」はそのまま）。
  #
  # **渡されたら、そのぶんだけ消す** (#266)。**前へ進んだ証拠で消えるのは、
  # 前へ進んだぶんだけ**である——**1.1 の打ち切りは `--reset` を通してから呼び直す**ので、
  # **呼び直した先が印ずれで積んだぶんまで、次の周回が消していた**
  # （**count は 1 を超えず、同じ障害が何周続いても人が呼ばれない**）。
  #
  # **記録は既に識別子ごとの行**なので、**残す行を書き戻すだけでよい**
  # ——**カウンタを 1 つに保ったまま解ける**（#239 に触れない）。
  if [[ -z $RESET_ID ]]; then
    # **消すのは、共有と自分の作業場のぶんだけ** (#239)。**他の作業場のカウントは
    # 残す**——**こちらが進んでも、あちらは何も解決していない。**
    rm -f "$STATE" "$LOCAL_STATE"
    echo "stall reset"
    exit 0
  fi
  kept=()
  reset_state="$(state_file "$RESET_ID")"
  if [[ -f $reset_state ]]; then
    while IFS=$'\t' read -r prev_count prev_id prev_id_epoch; do
      [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
      [[ $prev_id == "$RESET_ID" ]] && continue
      kept+=("$prev_count"$'\t'"$prev_id"$'\t'"$prev_id_epoch")
    done < "$reset_state"
  fi
  if ((${#kept[@]} == 0)); then
    rm -f "$reset_state"
  else
    printf '%s\n' "${kept[@]}" > "$reset_state" || {
      echo "[FAIL] カウンタを書き戻せません: $reset_state" >&2
      exit 2
    }
  fi
  echo "stall reset id=$RESET_ID"
  exit 0
fi

# **人が再開したという合図。** `./task loop:resume` が通す。
#
# **第 4 層は「3 周続いたら人を呼ぶ」仕組みだが、呼ばれた人が応えたことを受け取る口が
# 無かった。** `resume` はカウンタを消さないので、**人が判断して再開した直後に、
# 同じ条件でもう 1 回で止まり直す** (今日 6 回。毎回、人が手で `--reset` も打っていた)。
#
# **合図を `resume` にする理由。** STOP は人にしか解けないので、
# **resume は「人が来て判断した」唯一の証拠**である。**識別子ごとに違う痕跡
# (label が変わった / Issue が閉じた) を見に行く形は採らない**——**6 つの見る場所は
# 6 つの腐る場所**で、しかも**見に行けなかったときに黙って数え直す側へ倒れる**。
#
# **「判断した」であって「直った」ではない。** だから**消すのは数だけ**で、
# **同じ状態で再び上限に達すれば、そのときは止まる**——人が何もせず再開しただけなら、
# **これまでどおりの周回数で止まる**。**検出器は消えていない。**
#
# **上限に達していた識別子だけを、繰り返しとして覚える。** そこだけが「人を呼んだ」
# 状態であり、**同じところで何度も止まっていることを、記録から読めるようにする**
# (消すだけだと「1 回目と同じ」に見え、**人が同じ判断を繰り返していることに誰も
# 気づけない**)。
if [[ $ID == "--resumed" ]]; then
  # **全部のカウンタを見る** (#239 のレビュー)。**STOP は全 worktree へ配られ、
  # ここで全部消える**——**カウンタだけ呼び出し元のぶんしか消さないと、止めた当人が
  # 上限のまま残り、次の 1 回で即座に止め直す**（**`cmd_loop_resume` が消しに来た
  # 当のもの**。`AGENTS.md` §5 #184「止める仕組みを入れたら、止まった状態から
  # 出られるかを見る」）。
  #
  # **繰り返しの記録も全作業場から拾う**——**でないと、止めた当人の識別子が履歴に
  # 残らず、「同じところで何度目か」が出せない**（この節の狙いそのもの）。
  #
  # **同じロックの中で行う。** 下の STOP の撤去まで含めて 1 つの区間である。
  resumed_states=("$STATE")
  for resumed_state in "$common_dir"/valence-loop-stall-worker-*; do
    [[ -f $resumed_state ]] || continue
    resumed_states+=("$resumed_state")
  done
  for resumed_state in "${resumed_states[@]}"; do
    [[ -f $resumed_state ]] || continue
    while IFS=$'\t' read -r prev_count prev_id _prev_epoch; do
      [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
      ((10#$prev_count >= MAX_REPEATS)) || continue
      printf '%s\n' "$prev_id" >>"$RESUMED" || {
        echo "[FAIL] 再開の記録を書けません: $RESUMED" >&2
        exit 2
      }
    done < "$resumed_state"
  done
  # **消せなかったら成功を返さない。** `task` は終了コードで判断し、消せなければ
  # STOP を残す（そう約束した）。ここで握りつぶすと、**約束した側が、約束を測る値を
  # 返していない**ことになる。**カウンタが残ったまま STOP が消える**と、
  # **再開直後に 1 周で止まり直す**——#127 の症状が、#127 を直す経路の中に残る。
  #
  # **`rm -f` は「ファイルが無い」では失敗しない**ので、**まだ 1 度も記録していない
  # 状態の resume は、これまでどおり通る**。
  rm -f "${resumed_states[@]}" || {
    echo "[FAIL] 停止カウンタを消せません: ${resumed_states[*]}" >&2
    exit 2
  }
  # **配ったという印も一緒に消す。** **カウンタが無くなった以上、印だけ残しても
  # 何も指していない**（下の推定は「カウンタが上限」と組でしか働かない）。
  rm -f "$common_dir"/valence-loop-stopped-worker-* || {
    echo "[FAIL] 停止の印を消せません: $common_dir/valence-loop-stopped-worker-*" >&2
    exit 2
  }
  echo "stall resumed"
  # **STOP の撤去まで、このロックの中で行う** (#151)。
  #
  # **以前は `./task loop:resume` が、カウンタを消したあとで STOP を消していた。**
  # **順番は正しかったが、ロックの外だった**——**`--resumed` が返ってから削除までの間に
  # 上限へ達した周回が STOP を作ると、その削除がそれを消す**（**止まるべきなのに再開する**）。
  #
  # **上限の下限を検査で縛る形は採らない。** **窓へ入れる周回の数だけ数えられる**ので、
  # **安全な下限は「同時に走るループの数 + 1」**である——**既定の 3 が足りているのは
  # ループが 2 つだから**で、**作業場が増えれば 3 でも届く** (#82)。**値では追えない。**
  #
  # **置き場所は `task` が持っている**（配る側と同じ場所から取る）。**ここで組み立てない**
  # ——**2 箇所に持つと、片方だけ直して食い違う。**
  if [[ -z $script_common_dir || $script_common_dir != "$common_dir" || ! -x $TASK ]]; then
    echo "[FAIL] STOP を消せません（カウンタは消えています）: $TASK" >&2
    echo "       カウンタ: $STATE" >&2
    exit 2
  fi
  # **先に受けて、取れたことを確かめる。** **プロセス置換の終了状態は `while` へ
  # 伝わらない**ので、`done < <(...)` のままだと**取得の失敗が 0 件と区別できない**——
  # **カウンタだけ消えて STOP は残るのに、「STOP は無い」と言って成功で終わる**。
  # **人には再開できたように見え、ループは止まったまま**になる (#189 のレビュー)。
  if ! stop_paths="$("$TASK" loop:stop:paths)"; then
    echo "[FAIL] STOP の置き場所を取得できません（カウンタは消えています）: $TASK" >&2
    echo "       カウンタ: $STATE" >&2
    exit 2
  fi
  resume_found=0
  while read -r stop_path; do
    [[ -f $stop_path ]] || continue
    rm "$stop_path" || {
      echo "[FAIL] STOP を消せません: $stop_path" >&2
      exit 2
    }
    echo "==> 削除: $stop_path"
    resume_found=1
  done <<<"$stop_paths"
  ((resume_found == 1)) || echo "==> STOP は無い（停止していない）"
  exit 0
fi

# **配ったはずの STOP が無いなら、誰かが再開している** (#239 のレビュー 2 周目)。
#
# **前の版から再開されると、この作業場だけが出られない**（印の宣言に書いた形）。
# **前の版に何かをさせるのではなく、こちら側だけで閉じる**——**STOP は人にしか
# 解けない**ので、**配ったのに無いことが、そのまま「人が来た」証拠**になる。
#
# **`--resumed` と同じ扱いにする**（**経路が違うだけで、起きたことは同じ**）——
# **上限に達していた識別子を繰り返しとして覚えてから、この作業場のぶんを消す。**
#
# **読めなければ推定しない。** **別のリポジトリで動いている / `task` が無い /
# 一覧を取れない**ときは、**「STOP は無い」と読まない**——**取れなかったものを
# 0 件と読まない**のは、このリポジトリで繰り返し踏んできた形である。
if [[ -f $STOPPED_MARK ]]; then
  if [[ -z $script_common_dir || $script_common_dir != "$common_dir" || ! -x $TASK ]]; then
    echo "[WARN] STOP の有無を確かめられません（別のリポジトリで実行している）" >&2
  elif ! mark_stop_paths="$("$TASK" loop:stop:paths)"; then
    echo "[WARN] STOP の置き場所を取得できません: $TASK" >&2
  else
    mark_stop_found=0
    mark_stop_listed=0
    while read -r mark_stop_path; do
      [[ -n $mark_stop_path ]] || continue
      mark_stop_listed=$((mark_stop_listed + 1))
      [[ -f $mark_stop_path ]] || continue
      mark_stop_found=1
    done <<<"$mark_stop_paths"
    # **空の一覧を「STOP は無い」と読まない。** **置き場所が 1 つも返らないのは
    # 「見に行けなかった」**のと同じである——**取れなかったものを 0 件と読まない。**
    if ((mark_stop_listed == 0)); then
      echo "[WARN] STOP の置き場所が 1 つも返りません: $TASK" >&2
    elif ((mark_stop_found == 0)); then
      if [[ -f $LOCAL_STATE ]]; then
        while IFS=$'\t' read -r prev_count prev_id _prev_epoch; do
          [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
          ((10#$prev_count >= MAX_REPEATS)) || continue
          printf '%s\n' "$prev_id" >>"$RESUMED" || {
            echo "[FAIL] 再開の記録を書けません: $RESUMED" >&2
            exit 2
          }
        done < "$LOCAL_STATE"
      fi
      rm -f "$LOCAL_STATE" "$STOPPED_MARK" || {
        echo "[FAIL] 停止カウンタを消せません: $LOCAL_STATE" >&2
        exit 2
      }
      echo "==> 配った STOP が無い（誰かが再開した）ので、この作業場のカウンタを消した"
    fi
  fi
fi

# **識別子ごとに数える。** 1 つだけ持って「直前と違えば 1 に戻す」形にすると、
# **カウンタを共有している master と worker が互いの記録を消し合う**。
# 「master は no-work、worker は dirty」で交互に書かれると、どちらも 3 に届かず
# **2 つ動いているというだけで第 4 層が無効になる**。
#
# 前へ進んだ合図は --reset であって、識別子が変わったことではない。
# --reset が来るまでは、どの識別子の記録も消さない。
#
#   <回数><TAB><識別子>  を 1 行ずつ
#
# 書式に合わない行は捨てる (壊れた記録・古い書式で数えない)。
#   <回数><TAB><識別子><TAB><数えたときの worker の周回>  を 1 行ずつ
count=0
others=()
prev_epoch=""
counted_state="$(state_file "$ID")"
if [[ -f $counted_state ]]; then
  while IFS=$'\t' read -r prev_count prev_id prev_id_epoch; do
    [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
    if [[ $prev_id == "$ID" ]]; then
      count="$prev_count"
      prev_epoch="$prev_id_epoch"
    else
      others+=("$prev_count"$'\t'"$prev_id"$'\t'"$prev_id_epoch")
    fi
  done < "$counted_state"
fi

# **識別子ごとに「各 scope の前回時刻」を持つ。** `<scope>=<時刻>` を `,` で並べ、
# **scope 順に揃える**（並びが変わっただけで別物にならないため）。
#
# **前の版は 1 つの数値だった。** 読めない形は「初めて見た」として扱う——
# **記録は版をまたいで共有される**ので、**古い形で数え違えるより 1 周落とすほうが安い**。
snapshot_epochs() {
  local scope out=""
  for scope in $(printf '%s\n' "${!alive_scopes[@]}" | sort); do
    out+="${out:+,}${scope}=${alive_scopes[$scope]}"
  done
  printf '%s' "$out"
}

# **全 scope が、自分の前回より進んだか。** 1 つでも同じ周回の中なら数えない。
#
#   0 = 全部進んだ / 1 = 進んでいない
#   2 = **比べる基準が無い**（前の版が書いた形 / 前回に無かった scope）
#
# **「周回を始めた」と「前回から 1 周終えた」は別**である。**前回に無い scope には
# 基準が無いのだから、終えたとは言えない**——**飛ばすと、入れ替わった直後の作業場が
# 1 周も終えていないのに数が上限へ届く**（第 4 層が、誰も止まっていないのに人を呼ぶ）。
#
# **「読めない」を「進んでいない」と混ぜない。** 混ぜると印が書き換わらないまま
# 同じところへ落ち続け、**その識別子は二度と数えられない**（第 4 層が黙って死ぬ）。
all_scopes_advanced() {
  local previous="$1" pair scope epoch
  declare -A before=()
  local IFS=,
  for pair in $previous; do
    scope="${pair%%=*}"
    epoch="${pair#*=}"
    [[ $scope != "$pair" && $epoch =~ ^[0-9]+$ ]] || return 2
    before["$scope"]="$epoch"
  done
  unset IFS
  for scope in "${!alive_scopes[@]}"; do
    [[ -n ${before[$scope]-} ]] || return 2
    ((alive_scopes[$scope] > before[$scope])) || return 1
  done
  return 0
}

# **worker が解く状態か。** 主体が違うものに worker の周回を効かせない
# （review-unanswered は Codex が返さないので、worker が元気でも解けない）。
worker_fixes_this=0
for kind in "${WORKER_FIXES[@]}"; do
  [[ ${ID%%:*} == "$kind" ]] && worker_fixes_this=1
done

# **周回が動いているか。** **生きている作業場が 1 つでもあれば動いている**——
# **生死はその作業場自身の窓で測ってある**ので、ここで測り直さない。
worker_rounding=0
((${#alive_scopes[@]} > 0)) && worker_rounding=1

counted="yes"
if ((worker_rounding == 1 && worker_fixes_this == 1)); then
  advanced=0
  [[ -n $prev_epoch ]] && { all_scopes_advanced "$prev_epoch" || advanced=$?; }
  if [[ -z $prev_epoch ]] || ((advanced == 2)); then
    # **比べる基準が無い**（この識別子を初めて見た / 前の版が書いた形 /
    # 前回に無かった作業場がいる）。**印だけ覚えて数えない。**
    # 1 周落ちるが、次の周回から数え始められる。
    counted="first"
    prev_epoch="$(snapshot_epochs)"
  elif ((advanced == 0)); then
    count=$((count + 1))
    prev_epoch="$(snapshot_epochs)"
  else
    counted="no"
  fi
else
  count=$((count + 1))
fi

printf '%s\n' "${others[@]}" "$count"$'\t'"$ID"$'\t'"$prev_epoch" > "$counted_state" || {
  echo "[FAIL] 停止カウンタを書き込めません: $counted_state" >&2
  exit 2
}

if [[ $counted == "no" ]]; then
  echo "stall id=$ID count=$count max=$MAX_REPEATS (worker が同じ周回の中なので数えない)"
elif [[ $counted == "first" ]]; then
  echo "stall id=$ID count=$count max=$MAX_REPEATS (worker はこの周回を始めたばかりなので数えない)"
else
  echo "stall id=$ID count=$count max=$MAX_REPEATS"
fi

if ((count >= MAX_REPEATS)); then
  # **同じところで何度も止まっているなら、そう出す。** 人が同じ判断を繰り返している
  # ことに気づける唯一の手がかりになる。
  times=1
  if [[ -f $RESUMED ]]; then
    while IFS= read -r resumed_id; do
      [[ $resumed_id == "$ID" ]] && ((times++))
    done < "$RESUMED"
  fi
  if ((times > 1)); then
    echo "[STOP] 同じ状態が $count 回記録された (間に前進なし)。全ループを止める（この状態で止まるのは ${times} 回目）"
  else
    echo "[STOP] 同じ状態が $count 回記録された (間に前進なし)。全ループを止める"
  fi
  # **止まったかどうかを、終了コードで分ける** (#191 のレビュー)。**読む側が分岐に
  # 使うのはここ**なので、**標準エラーへ書いても分岐は変わらない**——**手順書の
  # 「exit 1 → 全ループが停止済み」が嘘になる。**
  stopped=1
  if [[ -n $script_common_dir && $script_common_dir == "$common_dir" && -x $TASK ]]; then
    # **戻り値を見る** (#190)。**見ないと、止められなかったことが `[STOP]` の後ろに
    # 隠れる**——**人は「止まった、あとで見よう」と読む**。**呼ばれる側を直しても、
    # ここが見ていなければ素通りする。**
    "$TASK" loop:stop "$ID: 同じ状態が $count 回記録されたため停止。人の判断が要る" || {
      # **止まっていないと断定しない** (#191 のレビュー)。**worktree ごとに書くので、
      # 途中で落ちれば「そこまでは止まっている」**——**「どのループも」と言うと、
      # 人は「まだ全部走っている」と読み、止まっている側を放置する。**
      echo "[FAIL] loop:stop が失敗しました。全 worktree を止められていません" >&2
      echo "       一部だけ止まっている場合があります（作成できたものは残ります）" >&2
      echo "       カウンタ: $STATE" >&2
      echo "       止めるには、この作業ツリーで ./task loop:stop を手で叩くこと" >&2
      stopped=3
    }
    # **配れたときだけ印を残す** (#239 のレビュー 2 周目)。**配れなかった側に残すと、
    # 「STOP が無い」が再開と区別できなくなり、人を呼ぶべき状態が黙って消える。**
    #
    # **書けなくても、終了コードは変えない。** **ここが表すのは「止まったかどうか」**
    # で、**止まってはいる**——**別の意味を同じ値に載せると、手順書の
    # 「exit 1 → 全ループが停止済み」が嘘になる**（#191 のレビューと同じ理由）。
    # **落ちたぶんは声に出す**——**次の周回は、前の版から再開されても気づけない。**
    ((stopped == 1)) && { printf '%s\n' "$(date +%s)" >"$STOPPED_MARK" || {
      echo "[FAIL] 停止の印を書けません: $STOPPED_MARK" >&2
      echo "       止まってはいます。前の版から再開されると、この作業場は出られません" >&2
      echo "       再開したら、この作業ツリーで ./task loop:resume を打つこと" >&2
    }; }
  else
    # 黙って何もしないのは、黙って止めるのと同じくらい分かりにくい。
    echo "[FAIL] ループを止められません" >&2
    echo "       カウンタ: $STATE" >&2
    echo "       スクリプト: ${script_common_dir:-不明}" >&2
    echo "       別のリポジトリで実行しているため、そちらの task は実行しません" >&2
    # **こちらも 1 つも止めていない。** 分けると、同じ意味に 2 つの値が残る
    stopped=3
  fi
  exit "$stopped"
fi
exit 0
