#!/usr/bin/env bash
# 停止識別子ごとに記録された回数を数え、上限に達したら全ループを止める。
#
#   bin/loop-stall <停止識別子>
#
# 「同じ状態で 3 周続いたら止める」をモデルの記憶に任せると、セッションを
# またいだ時点で忘れて空転し続ける。**回数はディスクに持つ。**
#
# 記録先は git の共通ディレクトリ配下。worktree をまたいで同じ場所を指すので、
# master と worker が別ツリーにいても同じカウンタを見る。作業ツリーの外なので
# コミットもされない。
#
#   exit 0 = まだ上限に達していない (呼び出し側はそのまま停止してよい)
#   exit 1 = 上限に達した。全ループを止めた
#   exit 2 = 使い方の誤り / 判定不能
#
set -uo pipefail

readonly MAX_REPEATS="${LOOP_MAX_STALL_REPEATS:-3}"

# 停止識別子の正はここ。`.claude/commands/loop-*.md` の判定箇所は、識別子を
# 別途一覧にせずこの表を引く (bin/loop-stall --list)。
#
# 一覧を 2 箇所に持つと、片方だけ直したときに表記がゆれる。数え方は文字列一致
# なので、周回ごとに違う綴りで呼ばれると **別状態として数え直し、3 周続いても
# 止まらない**。空転検出を機械化した意味が消えるため、ここに無い識別子は弾く。
#
#   <識別子の書式>|<どういう場面か>
#
# 書式のプレースホルダはそのまま検査用の正規表現になる (spec_to_regex)。
# 表示と検査が同じ文字列から出るので、片方だけずれることがない。
readonly STOP_IDS=(
  "dirty|worker: 作業ツリーが dirty"
  "main-sync-failed|両方: origin/main への追随に失敗 (worker は main、master は worktree)"
  "wrong-branch:<PR番号>|worker: PR の head ブランチに切り替わっていない"
  "too-many-own-prs:<件数>|worker: 自分の open PR が 2 件以上"
  "local-ci-failed:<PR番号>|worker: ./task check が通らない"
  "implementation-blocked:<Issue番号>|worker: blocked にして人へ渡した (完了条件を満たせない / PR が人手で閉じられた)"
  "publish-failed:<Issue番号>|worker: push / PR 作成に失敗"
  "too-many-ready:<件数>|両方: ready の Issue が 2 件以上ある (着手順が一意に決まらない)"
  "wrong-worktree|master: worker の作業ツリーにいる"
  "pr-lookup-failed|master: open PR の一覧を取得できない"
  "issue-lookup-failed|master: Issue の一覧を取得できない (label を触らずに止める)"
  "gate-misconfigured:<PR番号>|master: bin/loop-gate が exit 2"
  "review-budget-unknown:<PR番号>|master: 3.2 でレビューの判定ができない (予算・一覧の取得)"
  "merge-failed:<PR番号>@<SHA>|master: マージに失敗"
  "review-exhausted:<PR番号>@<SHA>|master: レビュー上限に達し、手直しも上限超え"
  "review-unanswered:<PR番号>@<SHA>|master: レビューが返らず、マージも再要求もできない"
  "blocking-findings:<PR番号>@<SHA>|master: 優先度 1 / 2 の指摘が残っている"
  # 件数を付けない。着手できる状態が 1 つでもあればこの識別子を使わないので、
  # 付けられる数はどれも 0 で、**状態が同じなのに毎回変わる値**にしかならない。
  # blocked だけがある状態もここに含める (人の判断待ちで、ループの中では解けない)。
  "no-work|master: 着手できる作業が無い (open PR も backlog / ready / in-progress も 0 件)"
  # label を外せるのは master だけなので、外し忘れると永久にマージされない。
  # head SHA を入れるので、worker が push した周回は別状態として数え直される。
  "changes-requested:<PR番号>@<SHA>|master: 出した要求が満たされていない (label が外れない)"
  # 件数を付けない。**溜まるほど件数が変わる**ので、付けると連続回数が数え直しになり、
  # 3 周続いても止まらない (`bin/loop-deferred-budget` が件数を出す)。
  "deferred-overflow|master: 外出しした指摘が溜まりすぎている (deferred-finding が上限超え)"
  # label と実態が食い違っている状態。**「送るものが無い」と混ぜない**ために別で数える。
  # PR 番号を入れるので、別の PR で起きたら数え直される。
  "handoff-mismatch:<PR番号>|両方: 未解決スレッドがあるのに changes-requested が無い"
  # 着手中でない Issue を閉じようとする open PR がある状態。**誰が持つべきかは
  # 状態から決められない**ので、人へ渡す（古い記録のほうは自動で解放される）。
  "claim-mismatch:<Issue番号>|master: 着手中でない Issue を閉じる open PR がある"
)

# **worker が動いて解く状態。** 第 4 層の数え方をここだけ変える (下の counted を参照)。
#
# **識別子ごとに主体が違う。** たとえば review-unanswered は「Codex が返さない」ので、
# **worker が元気に別の周回をまわしていても解けない**。「worker が動いているから待つ」と
# 読むのは主体が違うので、**worker が主体のものだけに効かせる**。
#
# **STOP_IDS とは別の軸**なので別に持つ (あちらは「誰が記録するか」で、これは
# 「誰が解くか」)。**綴りがずれると黙って効かなくなる**ので、
# 一覧に無い綴りが混ざっていないことを試験で押さえてある。
readonly WORKER_FIXES=(
  "blocking-findings"
  "changes-requested"
)

usage() {
  echo "使い方: bin/loop-stall <停止識別子>" >&2
  echo "       bin/loop-stall --reset        周回が前へ進んだときに呼ぶ" >&2
  echo "       bin/loop-stall --list         使える識別子を一覧する" >&2
  echo "  識別子は一覧にあるものだけ。書式まで一致しないと受け付けない" >&2
  exit 2
}

# 桁を揃えない。printf の幅指定はバイト数で数えるので、書式に混じる日本語の
# ぶんだけ列がずれ、揃えたつもりの表示が崩れる。
print_stop_ids() {
  local entry
  for entry in "${STOP_IDS[@]}"; do
    printf '%s  —  %s\n' "${entry%%|*}" "${entry#*|}"
  done
}

# 書式を検査用の正規表現へ変換する。未知のプレースホルダが残ったら失敗させる。
# 置換し損ねた `<...>` をそのまま正規表現にすると、意図しない文字列まで通る。
spec_to_regex() {
  local re="$1"
  # 置換文字列を直書きしない。`}` が ${...} を閉じてしまい、余った `}` が
  # 正規表現の末尾に残る (どの識別子にも一致しなくなる)。
  local sha_re='[0-9a-f]{7,40}'
  re="${re//<PR番号>/[0-9]+}"
  re="${re//<Issue番号>/[0-9]+}"
  re="${re//<件数>/[0-9]+}"
  re="${re//<SHA>/$sha_re}"
  [[ $re == *"<"* || $re == *">"* ]] && return 1
  printf '%s' "$re"
}

id_is_known() {
  local entry spec re
  for entry in "${STOP_IDS[@]}"; do
    spec="${entry%%|*}"
    if ! re="$(spec_to_regex "$spec")"; then
      echo "[FAIL] 内部エラー: 識別子の書式を検査できません: $spec" >&2
      exit 2
    fi
    # $re はパターンとして展開させる。ここを引用符で囲むとリテラル一致になる。
    [[ $1 =~ ^$re$ ]] && return 0
  done
  return 1
}

[[ $# -eq 1 ]] || usage
readonly ID="$1"

if [[ $ID == "--list" ]]; then
  print_stop_ids
  exit 0
fi

# 識別子はファイル名の一部にしないが、制御文字や改行が混ざるものは受けない。
[[ $ID == "--reset" ]] || [[ $ID =~ ^[A-Za-z0-9:@._/-]+$ ]] || {
  echo "[FAIL] 識別子に使えない文字が含まれています (bin/loop-stall --list)" >&2
  exit 2
}

# 綴りの検査はカウンタを触る前に行う。ゆれた識別子で 1 度でも書き込むと、
# そこで連続回数が切れてしまう。
if [[ $ID != "--reset" ]] && ! id_is_known "$ID"; then
  echo "[FAIL] 未知の停止識別子: $ID" >&2
  echo "       使えるのは次のものだけ:" >&2
  print_stop_ids | sed 's/^/       /' >&2
  exit 2
fi

if ! [[ $MAX_REPEATS =~ ^[0-9]+$ ]] || ((MAX_REPEATS < 1)); then
  echo "[FAIL] 設定: LOOP_MAX_STALL_REPEATS は 1 以上の整数で指定してください" >&2
  exit 2
fi

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
# --git-common-dir は worktree からだと相対パスを返すことがある。
# **物理パス (pwd -P) で解決する。** 既定の pwd はシンボリックリンクを保った論理パスを
# 返すので、同じ .git でも到達経路が違うだけで文字列が一致しなくなる。
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
readonly STATE="$common_dir/valence-loop-stall"

# **master と worker は同じカウンタを、同じ周期で書きうる。** 読んでから書くまでを
# 排他しないと、後から書いた側が相手の増分を消す (lost update)。記録が増えないまま
# 周回だけ進むので、**どちらの識別子も上限に届かず第 4 層が効かなくなる**。
# 排他しないほうへ倒れると気づけないので、**取れないときは数えずに失敗する**。
readonly LOCK_WAIT_SEC="${LOOP_STALL_LOCK_WAIT_SEC:-10}"
if ! [[ $LOCK_WAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_STALL_LOCK_WAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
exec 9>"$STATE.lock" || {
  echo "[FAIL] 停止カウンタのロックを作成できません: $STATE.lock" >&2
  exit 2
}
if ! flock -w "$LOCK_WAIT_SEC" 9; then
  echo "[FAIL] 停止カウンタのロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
  echo "       数えずに終わります。記録が飛ぶより止まらないほうが分かりにくいためです" >&2
  exit 2
fi

# 止める対象は **カウンタと同じリポジトリ**。スクリプトの位置から相対で `./task` を
# 引くと、cwd のリポジトリで数えているのに別のリポジトリを止めることになる。
# 実際に踏んだ: 使い捨てのリポジトリで数え方を確かめただけで、実リポジトリの
# master と worker が両方停止した。**検証のたびに本番が止まる形にしない。**
#
# ただし cwd 側の `task` を実行可能だからといって実行してはいけない。`-x` は
# 「Valence のタスクランナーである」ことを何も保証せず、**別のリポジトリが用意した
# 任意のコードを動かす**ことになる。**同じリポジトリのときだけ実行する。**
if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
  echo "[FAIL] 作業ツリーの根を特定できません" >&2
  exit 2
fi
readonly TASK="$toplevel/task"

# スクリプトのあるリポジトリ。cwd 側と同一かを共通ディレクトリで突き合わせる
# (worktree どうしでも共通ディレクトリは一致する)。
# 比較する両側とも物理パスに揃える。片方だけでは同じ問題が残る。
#
# **rev-parse --git-common-dir の返り方は場所で変わる。** 通常のリポジトリでは
# 相対パス (.git / ../.git)、**リンクされた worktree では絶対パス**を返す。
# 両方を通さないと、master (worktree で動く) だけ判定が壊れる。
#
# 失敗した代入で変数を壊さない。`var="$(cmd)"` は cmd が失敗しても空を代入するので、
# それをフォールバックの入力に使うと `cd ""` になる。**これは成功して cwd を返す**ため、
# 「同じリポジトリの worktree」が「別のリポジトリ」に化ける。実際に踏んだ。
script_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)" || script_dir=""
script_common_dir=""
if [[ -n $script_dir ]]; then
  if raw_common_dir="$(git -C "$script_dir" rev-parse --git-common-dir 2>/dev/null)" \
    && [[ -n $raw_common_dir ]]; then
    # 相対パスならスクリプトの位置から解決する。絶対パスはそのまま使う。
    [[ $raw_common_dir == /* ]] || raw_common_dir="$script_dir/$raw_common_dir"
    if resolved="$(cd "$raw_common_dir" 2>/dev/null && pwd -P)" && [[ -n $resolved ]]; then
      script_common_dir="$resolved"
    fi
  fi
fi
readonly script_common_dir

# 進捗があった周回は数え直す。これが無いと、同じエラーが 2 回起きたあと何周
# 正常に進んでも、後日の独立した 1 回を「3 周連続」と数えて全ループを止める。
if [[ $ID == "--reset" ]]; then
  rm -f "$STATE"
  echo "stall reset"
  exit 0
fi

# **識別子ごとに数える。** 1 つだけ持って「直前と違えば 1 に戻す」形にすると、
# **カウンタを共有している master と worker が互いの記録を消し合う**。
# 「master は no-work、worker は dirty」で交互に書かれると、どちらも 3 に届かず
# **2 つ動いているというだけで第 4 層が無効になる**。
#
# 前へ進んだ合図は --reset であって、識別子が変わったことではない。
# --reset が来るまでは、どの識別子の記録も消さない。
#
#   <回数><TAB><識別子>  を 1 行ずつ
#
# 書式に合わない行は捨てる (壊れた記録・古い書式で数えない)。
#   <回数><TAB><識別子><TAB><数えたときの worker の周回>  を 1 行ずつ
count=0
others=()
prev_epoch=""
if [[ -f $STATE ]]; then
  while IFS=$'\t' read -r prev_count prev_id prev_id_epoch; do
    [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
    if [[ $prev_id == "$ID" ]]; then
      count="$prev_count"
      prev_epoch="$prev_id_epoch"
    else
      others+=("$prev_count"$'\t'"$prev_id"$'\t'"$prev_id_epoch")
    fi
  done < "$STATE"
fi

# **数える単位を「相手の周回」にする。**
#
# 第 4 層は master の周回で数えるが、**前へ進めるのは worker の周回**である。
# master は 7〜10 分ごと、**worker の 1 周は 40〜60 分**。同じ状態を 3 回見るのに
# 21〜30 分しかかからないので、**指摘の修正に master 3 周ぶんかかる作業は必ず止まる**
# (実測で 5 回。5 回とも worker は 1 周も終えておらず、5 回とも人が手で再開した)。
# **難しい指摘ほど踏む**——レビューが良い仕事をするほど罰される (#126 と同じ逆相関)。
#
# **worker が生きているあいだは、worker が 1 周を始めるたびに 1 回だけ数える。**
#
#   worker が生きている … 活動の記録が期限内 (bin/loop-lease が持つ値。書き写さない)
#   worker の周回       … lease の取得時刻。**取り直すたびに変わる**
#
# **心拍を「前へ進んだ」と読まない。** 生きているだけで永久に猶予すると、
# `./task` を叩き続けるだけの周回が通ってしまう。**3 周まわしても変わらなければ止める。**
#
# **黙ったらこれまでどおり数える。** worker が死んだときにカウンタが進まなくなるのは
# 危険側の穴なので、**活動が期限切れなら master の周回で数える**。
# **記録が無い場合も同じ**——知らない状態を「作業中」に倒さない。
#
# **worker の作業ツリーは読まない。** 見るのは worker 自身が git の共通ディレクトリへ
# 書いた記録だけである。master が相手の作業場を覗く形にすると、
# 「GitHub を唯一の正とする」という設計に穴が開く。
worker_epoch=""
worker_alive=0
if [[ -n $script_dir && -x "$script_dir/loop-lease" ]] \
  && lease_ttl="$("$script_dir/loop-lease" ttl 2>/dev/null)" \
  && [[ $lease_ttl =~ ^[0-9]+$ ]]; then
  newest_activity=0
  for activity in "$common_dir"/valence-loop-activity-worker*; do
    [[ -f $activity ]] || continue
    read -r seen <"$activity" 2>/dev/null || continue
    [[ $seen =~ ^[0-9]+$ ]] || continue
    ((seen > newest_activity)) && newest_activity="$seen"
  done
  if ((newest_activity > 0)) && (($(date +%s) - newest_activity < lease_ttl)); then
    worker_alive=1
    # **始めた周回の印。** lease と違って返しても消えないので、
    # **周回と周回の間でも「どの周回まで始めたか」が読める**。
    for rounds in "$common_dir"/valence-loop-rounds-worker*; do
      [[ -f $rounds ]] || continue
      read -r started <"$rounds" 2>/dev/null || continue
      [[ $started =~ ^[0-9]+$ ]] || continue
      [[ -z $worker_epoch ]] || ((started > worker_epoch)) && worker_epoch="$started"
    done
  fi
fi

# **worker が解く状態か。** 主体が違うものに worker の生死を効かせない。
worker_fixes_this=0
for kind in "${WORKER_FIXES[@]}"; do
  [[ ${ID%%:*} == "$kind" ]] && worker_fixes_this=1
done

# **数えるのは「周回が変わったか」であって「いま持っているか」ではない。**
# lease は返すと消えるので、それを見ていると **周回と周回の間が「始めていない」と
# 同じ見え方**になり、**何周まわしても数えられない**（実際にそう書いて指摘された）。
# 印は返しても消えない (bin/loop-lease の ROUNDS)。
#
# **最初に見た周回は数えない。** 数えたいのは「**1 周終えても変わらなかった**」なので、
# **始まったばかりの周回を 1 と数えると、上限に達するのが 1 周早くなる**——
# **worker が上限ぶんの周回を試せる**ようにする。
#
# **印が無ければ数える。** 書けなかったとき (bin/loop-lease は印を書けなくても lease は
# 渡す) や、**この仕組みが入った直後**——活動の記録はあるのに印はまだ無い——に
# 数えないほうへ倒すと、**第 4 層が黙って死ぬ**。「分からない」は「数える」へ倒す。
counted="yes"
if ((worker_alive == 1 && worker_fixes_this == 1)) && [[ -n $worker_epoch ]]; then
  if [[ $worker_epoch == "$prev_epoch" ]]; then
    counted="no"
  elif [[ -z $prev_epoch ]]; then
    # この識別子を、この周回で初めて見た。**印だけ覚えて数えない。**
    counted="first"
    prev_epoch="$worker_epoch"
  else
    count=$((count + 1))
    prev_epoch="$worker_epoch"
  fi
else
  count=$((count + 1))
fi

printf '%s\n' "${others[@]}" "$count"$'\t'"$ID"$'\t'"$prev_epoch" > "$STATE" || {
  echo "[FAIL] 停止カウンタを書き込めません: $STATE" >&2
  exit 2
}

if [[ $counted == "no" ]]; then
  echo "stall id=$ID count=$count max=$MAX_REPEATS (worker が同じ周回の中なので数えない)"
elif [[ $counted == "first" ]]; then
  echo "stall id=$ID count=$count max=$MAX_REPEATS (worker はこの周回を始めたばかりなので数えない)"
else
  echo "stall id=$ID count=$count max=$MAX_REPEATS"
fi

if ((count >= MAX_REPEATS)); then
  echo "[STOP] 同じ状態が $count 回記録された (間に前進なし)。全ループを止める"
  if [[ -n $script_common_dir && $script_common_dir == "$common_dir" && -x $TASK ]]; then
    "$TASK" loop:stop "$ID: 同じ状態が $count 回記録されたため停止。人の判断が要る"
  else
    # 黙って何もしないのは、黙って止めるのと同じくらい分かりにくい。
    echo "[FAIL] ループを止められません" >&2
    echo "       カウンタ: $STATE" >&2
    echo "       スクリプト: ${script_common_dir:-不明}" >&2
    echo "       別のリポジトリで実行しているため、そちらの task は実行しません" >&2
  fi
  exit 1
fi
exit 0
