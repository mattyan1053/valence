#!/usr/bin/env bash
# 停止識別子ごとに記録された回数を数え、上限に達したら全ループを止める。
#
#   bin/loop-stall <停止識別子>
#
# 「同じ状態で 3 周続いたら止める」をモデルの記憶に任せると、セッションを
# またいだ時点で忘れて空転し続ける。**回数はディスクに持つ。**
#
# 記録先は git の共通ディレクトリ配下。worktree をまたいで同じ場所を指すので、
# master と worker が別ツリーにいても同じカウンタを見る。作業ツリーの外なので
# コミットもされない。
#
#   exit 0 = まだ上限に達していない (呼び出し側はそのまま停止してよい)
#   exit 1 = 上限に達した。全ループを止めた
#   exit 2 = 使い方の誤り / 判定不能
#
set -uo pipefail

readonly MAX_REPEATS="${LOOP_MAX_STALL_REPEATS:-3}"

# 停止識別子の正はここ。`.claude/commands/loop-*.md` の判定箇所は、識別子を
# 別途一覧にせずこの表を引く (bin/loop-stall --list)。
#
# 一覧を 2 箇所に持つと、片方だけ直したときに表記がゆれる。数え方は文字列一致
# なので、周回ごとに違う綴りで呼ばれると **別状態として数え直し、3 周続いても
# 止まらない**。空転検出を機械化した意味が消えるため、ここに無い識別子は弾く。
#
#   <識別子の書式>|<どういう場面か>
#
# 書式のプレースホルダはそのまま検査用の正規表現になる (spec_to_regex)。
# 表示と検査が同じ文字列から出るので、片方だけずれることがない。
readonly STOP_IDS=(
  "dirty|worker: 作業ツリーが dirty"
  "main-sync-failed|両方: origin/main への追随に失敗 (どちらも origin/main へ detach する)"
  "wrong-branch:<PR番号>|worker: PR の head ブランチに切り替わっていない"
  "too-many-own-prs:<件数>|worker: 自分の open PR が 2 件以上"
  "local-ci-failed:<PR番号>|worker: ./task check が通らない"
  # **「分からない」を「赤」と混ぜない** (#147)。`./task check` が途中で殺されると
  # **終了コードが取れないまま、出力だけが緑に見える**——**通らなかった**のではなく
  # **合否が分からない**状態である。
  #
  # **押し通してよいが、記録は残す。** 3 周続くなら**この機械では `./task check` が
  # 実行制限に収まらない**ということで、**人の判断が要る**（避ける方向は #131 / #133）。
  # **PR より前に起きる**ので Issue 番号で数える。
  "local-ci-unknown:<Issue番号>|worker: ./task check の合否が分からない (途中で殺された)"
  "implementation-blocked:<Issue番号>|worker: blocked にして人へ渡した (完了条件を満たせない / PR が人手で閉じられた)"
  "publish-failed:<Issue番号>|worker: push / PR 作成に失敗"
  "too-many-ready:<件数>|両方: ready の Issue が 2 件以上ある (着手順が一意に決まらない)"
  "wrong-worktree|master: worker の作業ツリーにいる"
  # **どちらの役も打つ。** 「一覧の失敗を 0 件として読む」は master 側で 4 箇所直したが、
  # **worker の手順には残っていた** (#136)。**同じ状態には同じ名前**なので分けない
  # (#128)——**主体ではなく状態で名前を決める**。
  #
  # **両方が同時に失敗するのは、実際に GitHub が落ちているとき**である。
  # そのとき**早く 3 周へ届く**のは正しい向きで、**どちらのループも進めない**。
  "pr-lookup-failed|両方: open PR の一覧を取得できない"
  "issue-lookup-failed|両方: Issue の一覧やコメントを読み取れない (label を触らずに止める)"
  "gate-misconfigured:<PR番号>|master: bin/loop-gate が exit 2"
  "review-budget-unknown:<PR番号>|master: 3.2 でレビューの判定ができない (予算・一覧の取得)"
  "merge-failed:<PR番号>@<SHA>|master: マージに失敗"
  "review-exhausted:<PR番号>@<SHA>|master: 人の判断待ち (レビュー上限に達し手直しも上限超え / 保留にできなかった)"
  "review-unanswered:<PR番号>@<SHA>|master: レビューが返らず、マージも再要求もできない"
  # **1 つの状態に 1 つの名前。** 以前は「優先度 1 / 2 の指摘が残っている」と
  # 「出した要求が満たされていない」を別の名前で数えていたが、**どちらも
  # 「worker の対応を待っている」**である。**`changes-requested` が付いているかは、
  # 待っている状態の性質ではなく、master がその周回までに何をしたか**なので、
  # **label を付けた瞬間に同じ膠着が別の名前になり、カウンタが割れた**（#128。実測）。
  # **第 4 層は文字列一致で数える**ので、割れると**3 周に届かず沈黙する**。
  #
  # **選び方を決めるのではなく、名前を 1 つにした。** 選び方を自動化しても
  # **選ぶ対象が 2 つあることは変わらず**、**master の操作で名前が変わる余地が残る**。
  # head SHA は残す——**変われば前へ進んだ**を表す値なので、変わってよい。
  "awaiting-worker:<PR番号>@<SHA>|master: worker の対応を待っている (指摘が残っている / 出した要求が満たされていない)"
  # 件数を付けない。着手できる状態が 1 つでもあればこの識別子を使わないので、
  # 付けられる数はどれも 0 で、**状態が同じなのに毎回変わる値**にしかならない。
  # blocked だけがある状態もここに含める (人の判断待ちで、ループの中では解けない)。
  # **push されたのに PR が無いブランチ** (#148)。**ループでは救うか捨てるかを
  # 判定できない**ので**人へ渡す**——**自動で消さない**（中身が要るかもしれない）。
  #
  # **消し残り（終わった PR のブランチ）はここで数えない。** そちらは**掃除してよい**もので、
  # **master がその周回で消せる**——**同じ名前にすると、消せるものが人を呼ぶ**。
  #
  # **ブランチ名を入れる。** 別のブランチで起きたら数え直すのが正しく、
  # **名前は状態が同じなら変わらない**（時刻のように毎回変わる値ではない）。
  "stray-branch:<ブランチ>|master: push されたのに PR が無いブランチがある (人へ渡す)"
  "no-work|master: 着手できる作業が無い (open PR も backlog / ready / in-progress も 0 件)"
  # 件数を付けない。**溜まるほど件数が変わる**ので、付けると連続回数が数え直しになり、
  # 3 周続いても止まらない (`bin/loop-deferred-budget` が件数を出す)。
  "deferred-overflow|master: 外出しした指摘が溜まりすぎている (deferred-finding が上限超え)"
  # **周回の途中で head が動いた状態**（`bin/loop-head same` の exit 1）。
  # **その周回の判断は記録しない**（評価したのは、もう head ではない commit）。
  #
  # **head SHA を付けない。** ずれるたびに評価した head は違うので、付けると
  # **毎回別状態として数え直され、3 周に届かない**。**ここで数えたいのは
  # 「同じ PR で、ずれが続いていること」**——worker が push し続ける間 master が
  # 判断できない状態は、3 周続いたら人を呼ぶ側に置く。
  "head-moved:<PR番号>|master: 周回の途中で PR の head が動いた (worker の push)"
  # **head を読めない状態**（`bin/loop-head same` の exit 2）。**上と分けてある。**
  #
  # **主体が違う。** 動かすのは worker だが、**読めない原因は gh / 認証 / GitHub** で、
  # **worker の push では解けない**。**同じ名前にまとめて `WORKER_FIXES` へ入れると、
  # worker が元気な間ずっと数えられない** (#145 のレビュー 2 周目。実際にそうしていた)。
  # **#128 は「同じ状態には同じ名前」だったが、これは逆に「違う状態には違う名前」**である。
  "head-lookup-failed:<PR番号>|master: PR の head を読み取れない (gh / 認証 / GitHub。worker では解けない)"
  # label と実態が食い違っている状態。**「送るものが無い」と混ぜない**ために別で数える。
  # PR 番号を入れるので、別の PR で起きたら数え直される。
  "handoff-mismatch:<PR番号>|両方: 未解決スレッドがあるのに changes-requested が無い"
  # 着手中でない Issue を閉じようとする open PR がある状態。**誰が持つべきかは
  # 状態から決められない**ので、人へ渡す（古い記録のほうは自動で解放される）。
  "claim-mismatch:<Issue番号>|master: 着手中でない Issue を閉じる open PR がある"
)

# **worker が動いて解く状態。** 第 4 層の数え方をここだけ変える (下の counted を参照)。
#
# **識別子ごとに主体が違う。** たとえば review-unanswered は「Codex が返さない」ので、
# **worker が元気に別の周回をまわしていても解けない**。「worker が動いているから待つ」と
# 読むのは主体が違うので、**worker が主体のものだけに効かせる**。
#
# **STOP_IDS とは別の軸**なので別に持つ (あちらは「誰が記録するか」で、これは
# 「誰が解くか」)。**綴りがずれると黙って効かなくなる**ので、
# 一覧に無い綴りが混ざっていないことを試験で押さえてある。
readonly WORKER_FIXES=(
  "awaiting-worker"
  # **head が動く原因は、worker が push したことである** (#145)。つまり
  # **この停止が起きているとき、worker はほぼ必ず動いている**——
  # **master の周回ごとに数えると、worker が元気に push している間に 3 周で止まる**。
  # **狙いは保たれる**: worker の周回ごとに 1 ずつ数えるので、
  # **push し続ける間 master が判断できない**なら 3 周で人を呼ぶ。
  #
  # **`head-lookup-failed` は入れない。** そちらは gh / 認証 / GitHub が主体で、
  # **worker が何周まわしても解けない** (`review-unanswered` と同じ側)。
  "head-moved"
)

usage() {
  echo "使い方: bin/loop-stall <停止識別子>" >&2
  echo "       bin/loop-stall --reset        周回が前へ進んだときに呼ぶ" >&2
  echo "       bin/loop-stall --resumed      人が再開したときに呼ぶ（./task loop:resume が通す）" >&2
  echo "       bin/loop-stall --list         使える識別子を一覧する" >&2
  echo "  識別子は一覧にあるものだけ。書式まで一致しないと受け付けない" >&2
  exit 2
}

# 桁を揃えない。printf の幅指定はバイト数で数えるので、書式に混じる日本語の
# ぶんだけ列がずれ、揃えたつもりの表示が崩れる。
print_stop_ids() {
  local entry
  for entry in "${STOP_IDS[@]}"; do
    printf '%s  —  %s\n' "${entry%%|*}" "${entry#*|}"
  done
}

# 書式を検査用の正規表現へ変換する。未知のプレースホルダが残ったら失敗させる。
# 置換し損ねた `<...>` をそのまま正規表現にすると、意図しない文字列まで通る。
spec_to_regex() {
  local re="$1"
  # 置換文字列を直書きしない。`}` が ${...} を閉じてしまい、余った `}` が
  # 正規表現の末尾に残る (どの識別子にも一致しなくなる)。
  local sha_re='[0-9a-f]{7,40}'
  re="${re//<PR番号>/[0-9]+}"
  re="${re//<Issue番号>/[0-9]+}"
  re="${re//<件数>/[0-9]+}"
  re="${re//<SHA>/$sha_re}"
  # ブランチ名。**`/` も `.` も入る**（`feat/x.y`）。**空白は入らない**ので、
  # **空白以外の 1 文字以上**で受ける（**`<` `>` は git が禁じている**）。
  re="${re//<ブランチ>/[^[:space:]]+}"
  [[ $re == *"<"* || $re == *">"* ]] && return 1
  printf '%s' "$re"
}

id_is_known() {
  local entry spec re
  for entry in "${STOP_IDS[@]}"; do
    spec="${entry%%|*}"
    if ! re="$(spec_to_regex "$spec")"; then
      echo "[FAIL] 内部エラー: 識別子の書式を検査できません: $spec" >&2
      exit 2
    fi
    # $re はパターンとして展開させる。ここを引用符で囲むとリテラル一致になる。
    [[ $1 =~ ^$re$ ]] && return 0
  done
  return 1
}

[[ $# -eq 1 ]] || usage
readonly ID="$1"

if [[ $ID == "--list" ]]; then
  print_stop_ids
  exit 0
fi

# 識別子はファイル名の一部にしないが、**制御文字・改行・空白**が混ざるものは受けない
# (記録は**タブ区切りの行**なので、混ざると列が壊れる)。
#
# **許す文字を並べない。** 並べると**同じファイルの中で 2 つの検査が違う幅を見る**ことに
# なり、**内側 (書式の `<ブランチ>`) を広げても外側が先に立って弾く** (#148 のレビュー)。
# **`feat/a+b` は git が受け付けるのに記録できず**、**見つけたのに人へ渡らない**——
# **`exit 2` は「記録できていない」なので 3 周の経路にも乗らない**。
#
# **目的をそのまま書く。** git も**空白と制御文字を含む ref 名は受け付けない**ので、
# **git が通す名前はここも通る**。
[[ $ID == "--reset" || $ID == "--resumed" ]] || [[ $ID =~ ^[^[:cntrl:][:space:]]+$ ]] || {
  echo "[FAIL] 識別子に使えない文字が含まれています (bin/loop-stall --list)" >&2
  exit 2
}

# 綴りの検査はカウンタを触る前に行う。ゆれた識別子で 1 度でも書き込むと、
# そこで連続回数が切れてしまう。
if [[ $ID != "--reset" && $ID != "--resumed" ]] && ! id_is_known "$ID"; then
  echo "[FAIL] 未知の停止識別子: $ID" >&2
  echo "       使えるのは次のものだけ:" >&2
  print_stop_ids | sed 's/^/       /' >&2
  exit 2
fi

if ! [[ $MAX_REPEATS =~ ^[0-9]+$ ]] || ((MAX_REPEATS < 1)); then
  echo "[FAIL] 設定: LOOP_MAX_STALL_REPEATS は 1 以上の整数で指定してください" >&2
  exit 2
fi

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
# --git-common-dir は worktree からだと相対パスを返すことがある。
# **物理パス (pwd -P) で解決する。** 既定の pwd はシンボリックリンクを保った論理パスを
# 返すので、同じ .git でも到達経路が違うだけで文字列が一致しなくなる。
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
readonly STATE="$common_dir/valence-loop-stall"
# **人が再開したときに、上限へ達していた識別子を積む。** 「同じところで何度目か」を
# 出すためのもので、**カウンタとは別に持つ**（--reset で消えると、繰り返しが見えなくなる）。
readonly RESUMED="$common_dir/valence-loop-resumed"

# **master と worker は同じカウンタを、同じ周期で書きうる。** 読んでから書くまでを
# 排他しないと、後から書いた側が相手の増分を消す (lost update)。記録が増えないまま
# 周回だけ進むので、**どちらの識別子も上限に届かず第 4 層が効かなくなる**。
# 排他しないほうへ倒れると気づけないので、**取れないときは数えずに失敗する**。
readonly LOCK_WAIT_SEC="${LOOP_STALL_LOCK_WAIT_SEC:-10}"
if ! [[ $LOCK_WAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_STALL_LOCK_WAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
exec 9>"$STATE.lock" || {
  echo "[FAIL] 停止カウンタのロックを作成できません: $STATE.lock" >&2
  exit 2
}
if ! flock -w "$LOCK_WAIT_SEC" 9; then
  echo "[FAIL] 停止カウンタのロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
  echo "       数えずに終わります。記録が飛ぶより止まらないほうが分かりにくいためです" >&2
  exit 2
fi

# 止める対象は **カウンタと同じリポジトリ**。スクリプトの位置から相対で `./task` を
# 引くと、cwd のリポジトリで数えているのに別のリポジトリを止めることになる。
# 実際に踏んだ: 使い捨てのリポジトリで数え方を確かめただけで、実リポジトリの
# master と worker が両方停止した。**検証のたびに本番が止まる形にしない。**
#
# ただし cwd 側の `task` を実行可能だからといって実行してはいけない。`-x` は
# 「Valence のタスクランナーである」ことを何も保証せず、**別のリポジトリが用意した
# 任意のコードを動かす**ことになる。**同じリポジトリのときだけ実行する。**
if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
  echo "[FAIL] 作業ツリーの根を特定できません" >&2
  exit 2
fi
readonly TASK="$toplevel/task"

# スクリプトのあるリポジトリ。cwd 側と同一かを共通ディレクトリで突き合わせる
# (worktree どうしでも共通ディレクトリは一致する)。
# 比較する両側とも物理パスに揃える。片方だけでは同じ問題が残る。
#
# **rev-parse --git-common-dir の返り方は場所で変わる。** 通常のリポジトリでは
# 相対パス (.git / ../.git)、**リンクされた worktree では絶対パス**を返す。
# 両方を通さないと、master (worktree で動く) だけ判定が壊れる。
#
# 失敗した代入で変数を壊さない。`var="$(cmd)"` は cmd が失敗しても空を代入するので、
# それをフォールバックの入力に使うと `cd ""` になる。**これは成功して cwd を返す**ため、
# 「同じリポジトリの worktree」が「別のリポジトリ」に化ける。実際に踏んだ。
script_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)" || script_dir=""
script_common_dir=""
if [[ -n $script_dir ]]; then
  if raw_common_dir="$(git -C "$script_dir" rev-parse --git-common-dir 2>/dev/null)" \
    && [[ -n $raw_common_dir ]]; then
    # 相対パスならスクリプトの位置から解決する。絶対パスはそのまま使う。
    [[ $raw_common_dir == /* ]] || raw_common_dir="$script_dir/$raw_common_dir"
    if resolved="$(cd "$raw_common_dir" 2>/dev/null && pwd -P)" && [[ -n $resolved ]]; then
      script_common_dir="$resolved"
    fi
  fi
fi
readonly script_common_dir

# 進捗があった周回は数え直す。これが無いと、同じエラーが 2 回起きたあと何周
# 正常に進んでも、後日の独立した 1 回を「3 周連続」と数えて全ループを止める。
if [[ $ID == "--reset" ]]; then
  rm -f "$STATE"
  echo "stall reset"
  exit 0
fi

# **人が再開したという合図。** `./task loop:resume` が通す。
#
# **第 4 層は「3 周続いたら人を呼ぶ」仕組みだが、呼ばれた人が応えたことを受け取る口が
# 無かった。** `resume` はカウンタを消さないので、**人が判断して再開した直後に、
# 同じ条件でもう 1 回で止まり直す** (今日 6 回。毎回、人が手で `--reset` も打っていた)。
#
# **合図を `resume` にする理由。** STOP は人にしか解けないので、
# **resume は「人が来て判断した」唯一の証拠**である。**識別子ごとに違う痕跡
# (label が変わった / Issue が閉じた) を見に行く形は採らない**——**6 つの見る場所は
# 6 つの腐る場所**で、しかも**見に行けなかったときに黙って数え直す側へ倒れる**。
#
# **「判断した」であって「直った」ではない。** だから**消すのは数だけ**で、
# **同じ状態で再び上限に達すれば、そのときは止まる**——人が何もせず再開しただけなら、
# **これまでどおりの周回数で止まる**。**検出器は消えていない。**
#
# **上限に達していた識別子だけを、繰り返しとして覚える。** そこだけが「人を呼んだ」
# 状態であり、**同じところで何度も止まっていることを、記録から読めるようにする**
# (消すだけだと「1 回目と同じ」に見え、**人が同じ判断を繰り返していることに誰も
# 気づけない**)。
if [[ $ID == "--resumed" ]]; then
  if [[ -f $STATE ]]; then
    while IFS=$'\t' read -r prev_count prev_id _prev_epoch; do
      [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
      ((10#$prev_count >= MAX_REPEATS)) || continue
      printf '%s\n' "$prev_id" >>"$RESUMED" || {
        echo "[FAIL] 再開の記録を書けません: $RESUMED" >&2
        exit 2
      }
    done < "$STATE"
  fi
  # **消せなかったら成功を返さない。** `task` は終了コードで判断し、消せなければ
  # STOP を残す（そう約束した）。ここで握りつぶすと、**約束した側が、約束を測る値を
  # 返していない**ことになる。**カウンタが残ったまま STOP が消える**と、
  # **再開直後に 1 周で止まり直す**——#127 の症状が、#127 を直す経路の中に残る。
  #
  # **`rm -f` は「ファイルが無い」では失敗しない**ので、**まだ 1 度も記録していない
  # 状態の resume は、これまでどおり通る**。
  rm -f "$STATE" || {
    echo "[FAIL] 停止カウンタを消せません: $STATE" >&2
    exit 2
  }
  echo "stall resumed"
  # **STOP の撤去まで、このロックの中で行う** (#151)。
  #
  # **以前は `./task loop:resume` が、カウンタを消したあとで STOP を消していた。**
  # **順番は正しかったが、ロックの外だった**——**`--resumed` が返ってから削除までの間に
  # 上限へ達した周回が STOP を作ると、その削除がそれを消す**（**止まるべきなのに再開する**）。
  #
  # **上限の下限を検査で縛る形は採らない。** **窓へ入れる周回の数だけ数えられる**ので、
  # **安全な下限は「同時に走るループの数 + 1」**である——**既定の 3 が足りているのは
  # ループが 2 つだから**で、**作業場が増えれば 3 でも届く** (#82)。**値では追えない。**
  #
  # **置き場所は `task` が持っている**（配る側と同じ場所から取る）。**ここで組み立てない**
  # ——**2 箇所に持つと、片方だけ直して食い違う。**
  if [[ -z $script_common_dir || $script_common_dir != "$common_dir" || ! -x $TASK ]]; then
    echo "[FAIL] STOP を消せません（カウンタは消えています）: $TASK" >&2
    echo "       カウンタ: $STATE" >&2
    exit 2
  fi
  # **先に受けて、取れたことを確かめる。** **プロセス置換の終了状態は `while` へ
  # 伝わらない**ので、`done < <(...)` のままだと**取得の失敗が 0 件と区別できない**——
  # **カウンタだけ消えて STOP は残るのに、「STOP は無い」と言って成功で終わる**。
  # **人には再開できたように見え、ループは止まったまま**になる (#189 のレビュー)。
  if ! stop_paths="$("$TASK" loop:stop:paths)"; then
    echo "[FAIL] STOP の置き場所を取得できません（カウンタは消えています）: $TASK" >&2
    echo "       カウンタ: $STATE" >&2
    exit 2
  fi
  resume_found=0
  while read -r stop_path; do
    [[ -f $stop_path ]] || continue
    rm "$stop_path" || {
      echo "[FAIL] STOP を消せません: $stop_path" >&2
      exit 2
    }
    echo "==> 削除: $stop_path"
    resume_found=1
  done <<<"$stop_paths"
  ((resume_found == 1)) || echo "==> STOP は無い（停止していない）"
  exit 0
fi

# **識別子ごとに数える。** 1 つだけ持って「直前と違えば 1 に戻す」形にすると、
# **カウンタを共有している master と worker が互いの記録を消し合う**。
# 「master は no-work、worker は dirty」で交互に書かれると、どちらも 3 に届かず
# **2 つ動いているというだけで第 4 層が無効になる**。
#
# 前へ進んだ合図は --reset であって、識別子が変わったことではない。
# --reset が来るまでは、どの識別子の記録も消さない。
#
#   <回数><TAB><識別子>  を 1 行ずつ
#
# 書式に合わない行は捨てる (壊れた記録・古い書式で数えない)。
#   <回数><TAB><識別子><TAB><数えたときの worker の周回>  を 1 行ずつ
count=0
others=()
prev_epoch=""
if [[ -f $STATE ]]; then
  while IFS=$'\t' read -r prev_count prev_id prev_id_epoch; do
    [[ $prev_count =~ ^[0-9]+$ && -n $prev_id ]] || continue
    if [[ $prev_id == "$ID" ]]; then
      count="$prev_count"
      prev_epoch="$prev_id_epoch"
    else
      others+=("$prev_count"$'\t'"$prev_id"$'\t'"$prev_id_epoch")
    fi
  done < "$STATE"
fi

# **数える単位を「相手の周回」にする。**
#
# 第 4 層は master の周回で数えるが、**前へ進めるのは worker の周回**である。
# master は何倍も速く回るので、**指摘の修正に master の何周ぶんもかかる作業は
# 必ず止まる** (実測で 5 回。5 回とも worker は 1 周も終えておらず、5 回とも人が
# 手で再開した)。**難しい指摘ほど踏む**——レビューが良い仕事をするほど罰される (#126)。
#
# **見るのは「worker の周回が動いているか」であって「誰かが `./task` を叩いたか」ではない。**
# 心拍 (bin/loop-lease の活動の記録) は **人が worker の作業場で `./task` を叩いても
# 新しくなる**ので、**worker が死んだあとも「作業中」に見え続ける**。それを使うと
# **カウンタが永久に止まる**——**第 4 層が黙って死ぬ側**の壊れ方である。
#
# **周回だけが出せる信号を使う。** `bin/loop-lease acquire` が書く印 (ROUNDS) は
# **周回の開始でしか動かない**。人が `./task` を叩いても動かない。
#
#   印が動いた           … 1 周終えて次が始まった → **数える**
#   印が同じで、まだ窓の内 … その周回が続いている   → **数えない**
#   印が窓より古い       … 周回が始まっていない     → **数える** (worker が死んだ場合もここ)
#
# **窓は書き写した閾値ではない。** `bin/loop-lease` が release のたびに残す
# **いちばん長かった周回の実測**の 2 倍を使う (記録が無ければ lease の期限で代用)。
# **1 周が長い機械では窓も広がる**ので、**長い周回の途中で止められない**。
#
# **worker の作業ツリーは読まない。** 見るのは worker 自身が git の共通ディレクトリへ
# 書いた記録だけである。master が相手の作業場を覗く形にすると、
# 「GitHub を唯一の正とする」という設計に穴が開く。
declare -A alive_scopes=()
if [[ -n $script_dir && -x "$script_dir/loop-lease" ]] \
  && lease_ttl="$("$script_dir/loop-lease" ttl 2>/dev/null)" \
  && [[ $lease_ttl =~ ^[0-9]+$ ]]; then
  # **始めた周回の印。** lease と違って返しても消えないので、
  # **周回と周回の間でも「どの周回まで始めたか」が読める**。
  # **作業場ごとに、前回からの進みを見る** (#144)。**最大値を取ると、無関係な worker が
  # 周回を始めるたびに数が進む**——**PR を直している worker が同じ長い周回にいても、
  # 別 worker の 3 周だけで全ループを誤停止しうる。**
  #
  # **最小値でも足りない** (#200 のレビュー)。**最小値を持っていた作業場が動けば
  # それだけで動く**ので、**開始時刻がずれていると、片方が 2 周・もう片方が 1 周でも
  # 上限に達する**。**「いちばん遅い値が動いたか」は「全員が動いたか」ではない。**
  #
  # **担当を突き止めない。** **どの作業場がどの PR を見ているかは、ここからは分からない**
  # （PR 番号から作業場を引くには GitHub が要る）。**代わりに「全員が新しい周回を
  # 始めたか」を見る**——**担当している作業場も必ずその中にいる**ので、
  # **無関係な周回だけでは進まない。**
  #
  # **止まらなくなる形にはしない。** **見るのは生きている作業場だけ**なので、
  # **周回を始めなくなった作業場は、その窓を過ぎた時点で外れる**（すぐ下と同じ判定）。

  # 窓 = いちばん長かった周回 × 2。**実測が無ければ lease の期限で代用する。**
  #
  # **生きている作業場のものだけを見る** (#175 のレビュー)。記録は**作業場ごと**にあり
  # (scope はパスから作る)、**書き換えるのはその作業場の周回だけ**である——
  # **長い周回を記録した作業場が使われなくなると、その値は誰も更新しない**ので、
  # **別の作業場で何周しても落ちず、窓は永久に広いまま**になる。
  # **この機械には既に worker 役の scope が 2 つある**ので、**#82 を待たずに踏む。**
  #
  # **1 つに絞らない**（いちばん新しい周回の作業場だけ、にはしない）。
  # **軽い Issue の作業場が新しく、重い Issue の作業場が少し古い**とき、
  # **重いほうが窓の外へ出る**——**長い周回の途中で止めない**という性質を壊す。
  #
  # **生死は「周回の印」で見る。活動の記録は使えない**（このすぐ上に書いてある）——
  # **`./task` は lease の有無に関係なく毎回 heartbeat を打つ**ので、
  # **使われなくなった作業場で人が 1 回叩けば、長い実測が窓へ戻る**。
  # **周回の開始でしか動かない印**だけが、周回が生きていることを表す。
  #
  # **期限は「その作業場自身の窓」で測る。** lease の期限で一律に切ると、
  # **30 分を超える周回の途中にある作業場が「死んだ」に落ちる**——
  # **いちばん守りたい場面で窓が縮む**という、向きが逆の壊れ方になる。
  # **新しい閾値は作っていない**（**下と同じ式・同じ既定**を、作業場ごとに当てるだけ）。
  #
  # **消さない**のも意図的である（**削除は戻せない**）。読むときに外すだけにする。
  # **印と窓を、同じ 1 つの走査で取る** (#144)。**生死の判定を 2 箇所に持つと、
  # 片方だけ直して食い違う**——**印の側だけ生死を見ないと、周回を始めなくなった
  # 作業場が数を永久に止める。**
  now_epoch="$(date +%s)"
  for scope_rounds in "$common_dir"/valence-loop-rounds-worker*; do
    [[ -f $scope_rounds ]] || continue
    read -r scope_started <"$scope_rounds" 2>/dev/null || continue
    [[ $scope_started =~ ^[0-9]+$ ]] || continue
    scope="${scope_rounds##*/valence-loop-rounds-}"
    # **実測が無い作業場もいる**（一度も返していない）。**そのときは既定の窓で見る**
    seconds=""
    len="$common_dir/valence-loop-roundlen-$scope"
    if [[ -f $len ]]; then
      read -r seconds <"$len" 2>/dev/null || seconds=""
      [[ $seconds =~ ^[0-9]+$ ]] || seconds=""
    fi
    scope_window="$lease_ttl"
    if [[ -n $seconds ]]; then
      scope_window=$((seconds * 2))
      ((scope_window >= lease_ttl)) || scope_window="$lease_ttl"
    fi
    ((now_epoch - scope_started < scope_window)) || continue
    alive_scopes["$scope"]="$scope_started"
  done
fi

# **識別子ごとに「各 scope の前回時刻」を持つ。** `<scope>=<時刻>` を `,` で並べ、
# **scope 順に揃える**（並びが変わっただけで別物にならないため）。
#
# **前の版は 1 つの数値だった。** 読めない形は「初めて見た」として扱う——
# **記録は版をまたいで共有される**ので、**古い形で数え違えるより 1 周落とすほうが安い**。
snapshot_epochs() {
  local scope out=""
  for scope in $(printf '%s\n' "${!alive_scopes[@]}" | sort); do
    out+="${out:+,}${scope}=${alive_scopes[$scope]}"
  done
  printf '%s' "$out"
}

# **全 scope が、自分の前回より進んだか。** 1 つでも同じ周回の中なら数えない。
# **前回に無かった scope は「進んだ」**として扱う（**その作業場は周回を始めている**）。
all_scopes_advanced() {
  local previous="$1" pair scope epoch
  declare -A before=()
  local IFS=,
  for pair in $previous; do
    scope="${pair%%=*}"
    epoch="${pair#*=}"
    [[ $scope != "$pair" && $epoch =~ ^[0-9]+$ ]] || return 1
    before["$scope"]="$epoch"
  done
  unset IFS
  for scope in "${!alive_scopes[@]}"; do
    [[ -n ${before[$scope]-} ]] || continue
    ((alive_scopes[$scope] > before[$scope])) || return 1
  done
  return 0
}

# **worker が解く状態か。** 主体が違うものに worker の周回を効かせない
# （review-unanswered は Codex が返さないので、worker が元気でも解けない）。
worker_fixes_this=0
for kind in "${WORKER_FIXES[@]}"; do
  [[ ${ID%%:*} == "$kind" ]] && worker_fixes_this=1
done

# **周回が動いているか。** **生きている作業場が 1 つでもあれば動いている**——
# **生死はその作業場自身の窓で測ってある**ので、ここで測り直さない。
worker_rounding=0
((${#alive_scopes[@]} > 0)) && worker_rounding=1

counted="yes"
if ((worker_rounding == 1 && worker_fixes_this == 1)); then
  if [[ -z $prev_epoch ]]; then
    # この識別子を、この周回で初めて見た。**印だけ覚えて数えない。**
    counted="first"
    prev_epoch="$(snapshot_epochs)"
  elif all_scopes_advanced "$prev_epoch"; then
    count=$((count + 1))
    prev_epoch="$(snapshot_epochs)"
  else
    counted="no"
  fi
else
  count=$((count + 1))
fi

printf '%s\n' "${others[@]}" "$count"$'\t'"$ID"$'\t'"$prev_epoch" > "$STATE" || {
  echo "[FAIL] 停止カウンタを書き込めません: $STATE" >&2
  exit 2
}

if [[ $counted == "no" ]]; then
  echo "stall id=$ID count=$count max=$MAX_REPEATS (worker が同じ周回の中なので数えない)"
elif [[ $counted == "first" ]]; then
  echo "stall id=$ID count=$count max=$MAX_REPEATS (worker はこの周回を始めたばかりなので数えない)"
else
  echo "stall id=$ID count=$count max=$MAX_REPEATS"
fi

if ((count >= MAX_REPEATS)); then
  # **同じところで何度も止まっているなら、そう出す。** 人が同じ判断を繰り返している
  # ことに気づける唯一の手がかりになる。
  times=1
  if [[ -f $RESUMED ]]; then
    while IFS= read -r resumed_id; do
      [[ $resumed_id == "$ID" ]] && ((times++))
    done < "$RESUMED"
  fi
  if ((times > 1)); then
    echo "[STOP] 同じ状態が $count 回記録された (間に前進なし)。全ループを止める（この状態で止まるのは ${times} 回目）"
  else
    echo "[STOP] 同じ状態が $count 回記録された (間に前進なし)。全ループを止める"
  fi
  # **止まったかどうかを、終了コードで分ける** (#191 のレビュー)。**読む側が分岐に
  # 使うのはここ**なので、**標準エラーへ書いても分岐は変わらない**——**手順書の
  # 「exit 1 → 全ループが停止済み」が嘘になる。**
  stopped=1
  if [[ -n $script_common_dir && $script_common_dir == "$common_dir" && -x $TASK ]]; then
    # **戻り値を見る** (#190)。**見ないと、止められなかったことが `[STOP]` の後ろに
    # 隠れる**——**人は「止まった、あとで見よう」と読む**。**呼ばれる側を直しても、
    # ここが見ていなければ素通りする。**
    "$TASK" loop:stop "$ID: 同じ状態が $count 回記録されたため停止。人の判断が要る" || {
      # **止まっていないと断定しない** (#191 のレビュー)。**worktree ごとに書くので、
      # 途中で落ちれば「そこまでは止まっている」**——**「どのループも」と言うと、
      # 人は「まだ全部走っている」と読み、止まっている側を放置する。**
      echo "[FAIL] loop:stop が失敗しました。全 worktree を止められていません" >&2
      echo "       一部だけ止まっている場合があります（作成できたものは残ります）" >&2
      echo "       カウンタ: $STATE" >&2
      echo "       止めるには、この作業ツリーで ./task loop:stop を手で叩くこと" >&2
      stopped=3
    }
  else
    # 黙って何もしないのは、黙って止めるのと同じくらい分かりにくい。
    echo "[FAIL] ループを止められません" >&2
    echo "       カウンタ: $STATE" >&2
    echo "       スクリプト: ${script_common_dir:-不明}" >&2
    echo "       別のリポジトリで実行しているため、そちらの task は実行しません" >&2
    # **こちらも 1 つも止めていない。** 分けると、同じ意味に 2 つの値が残る
    stopped=3
  fi
  exit "$stopped"
fi
exit 0
