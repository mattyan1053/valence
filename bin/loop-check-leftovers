#!/usr/bin/env bash
# **切られた走りが、この作業場に残っていないか** (#528)。
#
#   bin/loop-check-leftovers <作業場の名前>              自分の作業場
#   bin/loop-check-leftovers --elsewhere <名前> <場所>   別の作業場（言い方が変わる）
#   bin/loop-check-leftovers --groups <作業場の名前>     落とす側へグループを渡す (#571 / #574)
#   bin/loop-check-leftovers --alive <名前> <PGID>...    そのグループがまだ走っているか
#
#   exit 0 = 残っていない
#   exit 1 = 残っている（何が残っているかを標準エラーへ出す。--groups は番号を標準出力へ）
#   exit 2 = 判定できない（使い方の誤り / docker を引けない）
#
# **`./task check` が呼び出し側の上限で切られると、コンテナの中の `pnpm check` は
# 走り続ける。** **呼び出し側のシェルは死んでいる**（**`$status` も末尾の印も読めない**）
# **のに、中で走っているものは残る**——**そのまま次を打つと、同じ木で 2 本走る**
# （#509 で測った形。**あのときは load 41.8 で vitest が時間切れになった**）。
# **実測 2 件**（2026-08-26 / 2026-08-27。**どちらも同じ作業場**）。
#
# **別の作業場も見る**（#549 のレビュー。**P1**）。**`./task check` が 2 本重なると、
# 両方が倍かかる**（#547 で実測。**単独 442〜796 秒に対し、重なると 1200 秒前後**）
# ——**打つ前に分かれば、待てる。**
#
# **PID では見えない。** **外側の上限で切られると、呼び出し側の PID は消えても
# コンテナの中の `pnpm check` は走り続ける**（**このスクリプトの前提そのもの**）
# ——**まさに重なるときに、記録の PID は死んでいる。**
#
# **#186 が止めたのは、合否や分岐が他人の持ち物で決まること**である
# ——**ここは見るだけ**で、**落としもしないし、返り値も呼ぶ側の合否に混ぜない。**
# **言い方は分ける**（**「落としてから打ち直すこと」は自分の作業場への指示**）。
#
# **どの作業場を見るかは `task` が決める**（`AGENTS.md` §5。**正規化も、
# 並べるのも 1 箇所**）——**このスクリプトは渡されたものを見るだけである。**
#
# **ここは落とさない。落とすのは `bin/loop-check-kill` である** (#571)。
# **判定はこちらが持つ**——**「何がその走りのぶんか」を落とす側にも書くと、
# `test:watch` を数えない規則が 2 箇所になる**（`AGENTS.md` §5）。
# **`--groups` は、その判定の結果だけを渡す口**である。
#
# **グループで渡す** (#574)。**親（`pnpm check`）だけを落とすと `vitest` が残り**
# （**実測で 2 回打っている**。#571）、**列挙のあとに fork された子は、名前でも親でも
# 辿れない**——**同じグループに入ることだけが頼り**である（**`setsid` しないかぎり**）。
#
# **踏んだ 2 回とも、気づけば人が落とせている**——**当時は言えば足りた。**
# **`./task test:watch` のように、人が意図して長く走らせているもの**もあるので、
# **殺す側へ倒すと、正しく走っているものを止める**（`task` の `heartbeat()` の
# 但し書きと同じ判断——**「殺す」は新しい失敗モードを持ち込む**）。
#
# **判定できないときは、そう言う** (#497)。**「見つからなかった」へ倒すと、
# 見ていないことが「居ない」になる。**
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

usage() {
  echo "使い方: bin/loop-check-leftovers <作業場の名前>" >&2
  echo "        bin/loop-check-leftovers --elsewhere <名前> <場所>" >&2
  echo "        bin/loop-check-leftovers --groups <作業場の名前>" >&2
  echo "        bin/loop-check-leftovers --alive <名前> <PGID>..." >&2
  echo "        exit 0 残っていない / exit 1 残っている / exit 2 判定できない" >&2
  exit 2
}

# **`--groups` / `--alive` は自分の作業場だけ** (#571 / #574)。**`--elsewhere` と混ぜない**——
# **他の作業場のものを落とす口を、ここから生やさない**（#186）。
if [[ ${1-} == "--groups" ]]; then
  [[ $# -eq 2 && -n ${2-} && ${2-} != --* ]] || usage
  readonly WORKSPACE="$2"
  readonly WHERE=""
  readonly GROUPS_ONLY=1
  ALIVE_OF=()
elif [[ ${1-} == "--alive" ]]; then
  # **落としたグループが、まだ走っているか。** **名前では見ない**
  # ——**列挙のあとに fork された子は、名前に当たらない**（#574）。
  [[ $# -ge 3 && -n ${2-} && ${2-} != --* ]] || usage
  readonly WORKSPACE="$2"
  readonly WHERE=""
  readonly GROUPS_ONLY=0
  ALIVE_OF=("${@:3}")
elif [[ ${1-} == "--elsewhere" ]]; then
  [[ $# -eq 3 && -n ${2-} && -n ${3-} ]] || usage
  readonly WORKSPACE="$2"
  # **どの作業場かを言えないなら、この口は役に立たない**——**待つ相手が分からない。**
  readonly WHERE="$3"
  readonly GROUPS_ONLY=0
  ALIVE_OF=()
else
  [[ $# -eq 1 && -n ${1-} ]] || usage
  readonly WORKSPACE="$1"
  readonly WHERE=""
  readonly GROUPS_ONLY=0
  ALIVE_OF=()
fi
readonly ALIVE_OF

# **compose がコンテナに付ける label で引く**（`task` の `warn_stale_containers` と
# 同じ引き方）——**`compose ps` より速く、project を名指しできる。**
if ! container="$(docker ps -q \
  --filter "label=com.docker.compose.project=$WORKSPACE" \
  --filter "label=com.docker.compose.service=app" 2>/dev/null)"; then
  # **どの作業場の話かを、失敗の側でも言い分ける** (#549 のレビュー)。**成功したときは
  # 分けてあるのに、ここが共通だと「この作業場の」と読んで自分のコンテナを疑いに行く。**
  if [[ -n $WHERE ]]; then
    echo "[WARN] 別の作業場のコンテナを引けないので、走っているかを判定できません: $WHERE" >&2
  else
    echo "[WARN] この作業場のコンテナを引けないので、残った走りがあるかを判定できません" >&2
  fi
  exit 2
fi

container="${container%%$'\n'*}"
# **上がっていなければ、走りは残っていない**——**覗きに行かない**
[[ -n $container ]] || exit 0

# **列を名指しで受ける** (#574)。**既定は `UID PID PPID CMD`** だが、**実行木で読むには
# グループと状態が要る**——**`pgid` はあとから fork された子も同じ値を持ち**、
# **`stat` は `Z`（親の回収待ち）を分ける**（#572）。
#
# **列を読むのは下の 2 箇所だけ**である（**数えた**）——**グループを出す `--groups` と、
# 生死を見る `--alive`。** **名前で当てる側は列を読まない**（**行ごと拾うだけ**）。
if ! processes="$(docker top "$container" -eo pid,pgid,stat,cmd 2>/dev/null)"; then
  # **ここも言い分ける** (#549 のレビュー 2 周目)。**`--elsewhere` は複数の作業場を
  # 回る**ので、**場所なしで出るとどれのことか分からない**——**`ps` の側だけでは半分。**
  if [[ -n $WHERE ]]; then
    echo "[WARN] 別の作業場のコンテナの中を読めないので、走っているかを判定できません: $WHERE" >&2
  else
    echo "[WARN] コンテナの中を読めないので、残った走りがあるかを判定できません" >&2
  fi
  exit 2
fi

# **落としたグループが、まだ走っているか** (#574)。**名前では見ない**
# ——**列挙のあとに fork された子は、名前に当たらない**（**この Issue そのもの**）。
# **`Z` は数えない**（#572）——**親の回収を待っているだけ**である。
if ((${#ALIVE_OF[@]})); then
  alive=""
  while read -r pid pgid state _rest; do
    [[ -n $pid && -n $pgid ]] || continue
    [[ $state == Z* ]] && continue
    for want in "${ALIVE_OF[@]}"; do
      [[ $pgid == "$want" ]] || continue
      alive+="$pid $pgid $state"$'\n'
      break
    done
  done < <(printf '%s\n' "$processes" | tail -n +2)
  [[ -n $alive ]] || exit 0
  printf '%s' "$alive"
  exit 1
fi

# **何を「走り」と数えるか。** **`./task check` が中で起こすもの**である
# ——**`pnpm dev`（常に居る）を数えない**ので、**名指しで並べる。**
#
# **`vitest run` と watch を分ける**（`package.json` の `test` と `test:watch`）
# ——**後者は人が意図して走らせているもの**である。
#
# **`\b` では分けられない** (#529 のレビュー)——**`t` と非単語文字 `:` の間でも
# 成立する**ので、**`pnpm test:watch` が `pnpm test\b` に当たる。**
# **実物の `docker top` にその行は出る**（**測った**）ので、**毎回鳴っていた。**
# **空白か行末までを見る**——**`docker top` の最後の列がコマンドである。**
leftovers="$(printf '%s\n' "$processes" | grep -E "pnpm (check|test)( |$)|vitest run" || true)"

[[ -n $leftovers ]] || exit 0

# **グループを渡す口** (#571 / #574)。**落とす側は判定を持たない。**
#
# **列は PID PGID STAT CMD** である——**1 列目が番号、2 列目がグループ。**
# **当たった行のグループを出す**——**落とす側は、それを 1 つの単位として落とす。**
if ((GROUPS_ONLY)); then
  declare -A groups=()
  while read -r _pid pgid _rest; do
    [[ -n $pgid ]] && groups["$pgid"]=1
  done < <(printf '%s\n' "$leftovers")
  printf '%s\n' "${!groups[@]}"
  exit 1
fi

if [[ -n $WHERE ]]; then
  echo "[WARN] 別の作業場で走っています（重なると両方が倍かかります）: $WHERE" >&2
  printf '%s\n' "$leftovers" >&2
  echo "       待つか、重なることを承知で打つかは、打った側が決めます" >&2
  echo "       他の作業場のものは触らないこと（見ているだけです）" >&2
  exit 1
fi

echo "[WARN] この作業場に、前の走りが残っています（次の ./task check と重なります）" >&2
printf '%s\n' "$leftovers" >&2
echo "       切られた ./task check の残りなら、./task check:kill で落としてから打ち直すこと" >&2
echo "       他の作業場のものは触らないこと（見ているのはこの作業場のコンテナだけ）" >&2
exit 1
