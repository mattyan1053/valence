#!/usr/bin/env bash
# 周回の出口で、**次に動けるのは誰か**を決める。
#
#   exit 0 = 渡す相手がいる。`<役>\t<理由>` を stdout に出す
#   exit 1 = 渡さない (相手に持ち物が無い / 動けるのは自分 / 同じ状態で送信済み)
#   exit 2 = 状態を読めない / 使い方の誤り
#   exit 3 = **状態が矛盾している**。渡す相手がいれば出力は exit 0 と同じで、
#            送ったうえで記録する。**いなければ出力は無い**——**送るものが無いので、
#            続く `--sent` は「送っていない」として通る** (#399)
#
# **判断の根拠を 2 種類持たない。** ゲートは**未解決スレッド**を見て落とすのに、
# ここは **label** だけを見ていた。label が 0 件の PR は「master がゲートを回せる」と
# 読まれ、**自分宛なので黙る**。#103（手順書から外れた経路）と #107（**手順書どおり**の
# 経路。レビュースレッドへ返信する段に label を付ける指示が無い）で実際に起きた。
# **経路を数えるのではなく、状態から決める。**
#
# **通知は「〜した」ときにだけ送られていた。** 周回を終える経路は 9 つ以上あり、
# **何もせずに終わる経路には 1 つも通知が無い**ので、そこを通ると
# **次の cron まで誰も動かない**。列挙を足しても、経路が増えればまた漏れる
# (`bin/loop-procedure-changed` の「1 以外はすべて」と同じ理由)。
# **出口を 1 本にして、そこで必ず持ち手を決める。**
#
# **両側が同じものを見て、同じ判定を返す。** 役ごとに見るものを変えない。
# 変えると、**同じ PR の同じ瞬間に「対応が返っている」と「label が無い」が同時に成り立つ**——
# **どちらの記録が本当かを、人が突き合わせる**ことになる（#150）。
# 役で変わるのは**行き先だけ**で、**状態の読み方と終了コードは同じ**である。
#
# **持ち手は「次に動ける人」であって「直す人」ではない。** 当否がまだ判断されていない
# 指摘は、**`changes-requested` を付け外しできる master** にしか動かせない。
# ここを直す側（worker）へ渡していたので、**worker の周回は自分宛て → 沈黙**になり、
# **master は自分の周回まで気づけなかった**。その間ずっと食い違いが記録され、
# **PR が健全でも 3 周で `loop/STOP`** に達する（#149 / #152 で実際に踏んだ）。
#
# **ping-pong を作らない。** 「暇そうだから起こす」を許すと
# 「やることなし → 起こす → やることなし → 起こす」で焼き切れる。
#
#   1. **相手に具体的な持ち物があるときだけ送る**
#   2. **同じ状態で 2 通目を送らない** (判断に使った状態そのものを覚えておく)
#   3. **自分自身へは送らない** (自分が動けるなら次の周回でやればよい)
#
# 覚えておく場所は `bin/loop-stall` と同じ **git の共通ディレクトリ**。
# 新しい保存先を増やすと、掃除する場所が増える。
#
# **ただし「送ると決めた」ぶんだけは、作業場ごとに置く** (#265 のレビュー)。
# **共有してよいのは「この状態は既に伝えた」まで**で、**まだ投げている 1 件は、
# 決めた周回のものである**（理由は `PENDING` を組み立てるところに書いてある）。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
# shellcheck disable=SC2016
set -uo pipefail

readonly ROLES=(master worker)
# 役ごとの印（`bin/loop-review-reply --mark` から引く。#174）
declare -A ROLE_MARK=()

# 自動レビューの bot。**この人が最後なら、まだ誰も答えていない。**
#
# **名前は書き写さない。** `bin/loop-review-commits` が正で、そこから取る——
# **ここだけ `[bot]` 無しだったのは偶然ではない**（**GraphQL の `author.login` は
# 付けず、REST は付ける**）。**同じ相手を API ごとに別の文字列で持っていた** (#135)。
# **食い違うとそのレビューを数えないので、症状は「正しい PR がまた止まる」だけ**である。
#
# 隣を引くのに `dirname` を使わない。**外部コマンドを足すと、テストが PATH を絞れなくなる**。
bot_script_dir="${BASH_SOURCE[0]%/*}"
[[ $bot_script_dir != "${BASH_SOURCE[0]}" ]] || bot_script_dir="."
if ! REVIEW_BOT_REST="$("$bot_script_dir/loop-review-commits" --bot)" || [[ -z $REVIEW_BOT_REST ]]; then
  echo "[FAIL] レビュー用の bot の名前を取得できません" >&2
  exit 2
fi
readonly REVIEW_BOT_REST
# **ここが読むのは GraphQL の `author.login`** なので、`[bot]` を**取り除いて**持つ。
# **足す側で書かない**——出所が `[bot]` 無しに変わったときに二重に付く。
readonly REVIEW_BOT="${REVIEW_BOT_REST%\[bot\]}"

# 役の印 (#174)。**master と worker は同じアカウントで動く**ので、
# **GitHub 側の名前では見分けられない**——**投稿する側が印を付ける。**
#
# **文字列は書き写さない。** **正は `bin/loop-review-reply`**（付ける側）で、
# **ここは引くだけ**である——**2 箇所に持つと、片方だけ直して黙って食い違う** (#159)。
for mark_role in "${ROLES[@]}"; do
  if ! role_mark="$("$bot_script_dir/loop-review-reply" --mark "$mark_role")" \
    || [[ -z $role_mark ]]; then
    echo "[FAIL] 役の印を取得できません: $mark_role" >&2
    exit 2
  fi
  ROLE_MARK[$mark_role]="$role_mark"
done

# 列の区切り。**タブを使わない。**
#
# **タブは IFS の空白なので、連続すると 1 区切りに畳まれる。** label が 1 つも無い PR
# （外した直後など）で列が左へずれ、**時刻の欄に PR 本文が入る**。数字は英字より前に
# 並ぶので時刻の比較は**必ず偽**になり、**「判断済み」の枝 → worker 宛 → 自分宛て →
# 沈黙**——**この仕組みが消しに来た沈黙が、直したはずの経路の中に戻る。**
# **空の列があっても畳まれない文字**にすれば、`read` の並びがずれない。
#
# **同じ穴を `bin/loop-merge` が踏んでいる**（`mergedAt` が空のとき `headRefName` が
# そこへ入り、**未マージを「マージ済み」と誤判定**した）。**あちらは 1 行 1 値で受ける**。
# ここは 1 行が 1 件（PR・スレッド）なので、**区切りのほうを変える**。
readonly FIELD=$'\037'

usage() {
  echo "使い方: bin/loop-handoff <役> [--sent=<token> | --who]   役: ${ROLES[*]}" >&2
  echo "        --who は「いま誰の番か」を読むだけ（自分の番でも答える。記録も送信もしない）" >&2
  echo "        token は入口の bin/loop-lease acquire が出したもの（握ったまま打つ）" >&2
  exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
readonly ROLE="$1"
role_is_known=1
for known in "${ROLES[@]}"; do
  [[ $known == "$ROLE" ]] && role_is_known=0
done
((role_is_known == 0)) || {
  echo "[FAIL] 未知の役: $ROLE（使えるのは ${ROLES[*]}）" >&2
  exit 2
}

# **送信が成功したことを伝える口** (#258)。**呼んだ側にしか分からない。**
#
# **token を `--sent=` の中に入れる** (#355 のレビュー)。**別の引数として足さない**
# ——**古い版のスクリプトがディスクに残っている周回**では、**`bin/loop-handoff <役>
# --sent <token>` は「引数が 3 つ」なので `$# -eq 2` を外れ**、**ふつうの判定として
# 走ってしまう**（**出力を出して exit 0、記録はしない**——**呼んだ側は成功と読む**）。
# **`--sent=<token>` なら `$2` が `--sent` と一致しないので、古い版は usage で落ちる**
# ——**黙って別の意味に読まれるより、落ちるほうが安い**（`AGENTS.md` §5。#281）。
#
# **逆向き（新しいスクリプト × 古い手順書）は、下で「記録しない」へ倒す。**
confirm_sent=0
sent_token=""
# **誰の番かを、読むだけで訊く口** (#360)。**書かない・送らない・自分の番でも答える。**
#
# **出口は自分自身へは送らない**（#92）ので、**`to` が自分の役だと exit 1 で黙る**
# ——**「いまは自分の番だ」を周回の側から読む手立てが無かった。** **master の
# ステップ 2 は、そのぶんを大きさと古さで並べ直していた**——**手番を持っている PR が、
# より小さい / 古い PR に毎周回負ける**（**実測 105 分。上限が無い**）。
#
# **判定を並べ替えの側へ書き写さないため**の口である（`AGENTS.md` §5）。
peek=0
if [[ $# -eq 2 ]]; then
  case "$2" in
    --sent=*)
      confirm_sent=1
      sent_token="${2#--sent=}"
      ;;
    --sent)
      # **古い手順書が打つ形。** **usage で落とさない**——**何が足りないかを言う**
      confirm_sent=1
      ;;
    --who) peek=1 ;;
    *) usage ;;
  esac
fi
readonly confirm_sent sent_token peek

# **読めなかったら「送らない」に倒さない。** 倒すと、止まっていることに気づけない。
fail_unknown() {
  echo "[FAIL] GitHub の状態を読み取れません: $1" >&2
  exit 2
}

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}

readonly INFORMED="informed"
readonly OBSERVED="observed"

# **送ると決めた宛先と指紋の置き場所** (#258)。**記録とは分ける**——
# **ここにあるのは「送ると決めた」までで、届いたかどうかはまだ分からない。**
#
# **共通ディレクトリには置かない** (#265 のレビュー)。**`informed` の記録は役だけを
# キーに共有されているのが正しい**——表すのは**「この状態は既に伝えた」**で、
# **指紋は全体の状態**だからである（どの作業場から伝えたかは関係ない）。
# **送信待ちが表すのは「いま投げている 1 件」**なので、**共有できない**——
# **A が S1 を置いて送る → 確認の前に B が S2 を置く → A の `--sent` が S2 を
# `informed` へ上げる → B の送信が落ちても S2 は抑止される。**
# **この仕組みが塞いだ穴が、塞いだ仕組みの中に開く。**
#
# **作業場の識別子を自前で作らない** (#159 と同じ理由)。**`bin/loop-lease` は
# 作業場の根の digest で分けている**が、**同じ導き方をここへ書き写すと、片方だけ
# 直して食い違う**。**worktree ごとの git ディレクトリは git 自身が分けている**ので、
# **持ち主は 1 人**である（作業場は `git worktree` で増える。`./task loop:worker:add`）。
#
# **掃除する場所は増えない。** **作業場を消せば、その中の送信待ちも一緒に消える**
# ——**残ってはいけないのは、消えた作業場の「投げかけ」**である。
if ! worktree_dir="$(git rev-parse --git-dir 2>/dev/null)" || [[ -z $worktree_dir ]]; then
  echo "[FAIL] この作業場の git ディレクトリを特定できません" >&2
  exit 2
fi
worktree_dir="$(cd "$worktree_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] この作業場の git ディレクトリへ移動できません" >&2
  exit 2
}
readonly PENDING="$worktree_dir/valence-loop-handoff-$ROLE.pending"
# **送る相手がいなかった周回の印** (#399)。**矛盾だけを報せた周回は、出口の 2 手目で
# 「送ると決めた記録がありません」に落ちていた**——**送る相手はもともといない**ので、
# **周回は詰まらないが、毎回片方が失敗する。** **「失敗したが問題ない」を毎回読む形は、
# 読まなくなる側**である。
#
# **役の名前ではない値を置く。** **前の版がこれを読むと「宛先が読めません」で
# 落ちる**（**いまと同じ exit 2**）——**古い読み手の答えは変わらない。**
readonly NO_DESTINATION="-"

# **役ごとの指紋を置く先** (#359 / #363 のレビュー)。
#
# **前の版とは、置き場所を分けてある。** **あれは「1 枝ぶんの状態」を書く記録**で、
# **役ごとの指紋をそこへ書くと、古い版が別の意味で読む**（`AGENTS.md` §5。
# **#281 で 2 周連続で踏んだ形**）——**役ごとに `bin/loop-sync-main` を通る**ので、
# **master が新版・worker が旧版**という期間が**それぞれの次の周回まで**続く。
#
# **逃げ道は「足す」側にある**——**古い版が見ない場所へ置けば、古い版の解釈は変わらない。**
# **数えたのは「古い読み手が何を読むか」**である（**読んでいたのは `bin/loop-handoff`
# の 3 箇所だけ**で、**ほかのスクリプトは触っていなかった**）。
#
# **名前を短く戻さない** (#364)。**長いことが、版が分かれた証拠**である
# ——**戻すと、前の版の記録と同じ名前になり、また同じことが起きる。**
#
# **前の版の記録は #364 で消してある**（**全部の作業場が新しい版で周回を回したあと**）
# ——**残しておくと、次に読む人が「これが現役の記録だ」と読む。**
role_record() {
  printf '%s' "$common_dir/valence-loop-handoff-by-role.$1"
}

# **記録のロック。** 判断する側と `--sent` で同じものを取る。
lock_records() {
  exec 9>"$common_dir/valence-loop-handoff.lock" || {
    echo "[FAIL] 送信記録のロックを作成できません" >&2
    exit 2
  }
  if ! flock -w "${LOOP_HANDOFF_LOCK_WAIT_SEC:-10}" 9; then
    echo "[FAIL] 送信記録のロックを取得できません" >&2
    exit 2
  fi
}

# **送れたときにだけ「送った」と書く** (#258)。
#
# **判断した周回が「送信済み」を書いていた。** **実際に送るのは呼んだ側**なので、
# **送信が失敗しても記録だけが残る**——**同じ状態では 2 通目を送らない**ので、
# **その状態では二度と送られない**。**記録には `informed` と書いてある**ので、
# **落ちたことがどこにも残らない**（2026-08-14 に、宛先の名前が変わって実際に起きた）。
#
# **#173 が直したのは「送らないと決めた周回が記録を書く」**である。
# **こちらは「送ろうとして失敗した周回が記録を書く」**——**別の入口で、同じ結果**になる。
#
# **判断と記録を 2 回に分ける。** 判断した周回は**宛先と指紋を置くだけ**で、
# **`--sent` を通ったときにだけ `informed` へ上げる。**
#
# **ここで指紋を引き直さない。** 引き直すと、**送っている間に状態が変わった場合に、
# 送っていない状態を「送信済み」として塞ぐ**——**いま塞ごうとしている穴が、逆向きに開く。**
if ((confirm_sent == 1)); then
  # **握っていない周回の記録は上げない** (#352)。**出口は「返すのがいちばん最後」**
  # （#340）だが、**手順書に書いてあるだけでは守られなかった**——**worker が自己申告、
  # master も 1 度踏んでいる。** **#341 が入れた試験は手順書の本文を見るだけ**で、
  # **打つ側が守ったかは見ていない**（#176 の形：**規則はあるが、実行される場所には無い**）。
  #
  # **先に返すと、返した先で cron の周回が同じ判定をもう一度立てる**
  # （**指紋が動くのは `--sent` のとき**）。**`--sent` を打つのも lease を持たない
  # 周回になる**ので、**`bin/loop-lease check` が「入口を飛ばした」を記録する側へ回る** (#161)。
  #
  # **判定は `bin/loop-lease` が持つ**（`AGENTS.md` §5）——**`check` と同じ読み方**である
  # （**あちらは全部の役を回って言うだけ、こちらは役 1 つについて合否を返す**）。
  #
  # **判定できないとき（exit 2）も記録しない。** **倒す向きは「記録しない」**——
  # **記録すると、届いていない状態が「送信済み」になり、その状態では二度と送られない**
  # （#258）。**記録しなければ、次の周回が同じ状態をもう一度立ち上げる**（保険が効く）。
  #
  # **どの周回も入口 1.0 で lease を取る**ので、**握っていないのは順序が崩れたときだけ**
  # である。**崩れた周回では記録が上がらず、次の周回で 2 通目が出る**——
  # **それでよい**（**届かないより安い**）。
  if [[ -z $sent_token ]]; then
    echo "[FAIL] --sent には lease の token が要ります（入口の acquire が出したもの）" >&2
    echo "       この周回の送信は記録されていません——次の周回が同じ状態をもう一度立ち上げます" >&2
    echo "         bin/loop-handoff $ROLE --sent=\"<token>\"" >&2
    exit 2
  fi
  if ! "${BASH_SOURCE[0]%/*}/loop-lease" mine "$ROLE" "$sent_token"; then
    echo "[FAIL] この token は $ROLE の lease の資格ではないので、送信を記録しません" >&2
    echo "       返したあと・次の周回が取り直したあと・期限が切れたあと、のいずれかです（上の理由を読むこと）" >&2
    echo "       出口は 1 行ずつ別のコマンドで打ちます（返すのはいちばん最後）:" >&2
    echo "         bin/loop-handoff $ROLE" >&2
    echo "         # ここで 1 通送る" >&2
    echo "         bin/loop-handoff $ROLE --sent=\"<token>\"" >&2
    echo "         bin/loop-lease release $ROLE \"<token>\"" >&2
    echo "       この周回の送信は記録されていません——次の周回が同じ状態をもう一度立ち上げます" >&2
    exit 2
  fi
  lock_records
  pending="$(cat "$PENDING" 2>/dev/null || true)"
  if [[ -z $pending || $pending != *"$FIELD"* ]]; then
    echo "[FAIL] 送ると決めた記録がありません: $PENDING" >&2
    echo "       先に bin/loop-handoff $ROLE を通し、出力があったときだけ送ること" >&2
    exit 2
  fi
  sent_to="${pending%%"$FIELD"*}"
  sent_state="${pending#*"$FIELD"}"
  # **送る相手がいなかった周回** (#399)。**通すが、記録は上げない**——**誰にも
  # 配っていない**ので、**その状態を「届いた」と数えてはいけない**（#125 の本体）。
  if [[ $sent_to == "$NO_DESTINATION" ]]; then
    rm -f "$PENDING" ||
      echo "[WARN] 送信待ちの記録を消せません: $PENDING（次の周回が置き直す）" >&2
    exit 0
  fi
  sent_to_is_known=1
  for known in "${ROLES[@]}"; do
    [[ $known == "$sent_to" ]] && sent_to_is_known=0
  done
  ((sent_to_is_known == 0)) || {
    echo "[FAIL] 送ると決めた記録の宛先が読めません: $PENDING" >&2
    exit 2
  }
  # **自分より新しい記録を巻き戻さない** (#265 のレビュー)。
  #
  # **役が違えば lease は直列化しない。** **判断してから送るまでには、その周回で
  # 分かったことを本文へ書く時間がある**（出口がそう求めている）ので、**窓は小さくない**
  # ——**master が S1 で決めて送っている間に、worker が S2 で決めて `--sent` まで
  # 通す**と、**あとから来た `--sent` が `informed(S2)` を `informed(S1)` へ戻す。**
  # **次の周回は、同じ通知をもう 1 通送る。**
  #
  # **順序を決める材料は、時刻ではなく記録そのものから取る。** **指紋は状態の記述で
  # 順序を持たない**が、**「決めたときに見た状態のままか」なら比べられる**——
  # **判断した周回は、両方の記録をその指紋で置いてきている**（`observed` か
  # `informed` かは違っても、**指紋は同じ**）。
  #
  # **違っていたら、書かずに終える。** **抑止が答える問いは「いまの状態は既に
  # 伝えたか」**で、**後から書かれたほうが、いまの状態に近い**——
  # **送ったこと自体は失敗していない**ので、**呼んだ側へは成功を返す。**
  # **見るのは宛先の記録だけ** (#359)。**指紋は役ごと**になったので、
  # **こちらの役の記録には、こちらの役の状態が入っている**——**送った状態と
  # 突き合わせる意味が無い**（**必ず食い違い、書かずに終える**）。
  record="$(role_record "$sent_to")"
  stored="$(cat "$record" 2>/dev/null || true)"
  if [[ ${stored#*"$FIELD"} != "$sent_state" ]]; then
    echo "[INFO] 送ったあいだに、より新しい状態が記録されました（$sent_to）。巻き戻さずに終えます" >&2
    rm -f "$PENDING" ||
      echo "[WARN] 送信待ちの記録を消せません: $PENDING（次の周回が置き直す）" >&2
    exit 0
  fi
  # **書くのは宛先の記録だけ** (#359)。
  #
  # **#173 のレビューが「送った側にも書く」とした理由は、指紋が役をまたいで
  # 同じだったから**である——**宛先が呼んだ役で反転すると、同じ指紋のまま
  # master→worker→master と 2 通出た。**
  #
  # **指紋を役ごとに持つと、その形は作れない**——**worker の周回が見るのは
  # 「master の番の枝」で、master が送った「worker の番の枝」とは別の鍵**である。
  # **こちらの役の記録へ相手の状態を書くと、そちらの記録が壊れる。**
  record="$(role_record "$sent_to")"
  printf '%s' "${INFORMED}${FIELD}${sent_state}" >"$record" || {
    echo "[FAIL] 送信記録を書き込めません: $record" >&2
    exit 2
  }
  # **消せなくても、記録は済んでいる。** 次の周回が置き直すか消すので自然に収まる
  rm -f "$PENDING" ||
    echo "[WARN] 送信待ちの記録を消せません: $PENDING（次の周回が置き直す）" >&2
  exit 0
fi

# **入口の確認は、GitHub を読む前に済ませる。** 読めずに落ちた周回でも、
# **飛ばしたことは記録に残る**——記録を状態の取得に依存させない。
#
# **判定は `bin/loop-lease` が 1 箇所で持つ**（#161）。ここで自前に持つと、
# **周回中の他のスクリプトと食い違う**——**同じ判定を 2 箇所に置いて、
# 片方だけ直した**のは #159 で踏んだ形である。
# **役は渡さない。** ここは `$ROLE` を知っているが、**知らない呼び出し側と
# 同じ形にそろえる**（`check` が見るのは「この周回が、どれかの役の lease を
# 自分として持っているか」で、役を当てる必要が無い）。
# **読むだけの口では呼ばない** (#362 のレビュー)。**周回の外から打つ人がいる**
# ——**`--who` は「読むだけ」と決めた口**なのに、**打つと `./task loop:status` へ
# 偽の運用違反が残る**（**決めた契約と実装が食い違う**）。**周回の中から打つぶんは、
# 同じ周回の出口（ふつうの呼び出し）がこれまでどおり通る。**
((peek == 1)) || "${BASH_SOURCE[0]%/*}/loop-lease" check || true

# **一覧（検索）を信じない。** `gh issue list` / `gh pr list` の label 絞り込みは
# **検索の索引を経由するので、付け替えた直後は古い値が返る**（実測: `ready` を付けた直後、
# 一覧は 4 秒ほど 0 件のまま。同じ瞬間に GraphQL は 1 件を返す）。
# **昇格させた直後は必ず 0 件に見える**ので、**`ready` を付けて通知する、という
# もっとも普通の受け渡しが、もっとも落ちやすい**（#101。master が毎回手で回し直していた）。
#
# **リポジトリの issues / pullRequests を直接引く**（検索ではない）ので遅れない。
# owner / repo は `{owner}` の置換が効かない（置換されるのは `gh api` の
# エンドポイントだけ）ので、先に引く。
repo_ref="$(gh repo view --json owner,name --jq '.owner.login, .name')" || fail_unknown "リポジトリ"
mapfile -t repo_parts <<<"$repo_ref"

prs="$(gh api graphql --paginate \
  -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" \
  -f query='query($owner:String!,$repo:String!,$endCursor:String){
    repository(owner:$owner,name:$repo){
      pullRequests(states:OPEN,first:50,after:$endCursor){
        pageInfo{hasNextPage endCursor}
        nodes{number headRefOid body labels(first:50){nodes{name}}
          commits(last:1){nodes{commit{committedDate}}}
          timelineItems(itemTypes:LABELED_EVENT, last:50){
            nodes{... on LabeledEvent{createdAt label{name}}}}}}}}' \
  --jq '.data.repository.pullRequests.nodes[]
    | "\(.number)\u001f\([.labels.nodes[].name] | join(","))\u001f\(.headRefOid)\u001f\(
        [.timelineItems.nodes[] | select(.label.name == "changes-requested") | .createdAt] | max // ""
      )\u001f\(.commits.nodes[0].commit.committedDate // "")\u001f\((.body // "") | gsub("\\s+"; " "))"')" ||
  fail_unknown "open PR"

# **未解決スレッドを、ゲートと同じ読み方で取る。**
#
# `gh pr list --json` は未解決スレッドを返さないので GraphQL で取る。
# owner / repo は `{owner}` の置換が効かない（置換されるのは `gh api` の
# エンドポイントだけ）ので、先に引く。
#
# **スレッド自体をページングする。** 内側の接続に `pageInfo` と `after` が無いと
# `--paginate` は外側しか進めず、**101 件目以降にだけ未解決が残る PR を 0 件と数える**。
# `bin/loop-gate` も同じ形でページングしている——**同じものを、同じ読み方で見る**のが
# この仕組みの主題で、読み方が違えば同じ食い違いが戻る。
#
# **組み立てはゲートと 2 箇所に分かれている。** ゲートは 1 本の PR について合否を出し、
# ここは open な PR すべてについて持ち手を決めるので、必要な形が違う。
# **片方だけ直すと食い違う**ので、どちらかを触るときはもう一方も見ること。
# 未解決スレッドの「最後の発言」を PR 番号で引けるようにする。
declare -A unresolved_of=()
declare -A last_comment_of=()
# **最後の発言の本文。** **役の印を読むため**である (#174)
declare -A last_body_of=()
# **まだ誰も答えていないスレッドの数。** 件数とは別に持つ。
#
# さらに 2 つに分ける。**`changes-requested` は PR 全体の状態であって、
# スレッドごとの印ではない**——CI の失敗・規模超過・1 つ前の指摘で既に付いている
# ところへ新しい指摘が届くと、**当否を判断していないのに「判断済み」になる**。
# **label を付けた時刻より後に立ったスレッドは、付けた人には見えていない。**
#
# **「master が返信したスレッドは判断済み」では解けない。** 役は同じアカウントで
# 動くので、**GitHub 側の名前では master と worker を見分けられない**——
# そこへ寄せると、**worker の返信を master の判断として読む**。
declare -A untriaged_of=()
declare -A requested_of=()

# **ゲートが落とす条件は、ここから見えていなければならない** (#125)。
#
# **集約値 (`statusCheckRollup`) では同値にならない** (#173 のレビュー)。あれは
# **必須でないチェックも混ざった値**なので、**必須でないものが落ちている間は
# `FAILURE` のまま**——**必須が pending → pass に変わってゲートが不合格 → 合格に
# なっても、指紋が動かない**。**マージできるようになった、まさにその瞬間に黙る。**
#
# **判定は `bin/loop-ci-status` が持つ** (#206 / #207 のレビュー)。**一覧も読み方も
# 書き写さない**——**2 箇所に持つと片方だけ直して食い違う** (#159 で踏んだ形)。
# **`bucket` を自分で読むと、ゲートが `conclusion` で成功へ変わっても指紋が動かない。**

# PR ごとの、必須チェックの結果。**指紋に入れる**
declare -A checks_of=()
# PR ごとの head。**枝ごとの指紋に要る** (#274)——**その PR が動いたかは head で見る**
declare -A head_of=()
declare -A pushed_of=()
declare -A requested_at_of=()
# PR ごとの、コンフリクトの有無 (#347)。**指紋に載せる**——**解けたら次の枝へ移る**
declare -A mergeable_of=()

while IFS="$FIELD" read -r number _labels head labeled_at pushed_at _body; do
  [[ -n $number ]] || continue
  head_of[$number]="$head"
  requested_at_of[$number]="$labeled_at"
  # **head が積まれた時刻** (#384)。**要求より後なら、worker は既に直している。**
  pushed_of[$number]="$pushed_at"

  # **ゲートと同じ判定を、同じところから取る。** **指紋は決着の別だけ**で、
  # **予算は見ない**——**時間の経過だけで指紋が動くと、何も変わっていないのに通知が飛ぶ**。
  if ! states="$("${BASH_SOURCE[0]%/*}/loop-ci-status" --fingerprint "$number")" \
    || [[ -z $states ]]; then
    fail_unknown "CI の状態 (#$number)"
  fi
  checks_of[$number]="$states"
  threads="$(gh api graphql --paginate \
    -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" -F number="$number" \
    -f query='query($owner:String!,$repo:String!,$number:Int!,$endCursor:String){
      repository(owner:$owner,name:$repo){
        pullRequest(number:$number){
          reviewThreads(first: 100, after: $endCursor){
            pageInfo{hasNextPage endCursor}
            nodes{isResolved
              opened: comments(first:1){nodes{createdAt}}
              comments(last:1){nodes{databaseId author{login} body}}}}}}}' \
    --jq '.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)
      | "\(.comments.nodes[0].databaseId)\u001f\(.comments.nodes[0].author.login)\u001f\(.opened.nodes[0].createdAt)\u001f\(.comments.nodes[0].body | gsub("[\n\r]"; " "))"')" ||
    fail_unknown "未解決スレッド (#$number)"
  count=0
  untriaged=0
  requested=0
  while IFS="$FIELD" read -r comment_id author opened_at body_line; do
    [[ -n $comment_id ]] || continue
    ((count++))
    # **スレッドごとに数える。** PR ごとに「いちばん新しい発言」だけで決めると、
    # **新しいほうへ返信しただけで、答えの無いスレッドが隠れる**——
    # **指摘が 1 つ、誰にも拾われずに消える**。
    if [[ $author == "$REVIEW_BOT"* ]]; then
      # **label より後に立ったスレッドは、付けた時点で見えていない。**
      # 時刻はどちらも GitHub が記録した値で、書式が同じなので文字列で比べられる。
      if [[ -z $labeled_at || $opened_at > $labeled_at ]]; then
        ((untriaged++))
      else
        ((requested++))
      fi
    fi
    # **いちばん新しい発言を持つ。** ID は増える一方なので、大きいほうが新しい
    if [[ -z ${last_comment_of[$number]-} || $comment_id -gt ${last_comment_of[$number]} ]]; then
      last_comment_of[$number]="$comment_id"
      last_body_of[$number]="$body_line"
    fi
  done <<<"$threads"
  unresolved_of[$number]="$count"
  untriaged_of[$number]="$untriaged"
  requested_of[$number]="$requested"
done <<<"$prs"

# **最後の発言も指紋に入れる。** コードを変えずに理由だけ返信すると、head も件数も
# label も動かない。**「状態が動いたのに指紋が持っていない」**が、入口を変えて戻る。
# ID は**新しい発言があったときだけ変わる**ので、時刻のように毎回変わる値ではない。
details=""
for number in "${!unresolved_of[@]}"; do
  details+="${number}:${unresolved_of[$number]}:${last_comment_of[$number]-} "
done
# **ゲートが見る条件を、同じ形で持つ** (#125)。名前ではなく**必須の並び順の結果**を書く
checks=""
while IFS="$FIELD" read -r number _labels _head _labeled_at _pushed_at _body; do
  [[ -n $number ]] || continue
  checks+="${number}:${checks_of[$number]-} "
done <<<"$prs"
# **理由の無い保留を探す** (#163)。**判定はここに書かない**——`./task loop:status` も
# 同じことを見るので、**2 箇所に置くと片方だけ直して食い違う**。
#
# **読めなくても止めない。** ここは持ち手を決めるのが仕事で、
# **付け足しの診断で本業を落とさない**。**ただし黙らない** (#161 と同じ判断)。
silent_park=""
if parks="$("${BASH_SOURCE[0]%/*}/loop-silent-park")"; then
  : # 無い
else
  case $? in
    1)
      # **番号だけを取り出す。** 1 行目で足りる (複数あっても、渡す相手は同じ)
      IFS=$'\t' read -r silent_park _parked_at <<<"$parks"
      ;;
    *)
      echo "[WARN] 理由の無い保留があるかどうかを読めません（bin/loop-silent-park）" >&2
      ;;
  esac
fi

# **件数も検索を通さない。** ここが遅れると `ready` の昇格が伝わらない。
#
# **番号も受け取る** (#285)。**件数だけでは、報告に載せる直前に確かめ直せない。**
counts="$(gh api graphql -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" \
  -f query='query($owner:String!,$repo:String!){
    repository(owner:$owner,name:$repo){
      ready: issues(states:OPEN, labels:["ready"], first:50){nodes{number}}
      inProgress: issues(states:OPEN, labels:["in-progress"], first:50){nodes{number}}
      backlog: issues(states:OPEN, labels:["backlog"]){totalCount}
      waiting: issues(states:OPEN, labels:["backlog","waiting-condition"]){totalCount}}}' \
  --jq '.data.repository | "\([.ready.nodes[].number] | join(","))\u001f\([.inProgress.nodes[].number] | join(","))\u001f\(.backlog.totalCount)\u001f\(.waiting.totalCount)"')" ||
  fail_unknown "Issue の件数"
IFS="$FIELD" read -r ready_numbers progress_numbers backlog waiting <<<"$counts"

# **報告に載せる直前だけ、直接読んで数え直す** (#285。#281 と同じ形)。
#
# **この口も遅れる。** **label を外した数コマンド後の周回では、まだ返ってくる**
# ——**そこで「手が埋まっている」と読むと、渡すものがあるのに黙る**（実測で同じ日に 3 回。
# **マージした周回の出口でいちばん損をする**——**worker が空いていて、仕事が増えた瞬間**である）。
#
# **全件には投げない。** **`ready` と `in-progress` は上限が小さい**ので、往復は増えない
# （**`backlog` は「1 件でもあるか」しか見ない**ので、数え直さない）。
#
# **読めなかったら数を返さない。** **「0 件」に倒すと、読めないあいだ黙る**——
# **呼ぶ側が `fail_unknown` へ渡す**（判定不能は、送らない理由にしない）。
count_labelled() {
  local wanted="$1" list="$2" number labels label found=0
  [[ -n $list ]] || {
    printf '0'
    return 0
  }
  while IFS= read -r number; do
    [[ $number =~ ^[0-9]+$ ]] || continue
    labels="$(gh issue view "$number" --json labels --jq '.labels[].name')" || return 1
    while IFS= read -r label; do
      [[ $label == "$wanted" ]] || continue
      found=$((found + 1))
      break
    done <<<"$labels"
  done <<<"${list//,/$'\n'}"
  printf '%s' "$found"
}

ready="$(count_labelled "ready" "$ready_numbers")" || fail_unknown "ready の label"
in_progress="$(count_labelled "in-progress" "$progress_numbers")" || fail_unknown "in-progress の label"

for count in "$ready" "$in_progress" "$backlog" "$waiting"; do
  [[ $count =~ ^[0-9]+$ ]] || fail_unknown "件数が数値ではありません: $count"
done

# **「渡せるものが無い」と「渡す番だ」を分ける** (#312)。
#
# **`backlog > 0` だけを見ていたので、どちらも同じに見えていた。** **条件がまだ来て
# いない Issue しか残っていないと、master は毎周回「昇格の番」と言われながら
# 何も昇格させられない**——**その間 `no-work` は 1 度も積まれない**ので、
# **3 周で人を呼ぶ仕掛けが、呼ぶべき場面で黙る**（#47 が塞いだ形が、別の場所に開いていた）。
#
# **判断は state から取る。** **`waiting-condition` は master が「今は渡さない」と
# 決めた時点で付ける印**である——**記憶に置くと、セッションが落ちた時点で消え、
# 次の周回は同じ判断をやり直すだけ**になる（どこにも出てこない）。
#
# **負に振れても、そのまま渡さない側へ落ちる。** **数え直しの隙間で `waiting` が
# `backlog` を超えうる**（label の付け替えの途中）——**下の判定は `> 0` なので、
# 負は「渡せない」へ倒れる。** **0 で丸めない**——**丸めても判定は変わらず、
# 試験で守れない枝が 1 つ増えるだけ**である（**積みすぎても人が呼ばれるだけだが、
# 積み損ねると誰も来ない**——**倒れる向きはこのままで正しい**）。
promotable=$((backlog - waiting))

# 判断に使う状態。**指紋もここから作る**（別の値から作ると、判断が変わっていないのに
# 指紋だけ変わって 2 通目が飛ぶ）。
# **`parked` な PR が食っている枠は「着手中」に数えない**（master のステップ 6 と同じ理由）。
# 保留した PR の Issue は `in-progress` のまま残るので、数えると
# **保留中はいつも「渡すものが無い」**になり、**保留がいちばん埋めたかった沈黙を作る**。
#
# **数え方は `bin/loop-parked-issues` が 1 つだけ持つ** (#318)。**ここと master の
# ステップ 6 が同じ数え方を書いていた**ので、**片方だけ直すと食い違う**（`AGENTS.md` §5）
# ——**`Closes` の無い保留 PR も枠を食う**という判断は、そちらに書いてある。
#
# **同じ一覧から数える。** **取り直さず、いま取れているものを渡す**——
# **別の口で取り直すと、そこだけ古い値になりうる。**
# **読めなければ止める**（`fail_unknown`）。**0 件へ倒すと、着手中が引かれないまま
# 「渡すものがある」に見える。**
parked_slots="$(
  while IFS="$FIELD" read -r number labels _head _labeled_at _pushed_at body || [[ -n $number ]]; do
    [[ -n $number ]] || continue
    printf '%s%s%s%s%s\n' "$number" "$FIELD" "$labels" "$FIELD" "$body"
  done <<<"$prs" | "${BASH_SOURCE[0]%/*}/loop-parked-issues"
)" || fail_unknown "保留した PR が食っている枠"
parked_issues=0
if [[ -n $parked_slots ]]; then
  mapfile -t parked_lines <<<"$parked_slots"
  parked_issues=${#parked_lines[@]}
fi
((in_progress -= parked_issues))
((in_progress < 0)) && in_progress=0

# **手が何本あるか** (#302)。**周回を回している worker の作業場の数**である。
#
# **ここでは数えない。** **同じ生死を `bin/loop-stall` が既に数えている**
# （`scan_alive_scopes`。#289 / #290）ので、**そちらへ訊く**——**写しを持つと、
# 片方だけ直したときに食い違う**（`AGENTS.md` §5）。
#
# **読めなければ 1 本とみなす。** **`in_progress < 1` は、これまでの
# `in_progress == 0` と同じ**——**分からないほうへ倒しても、渡しすぎにならない。**
#
# **数えられなかった理由は、ここで捨てない** (#310)。**言うようにした側（#304 / #308）の
# 読み手はここだけ**で、**`2>/dev/null` にすると「本当は 2 人いるのに 1 本」へ倒れたことが
# 周回の出力のどこにも出ない**——**#302 が消しに来た沈黙が、原因を変えて戻る。**
#
# **受け取ったものをそのまま流す**（**二重に言わない**）。**数えられた周回では
# `bin/loop-stall` は何も書かない**ので、**正常な周回で増えるものは無い。**
hands=1
if alive="$("${BASH_SOURCE[0]%/*}/loop-stall" --alive-workers 2>&1)" &&
  [[ $alive =~ ^[0-9]+$ ]]; then
  ((alive > hands)) && hands="$alive"
else
  [[ -z $alive ]] || echo "$alive" >&2
  echo "[WARN] 生きている作業場を数えられないので、手は 1 本として扱います" >&2
fi
readonly hands

# **PR の中身も指紋に入れる。** label と件数だけだと、**往復すると元の値へ戻る**——
# 直して push した周回も、指摘を返した周回も「同じ状態」と読まれて黙った（#105）。
# **head SHA は「変われば前へ進んだ」を表す値**なので、時刻のように毎回変わる値を
# 入れるのとは違う（`bin/loop-stall` の識別子と同じ制約を満たす）。
# **未解決スレッド数も要る。** push が無くても master が指摘を返せば状態は動く。
# **理由の無い保留も指紋に入れる。** **理由を投稿し直しても `prs` にも `details` にも
# 現れない**（issue コメントはどちらにも入らない）ので、**入れないと「送信済み」のまま**
# になる——**その PR の話だけでなく、`ready` を worker へ渡す通知も同じ指紋で止まる**。
# **「直したら止まる」がいちばん悪い形**である (#163)。
#
# **番号だけを入れる。** 時刻を入れると**変わらないはずのもので指紋が動く**ので、
# **「同じ状態では 2 通目を送らない」を壊す側**に倒れる。
#
# **ただし、世界全部を指紋にしない** (#274)。**上の値をすべて並べると、
# 理由が同じでも、無関係な数が動いただけで「新しい状態」になる**——
# **CI が pending から success へ進んだだけ / master が別の Issue を起票しただけ**で
# 再送されていた（どちらも実測）。**受け取る側は本文を読まなくなり、
# 本当に新しい 1 通がその中に埋もれる。**
#
# **指紋は「選ばれた枝が読んだものだけ」から作る。** 枝ごとに `witness` を組み立て、
# **理由と合わせて 1 つの鍵にする**（下の分岐を参照）。**理由だけを鍵にはしない**
# ——**同じ文面のまま状況が変わる**（指摘が 1 件増えても文面は同じ）ので、
# **狭めすぎると、変わったのに黙る**（#258 が塞いだ向きへ倒れる）。

# その PR について、**判断に効く入力だけ**を並べる。
# **head は「変われば前へ進んだ」**、**未解決の数と最後の発言 ID は「指摘が動いた」**
# を表す。**どちらも時刻ではない**（`bin/loop-stall` の識別子と同じ制約）。
pr_witness() {
  printf 'pr=%s|head=%s|detail=%s:%s' \
    "$1" "${head_of[$1]-}" "${unresolved_of[$1]-}" "${last_comment_of[$1]-}"
}

changes_requested=""
gateable=""
# **label と実態の食い違い。** 未解決が残っているのに `changes-requested` が無い状態で、
# 運用が壊れている（付け忘れではなく、**付ける段が無い経路がある**）。
mismatched=""
# **答えを待っている側**の PR（未解決があり、最後に書いたのが自分たちの役）。
answered=""
# **当否がまだ判断されていない指摘がある** PR。**動けるのは master だけ**である。
untriaged=""
while IFS="$FIELD" read -r number labels _head _labeled_at _pushed_at _body; do
  [[ -n $number ]] || continue
  unresolved="${unresolved_of[$number]-0}"
  [[ $unresolved =~ ^[0-9]+$ ]] || fail_unknown "未解決スレッド数が数値ではありません: $unresolved"
  untriaged_here="${untriaged_of[$number]-0}"
  requested_here="${requested_of[$number]-0}"
  if [[ ",$labels," == *",parked,"* ]]; then
    :
  elif ((untriaged_here > 0)); then
    # **まだ誰も答えておらず、当否も判断されていない。**
    # **`changes-requested` を付け外しできるのは master だけ**なので、
    # ここを worker 宛にすると **worker の周回は自分宛て → 沈黙**になり、
    # **master は自分の周回まで気づけない**。その間ずっと下の食い違いが記録され、
    # **PR が健全でも 3 周で `loop/STOP`** に達する（#149 / #152 で実際に踏んだ）。
    untriaged="${untriaged:+$untriaged }$number"
    # **食い違いは「label が 1 つも付いていない」ときだけ**である。
    # 既に付いている PR へ新しい指摘が届いた状態は、**運用が壊れているのではない**——
    # 渡す先が master だというだけなので、ここで記録すると**正常な受け渡しで人を呼ぶ**。
    [[ ",$labels," == *",changes-requested,"* ]] || mismatched="$number"
  elif ((requested_here > 0)); then
    # 当否は判断済み（その指摘が見えている時点で label が付いている）。直すのは worker
    changes_requested="${changes_requested:+$changes_requested }$number"
  elif ((unresolved > 0)); then
    # **件数だけでは持ち手が決まらない。** 同じ「未解決 1 件」に
    # 「指摘が返ってきた直後」と「直して返信し終えた直後」が混ざっている。
    # **役は同じアカウントで動く**ので、GitHub 側の名前では見分けられない——
    # **呼んだ側は、その周回で書き終えている**ので、渡す先は相手役である。
    answered="${answered:+$answered }$number"
  elif [[ ",$labels," == *",changes-requested,"* ]]; then
    changes_requested="${changes_requested:+$changes_requested }$number"
  else
    gateable="${gateable:+$gateable }$number"
  fi
done <<<"$prs"

# 上から順に見る。**具体的な持ち物がある側だけ**が持ち手になる。
#
# **枝は排他である。** **ふつうの呼び出しは、最初に当たった枝で決まる**——
# **渡す相手は 1 人で、通知も 1 通**だからである。
#
# **`--who` は続きを読む** (#362 のレビュー)。**訊いているのは「自分の番はどれか」**で、
# **上の枝が相手の番でも、下に自分の番があれば、それが答え**である——**そこで止めると、
# 手番を持っている PR が小さい / 古い PR に毎周回負ける**（**#360 の芯がそのまま残る**）。
#
# **進めるのは枝ではなく PR である** (#362 の 2 度目のレビュー)。**`answered` は枝の中で
# 宛先が PR ごとに割れる**——**他の枝は入った時点で宛先が決まる**のに、**あそこだけ
# 「最後の発言の印」で反転する** (#174)。**master が 2 本に要求を出し、片方だけ worker が
# 返した**、それだけでこの形になる——**枝ごと飛ばすと、その 2 本目が出てこない。**
#
# **見た PR を覚えておいて、次の周で飛ばす。** **ふつうの呼び出しでは 1 周で抜ける**ので、
# **`bin/loop-ci-status` への問い合わせが増えるのは `--who` だけ**である。
skip_prs=""
# **飛ばしたぶんを除いた一覧を返す。** **枝の条件も、選ぶ PR も、witness も、
# ここを通したものだけを見る**——**1 件目だけを見て全体の答えにしない** (#349 / #362)。
unskipped() {
  local number out=""
  for number in $1; do
    [[ " $skip_prs " == *" $number "* ]] && continue
    out+="${out:+ }$number"
  done
  printf '%s' "$out"
}
# **枝を最後まで歩いて、役ごとに集める** (#359)。**指紋を「当たった 1 枝」で作ると、
# 前の枝が続いている間、後ろの枝の材料が指紋に入らない**——**`changes-requested` の枝に
# 入っているあいだ `ready` が 0 から 1 になっても、同じ状態と読む**（**空いた worker は
# 次の cron まで動かない**。**症状は「何も起きていない」**）。
#
# **その役が動ける枝を全部集めたものが、その役の状態**である。
declare -a entry_to=() entry_reason=() entry_branch=() entry_witness=() entry_pr=()
while :; do
silent_park_left="$(unskipped "$silent_park")"
untriaged_left="$(unskipped "$untriaged")"
answered_left="$(unskipped "$answered")"
changes_requested_left="$(unskipped "$changes_requested")"
gateable_left="$(unskipped "$gateable")"
if [[ -n $silent_park_left ]]; then
  picked="$silent_park_left"
  # **忘れられる側にある**ので、いちばん先に見る (#163)。**ステップ 2 は `parked` を
  # 選ばない**ので、**ここで渡さないと誰もその PR を見ない**。
  # **直せるのは master** である (理由を投稿し直すか、保留を戻す)。
  to="master"
  reason="PR #${silent_park_left} が理由の無い保留になっている（理由を投稿し直すか、保留を戻す）"
  # **読んだのは「理由の無い保留がある」ことだけ**である
  branch="silent-park"
  witness="silent-park=${picked}"
elif [[ -n $untriaged_left ]]; then
  picked="${untriaged_left%% *}"
  # **当否を判断できるのは master だけ**である。**放っておくとループが止まる側**なので、
  # 他の持ち物より先に見る。
  to="master"
  reason="PR #${picked} の指摘が未処理（当否を判断して changes-requested を付けるか、外出しする）"
  branch="untriaged"
  witness="$(pr_witness "$picked")"
elif [[ -n $answered_left ]]; then
  picked="${answered_left%% *}"
  # **誰が書いたかは、発言の印で読む** (#174)。**呼んだ役では決めない。**
  #
  # **前は「呼んだ側は、その周回で書き終えている」で代用していた**——**前提であって
  # 事実ではない。** **worker の返信を master の判断として読むと、当否が判断されて
  # いない指摘が「判断済み」に落ちる**（**通す側へ倒れるので気づけない**）。
  # **代用はやめた**——**印で分かるなら、呼んだ役を見る理由が無い。**
  #
  # **印の無い発言は worker の返信として扱う。** **この仕組みより前のコメントと、
  # 人が手で書いたものがそこに入る**——**master 扱いにすると、この Issue が挙げた
  # 誤認そのものを既定にする。** **worker 扱いなら倒れる先は「master が確認する」**で、
  # **止まる側**である。
  #
  # **役で反転しても、同じ状態である** (#173 のレビュー)。**理由の文面を鍵にすると、
  # 同じ指摘について master→worker と worker→master で 2 通出る**——
  # **鍵は枝の名前で持ち、文面は持たない。**
  branch="answered"
  witness="$(pr_witness "$picked")"
  if [[ ${last_body_of[$picked]-} == *"${ROLE_MARK[master]}"* ]]; then
    # master が書いた（要求・質問）。**直すのは worker**
    to="worker"
    reason="PR #${picked} に未解決の指摘がある"
  else
    to="master"
    # **状態から読めることだけを言う。** 「対応が返っている」とは書かない——
    # **出口は「何もしなかった場合も含めて必ず通す」**ので、**何も書いていない周回も
    # ここへ来る**。**書いた前提で文を作ると、していないことを言う** (#173 のレビュー)。
    reason="PR #${picked} の未解決スレッドの最後の発言が bot ではない（確認して resolve できる）"
  fi
elif [[ -n $changes_requested_left ]]; then
  # **要求が満たされたかを見る** (#384)。**label が持っているのは「master が確認したか」**
  # で、**受け渡しが答えたい問いは「要求が満たされたか」**である——**`changes-requested`
  # を外すのは master だけ**なので、**worker が直して押したあとも label は残り、
  # 受け渡しは worker を指し続ける**（**呼ばれて、見て、何も無くて、返す**）。
  #
  # **押されていない PR を先に選ぶ**——**探しているのは「まだ直していない PR」**であって、
  # **先頭の PR の状態ではない**（#349 / #362 と同じ形。**1 件目だけを見て全体の
  # 答えにしない**）。
  picked=""
  pushed_picked=""
  for candidate in $changes_requested_left; do
    if [[ -n ${pushed_of[$candidate]-} && -n ${requested_at_of[$candidate]-} &&
      ${pushed_of[$candidate]} > ${requested_at_of[$candidate]} ]]; then
      # **要求より後に押されている。** **次に動くのは master** である
      [[ -n $pushed_picked ]] || pushed_picked="$candidate"
      continue
    fi
    picked="$candidate"
    break
  done
  if [[ -n $picked ]]; then
    to="worker"
    reason="PR #${picked} に master の要求が残っている"
  else
    picked="$pushed_picked"
    to="master"
    reason="PR #${picked} は要求のあとに押されている（確認して label を外せる）"
  fi
  # **CI は見ない。** **要求が残っているかどうかは、CI が進んでも変わらない**
  branch="changes-requested"
  witness="$(pr_witness "$picked")"
elif [[ -n $gateable_left ]]; then
  # **ゲートを回せる PR でも、コンフリクトしていれば行き先が違う** (#347)。
  # **master が指摘を resolve して label も外した直後**、**上の 2 つの手掛かりが
  # 両方消え**、**残っている `mergeable` を見ていなかった**——**どちらの役も呼ばれず、
  # 症状は「何も起きていない」**なので気づけない（#346 で実測）。
  #
  # **判定は `bin/loop-ci-status` が持っている** (`AGENTS.md` §5)——**`bin/loop-gate` が
  # 「コンフリクトしているため実行が作られない」と出せるのはあの判定があるから**で、
  # **ここへ書き写すと、片方だけ直したときに食い違う。**
  #
  # **候補は全部見る** (#349 のレビュー)。**探しているのは「取り込み直しが要る候補」で
  # あって「先頭の候補の状態」ではない**——**先頭が `MERGEABLE` で後続が
  # `CONFLICTING` のとき、先頭だけを見ると「ゲートを回せる」になり**、**後続の
  # 取り込み直しは誰にも依頼されない**（**この枝が消しに来た沈黙を、この枝自身が作る**）。
  conflicting=""     # 取り込み直しが要る（確定）
  computing=""       # まだ計算中（`UNKNOWN`）
  # **`mergeable` も指紋に載せる。** **候補ごとに載せる**ので、
  # **どれか 1 本の状態が動いた瞬間に指紋も動く**——**解けたら次の枝へそのまま移る。**
  # **同じ PR を 2 度引かない** (#363 のレビュー)。**枝は歩くたびに残りを見る**ので、
  # **その都度引き直すと N(N+1)/2 回**になる——**`--who` は毎周回打たれる**ので、
  # **常時のコスト**である。**状態は周回の中で変わらない**（**同じ盤面を読んでいる**）。
  read -ra gateable_all <<<"$gateable_left"
  mapfile -t gateable_sorted < <(printf '%s\n' "${gateable_all[@]}" | sort -n)
  for candidate in "${gateable_sorted[@]}"; do
    if [[ -z ${mergeable_of[$candidate]-} ]]; then
      "${BASH_SOURCE[0]%/*}/loop-ci-status" --conflicting "$candidate" >/dev/null
      case "$?" in
        0) mergeable_of[$candidate]=1 ;;
        1) mergeable_of[$candidate]=0 ;;
        3) mergeable_of[$candidate]=2 ;;
        # **判定不能を「していない」へ倒さない**——**倒すと、コンフリクトしている PR が
        # master 宛てになり、ゲートで落ちるだけで誰も直さない。**
        *) fail_unknown "PR #${candidate} がコンフリクトしているか" ;;
      esac
    fi
    case "${mergeable_of[$candidate]}" in
      1) conflicting="${conflicting:+$conflicting }$candidate" ;;
      2) computing="${computing:+$computing }$candidate" ;;
    esac
  done
  if [[ -n $conflicting || -n $computing ]]; then
    # **起こす先は worker ではない** (#349 のレビュー)。**取り込み直せるのは著者だけ**だが、
    # **worker は通知の本文で分岐せず、GitHub 側の裏付けを見る**——**label も未解決
    # スレッドも無い PR で起こしても、実行できる指示がどこにも無い**ので、
    # **訊きに戻るだけ**である（**実測: worker-1 が #348 について「自分の判断では
    # rebase しません」と訊いてきた**。**手順書が「指示が来てから行う」と決めている**）。
    #
    # **worker を指すと、この枝が消しに来た沈黙を worker 側に作る**——
    # **worker の周回では自己通知が抑止される**ので、**誰も起きない。**
    #
    # **`to=master` は沈黙ではない**（**worker が通れば master が起き、master が
    # 通れば自分の周回でそのまま見る**）。**#347 が解いたのは
    # 「どちらの役も呼ばれない」**であって、**「master を指すこと」ではない。**
    #
    # **鎖はここで終わらない。** **master が `changes-requested` を付けた時点で
    # `gateable` から外れ**、**既存の枝が worker を指す**——**新しい経路は要らない。**
    to="master"
    branch="conflicting"
    if [[ -n $conflicting ]]; then
      picked="${conflicting%% *}"
      reason="PR #${picked} がコンフリクトしている（取り込み直しを指示する）"
    else
      # **計算中（`UNKNOWN`）も同じ側へ渡す。** **「していない」ではない**ので
      # **「ゲートを回せる」に混ぜない**——**混ぜると、ゲートが落ちるのを見るだけで、
      # 取り込み直しの指示は残らない。** **確かめられるのは master だけ**である。
      picked="${computing%% *}"
      reason="PR #${picked} のコンフリクトの有無が計算中（確定したら取り込み直しを指示する）"
    fi
    # **CI は読まない。** **コンフリクトしている間、必須チェックは作られない**
    witness="$(pr_witness "$picked")|mergeable=${mergeable_of[$picked]-}"
  else
    to="master"
    picked="${gateable_left%% *}"
    reason="PR #${picked} のゲートを回せる"
    branch="gateable"
    # **ここでは CI も読む。** **ゲートが落とす条件そのもの**なので、
    # **外すと、マージできるようになった、まさにその瞬間に黙る** (#125 / #173 のレビュー)
    witness="$(pr_witness "$picked")|checks=${checks_of[$picked]-}|mergeable=${mergeable_of[$picked]-}"
  fi
elif ((ready >= 1 && in_progress < hands)); then
  # **PR ではないので、ここから先へは進めない**（`--who` は次の周で止まる）
  picked=""
  # **件数で絞らない** (#267)。**等号だと 2 件でどの枝にも入らず、
  # 「相手に持ち物が無い」と読まれて終わる**——**いちばん渡したい瞬間に落ちる。**
  #
  # **重複の抑止は指紋が別に持っている**ので、**緩めても 2 通目は出ない。**
  #
  # **着手中は「手の本数」と比べる** (#302)。**`in-progress == 0` は worker が 1 人の
  # ときの言い換え**で、**2 人いると、着手中 1 件は「片方が塞がっている」でしかない**
  # ——**空いた側は `ready` に仕事があっても起こされない。**
  # **人数は書き写さない**（作業場は `./task loop:worker:add` で増える）。
  to="worker"
  reason="ready の Issue が ${ready} 件ある"
  # **`backlog` は読んでいない。** **起票や昇格で動くだけ**で、渡す理由は変わらない
  branch="ready"
  witness="ready=${ready}|in-progress=${in_progress}"
elif ((promotable > 0 && ready == 0)); then
  picked=""
  to="master"
  reason="昇格できる backlog が ${promotable} 件あり、ready が 0 件（昇格の番）"
  # **件数までは見ない。** **「1 件でもあるか」しか判断に使っていない**
  branch="promote"
  witness="ready=${ready}|promotable=$((promotable > 0))"
else
  # ここは `bin/loop-stall` が `no-work` として数える領域である。
  #
  # **記録は通す。** **何も渡さない周回でも、状態が動いたことは残す**——
  # **残さないと、前に送った理由の記録が古くならず、同じ理由が次に立ち上がったとき
  # 「送信済み」として黙る**（**狭めた指紋では、これが起きやすい**）。
  to=""
  reason=""
  branch="no-work"
  # **昇格できない `backlog` は、ここへ落ちる** (#312)。**件数も残す**——
  # **条件待ちが解けた瞬間に指紋が動く**ので、**そのとき master が起こされる**
  witness="ready=${ready}|in-progress=${in_progress}|backlog=${backlog}|promotable=${promotable}"
  picked=""
fi

# **当たった枝を覚えて、次の PR へ進む。**
# **PR を持たない枝（`ready` / `promote` / `no-work`）は、そこで止まる**
# ——**進める先が無いのに回ると終わらない。**
entry_to+=("$to")
entry_reason+=("$reason")
entry_branch+=("$branch")
entry_witness+=("$witness")
entry_pr+=("$picked")
[[ -n $picked ]] || break
skip_prs="$skip_prs $picked"
done

# **役ごとに指紋を持つ** (#359)。**その役が動ける枝を、上から順に並べたもの**である。
#
# **どの枝に入ったかと、その枝が読んだ入力**を鍵にするのは #274 のまま——
# **盤面ぜんぶを鍵にしない**（**何も動いていないのに通知が飛ぶ**）。**変えたのは
# 「1 枝ぶん」から「その役のぶん」への広げ方だけ**である。
#
# **理由の文面は鍵にしない。** **`answered` は印で宛先が割れる**ので、
# **文面を入れると、同じ指摘について 2 通出る** (#173 のレビュー)。
#
# **持ち物が無い役は `on=none`。** **毎周回同じ値**なので、**そこでは何も起きない。**
# **枝の候補ぜんぶを指紋にする** (#292 のレビュー)。**選ぶのは 1 件だが、指紋を
# 1 件ぶんにすると、もう 1 件が動いても状態は同じ**——**送らない。** **枝を最後まで
# 歩くので、その役の PR は全部ここに並ぶ。**
#
# **並びは番号順にする。** **`gh` の返す順に依存すると、並びが変わっただけで
# 別状態になる**——**何も動いていないのに通知が飛ぶ**（#274 が減らそうとした側）。
declare -A witness_of=()
for index in "${!entry_to[@]}"; do
  witness_of["${entry_to[$index]}|${entry_branch[$index]}|${entry_pr[$index]}"]="${entry_witness[$index]}"
done
declare -A state_of=()
for role in "${ROLES[@]}"; do
  state_of[$role]=""
  seen_branches=""
  for index in "${!entry_to[@]}"; do
    [[ ${entry_to[$index]} == "$role" ]] || continue
    entry_branch_name="${entry_branch[$index]}"
    [[ " $seen_branches " != *" $entry_branch_name "* ]] || continue
    seen_branches="$seen_branches $entry_branch_name"
    # **その役・その枝のぶんを、PR 番号順に並べる**（**PR を持たない枝は 1 件だけ**）
    group_prs=""
    for other in "${!entry_to[@]}"; do
      [[ ${entry_to[$other]} == "$role" && ${entry_branch[$other]} == "$entry_branch_name" ]] ||
        continue
      group_prs="${group_prs:+$group_prs }${entry_pr[$other]}"
    done
    group=""
    read -ra group_all <<<"$group_prs"
    mapfile -t group_sorted < <(printf '%s\n' "${group_all[@]}" | sort -n)
    for number in "${group_sorted[@]}"; do
      group+="${group:+;}${witness_of["${role}|${entry_branch_name}|${number}"]-}"
    done
    # **PR を持たない枝**（`ready` / `promote` / `no-work`）は、その枝の材料をそのまま
    [[ -n $group ]] || group="${entry_witness[$index]}"
    state_of[$role]+="${state_of[$role]:+;}on=${entry_branch_name}|${group}"
  done
  # **持ち物が無い役は `on=none`。** **毎周回同じ値**なので、**そこでは何も起きない**
  [[ -n ${state_of[$role]} ]] || state_of[$role]="on=none"
done

# **渡すのは相手役だけ** (#92。**自分自身へは送らない**)。**自分の番が上にあっても、
# 下に相手の番があれば渡す** (#359)——**役は 2 つで、自己通知は抑止される**ので、
# **出口が出す通知は、これまでどおり多くて 1 通**である（**手順書は変わらない**）。
to=""
reason=""
for index in "${!entry_to[@]}"; do
  [[ -n ${entry_to[$index]} && ${entry_to[$index]} != "$ROLE" ]] || continue
  to="${entry_to[$index]}"
  reason="${entry_reason[$index]}"
  break
done
readonly STATE="${state_of[${to:-$ROLE}]}"

# **「送った」と「見た」を分ける** (#125)。
#
# **記録が「送った」を意味していないのに、「送った」として使われていた。**
# すべての役の記録を分岐の前に更新していたので、**送らずに終わった周回でも
# 「この状態は配った」ことになる**——
#
#   worker  push → 自分宛て → exit 1（送らない）→ **両方の記録に状態を書く**
#   master  CI の失敗を見つける → 記録と同じ → exit 1（送信済みとして抑止）
#
# **どちらも送っていないのに、2 通目として弾かれる** (#124)。**倒れる向きが悪い**——
# **同じ状態が続く限りずっと届かず**、**正常に周回しているので停止としても数えられない**。
#
# **かといって、受け手のぶんだけを送ったときに書く形にはできない。** それだと
# **A→B→A と戻ったときの 3 通目が出ない**（記録が A のままで「送信済み」と読む）。
#
# **記録に「どちらか」を書く。**
#
#   observed … その状態を**誰かが見た**（**送ってはいない**）
#   informed … その役へ**実際に送った**
#
# **抑止に使うのは `informed` だけ**で、**`observed` は「前の `informed` を古くする」
# ためだけに置く**（状態が動いたことを覚えておく場所）。
# **読むだけの周回は、ここで答えて終わる** (#360)。**記録も送信待ちも書かない**
# ——**並べ替えのために毎周回打つ**ので、**打っただけで指紋が動くと、その周回は
# 「もう伝えた」ことにされ**、**出口の 1 通が消える。**
#
# **自分の番でも答える**（**そこが訊きたいところ**である）。**抑止も見ない**
# ——**「同じ状態を既に伝えたか」は送るときの問い**で、**「いま誰の番か」とは別**である。
if ((peek == 1)); then
  for index in "${!entry_to[@]}"; do
    [[ ${entry_to[$index]} == "$ROLE" ]] || continue
    printf '%s\t%s\n' "${entry_to[$index]}" "${entry_reason[$index]}"
    exit 0
  done
  exit 1
fi

lock_records

# **判断し直す周回は、前の送信待ちを引き継がない** (#258)。**残すと、あとから
# `--sent` が通ったときに、配っていない状態を「送信済み」にする。**
rm -f "$PENDING" || {
  echo "[FAIL] 送信待ちの記録を消せません: $PENDING" >&2
  exit 2
}

declare -A informed=()
for role in "${ROLES[@]}"; do
  record="$(role_record "$role")"
  stored="$(cat "$record" 2>/dev/null || true)"
  # **印は 1 列目**。状態そのものにも `$FIELD` が入るので、**最初の 1 つだけ**を剥がす。
  # **前の版が書いた記録には印が無い**（状態がそのまま入っている）。その場合は
  # 印が一致しないので「見ただけ」に落ちる——**多く送る側へ倒れる**ので害が無い
  # （`bin/loop-lease` の 1 行目と同じで、**記録は版をまたいで共有される**）。
  if [[ ${stored%%"$FIELD"*} == "$INFORMED" && ${stored#*"$FIELD"} == "${state_of[$role]}" ]]; then
    # **送った記録は、上書きしない。** 上書きすると、**受け取った側が自分の周回を
    # 回しただけで「まだ送っていない」に戻り**、**送り合いになる**。
    informed[$role]=1
    continue
  fi
  informed[$role]=""
  printf '%s' "${OBSERVED}${FIELD}${state_of[$role]}" >"$record" || {
    echo "[FAIL] 送信記録を書き込めません: $record" >&2
    exit 2
  }
done

# **「送るかどうか」と「記録するかどうか」は別の判断である。**
#
#   重複抑止      … 送り合いを防ぐ。**前回と同じ状態か**を見る
#   食い違いの記録 … 気づかないまま続くのを防ぐ。**食い違いが今あるか**を見る
#
# **同じ条件で両方を決めると、記録が 1 回で止まる**（送らない周回はここへ来ないので、
# 3 周に到達せず人を呼べない）。**気づかせたい状態でだけ黙る**ことになる。
#
# **渡す相手がいない周回より先に見る** (#359)。**食い違いは、渡す相手の有無とは
# 別のこと**である——**後ろに置くと、自分の番しか無い盤面で黙る**（**そこがまさに
# `untriaged`＝master の番**なので、**いちばん出したい場面で出なくなる**）。
# **master がまだ見ていないだけの状態を、食い違いとして数えない** (#440)。
#
# **レビューが着いた PR は、master が判定するまで「未解決があるのに
# `changes-requested` が無い」に見える**——**master は 1 周に 1 本しか見ない**ので、
# **PR が 2 本並べば、必ず片方がこの形になる。** **2026-08-24 の 1 日で 3 回出て、
# 3 回とも master が手で `--reset` している**（**消し忘れれば、異常なしで人が呼ばれる**）。
#
# **時刻では切らない**（#129。**遅い周回と落ちた周回は、経過時間では分けられない**）
# ——**master の周回が進んだかで見る**（`bin/loop-cadence` と同じ物差し）。
#
# **同じ状態のまま、master の周回が 2 つ進んだら数える。** **2 つなのは、
# 「1 周に 1 本」で PR が 2 本並びうるから**である（**1 人 1 本・全体で 2 本**）
# ——**1 つだと、master が正しくもう一方を見ている周回で鳴る。**
#
# **状態が変われば、数え直す。** **witness（head・未解決の数・最後の発言）が動けば、
# それは別の食い違い**である。
#
# **master の周回を読めないときは数えない**——**「見送った」と言える根拠が無い。**
# **WARN は出す**ので、黙って消えるのではない。
readonly MISMATCH_GRACE_ROUNDS=2

master_starts_after() {
  local since="$1" starts at _rest seen=0
  starts="$common_dir/valence-loop-starts-master"
  [[ -f $starts ]] || return 1
  while IFS=$'\t' read -r at _rest; do
    [[ $at =~ ^[0-9]+$ ]] || continue
    ((at > since)) && ((seen++))
  done <"$starts"
  printf '%s' "$seen"
}

# master の最後の周回（**いつを起点にするか**）。**読めなければ空。**
master_last_start() {
  local starts at _rest last=""
  starts="$common_dir/valence-loop-starts-master"
  [[ -f $starts ]] || return 1
  while IFS=$'\t' read -r at _rest; do
    [[ $at =~ ^[0-9]+$ ]] || continue
    [[ -n $last ]] && ((at <= last)) || last="$at"
  done <"$starts"
  [[ -n $last ]] || return 1
  printf '%s' "$last"
}

# **この食い違いを、master が見送ったと言えるか。**
mismatch_is_overlooked() {
  local number="$1" witness record stored_witness stored_at seen now_last
  witness="$(pr_witness "$number")"
  record="$common_dir/valence-loop-mismatch-$number"
  now_last="$(master_last_start)" || return 1
  if [[ -f $record ]] && IFS=$'\t' read -r stored_witness stored_at <"$record" 2>/dev/null &&
    [[ $stored_witness == "$witness" && $stored_at =~ ^[0-9]+$ ]]; then
    seen="$(master_starts_after "$stored_at")" || return 1
    ((seen >= MISMATCH_GRACE_ROUNDS)) && return 0
    return 1
  fi
  # **初めて見た状態**（あるいは状態が変わった）。**起点を置いて、今回は数えない。**
  printf '%s\t%s\n' "$witness" "$now_last" >"$record" ||
    echo "[WARN] 食い違いの起点を記録できません: $record" >&2
  return 1
}

mismatch_exit=0
if [[ -n $mismatched ]]; then
  echo "[WARN] PR #${mismatched}: 未解決スレッドがあるのに changes-requested がありません" >&2
  if mismatch_is_overlooked "$mismatched"; then
    mismatch_exit=3
  else
    echo "       master がまだ判定していないだけかもしれません（$MISMATCH_GRACE_ROUNDS 周ぶん待ちます）" >&2
  fi
fi

# **渡す相手がいなければ、ここで終わる**（記録は上で通してある）。
#
# **同じ状態で 2 通目を送らない。** 相手はもう知っている。
# どちらの場合も**記録は通す**——その状態が続いていること自体が、記録したい事実である。
if [[ -z $to || -n ${informed[$to]-} ]]; then
  if ((mismatch_exit == 3)); then
    # **出口の 2 手目が通るようにしておく** (#399)。**矛盾は記録してほしい**ので
    # **exit 3 のまま**だが、**送るものは無い**——**印を置いて、`--sent` に
    # 「送っていない」と分かるようにする**（**記録は上げない**）。
    printf '%s' "${NO_DESTINATION}${FIELD}${STATE}" >"$PENDING" || {
      echo "[FAIL] 送信待ちの記録を書き込めません: $PENDING" >&2
      exit 2
    }
    exit 3
  fi
  exit 1
fi

# **送ると決めただけでは、まだ届いていない** (#258)。**宛先と指紋を置いておき、
# 送信が成功して `--sent` が通ったときにだけ `informed` へ上げる。**
#
# **ここで `informed` を書くと、送信に失敗した周回が「送信済み」を作る**——
# **同じ状態では 2 通目を送らない**ので、**その状態では二度と送られない。**
#
# **何もしなかった周回とは分ける。** あちらは**誰にも配っていない**ので、
# **その状態を「届いた」と数えてはいけない**——それが #125 の本体である。
printf '%s' "${to}${FIELD}${STATE}" >"$PENDING" || {
  echo "[FAIL] 送信待ちの記録を書き込めません: $PENDING" >&2
  exit 2
}

printf '%s\t%s\n' "$to" "$reason"
exit "$mismatch_exit"
