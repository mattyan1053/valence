#!/usr/bin/env bash
# 周回の出口で、**次に動けるのは誰か**を決める。
#
#   exit 0 = 渡す相手がいる。`<役>\t<理由>` を stdout に出す
#   exit 1 = 渡さない (相手に持ち物が無い / 動けるのは自分 / 同じ状態で送信済み)
#   exit 2 = 状態を読めない / 使い方の誤り
#   exit 3 = 渡す相手はいる (出力は exit 0 と同じ) が、**状態が矛盾している**。
#            送ったうえで記録する
#
# **判断の根拠を 2 種類持たない。** ゲートは**未解決スレッド**を見て落とすのに、
# ここは **label** だけを見ていた。label が 0 件の PR は「master がゲートを回せる」と
# 読まれ、**自分宛なので黙る**。#103（手順書から外れた経路）と #107（**手順書どおり**の
# 経路。レビュースレッドへ返信する段に label を付ける指示が無い）で実際に起きた。
# **経路を数えるのではなく、状態から決める。**
#
# **通知は「〜した」ときにだけ送られていた。** 周回を終える経路は 9 つ以上あり、
# **何もせずに終わる経路には 1 つも通知が無い**ので、そこを通ると
# **次の cron まで誰も動かない**。列挙を足しても、経路が増えればまた漏れる
# (`bin/loop-procedure-changed` の「1 以外はすべて」と同じ理由)。
# **出口を 1 本にして、そこで必ず持ち手を決める。**
#
# **ping-pong を作らない。** 「暇そうだから起こす」を許すと
# 「やることなし → 起こす → やることなし → 起こす」で焼き切れる。
#
#   1. **相手に具体的な持ち物があるときだけ送る**
#   2. **同じ状態で 2 通目を送らない** (判断に使った状態そのものを覚えておく)
#   3. **自分自身へは送らない** (自分が動けるなら次の周回でやればよい)
#
# 覚えておく場所は `bin/loop-stall` と同じ **git の共通ディレクトリ**。
# 新しい保存先を増やすと、掃除する場所が増える。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
# shellcheck disable=SC2016
set -uo pipefail

readonly ROLES=(master worker)

usage() {
  echo "使い方: bin/loop-handoff <役>   役: ${ROLES[*]}" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage
readonly ROLE="$1"
role_is_known=1
for known in "${ROLES[@]}"; do
  [[ $known == "$ROLE" ]] && role_is_known=0
done
((role_is_known == 0)) || {
  echo "[FAIL] 未知の役: $ROLE（使えるのは ${ROLES[*]}）" >&2
  exit 2
}

# **読めなかったら「送らない」に倒さない。** 倒すと、止まっていることに気づけない。
fail_unknown() {
  echo "[FAIL] GitHub の状態を読み取れません: $1" >&2
  exit 2
}

prs="$(gh pr list --state open --limit 200 --json number,labels \
  --jq '.[] | "\(.number)\t\(.labels | map(.name) | join(","))"')" || fail_unknown "open PR"

# **未解決スレッドと head SHA を取る。** `gh pr list --json` は未解決スレッドを返さない
# ので GraphQL で取る。owner / repo は `{owner}` の置換が効かない（置換されるのは
# `gh api` のエンドポイントだけ）ので、先に引く。
repo_ref="$(gh repo view --json owner,name --jq '.owner.login, .name')" || fail_unknown "リポジトリ"
mapfile -t repo_parts <<<"$repo_ref"
details="$(gh api graphql --paginate \
  -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" \
  -f query='query($owner:String!,$repo:String!,$endCursor:String){
    repository(owner:$owner,name:$repo){
      pullRequests(states:OPEN,first:50,after:$endCursor){
        pageInfo{hasNextPage endCursor}
        nodes{number headRefOid reviewThreads(first:100){nodes{isResolved}}}}}}' \
  --jq '.data.repository.pullRequests.nodes[]
    | "\(.number)\t\(.headRefOid)\t\([.reviewThreads.nodes[] | select(.isResolved == false)] | length)"')" ||
  fail_unknown "未解決スレッド"
ready="$(gh issue list --label ready --limit 200 --json number --jq 'length')" || fail_unknown "ready"
in_progress="$(gh issue list --label in-progress --limit 200 --json number --jq 'length')" ||
  fail_unknown "in-progress"
backlog="$(gh issue list --label backlog --limit 200 --json number --jq 'length')" ||
  fail_unknown "backlog"

for count in "$ready" "$in_progress" "$backlog"; do
  [[ $count =~ ^[0-9]+$ ]] || fail_unknown "件数が数値ではありません: $count"
done

# 判断に使う状態。**指紋もここから作る**（別の値から作ると、判断が変わっていないのに
# 指紋だけ変わって 2 通目が飛ぶ）。
# **`parked` な PR に紐づく Issue は「着手中」に数えない**（master のステップ 6 と同じ理由）。
# 保留した PR の Issue は `in-progress` のまま残るので、数えると
# **保留中はいつも「渡すものが無い」**になり、**保留がいちばん埋めたかった沈黙を作る**。
parked_issues="$(gh pr list --state open --limit 200 --json number,labels,body \
  --jq '.[] | select([.labels[].name] | index("parked")) | .body' |
  grep -oE 'Closes #[0-9]+' | grep -oE '[0-9]+' | sort -u | wc -l)" || parked_issues=0
[[ $parked_issues =~ ^[0-9]+$ ]] || parked_issues=0
((in_progress -= parked_issues))
((in_progress < 0)) && in_progress=0

# **PR の中身も指紋に入れる。** label と件数だけだと、**往復すると元の値へ戻る**——
# 直して push した周回も、指摘を返した周回も「同じ状態」と読まれて黙った（#105）。
# **head SHA は「変われば前へ進んだ」を表す値**なので、時刻のように毎回変わる値を
# 入れるのとは違う（`bin/loop-stall` の識別子と同じ制約を満たす）。
# **未解決スレッド数も要る。** push が無くても master が指摘を返せば状態は動く。
readonly STATE="prs=${prs}|detail=${details}|ready=${ready}|in-progress=${in_progress}|backlog=${backlog}"

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}

# **状態を求めたら、いちばん最初にすべての役の記録を更新する。分岐はそのあと。**
# 分岐ごとに更新すると、**通らなかった分岐の記録が古いまま残り**、
# 行き先が戻ったときに「送信済み」と誤読する。**分岐が増えても同じ穴が開かない形にする。**
exec 9>"$common_dir/valence-loop-handoff.lock" || {
  echo "[FAIL] 送信記録のロックを作成できません" >&2
  exit 2
}
if ! flock -w "${LOOP_HANDOFF_LOCK_WAIT_SEC:-10}" 9; then
  echo "[FAIL] 送信記録のロックを取得できません" >&2
  exit 2
fi

declare -A previous=()
for role in "${ROLES[@]}"; do
  record="$common_dir/valence-loop-handoff-$role"
  previous[$role]="$(cat "$record" 2>/dev/null || true)"
  printf '%s' "$STATE" >"$record" || {
    echo "[FAIL] 送信記録を書き込めません: $record" >&2
    exit 2
  }
done

# 未解決スレッド数を PR 番号で引けるようにする。
declare -A unresolved_of=()
while IFS=$'\t' read -r number _head unresolved; do
  [[ -n $number ]] || continue
  unresolved_of[$number]="$unresolved"
done <<<"$details"

changes_requested=""
gateable=""
# **label と実態の食い違い。** 未解決が残っているのに `changes-requested` が無い状態で、
# 運用が壊れている（付け忘れではなく、**付ける段が無い経路がある**）。
mismatched=""
while IFS=$'\t' read -r number labels; do
  [[ -n $number ]] || continue
  unresolved="${unresolved_of[$number]-0}"
  [[ $unresolved =~ ^[0-9]+$ ]] || fail_unknown "未解決スレッド数が数値ではありません: $unresolved"
  if [[ ",$labels," == *",changes-requested,"* ]]; then
    changes_requested="$number"
  elif [[ ",$labels," == *",parked,"* ]]; then
    :
  elif ((unresolved > 0)); then
    # **ゲートが落とす PR は master の持ち物ではない。** 直すのは worker である
    changes_requested="$number"
    mismatched="$number"
  else
    gateable="$number"
  fi
done <<<"$prs"

# 上から順に見る。**具体的な持ち物がある側だけ**が持ち手になる。
if [[ -n $changes_requested ]]; then
  to="worker"
  reason="PR #${changes_requested} に master の要求が残っている"
elif [[ -n $gateable ]]; then
  to="master"
  reason="PR #${gateable} のゲートを回せる"
elif ((ready == 1 && in_progress == 0)); then
  to="worker"
  reason="ready の Issue が 1 件ある"
elif ((backlog > 0 && ready == 0)); then
  to="master"
  reason="backlog はあるが ready が 0 件（昇格の番）"
else
  # ここは `bin/loop-stall` が `no-work` として数える領域である。
  exit 1
fi

# **自分自身へは送らない。** 自分が動けるなら次の周回でやればよい
# （自己通知で新しい手順書に載れる保証も無い）。
[[ $to == "$ROLE" ]] && exit 1

# **同じ状態で 2 通目を送らない。** 相手はもう知っている。
[[ "${previous[$to]}" == "$STATE" ]] && exit 1

printf '%s\t%s\n' "$to" "$reason"

# **「送るものが無い」と「状態が矛盾している」を混ぜない。** 混ぜると、
# 食い違いが起きても**どこにも記録が残らない**（#105）。
if [[ -n $mismatched ]]; then
  echo "[WARN] PR #${mismatched}: 未解決スレッドがあるのに changes-requested がありません" >&2
  exit 3
fi
