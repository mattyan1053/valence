#!/usr/bin/env bash
# **切られた `./task check` の残りを落とす** (#571)。
#
#   bin/loop-check-kill <作業場の名前>
#
#   exit 0 = 残っていない（元から無かった / 落とせた）
#   exit 1 = 落とし切れなかった（残りを標準エラーへ出す）
#   exit 2 = 判定できない（使い方の誤り / 番号を訊けない）
#
# **`bin/loop-check-leftovers` は「落としてから打ち直すこと」と言うが、その手が無かった。**
# **打っても当たらない**——**しかも空振りしても何も言われない。**
#
# **出る番号はホスト側である**（あちらは `docker top` で並べる）——**`AGENTS.md` §2 は
# 「すべてコンテナ内で実行する」と言うので、打つ側はコンテナの中で落としに行く。**
# **そこにその番号は無い**（**実測: `docker exec … kill` は当たらない**）。
#
# **ホスト側からは落とせる。** **コンテナは `node` で走るが、ホストの UID 1000
# （実行している人）に写っている**ので、**`kill -0` が通る**（実測）。
# **だからここはホストで打つ**——**`docker` を引くのと同じ側である。**
#
# **グループごと落とす** (#574)。**番号の一覧では足りない**——**列挙してから送るまでの
# 間に `vitest` が worker を fork すると、その番号は一覧に無く、親が消えたあとは
# reparent される**（**名前でも親でも辿れない**）。**同じグループに入ることだけが
# 頼り**である（**`setsid` しないかぎり**）。
#
# **グループは自分で探さない** (`AGENTS.md` §5)。**「何がその走りのぶんか」は
# `bin/loop-check-leftovers --groups` が持っている**——**書き写すと、`test:watch` を
# 数えない規則が 2 箇所になる。** **他の作業場を見ないのも、あちらの性質である**（#186）。
#
# **落としたあと、確かめる。** **「何も起きない」を「落とせた」と読ませない**
# ——**この 1 行がこのスクリプトの存在理由である。**
#
# **確かめるのもグループである** (#574)。**名前で当てる側は、親が消えたあとの子に
# 当たらない**——**落とす側が木ごと落としているのに、確かめる側が名前で見ていた。**
# **`Z` を数えないのは `--alive` の側が持つ**（#572。**判定を 2 箇所に置かない**）。
#
# -e は使わない。落とし損ねても、最後まで確かめてから報告する。
set -uo pipefail

usage() {
  echo "使い方: bin/loop-check-kill <作業場の名前>" >&2
  echo "        exit 0 残っていない / exit 1 落とし切れなかった / exit 2 判定できない" >&2
  exit 2
}

[[ $# -eq 1 && -n ${1-} && ${1-} != --* ]] || usage
readonly WORKSPACE="$1"

# **同じディレクトリのものを呼ぶ**（`bin/loop-claim` と同じ引き方）。
# **試験は身代わりを差せる**——**実物のプロセスを触らないため**である。
here="${0%/*}"
readonly LEFTOVERS="${LOOP_CHECK_LEFTOVERS:-$here/loop-check-leftovers}"

# **`kill` は bash の組み込みである**——**PATH に身代わりを置いても当たらない。**
# **試験が差せる口を開けておく**（**実物のプロセスを触らないため**。`AGENTS.md` §4 の
# 「外部 I/O はモックせず、インメモリ実装を使う」と同じ向き——**ここでの「インメモリ」は
# 記録を書くだけの `kill` である**）。**既定は組み込み**で、外部の `kill(1)` に依存しない。
readonly KILL_CMD="${LOOP_CHECK_KILL_CMD:-kill}"

# **TERM で頼んでから、KILL で落とす。** **`vitest` は TERM で畳めることがある**
# ——**いきなり KILL にすると、書きかけの記録が残る。**
readonly GRACE_SEC="${LOOP_CHECK_KILL_GRACE_SEC:-2}"

groups="$("$LEFTOVERS" --groups "$WORKSPACE")"
case "$?" in
  # **落とすものが無い。** **打たない**——**打つと、新しい失敗モードが増えるだけ**である
  0) exit 0 ;;
  1) ;;
  # **「残っていない」へ倒さない** (#497)。**見ていないことを「居ない」にしない**
  *)
    echo "[WARN] 残りのグループを引けないので、落とせません" >&2
    exit 2
    ;;
esac

# **空で返ってきたら、落とすものが無いのと同じ**——**`kill` に空の引数を渡さない**
mapfile -t targets < <(printf '%s\n' "$groups" | grep -E '^[0-9]+$' || true)
((${#targets[@]})) || exit 0

# **負の番号がプロセスグループである。** **落ちなくても止めない**——**確かめるのは下**
# であり、**`kill` の終了コードで決めると「もう居ない」も失敗として数える。**
for pgid in "${targets[@]}"; do
  "$KILL_CMD" -TERM "-$pgid" 2>/dev/null
done
((GRACE_SEC > 0)) && sleep "$GRACE_SEC"
for pgid in "${targets[@]}"; do
  "$KILL_CMD" -KILL "-$pgid" 2>/dev/null
done

# **確かめるのもグループである** (#574)。**名前で当てる側は、親が消えたあとの子に
# 当たらない**——**落とす側が木ごと落としているのに、確かめる側が名前で見ていた。**
# **`Z` を数えないのは `--alive` の側が持つ**（#572。**判定を 2 箇所に置かない**）。
survivors="$("$LEFTOVERS" --alive "$WORKSPACE" "${targets[@]}")"
case "$?" in
  0) exit 0 ;;
  # **「判定できない」を「落とし切れなかった」に潰さない** (#572 のレビュー)
  2)
    echo "[WARN] 落としましたが、残っていないかを確かめられません" >&2
    exit 2
    ;;
esac

echo "[FAIL] 残りを落とし切れません:" >&2
printf '%s\n' "$survivors" >&2
echo "       重なると両方が倍かかります（#547）。人の判断が要ります" >&2
exit 1
