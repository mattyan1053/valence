#!/usr/bin/env bash
# いま commit してよい場所に居るかを見る。
#
#   exit 0 = ブランチの上に居る (commit してよい)
#   exit 1 = main の上に居る (止める)
#   exit 2 = 読めない (止める側へ倒す)
#
# **`main` の上で commit されたことが 2 回ある** (#68)。どちらも
# **ブランチは切られており、その後 `main` へ戻されて**、そのまま commit された。
#
#   15:08:23 checkout: moving from main to feat/…   ← ブランチは作られた
#   15:09:53 checkout: moving from feat/… to main   ← 戻された
#   15:13:52 commit:   ✨ feat: …                   ← main の上で commit
#   15:15:59 reset:    moving to origin/main        ← 気づいて修復
#
# **2 回とも、止めたのは仕組みではなく人である。** ループは何も知らないまま先へ進んだ。
# **気づかなければ、`git push` 1 回ぶんの距離で絶対ルールを破る。**
#
# **原因ではなく結果を止める。** 誰が `main` へ戻したかは特定できていないので、
# **commit しようとした時点で `main` に居るか**だけを見る——
# **「ブランチ作成の抜け」に寄せた検査は、実際に起きた経路を素通りする。**
#
# **判定はここだけが持つ。** hook (`.githooks/pre-commit`) は呼ぶだけである。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# **既定ブランチを remote に尋ねない。** `origin/HEAD` は fetch の状態しだいで
# 解決できず、**そのたびに「読めない」へ倒れて commit が止まる**。
# このリポジトリの既定は `main` で固定である (AGENTS.md)。
readonly PROTECTED="main"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "[FAIL] git の作業ツリーの中に居るかどうかを読み取れません" >&2
  echo "       commit してよい場所かどうかが分からないので、止めます" >&2
  exit 2
fi

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
status=$?
case "$status" in
  0) ;;
  # **detached HEAD。`main` ではないので、この検査の対象ではない。**
  # **rebase は detached のまま commit する**ので、ここで止めると
  # **手順書の `git rebase origin/main` が落ちる** (塞ぐ側が、通る道を塞ぐ)。
  #
  # **ただし、下の検査へは進む** (#376 のレビュー)。**worker は detached のまま
  # commit する**（手順書がそう書いている）ので、**ここで返すと、worker の主要な
  # 経路では check の記録を 1 度も見ない**——**錠を作って、通らない道に掛けることになる**
  # （#176 の裏返し）。
  1) branch="" ;;
  *)
    echo "[FAIL] いま居るブランチを読み取れません (git symbolic-ref が $status)" >&2
    echo "       commit してよい場所かどうかが分からないので、止めます" >&2
    exit 2
    ;;
esac

check_state() {
  # **`./task check` が終わったかどうかも見る** (#375)。**印は終わったときにしか
  # 書かれない**（`task` の `cmd_check`）**が、読む側を強いるものが無かった**
  # ——**2 つの作業場が、別々の日に「終わったこと」を読み違えて赤いものを push した。**
  #
  # **判定は `bin/loop-check-state` が持つ** (`AGENTS.md` §5)——**ここは行き先だけ。**
  # **判定する口が無いこと自体は、赤ではない** (#375)。**古い checkout・写した
  # 作業場では、hook とこのスクリプトだけがあって隣が無いことがある**——
  # **そこで全部の commit を止めると、直しに行く経路が閉じ込められる**（#184 の形）。
  # **`main` を守る側は、この下でこれまでどおり効く。**
  if [[ ! -x "${BASH_SOURCE[0]%/*}/loop-check-state" ]]; then
    echo "[WARN] bin/loop-check-state が無いので、./task check の合否を見ていません" >&2
    exit 0
  fi
  "${BASH_SOURCE[0]%/*}/loop-check-state" --verdict
  case "$?" in
    0) exit 0 ;;
    4)
      # **記録が無いのは「赤」ではない**——**打っていない人を止める口ではない。**
      # **ただし黙らない**（**通したことが、緑の証拠だと読まれないように**）
      echo "[WARN] この作業場に ./task check の記録がありません（合否は分かりません）" >&2
      exit 0
      ;;
    3)
      echo "[FAIL] ./task check がまだ走っています（終わっていません）" >&2
      echo "       終わるまで待ってから commit してください——**途中のログは緑に見えます**" >&2
      echo "       殺された周回も、ここへ来ます（記録は「走っている」のまま残る）:" >&2
      echo "         ./task check   # 走り直して、末尾の check-exit=<合否> を見る" >&2
      exit 1
      ;;
    1)
      echo "[FAIL] 直近の ./task check が赤で終わっています" >&2
      echo "       直してから、もう一度 ./task check を通してください" >&2
      echo "       （赤いまま commit すると、CI が拾うまで往復が 1 回増えます）" >&2
      exit 1
      ;;
    *)
      echo "[FAIL] ./task check の記録を読めません" >&2
      echo "       合否が分からないので、止めます（上の理由を読むこと）" >&2
      exit 2
      ;;
  esac
}

# **`main` の上かどうかを先に見る**——**緑でも `main` の上なら通さない。**
[[ $branch == "$PROTECTED" ]] || check_state

# **止めるだけでは、止まった側は次に何をすればよいか分からない。**
echo "[FAIL] $PROTECTED の上で commit しようとしています" >&2
echo "       このリポジトリは $PROTECTED へ直接 commit / push しません (AGENTS.md)" >&2
echo >&2
echo "       ブランチを切り直してから、もう一度 commit してください:" >&2
echo >&2
echo "         git switch -c <feat|fix|chore|refactor|docs>/<名前>" >&2
echo "         git commit ..." >&2
echo >&2
echo "       staged にあるものは、そのまま新しいブランチへ移ります" >&2
exit 1
