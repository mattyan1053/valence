#!/usr/bin/env bash
# PR の必須チェックが決着したかを、`status` と `conclusion` の両方で見る。
#
#   bin/loop-ci-status <PR番号>
#   bin/loop-ci-status --required-checks   必須チェック名を並べる (定数の問い合わせ)
#
#   exit 0 = 必須がすべて決着して成功
#   exit 1 = 決着して失敗 / 必須が見つからない (worker に直させる)
#   exit 3 = まだ決着していないが、予算の内 (待つ)
#   exit 4 = 決着しないまま予算を超えた (人を呼ぶ)
#   exit 2 = 読めない / 使い方の誤り
#
# **`status` と `conclusion` は別の軸である。** **実物が 105 分止まった** (#206)——
# **`conclusion=success` なのに `status=in_progress` のまま**で、
# **`gh pr checks` の `bucket` は `status` から導かれる**ので **pending と読まれた**。
# **master は毎周回「正しく何もしない」を選び、そのたびに永久へ近づいた。**
# **片方に丸めない** (#90「並べ忘れた値がどの分岐にも入らない」と同族)。
#
# **止めるだけにしない。** **本当に走っている CI を止めると、#47 で塞いだ
# 「正常に動きながら何も進まない」の逆側**——**健全な待ちを壊す**——へ倒れる。
#
# **`bin/loop-lease check` は通さない。** **`bin/loop-gate` の中から呼ばれる**ので
# 入口は既に確かめてあり、**`--required-checks` は定数の問い合わせ**である
# (尋ねるたびに偽の「飛ばした」が積まれる。`bin/loop-gate` の同じ判断を参照)。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# 列の区切り。**タブにしない**——`IFS` の空白として畳まれ、空の列があるとずれる。
readonly FIELD=$'\037'

# .github/workflows/*.yml のジョブ名。これらが決着して成功していることを個別に要求する。
# 「全部 pass」だけでは、ワークフローが起動しなかった PR が 0 件で通ってしまう。
readonly DEFAULT_REQUIRED_CHECKS="lint / typecheck / boundaries / test
build
shell scripts
dependency vulnerabilities
new dependencies
analyze"

# **成功の側を並べ、それ以外は失敗へ倒す。** 失敗の側を並べると、
# **GitHub が値を増やしたときに、知らない値がどの分岐にも入らない** (#90)。
readonly OK_CONCLUSIONS="success skipped neutral"

usage() {
  echo "使い方: bin/loop-ci-status <PR番号>" >&2
  echo "        bin/loop-ci-status --required-checks" >&2
  echo "        exit 0 = 決着して成功 / exit 1 = 失敗・欠け / exit 3 = 待つ" >&2
  echo "        exit 4 = 予算を超えた / exit 2 = 読めない・使い方の誤り" >&2
  exit 2
}

mapfile -t REQUIRED_CHECKS <<<"${LOOP_REQUIRED_CHECKS:-$DEFAULT_REQUIRED_CHECKS}"
required=()
for name in "${REQUIRED_CHECKS[@]}"; do
  [[ -n ${name//[[:space:]]/} ]] && required+=("$name")
done
if ((${#required[@]} == 0)); then
  echo "[FAIL] 設定: 必須チェックが空です。空にすることはできません" >&2
  exit 2
fi

if [[ ${1-} == "--required-checks" ]]; then
  [[ $# -eq 1 ]] || usage
  printf '%s\n' "${required[@]}"
  exit 0
fi

[[ $# -eq 1 ]] || usage
[[ $1 =~ ^[0-9]+$ ]] || usage
readonly PR="$1"

if ! head_sha="$(gh pr view "$PR" --json headRefOid --jq '.headRefOid' 2>/dev/null)" \
  || [[ -z $head_sha || $head_sha == "null" ]]; then
  echo "[FAIL] PR #$PR の head を読み取れません" >&2
  exit 2
fi

# **`gh pr checks` を使わない。** **`bucket` は `status` から導かれる**ので、
# **`conclusion` が落ちる**——**この Issue が直しに来たものが、そこで消える** (#206)。
#
# **チェック名は @base64 で符号化して受け取る。** 名前は job 名から来るので
# **PR 側で決められる**——区切りを含む名前で行を増やされないようにする
# (`bin/loop-gate` と同じ判断。**復号はしない**)。
if ! checks_out="$(gh api --paginate "repos/{owner}/{repo}/commits/$head_sha/check-runs" \
  --jq ".check_runs[]? | \"\\(.name | @base64)$FIELD\\(.status)$FIELD\\(.conclusion // \"\")$FIELD\\(.started_at // \"\")\"" \
  2>/dev/null)"; then
  echo "[FAIL] PR #$PR の check-runs を取得できません" >&2
  exit 2
fi

# **予算は、その場所の数字から取る** (#206)。**ジョブ自身が諦める時間より長く待つ
# 理由が無い**ので、**`.github/workflows/` の `timeout-minutes` の最大**を使う。
#
# **いちばん長いものに合わせる。** **短いほうに合わせると、長い CI を持つ検査で
# 誤って止める**——**倒す先を「待つ」側へ寄せる**。
# **どの workflow の検査かを引き当てない**のは、**check run から workflow まで
# 3 回 API を挟む**うえ、**当たらなかったときに倒れる先がまた要る**からである。
#
# **読めなければ止めない。** **判定不能を「止める」へ倒さない。**
budget_min=""
if toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" && [[ -n $toplevel ]]; then
  while IFS= read -r minutes; do
    [[ $minutes =~ ^[0-9]+$ ]] || continue
    if [[ -z $budget_min ]] || ((minutes > budget_min)); then
      budget_min="$minutes"
    fi
  done < <(
    grep -rhoE '^[[:space:]]*timeout-minutes:[[:space:]]*[0-9]+' \
      "$toplevel/.github/workflows/" 2>/dev/null | grep -oE '[0-9]+$'
  )
fi

now_epoch="$(date +%s)"

missing=()
bad=()
waiting=()
overdue=()
for name in "${required[@]}"; do
  # 比較する側も同じ符号化に揃える。base64 は 76 桁で折り返す実装があるので改行を落とす。
  if ! want="$(printf '%s' "$name" | base64 | tr -d '\n')" || [[ -z $want ]]; then
    echo "[FAIL] 必須チェック名を符号化できません: $name" >&2
    exit 2
  fi
  found=0
  status=""
  conclusion=""
  started=""
  while IFS="$FIELD" read -r got_name got_status got_conclusion got_started; do
    [[ $got_name == "$want" ]] || continue
    found=1
    status="$got_status"
    conclusion="$got_conclusion"
    started="$got_started"
    break
  done <<<"$checks_out"

  if ((found == 0)); then
    missing+=("$name")
    continue
  fi

  # **決着しているか**は `conclusion` で決まる。**`status` は見ない**——
  # **実物が食い違っていた**（`in_progress` + `success`）。
  if [[ -n $conclusion ]]; then
    if [[ " $OK_CONCLUSIONS " == *" $conclusion "* ]]; then
      continue
    fi
    bad+=("$name=$conclusion")
    continue
  fi

  # ここから先は、まだ決着していない検査である。
  if [[ -z $budget_min || -z $started ]]; then
    waiting+=("$name=$status")
    continue
  fi
  if ! started_epoch="$(date -d "$started" +%s 2>/dev/null)" \
    || ! [[ $started_epoch =~ ^[0-9]+$ ]]; then
    waiting+=("$name=$status")
    continue
  fi
  if ((now_epoch - started_epoch > budget_min * 60)); then
    overdue+=("$name=$status")
  else
    waiting+=("$name=$status")
  fi
done

# **決着した失敗が先。** **待ちに混ぜると、直せるものを待ち続ける。**
if ((${#missing[@]} > 0)); then
  echo "必須チェックが見つかりません: ${missing[*]}"
  exit 1
fi
if ((${#bad[@]} > 0)); then
  echo "成功していないチェック: ${bad[*]}"
  exit 1
fi
if ((${#overdue[@]} > 0)); then
  echo "決着しないまま ${budget_min} 分を超えました: ${overdue[*]}"
  exit 4
fi
if ((${#waiting[@]} > 0)); then
  echo "まだ決着していません: ${waiting[*]}"
  exit 3
fi
echo "必須 ${#required[@]} 件すべて決着して成功"
exit 0
