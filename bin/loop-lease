#!/usr/bin/env bash
# 重ねてはいけない周回を直列化する。
#
# **単位は役によって違う。** master は役ごとに 1 つ、worker は作業場ごとに 1 つ。
# 理由は下の `lease_scope` を組み立てるところに書いてある。
#
# 通知で始めた周回と cron の周回が重なると、**同じ作業ツリーで checkout・commit・push が
# 並行する**。実際に一度起きている (#68: ブランチを切った直後に main へ戻され、
# main の上で commit された)。レビュー要求も、判定と投稿の間に割り込まれると
# **同時に 2 件投稿され、枠を一度に使い切る**。
#
#   exit 0 = 取れた (acquire は token を stdout に出す)
#   exit 1 = 走っている周回がある / token が合わない
#   exit 2 = 使い方の誤り / 設定の誤り / 判定不能
#   exit 3 = 配られた手順書の印がずれている（acquire だけ。捨てて呼び直す）
#
# **周回をまたいで保持する**ので、flock を持ち続ける形にはできない (1 周は複数の
# コマンドに分かれる)。ファイルに「誰が・いつ」を書き、その読み書きだけを flock で
# 守る。落ちた周回が抱えたままにならないよう、期限を過ぎた lease は引き継ぐ。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# 語彙を固定する。綴り違いで別の lease を取ると、
# **直列化しているつもりで 2 つ走る**。master と worker は互いを待たせない。
readonly ROLES=(master worker)

# 抱えたままの lease を引き継ぐまでの時間。**周回が落ちても、その役のループが
# 二度と動かなくならないようにする。**
#
# **これは「周回の長さ」への賭けではない。** 以前はそう読んでいて、実装する周回が
# `./task check` を含むと 1 時間近くかかるため、**返す前に期限が切れていた**
# (実測で 4 周連続)。切れた窓へ別の周回が入ると、**同じ作業ツリーで checkout と
# commit が並行する** (#68 の形)。
#
# **いまは「最後に何かが起きてからの経過」を測る。** 長い処理はすべて `./task` を通り、
# そこが活動を記録するので、**周回が何分かかっても、動いているかぎり切れない**。
# 賭けているのは**周回の長さではなく、活動と活動の間隔**である。
readonly TTL_SEC="${LOOP_LEASE_TTL_SEC:-1800}"

# 飛ばした記録を何件残すか。**増え続けないための上限**であって、意味のある数ではない。
readonly MISSING_KEEP_DEFAULT=20
MISSING_KEEP="${LOOP_LEASE_MISSING_KEEP:-$MISSING_KEEP_DEFAULT}"

# 読み書きのロックを待つ時間。ここは一瞬で終わる操作なので短くてよい。
readonly LOCK_WAIT_SEC="${LOOP_LEASE_LOCK_WAIT_SEC:-10}"

# 周回の長さを何回ぶん覚えておくか（窓の材料。詳しくは release のところ）。
#
# **1 つの Issue は 3〜4 周**かかる（実装 → PR → レビュー対応 → 確認。#68 は 3 周、
# #125 は 4 周）。**いま取り組んでいる作業の中でいちばん長かった周回は残り、
# 前の Issue の重さは落ちる**——という境目に置いてある。
# **設定で変えられるようにしない**（変える理由が出てから考える）。
readonly RECENT_ROUNDS=5

usage() {
  echo "使い方: bin/loop-lease acquire <役> <手順書の印>" >&2
  echo "        bin/loop-lease recover <役> <手順書の印>  印がずれた周回が、木を入れ替える前に押さえる" >&2
  echo "        bin/loop-lease release <役> <token>" >&2
  echo "        bin/loop-lease held <役>        その lease を誰かが持っているか（worker は呼んだ作業場の分）" >&2
  echo "                                        別の作業場の worker も見るなら busy（master は 1 つなので同じ）" >&2
  echo "        bin/loop-lease mine <役> <token>  その token が、いま握られている lease のものか（読むだけ）" >&2
  echo "                                        held は「誰かが持っているか」——順序が崩れても 0 になる" >&2
  echo "        bin/loop-lease check            この周回が持っていなければ言って記録する（止めない）" >&2
  echo "        bin/loop-lease busy <役>        その役の周回がどこかで走っているか（読むだけ）" >&2
  echo "        bin/loop-lease heartbeat <役>   活動を記録する（./task が呼ぶ）" >&2
  echo "        bin/loop-lease ttl              期限（秒）を出す" >&2
  echo "        bin/loop-lease scope <役>       その役の記録を分ける単位（作業場）を出す" >&2
  echo "        bin/loop-lease alive <作業場>    その作業場が周回を回しているか（読むだけ）" >&2
  echo "        bin/loop-lease running <役>     いま lease を握っている作業場の名前を並べる（読むだけ）" >&2
  echo "        役: ${ROLES[*]}" >&2
  echo "        master は役ごとに 1 つ（判定を並列にしない）" >&2
  echo "        worker は作業場ごとに 1 つ（作業場が増えたぶん並列になる）" >&2
  exit 2
}

role_is_known() {
  local candidate="$1" role
  for role in "${ROLES[@]}"; do
    [[ $role == "$candidate" ]] && return 0
  done
  return 1
}

# 「最後の活動」を人が読める形にする。**分からないときは分からないと言う。**
activity_age() {
  if [[ -z $last_activity ]]; then
    printf '%s' "活動の記録なし"
  else
    printf '最後の活動 %s 秒前' "$((now - last_activity))"
  fi
}

# 期限まであと何秒か。**待つ側が「待てば済むのか」を判断できるようにする** (#251)。
# **測り方は `read_lease` と揃える**（取得時刻と最後の活動の、新しいほうから）——
# **2 箇所に持つと、出す数と実際の判定が食い違う。**
expires_in() {
  local alive="$held_since"
  [[ -z $last_activity ]] || ((last_activity <= alive)) || alive="$last_activity"
  printf '%s' "$((TTL_SEC - (now - alive)))"
}

# **期限の値をここ 1 箇所に持つ。** 他のスクリプトが「相手が生きているか」を判断するのに
# 使うので、**書き写させない**（2 箇所に持つと片方だけ直して食い違う）。
if [[ ${1-} == "ttl" ]]; then
  [[ $# -eq 1 ]] || usage
  if ! [[ $TTL_SEC =~ ^[0-9]+$ ]]; then
    echo "[FAIL] 設定: LOOP_LEASE_TTL_SEC は 0 以上の整数（秒）で指定してください" >&2
    exit 2
  fi
  printf '%s\n' "$TTL_SEC"
  exit 0
fi

[[ $# -ge 1 ]] || usage
readonly ACTION="$1"

# **`check` は役を取らない。** 役を引数で固定すると、**`bin/loop-review-head` や
# `bin/loop-claim` のように両方の役が使うもの**で必ずどちらかが偽になる——
# **正常な master の周回のたびに「worker が飛ばした」と記録が 1 件増え、
# 上限 20 件を偽物が埋める**（実測で確認した master の指摘）。
# **見るのは「この周回が、どれかの役の lease を自分として持っているか」だけ**である。
# **`alive` も役を取らない** (#296)。**見るのは作業場そのもの**で、
# **worker の scope は作業場から作る**——**役を渡させると、呼ぶ側が
# 「どの役の作業場か」を判断することになる**（**worker しか作業場を持たない**）。
ROLE=""
if [[ $ACTION != "check" && $ACTION != "alive" ]]; then
  [[ $# -ge 2 ]] || usage
  ROLE="$2"
  if ! role_is_known "$ROLE"; then
    echo "[FAIL] 未知の役: $ROLE" >&2
    echo "       使えるのは次のものだけ: ${ROLES[*]}" >&2
    exit 2
  fi
fi
readonly ROLE

if ! [[ $TTL_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_LEASE_TTL_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
if ! [[ $LOCK_WAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_LEASE_LOCK_WAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
# **ここだけ落とさずに既定へ戻す。** 上の 2 つは**直列化そのもの**を決めるので、
# 誤っていれば止めるのが正しい。**こちらは記録を畳む件数**でしかなく、
# **止めると診断のための設定 1 つで周回が動かなくなる**。
#
# **黙って「上限が効かない」へは倒さない。** `tail -n abc` は落ち、**`if` が偽になって
# 畳む処理ごと飛ぶ**ので、**追記だけが毎回残る**——**この記録に上限を付けた理由
# （際限なく積む記録は、読む気を失わせるぶん、無いのと同じ）に、設定 1 つで戻る**。
# しかも**上限に達していないのか畳めていないのか、見分けが付かない**。
if ! [[ $MISSING_KEEP =~ ^[1-9][0-9]*$ ]]; then
  echo "[WARN] 設定: LOOP_LEASE_MISSING_KEEP は 1 以上の整数（件）で指定してください" >&2
  echo "       ${MISSING_KEEP_DEFAULT} 件で畳みます（この設定は無視します）" >&2
  MISSING_KEEP="$MISSING_KEEP_DEFAULT"
fi
readonly MISSING_KEEP

# **git の共通ディレクトリに置く。** master は worktree で動くので、作業ツリーごとに
# 置くと同じ役が 2 つ走っても気づけない。`bin/loop-stall` と同じ理由・同じ形。
if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
# worktree からだと相対パスを返すことがある。**物理パスで解決する。**
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
# **worker はセッションごとに鍵を取る。master は役のまま 1 人。**
#
# worker を役で取ると **2 人目が何もせず終わる**（#74 の直列化が、そのまま並列の
# 妨げになる）。master を並列にしないのは、**判定が並列になるとゲートの意味が薄れる**
# ためである。
#
# **識別子は作業場（worktree の根）から作る。**
#
#   - **毎回変わる値にしない。** 落ちた周回の lease が永遠に残る
#   - **人が付ける名前にしない。** 付け忘れ・付け間違いが「直列化しているつもりで
#     2 つ走る」に化ける
#   - **衝突したら直列になる。** 同じ作業場を共有する 2 つのセッションは、
#     checkout と commit が並行するので**直列でなければならない**。
#     つまり**衝突が正しい答えになる**（人数は前提にしていない。作業場が増えれば
#     そのぶん並列になる）
#
# **1 度きりの組み立てにしない。** `check` は**役をまたいで**見るので、
# **同じ組み立てを 2 度使う**——書き写すと、片方だけ直して食い違う（#159 で踏んだ）。
# 作業場のパスから scope を作る。**式はここ 1 つ** (#296)——**`alive` も同じ名前で
# 印を引く**ので、**書き写すと片方だけ直して食い違う** (#159 の形)。
worker_scope_of() {
  local path="$1" resolved digest
  resolved="$(cd "$path" 2>/dev/null && pwd -P)" || return 2
  digest="$(printf '%s' "$resolved" | sha256sum)" || return 2
  [[ -n ${digest%% *} ]] || return 2
  printf 'worker-%s' "${digest%% *}"
}

# その名前は、この作業場のものか (#298 のレビュー)。
#
# **記録は版をまたいで共有される**（`AGENTS.md` §5。#240 / #290 で 2 度踏んだ）——
# **持ち主が前の版で周回を始めていると、印は前の名前で残る。** **いまの名前だけを見ると
# 「回っていない」に落ち、生きている持ち主から Issue を取り上げる**（**この直しが
# 消しに来たものが、版の側から戻ってくる**）。
#
# **前の名前は、こちらから組み立てる**——**残っている名前を解釈するのではなく、
# 「この作業場が名乗りえた名前」を数える**（**他人の印を自分のものにしない**）。
#
#   worker<パスの / を _ にしたもの>  … #98 以前
#   worker-<digest の頭>              … 切り詰めていた版（実物に 26 桁が残っている）
#   worker-<digest 64 桁>             … いまの版
# その名前は、**こちらが知っている形か** (#298 のレビュー)。
#
# **知らない形は「自分のではない」と「まだ知らない」の区別が付かない**——
# **次の版が別の名前を使えば、この作業場の印がそこに入りうる。**
# **回っていない側へ倒すと、また生きている持ち主から取り上げる**ので、
# **判定できない側へ倒す**（呼ぶ側は引き継がない）。
worker_name_is_known_form() {
  local name="$1" hex
  [[ $name == worker_* ]] && return 0   # パスを畳んだ版
  [[ $name == worker-* ]] || return 1
  hex="${name#worker-}"
  [[ $hex =~ ^[0-9a-f]+$ ]]             # digest（頭でも全部でも）
}

worker_name_is_mine() {
  local name="$1" resolved="$2" digest hex
  [[ $name == "worker${resolved//\//_}" ]] && return 0
  [[ $name == worker-* ]] || return 1
  hex="${name#worker-}"
  [[ $hex =~ ^[0-9a-f]+$ ]] || return 1
  # **短すぎる頭では照合しない**（**別の作業場と当たりうる**）
  ((${#hex} >= 8)) || return 1
  digest="$(printf '%s' "$resolved" | sha256sum)" || return 1
  digest="${digest%% *}"
  [[ $digest == "$hex"* ]]
}

set_role_paths() {
  local role="$1" toplevel digest
  lease_scope="$role"
  SCOPE_LABEL="$role"
  if [[ $role == "worker" ]]; then
    if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
      echo "[FAIL] 作業場の根を特定できません" >&2
      return 2
    fi
    toplevel="$(cd "$toplevel" 2>/dev/null && pwd -P)" || {
      echo "[FAIL] 作業場の根へ移動できません" >&2
      return 2
    }
    # **ファイル名の長さを、作業場のパスの長さから切り離す** (#99)。
    #
    # **パス全体を 1 つの成分へ畳んでいた。** 深い checkout では
    # `$STATE.lock` が NAME_MAX (一般に 255 バイト) を超え、**acquire が常に exit 2**
    # になる——**worker がまったく動けなくなる** (約 350 文字のパスで再現済み。#98)。
    #
    # **元のパスは記録の中身に残す** (lease の 3 行目)。**名前に入れていたのは
    # 「どのセッションが握っているか」を読めるようにするため**で、そこは
    # `busy` が既に中身から読んでいる (#148)。**衝突すれば直列になる**という性質も
    # そのまま——**同じパスは同じ digest** である。
    if ! digest="$(printf '%s' "$toplevel" | sha256sum)" || [[ -z ${digest%% *} ]]; then
      echo "[FAIL] 作業場の識別子を作れません: $toplevel" >&2
      return 2
    fi
    lease_scope="worker-${digest%% *}"
    # **どの作業場かは、名前ではなく中身で照らす** (#291)。**名前の作り方は版で変わる**
    # ので、**別の名前の記録が自分のものかは、記録の 3 行目（作業場）でしか分からない。**
    WORKSPACE_PATH="$toplevel"
    # **どの単位で弾かれたのかを、出力だけで分かるようにする。** 「worker の周回が
    # 走っています」だと、別の作業場の worker まで止まっているように読める
    SCOPE_LABEL="この作業場（$toplevel）の worker"
  fi
  STATE="$common_dir/valence-loop-lease-$lease_scope"
  # **始めた周回の印。lease と違って、返しても消さない。**
  # 「いま持っているか」ではなく「**新しい周回を始めたか**」を外から見るためのもので、
  # 消してしまうと**周回と周回の間が「始めていない」と同じ見え方**になる
  # （bin/loop-stall がそれで数えられなくなった）。
  ROUNDS="$common_dir/valence-loop-rounds-$lease_scope"
  # **いちばん長かった周回の秒数。** 「周回が動いているか」を外から判断するのに使う
  # （bin/loop-stall）。**書き写した閾値を置かないため**に、実測を溜める形にしてある。
  ROUND_LEN="$common_dir/valence-loop-roundlen-$lease_scope"
  # **引き継がれた跡** (#278 のレビュー)。**退避がプロセス内の変数だけだと、
  # 取り直された後の持ち主に何も言えない**——**記録は上書きされている。**
  SUPERSEDED="$common_dir/valence-loop-superseded-$lease_scope"
  # **活動は lease とは別のファイルに置く。** lease を持っていなくても記録できる
  # ようにするため (`./task` は周回の外でも走る)。
  ACTIVITY="$common_dir/valence-loop-activity-$lease_scope"
}

# **この周回を表す印。**
#
# **「誰かが持っている」は「自分が持っている」ではない。** 前の版はそこを区別して
# いなかったので、**別の周回が保持している状況——この仕組みが存在する理由そのもの——
# でだけ黙った**（master の指摘）。
#
# **token を持ち回らない。** 環境変数は子プロセスにしか届かず、**手順書の各コマンドは
# 別々に起動される**。ファイルへ置くと**同じ作業場の別周回と共有**されるので、
# 同一性にならない。**残るのはプロセスの系譜**である。
#
# **自分のセッションの外に出た最初の親**を採る。手順書のコマンドは
# `claude → bash → スクリプト → …` と起こされ、**bash 以下は同じセッション**なので、
# ここで得られるのは**そのセッションを回している本体**になる。
#
# **PID の再利用に備えて起動時刻を添える**（`/proc/<pid>/stat` の 22 番目）。
#
# **限界を書いておく。** **同じセッションの中の別周回**（cron と通知が同じ本体から
# 起きる形）は、この印では区別できない——**分からないものは飛ばしと呼ばない**方へ倒す。
round_owner() {
  local pid="$$" mysid ppid sid
  proc_field "$pid" 4 || return 1
  mysid="$PROC_FIELD"
  while :; do
    proc_field "$pid" 2 || break
    ppid="$PROC_FIELD"
    [[ $ppid =~ ^[0-9]+$ && $ppid != 0 && $ppid != 1 ]] || break
    proc_field "$ppid" 4 || break
    sid="$PROC_FIELD"
    if [[ $sid != "$mysid" ]]; then
      # 自分のセッションの外に出た。**そこがセッションを回している本体**である
      proc_field "$ppid" 20 || return 1
      printf 'p:%s:%s' "$ppid" "$PROC_FIELD"
      return 0
    fi
    pid="$ppid"
  done
  # **外へ出られなかった**（コンテナの中など、全部が同じセッションにいる形）。
  # **セッションそのものを印にする。** `setsid` で切り離した周回とは違う値になる。
  #
  # **種類を混ぜない。** `p:` と `s:` は**測っているものが違う**ので、
  # **食い違ったら「別の周回」ではなく「分からない」**へ倒す（`check` を読むこと）。
  proc_field "$mysid" 20 || return 1
  printf 's:%s:%s' "$mysid" "$PROC_FIELD"
}

# `/proc/<pid>/stat` の値を 1 つ読む。**番号は comm の後ろから数える**
# （**comm には空白も `)` も入りうる**ので、**最後の `) ` で切る**）。
#   2=親 PID / 4=セッション / 20=起動時刻
proc_field() {
  local line rest
  # shellcheck disable=SC2162
  read -r line <"/proc/$1/stat" 2>/dev/null || return 1
  rest="${line##*') '}"
  [[ $rest != "$line" ]] || return 1
  local -a fields
  # shellcheck disable=SC2206
  fields=($rest)
  PROC_FIELD="${fields[$(($2 - 1))]-}"
  [[ -n $PROC_FIELD ]] || return 1
}


# 判定と書き込みの間に割り込まれると、**両方の周回が「空いている」と読む**。
# ここを守らないと、直列化そのものが成立しない。
lock_state() {
  exec 9>"$STATE.lock" || {
    echo "[FAIL] lease のロックを作成できません: $STATE.lock" >&2
    return 2
  }
  if ! flock -w "$LOCK_WAIT_SEC" 9; then
    echo "[FAIL] lease のロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
    return 2
  fi
}

# 保持されている lease を読む。期限切れは「誰も持っていない」として扱う。
# **前提: `set_role_paths` を通し、ロックを取っていること。**
#
# **読むところを 1 つにする。** `check` は役をまたいで 2 度読むので、
# **同じ判定（期限・持ち主）を書き写すと片方だけ古くなる**。
read_lease() {
  local quiet="${1-}" alive_since
  # 最後の活動。**読めなければ「活動なし」として扱う**——推測で新しくしない。
  last_activity=""
  if [[ -f $ACTIVITY ]]; then
    read -r last_activity <"$ACTIVITY" || last_activity=""
    [[ $last_activity =~ ^[0-9]+$ ]] || last_activity=""
  fi

  held_token=""
  held_since=""
  held_owner=""
  held_workspace=""
  # **持ち越さない** (#260)。`busy` / `check` は役や作業場ごとに何度も読む——
  # **前の記録の跡が残ると、次の判定に混ざる。** **記録が無い経路でも空にする**
  # （**「誰も持っていない」を「期限切れの記録がある」と読ませない**）。
  expired_token=""
  expired_owner=""
  expired_over=0
  [[ -f $STATE ]] || return 0

  # **1 行目は「前の版が読める形」のまま**（token と時刻の 2 列）。**印は 2 行目**である。
  #
  # **実際に踏んだ。** 3 列目に足したところ、**前の版が読めなくなった**——
  # `read -r held_token held_since` は**残り全部を 2 つ目へ入れる**ので、
  # **時刻が数値に見えなくなる**。**lease のファイルは版をまたいで共有される**
  # （master は worktree で `origin/main` の版、worker はブランチの版を走らせる）ので、
  # **マージされるまでの間、直列化そのものが働かなくなる**。
  {
    IFS=$'\t' read -r held_token held_since
    read -r held_owner || held_owner=""
    read -r held_workspace || held_workspace=""
  } <"$STATE"
  if ! [[ $held_since =~ ^[0-9]+$ ]]; then
    echo "[FAIL] lease の記録を読めません: $STATE" >&2
    return 2
  fi
  # **取得時刻と最後の活動の、新しいほうから測る。** 取得時刻だけで測ると、
  # **長い周回がそれだけで奪われる**。活動だけで測ると、**活動が 1 度も無い周回**
  # （取った直後に落ちた）が測れない。
  alive_since="$held_since"
  if [[ -n $last_activity ]] && ((last_activity > alive_since)); then
    alive_since="$last_activity"
  fi
  if ((now - alive_since >= TTL_SEC)); then
    # **黙って上書きしない。** 期限切れの引き継ぎは、落ちた周回の跡である。
    # **読むだけの action（`held` / `check`）では黙る**（誰も引き継がない）。
    [[ -n $quiet ]] ||
      echo "[WARN] $SCOPE_LABEL の lease が期限切れでした（$((now - held_since)) 秒前に取得、$(activity_age) ）。引き継ぎます" >&2
    # **跡は捨てない** (#260)。**「誰も持っていない」と「期限が切れた記録が残っている」は
    # 別の状態**である——**捨てると、返しに来た持ち主にも、走っている本人にも、
    # 起きたことを言えない**（**出口で「別の周回が持っています」と読まれる**）。
    expired_token="$held_token"
    expired_owner="$held_owner"
    expired_over=$((now - alive_since - TTL_SEC))
    held_token=""
    held_owner=""
  fi
}

# 引き継がれた lease の跡を 1 行足し、上限まで畳む (#278 のレビュー)。
#
# **`./task loop:status` の件数には混ぜない。** あれは**入口を飛ばした周回**を数えている
# ——**原因の違うものを入れると、読めなくなる。**
#
# **落ちても止めない。** **これは案内のための記録**で、**直列化そのものは lease が持つ。**
record_superseded() {
  local kept
  printf '%s\t%s\t%s\n' "$1" "$now" "$2" >>"$SUPERSEDED" 2>/dev/null || return 0
  kept="$(tail -n "$RECENT_ROUNDS" "$SUPERSEDED" 2>/dev/null)" || return 0
  printf '%s\n' "$kept" >"$SUPERSEDED.tmp" 2>/dev/null \
    && mv -f "$SUPERSEDED.tmp" "$SUPERSEDED" 2>/dev/null \
    || rm -f "$SUPERSEDED.tmp" 2>/dev/null || true
}

# 自分の跡を消す (#278 のレビュー)。**跡は 1 度だけ伝わればよい記録**である——
# **`round_owner` はセッションの外側を印にする**ので、**同じセッションの周回は何周しても
# 同じ値**で、**残したままだと後の健全な周回で誤報が出る。** **そして誤報の側で `exit 0`
# するので、本当に入口を飛ばした周回が記録されない**——**「件数を汚さない」枝が、
# 汚さない代わりに消すことになる**（§5「消す側を足したら、残る側の前提を見直す」）。
forget_superseded() {
  local kept token when owner_seen
  [[ -n $1 && -f $SUPERSEDED ]] || return 0
  kept=""
  while IFS=$'\t' read -r token when owner_seen; do
    [[ $owner_seen == "$1" ]] && continue
    kept+="$token"$'\t'"$when"$'\t'"$owner_seen"$'\n'
  done <"$SUPERSEDED"
  printf '%s' "$kept" >"$SUPERSEDED.tmp" 2>/dev/null \
    && mv -f "$SUPERSEDED.tmp" "$SUPERSEDED" 2>/dev/null \
    || rm -f "$SUPERSEDED.tmp" 2>/dev/null || true
}

# 跡の中に、その token か持ち主があるか。**照合できる形で残してある**ので、
# **返しに来た側にも、打ち直した側にも同じことを言える。**
superseded_has() {
  local token owner_seen when
  [[ -f $SUPERSEDED ]] || return 1
  while IFS=$'\t' read -r token when owner_seen; do
    [[ -n $1 && $token == "$1" ]] && return 0
    [[ -n $2 && -n $owner_seen && $owner_seen == "$2" ]] && return 0
  done <"$SUPERSEDED"
  return 1
}

# 飛ばした記録を 1 行足し、上限まで畳む。
#
# **この記録は役をまたいで共有される**（`$common_dir` に 1 つ）。**lease のロックは
# 役ごと**なので互いを止めない——`追記 → tail → 置換` をそのまま並べると、
# **片方の 1 行が黙って消える**（master の指摘）。**飛ばすのは並行しているときに
# 起きやすい**ので、**いちばん起きてほしくないときに、いちばん起きやすい**。
# **記録に付いたロックで、書き換えごと直列にする。**
#
# **取れなければ諦めて進む**（`check` は止めない）**が、黙らない**——
# 黙って落とすと、`./task loop:status` から見て**「飛ばしていない」と同じ**になる。
record_missing() {
  local record="$common_dir/valence-loop-lease-missing" kept
  exec 8>"$record.lock" || {
    echo "[WARN] lease 無しの実行の記録のロックを作れません: $record.lock" >&2
    echo "       この周回のぶんは ./task loop:status に出ません（数え直せません）" >&2
    return 0
  }
  if ! flock -w "$LOCK_WAIT_SEC" 8; then
    echo "[WARN] lease 無しの実行の記録のロックを取れません（${LOCK_WAIT_SEC} 秒待機）: $record.lock" >&2
    echo "       この周回のぶんは ./task loop:status に出ません（数え直せません）" >&2
    exec 8>&-
    return 0
  fi
  if ! printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$PWD" >>"$record"; then
    echo "[WARN] lease 無しの実行の記録を残せません: $record" >&2
    echo "       この周回のぶんは ./task loop:status に出ません（数え直せません）" >&2
    exec 8>&-
    return 0
  fi
  # **記録は増え続けない。** 読むのは `./task loop:status`、**古いものから畳むのはここ**——
  # **際限なく積む記録は、読む気を失わせるぶん、無いのと同じ**になる。
  #
  # **畳めなかったら言う**（`2>/dev/null` を置かない）。**落ちる理由は設定だけではない**
  # ——記録が読めない場合もここを通る。**黙ると「上限に達していない」と見分けが付かない**。
  if ! kept="$(tail -n "$MISSING_KEEP" "$record")" \
    || ! printf '%s\n' "$kept" >"$record.tmp.$$" \
    || ! mv -f "$record.tmp.$$" "$record"; then
    rm -f "$record.tmp.$$" 2>/dev/null
    echo "[WARN] lease 無しの実行の記録を畳めません: $record" >&2
    echo "       この記録は ${MISSING_KEEP} 件を超えて増え続けます" >&2
  fi
  exec 8>&-
}

now="$(date +%s)"

# **伸ばしてよいのは、持ち主の周回だけ** (#251)。**`./task` は周回の外からも打たれる**
# （人が手で叩く）——**打った人が持ち主でなくても伸びていた**ので、
# **取り落とした lease は「待てば切れる」と読めるのに切れなかった**（実測）。
#
# **token は要求しない。** **周回の外から打つ人に毎回 token を求めると、
# 普通の作業ができなくなる**——**持ち主かどうかは、周回の印で見る。**
#
# **分からないものは伸ばす側へ倒す。** **持ち主の印が無い記録**（前の版が書いたもの）や、
# **こちらの印を作れないとき**は、**これまでどおり書く**——**この仕組みの目的は
# 「長い周回を殺さない」ことで、偽の引き継ぎのほうが高くつく。**
#
# **置き換えは原子的に行う。** `>` は切り詰めてから書くので、**その隙間を `acquire` が
# 読むと空に見え**、**活動中なのに「記録なし」として引き継がれる**。
#
# **書けなかったことを黙らない。** 書けない状態は「安全な側」ではない——
# **期限が取得時刻だけで決まる状態**、つまり**この仕組みが直した当の壊れ方**に戻る。
# 呼ぶ側 (`./task`) が**コマンド自体は落とさない**のは別の判断で、そこは変えない。
if [[ $ACTION == "heartbeat" ]]; then
  [[ $# -eq 2 ]] || usage
  set_role_paths "$ROLE" || exit 2
  # **読むのでロックを取る。** **読んだ値が途中の状態だと、持ち主を取り違える。**
  #
  # **読めなくても止めない。** **ここで落とすと、心拍そのものが打たれなくなる**
  # ——**「長い周回を殺さない」ほうが、この仕組みの目的**である。
  # **書けない状態なら、下の書き込みが理由つきで言う**（そちらが本来の口）。
  # **照合と書き込みを、同じ区間の中で行う** (#280 のレビュー)。**読んだ時点と書く時点が
  # 別だと、間に `acquire` / `recover` が入れる**——**古い周回の心拍が、新しい持ち主の
  # 期限を伸ばす**。**この節が立てた保証が、そこだけ抜ける。**
  holder=""
  if lock_state 2>/dev/null; then
    # **期限切れの記録でも、持ち主なら伸ばす**（`expired_owner`）——**長い周回が
    # 静かだっただけ**ということがある。**他人が生き返らせるのだけを止める。**
    if read_lease quiet; then
      holder="$held_owner"
      [[ -n $holder ]] || holder="$expired_owner"
    fi
  fi
  beating="$(round_owner)" || beating=""
  if [[ -n $holder && -n $beating && $holder != "$beating" ]]; then
    # **別の周回が打った。** **黙って終える**——**`./task` は周回の外からも打たれるので、
    # ここで言うと、関係のない作業に毎回警告が出る。**
    exit 0
  fi
  if ! date +%s >"$ACTIVITY.tmp" 2>/dev/null || ! mv -f "$ACTIVITY.tmp" "$ACTIVITY" 2>/dev/null; then
    rm -f "$ACTIVITY.tmp" 2>/dev/null || true
    echo "[WARN] $SCOPE_LABEL の活動を記録できません: $ACTIVITY" >&2
    echo "       この周回は、取得時刻だけで期限を判定されます（長い周回は途中で奪われます）" >&2
    exit 1
  fi
  # **錠は、書き終えるまで持ったまま**——**exit が閉じるので、ここでは開けない。**
  exit 0
fi

# **入口を飛ばした周回を、出口より前に捕まえる**（#161）。
#
# **書いてあっても踏む。** 両方の手順書が「冒頭で呼べ」と書いているのに、
# **通知で始めた周回で 3 回飛ばされた**——踏んだのは **#157 を実装した本人**と
# **#143 の完了条件を書いた本人**である。**通知の経路には「周回の開始」という
# 区切りが無い**（メッセージを読むと、そのまま調査や実装へ入る）。
#
# **出口だけでは遅い。** 気づくのは終わったあとで、**その周回の直列化は既に効いていない**。
#
# **止めない。** #157 の判断を覆さない——**止めていたら #159 の特定が止まっていた**。
# **その役の周回が、どこかの作業場で走っているか。**
#
# **`held` では答えられない。** worker の単位は**作業場**なので、`held worker` は
# **呼んだ場所の worker** しか見ない——**master の worktree から尋ねると、
# worker の lease は別の scope になって見えない**。
#
# **使い道は「まだ PR が無いブランチ」の見分け**である (#148)。**push から PR 作成までの
# 間に必ず窓が開く**ので、**走っている周回のものかどうか**を知りたい。**時間で切らない**
# ——**遅い周回と落ちた周回は、経過時間では分けられない** (#129)。
#
#   exit 0 = 走っている / exit 1 = 走っていない / exit 2 = 読めない
# **記録を分ける単位を、外から引けるようにする** (#239)。
#
# **`bin/loop-stall` は作業場ごとにカウンタを分ける**が、**単位の作り方をあちらへ
# 書き写すと、片方だけ直して食い違う**（#159 で実際に踏んだ形）——**組み立ては
# `set_role_paths` が 1 箇所で持っている**ので、そこへ訊く。
#
#   exit 0 = 出せた / exit 2 = 判定できない
if [[ $ACTION == "scope" ]]; then
  [[ $# -eq 2 ]] || usage
  set_role_paths "$ROLE" || exit 2
  printf '%s\n' "$lease_scope"
  exit 0
fi

# **いま lease を握っている作業場の名前を並べる** (#303 のレビュー)。
#
# **期限の判定を渡すための口である。** **`bin/loop-stall` は周回の印（時刻の窓）でしか
# 生死を測っていなかった**——**印は「周回を*始めた*時刻」しか言わない**ので、
# **初めての周回と、過去より長い周回は、走っている最中に窓から出る。**
# **`alive` は #298 で「まず生きている lease を見る」形にした**のに、**数える側は
# 古いほうだけを見ていた**——**同じ生死を 2 通りに測っていた**ことになる。
#
# **判定そのものは足さない。** **期限は `read_lease` が 1 箇所で持っている**
# （`busy` / `alive` と同じ）——**ここは並べるだけ**である。
#
#   exit 0 = 並べた（0 件でも 0）/ exit 2 = 判定できない
if [[ $ACTION == "running" ]]; then
  [[ $# -eq 2 ]] || usage
  for running_state in "$common_dir/valence-loop-lease-$ROLE"*; do
    [[ -f $running_state ]] || continue
    [[ $running_state != *.lock ]] || continue
    running_scope="${running_state##*/valence-loop-lease-}"
    SCOPE_LABEL="$running_scope"
    STATE="$running_state"
    ACTIVITY="$common_dir/valence-loop-activity-$running_scope"
    lock_state || exit 2
    read_lease quiet || {
      exec 9>&-
      exit 2
    }
    exec 9>&-
    [[ -n $held_token ]] || continue
    printf '%s\n' "$running_scope"
  done
  exit 0
fi

# **その作業場が周回を回しているか** (#296)。
#
# **`bin/loop-claim` は「claim の記録を触った時刻」で測っていた**——**PR を持つ worker は
# `mine <PR>` からステップ 3 へ入り `resume` を打たない**ので、**作業場が生きていても
# 記録だけ古くなり、着手中の Issue を取り上げてしまう**（2026-08-15 に実測）。
#
# **測るのは周回の印**（`acquire` が書き、**返しても消さない**）——**lease と違って
# 周回と周回の間でも読める**ので、**「次の周回で戻ってくる作業場」を生きていると読める。**
# **窓の式は `bin/loop-stall` と同じ**（**いちばん長かった周回の 2 倍。既定は lease の期限**）。
#
#   exit 0 = 回っている / exit 1 = 回っていない / exit 2 = 判定できない
#
# **「読めない」を「回っていない」に倒さない**——**取り上げる側へ倒れる。**
if [[ $ACTION == "alive" ]]; then
  [[ $# -eq 2 ]] || usage
  # **消えた作業場は、回っていない** (#298 のレビュー)。**`./task loop:worker:remove` で
  # worktree を消しても claim の記録は残る**ので、**「判定できない」に倒すと、
  # 公開に失敗した `in-progress` の Issue を誰も回収できない。**
  [[ -d $2 ]] || exit 1
  if ! alive_path="$(cd "$2" 2>/dev/null && pwd -P)" || [[ -z $alive_path ]]; then
    echo "[FAIL] 作業場を特定できません: $2" >&2
    exit 2
  fi
  # **先に lease を見る** (#298 の 2 周目のレビュー)。**印は「周回を始めた」しか
  # 言わない**——**`acquire` が書いたきり途中で更新されず、実測は `release` まで
  # 書かれない**ので、**初めての周回と、過去より長い周回は走っている最中に窓から出る。**
  # **当たるのはいちばん守りたい側**（長い実装を抱えた周回。#129 / #142 と同じ形）。
  #
  # **lease は「いま走っている」を言う**——**別のことを測っているので、併せて見る。**
  # **活動の記録そのものは見ない**（`bin/loop-stall` が避けた理由がそのまま当たる。
  # **人が `./task` を叩いても新しくなる**）——**#283 で heartbeat は持ち主に限られた**
  # ので、**lease を握っているかどうかは信じてよい。**
  for alive_state in "$common_dir/valence-loop-lease-worker"*; do
    [[ -f $alive_state ]] || continue
    [[ $alive_state != *.lock ]] || continue
    # **期限の判定を書き写さない。** `read_lease` が 1 箇所で持っている（`busy` と同じ）
    lease_scope="${alive_state##*/valence-loop-lease-}"
    SCOPE_LABEL="$lease_scope"
    STATE="$alive_state"
    ACTIVITY="$common_dir/valence-loop-activity-$lease_scope"
    lock_state || exit 2
    read_lease quiet || {
      exec 9>&-
      exit 2
    }
    exec 9>&-
    [[ -n $held_token ]] || continue
    # **どの作業場かは、名前ではなく中身で照らす** (#291)。**帰属できない lease は
    # この作業場のものかもしれない**ので、**「走っていない」へ倒さない**——
    # **印と違って lease は期限で切れる**ので、**待たせても永久には残らない。**
    if [[ -z $held_workspace ]]; then
      echo "[FAIL] 走っている lease に作業場が入っていません: $alive_state" >&2
      echo "       この作業場のものか判定できません" >&2
      exit 2
    fi
    [[ $held_workspace == "$alive_path" ]] && exit 0
  done
  # **前の版の名前も見る**（`worker_name_is_mine`）。**印が無いのは「一度も周回を
  # 始めていない」**である——**引き継げなくなると、落ちた周回の Issue を誰も拾えない**
  # ので、**回っていない側へ倒す。**
  alive_unknown=0
  alive_known_mine=0
  for alive_rounds in "$common_dir"/valence-loop-rounds-worker*; do
    [[ -f $alive_rounds ]] || continue
    alive_name="${alive_rounds##*/valence-loop-rounds-}"
    if ! worker_name_is_mine "$alive_name" "$alive_path"; then
      # **知らない形は素通りしない**（上記）。**この作業場のものかもしれない**
      worker_name_is_known_form "$alive_name" || alive_unknown=1
      continue
    fi
    # **この作業場の名乗りが 1 つでも見えたか**（下の「判定できない」を狭める）
    alive_known_mine=1
    if ! read -r alive_started <"$alive_rounds" 2>/dev/null \
      || ! [[ $alive_started =~ ^[0-9]+$ ]]; then
      echo "[FAIL] 周回の印を読めません: $alive_rounds" >&2
      exit 2
    fi
    # **実測があれば、それで窓を広げる**（**長い周回の途中で「死んだ」に落とさない**）
    alive_window="$TTL_SEC"
    alive_len="${alive_rounds/valence-loop-rounds-/valence-loop-roundlen-}"
    if [[ -f $alive_len ]] && read -r alive_seconds <"$alive_len" 2>/dev/null \
      && [[ $alive_seconds =~ ^[0-9]+$ ]]; then
      ((alive_seconds * 2 <= alive_window)) || alive_window=$((alive_seconds * 2))
    fi
    # **1 つでも窓の内なら回っている**（**前の版で始めた周回も、いまの周回である**）
    ((now - alive_started < alive_window)) && exit 0
  done
  # **知らない形を、無関係な作業場の判定にまで混ぜない** (#298 の 2 周目のレビュー)。
  # **印は消えない**ので、**1 つ置かれた瞬間からどの作業場も判定できなくなり、
  # 落ちた持ち主の `in-progress` を誰も回収できない**——**「取り上げるより待つ」は
  # 正しいが、待ち続けて誰も拾えないのは別の壊れ方**である（#291 の「消せない保留」）。
  #
  # **この作業場の名乗りが既に見えているなら、知らない形はその作業場のものではない。**
  # **走っている周回は、上の lease で捕まる。**
  if ((alive_unknown == 1 && alive_known_mine == 0)); then
    echo "[FAIL] 知らない形の周回の印があります（この作業場のものか判定できません）" >&2
    exit 2
  fi
  exit 1
fi

if [[ $ACTION == "busy" ]]; then
  [[ $# -eq 2 ]] || usage
  # **役ごとに置き場所が違う。** master は 1 つ、worker は作業場ごとに増える——
  # **その役のものだけを見る**（`valence-loop-lease-master` と
  # `valence-loop-lease-worker-<digest>` は前方一致で分けられる）。
  running=0
  for state in "$common_dir/valence-loop-lease-$ROLE"*; do
    [[ -f $state ]] || continue
    [[ $state != *.lock ]] || continue
    # **期限の判定を書き写さない。** `read_lease` が 1 箇所で持っている
    lease_scope="${state##*/valence-loop-lease-}"
    SCOPE_LABEL="$lease_scope"
    STATE="$state"
    ACTIVITY="$common_dir/valence-loop-activity-$lease_scope"
    # **読めなかったら「走っていない」に倒さない。** 倒すと、**作業中のブランチを
    # 「宙に浮いている」と誤報する**——**契約どおり「読めない」を返す** (#148 のレビュー)。
    lock_state || exit 2
    read_lease quiet || {
      exec 9>&-
      exit 2
    }
    exec 9>&-
    [[ -n $held_token ]] || continue
    running=1
    # **走っている作業場を出す。** 呼ぶ側は**そこで触っているブランチだけ**を抑える。
    #
    # **帰属できないなら「読めない」である。** 「走っている」と答えながら**内訳を出さない**
    # のは**契約の外**——**呼ぶ側は空行を飛ばし、「走っているが抑えるものは無い」と読む**ので、
    # **走っている worker のブランチを「宙に浮いている」と誤報する** (#148 のレビュー)。
    # **前の版が書いた lease (作業場の行が無い) で必ず踏む**——**lease のファイルは
    # 版をまたいで共有される** (2 行 → 3 行のときに実際に踏ませた)。
    #
    # **呼ぶ側ではなくここで倒す。** **契約 (`exit 2 = 読めない`) はこちらが持つ**ので、
    # **呼ぶ側ごとに同じ判断をやり直さずに済む**。
    if [[ $ROLE == "worker" && -z $held_workspace ]]; then
      echo "[FAIL] 走っている lease に作業場が入っていません: $STATE" >&2
      echo "       どのブランチを触っているか分からないので、判定できません" >&2
      exit 2
    fi
    [[ -z $held_workspace ]] || printf '%s\n' "$held_workspace"
  done
  ((running == 1)) || exit 1
  exit 0
fi

# **この周回が、その役の lease を持っているか。** **読み方はここ 1 つ** (#352)。
#
#   0 = 持っている / 1 = 持っていない / 2 = 読めない / 3 = 分からない
#
# **`check`（全部の役を回って言うだけ）と `mine`（役 1 つについて合否を返す）が、
# 同じものを読む**——**写すと、片方だけ直したときに食い違う**（`AGENTS.md` §5。
# **#159 で踏んだ形**）。
#
# **「読めない」と「分からない」を分ける。** **前者はロックや記録に届かなかった**、
# **後者は届いたが突き合わせられない**（印が片方に無い・測っているものが違う）
# ——**呼ぶ側で言うことが違う。**
#
# **どこで見たかを `taken` に残す**（`check` の案内が使う）。
round_holds() {
  local role="$1" owner="$2"
  set_role_paths "$role" || return 2
  lock_state || return 2
  read_lease quiet || {
    exec 9>&-
    return 2
  }
  exec 9>&-
  if [[ -z $held_token ]]; then
    # **走っている最中に切れたのを、飛ばしたと誤診しない** (#260)。
    # **原因が違えば、次にやることも違う**——**飛ばした周回は取り直せばよい**が、
    # **切れた周回は「空いて見えた間に別の周回が入ったかもしれない」を疑う。**
    #
    # **気づけるのがここしかない。** **期限を見るのは `acquire` だけ**で、
    # **走っている本人は出口の `release` まで気づけない**——**そのときには
    # 重なりは既に起きている。** **`bin/loop-*` を打つたびにここを通る。**
    if [[ -n $expired_token && -n $owner && -n $expired_owner && $expired_owner == "$owner" ]]; then
      echo "[WARN] この周回の lease は期限切れです（${expired_over} 秒超過）。走っている最中に外れました" >&2
      echo "       切れている間は空いて見えるので、別の周回が入っているかもしれません" >&2
      echo "       出口では、同じ token でそのまま返せます（期限切れだったと言われます）" >&2
      # **持っていた側として答える。** **飛ばしてはいない**ので、`./task loop:status` の
      # 「入口を飛ばした周回」に混ぜると、**数えているものが濁る。**
      return 0
    fi
    # **記録そのものが消えていても、跡は残っている** (#278 のレビュー)。
    # **`expired_*` はプロセス内の変数**なので**この経路では必ず空**——
    # **見にいく者がここにいないと、返した後の窓では誰も言えない。**
    if [[ -n $owner ]] && superseded_has "" "$owner"; then
      echo "[WARN] この周回の lease は期限切れのあと、別の周回が取り直しています" >&2
      echo "       この周回が走っている間、別の周回も走っていた可能性があります" >&2
      return 0
    fi
    return 1
  fi
  taken="$SCOPE_LABEL"
  # **重なった後こそ知りたい** (#278 のレビュー)。**待っている間に切れて取り直された
  # 周回は、次に何かを打ったときここへ来る**——**記録は上書き済みなので、
  # 跡と突き合わせないと「別の周回が持っている」としか見えない。**
  if [[ -n $owner && -n $held_owner && $held_owner != "$owner" ]] && superseded_has "" "$owner"; then
    echo "[WARN] この周回の lease は期限切れのあと、別の周回が取り直しています" >&2
    echo "       この周回が走っている間、別の周回も走っていた可能性があります" >&2
    return 0
  fi
  # **印が片方でも無ければ、持ち主が自分かどうかは分からない。**
  # **測っているものが違う**（`p:` と `s:`）ときも同じで、**分からない**である。
  if [[ -z $owner || -z $held_owner || ${owner%%:*} != "${held_owner%%:*}" ]]; then
    return 3
  fi
  [[ $held_owner == "$owner" ]] || return 1
  return 0
}

# **この周回が持っているかを、役 1 つについて返す** (#352)。
#
# **`held` は「誰かが持っているか」**である——**返してから打った周回でも、別の周回が
# 取っていれば 0 になる**ので、**順序が崩れたことは見えない。** **呼ぶ側が知りたいのは
# 「いま自分が握っているか」**で、それを答えるのがここである。
#
# **判定不能を「持っている」へも「持っていない」へも倒さない**（exit 2）——
# **倒す向きは呼ぶ側が決める**（`bin/loop-handoff --sent` は記録しない側へ倒す）。
# **その token が置かれている記録へ乗り換える** (#240)。**周回の途中で
# `bin/loop-lease` の版が入れ替わると、記録の名前の作り方が変わる**——
# **名前ではなく token が資格**なので、**役のぶんだけ走査して引き当てる。**
#
# **`release` と `mine` が同じものを使う** (#355 のレビュー)。**片方だけ引き当てると、
# 「返せるのに、持っていないと言われる」**——**正しい順序の周回の記録が上がらない。**
#
# **走査するのは自分の役のぶんだけ** (#290 のレビュー)。**`worker-` で切らない**
# ——**いちばん古い版は `worker` の直後が `_`** である（#98）。
#
# **前提: `lock_state` を通していること**（**乗り換え先のロックを取り直す**——
# **持っていたのは前の名前のロック**なので、**そのまま読むと別の周回と競る**）。
#
#   0 = 乗り換えた / 1 = 見つからない / 2 = 乗り換え先を読めない
switch_to_renamed_state() {
  local token="$1" candidate first
  for candidate in "$common_dir/valence-loop-lease-$ROLE"*; do
    [[ -f $candidate ]] || continue
    [[ $candidate != *.lock && $candidate != *.tmp ]] || continue
    [[ $candidate != "$STATE" ]] || continue
    read -r first <"$candidate" 2>/dev/null || continue
    [[ ${first%%$'\t'*} == "$token" ]] || continue
    echo "[WARN] $SCOPE_LABEL の lease は、いまと違う名前で置かれていました" >&2
    echo "       記録: ${candidate##*/}" >&2
    echo "       周回の途中で bin/loop-lease の版が入れ替わっています（名前の作り方が違う）" >&2
    exec 9>&-
    lease_scope="${candidate##*/valence-loop-lease-}"
    STATE="$candidate"
    # **活動の記録も名前から作られる。** **期限の判定はそちらを見る**ので、
    # **一緒に乗り換えないと、動いていた周回が「切れていた」に化ける。**
    ACTIVITY="$common_dir/valence-loop-activity-$lease_scope"
    lock_state || return 2
    read_lease quiet || return 2
    return 0
  done
  return 1
}

if [[ $ACTION == "check" ]]; then
  # **役を渡す形は残さない。** 黙って無視すると、**役を書き固めた古い呼び出しが
  # 生き残っているのに、直したつもりになる**
  [[ $# -eq 1 ]] || usage
  owner="$(round_owner)" || owner=""
  unknown=""
  taken=""
  for role in "${ROLES[@]}"; do
    # **理由を捨てない。** **なぜ読めないのかは、round_holds が出すメッセージに
    # しか書かれていない**
    round_holds "$role" "$owner"
    case "$?" in
      # **自分の周回が持っていた。** ここだけが黙ってよい場合である
      0) exit 0 ;;
      1) ;;
      # **分からないものを飛ばしと呼ばない**——**偽の記録より取りこぼしのほうが安い**
      # （この記録は「同じ癖が続いていること」を読むためのもので、汚れると読めなくなる）
      3) exit 0 ;;
      *) unknown="$unknown $role" ;;
    esac
  done
  if [[ -n $unknown ]]; then
    # **読めない役があった。「持っていない」と言い切らない**——**記録にも残さない**
    # （**偽の記録より取りこぼしのほうが安い**）。**ただし黙らない。**
    #
    # **言っても記録は汚れない**（`./task loop:status` の件数は増えない）。
    # **そして読めない状態は続く**——ロックが作れないのは**権限や置き場所の問題**で、
    # **次の周回でも同じ**である。**黙ると、直すべきものが誰の目にも入らない**。
    #
    # **「飛ばした」と同じ文言にしない。** 言い切ると、**読めなかっただけの周回に
    # 出したときに逆向きの誤解**になる。
    echo "[WARN] lease を読めませんでした（役:${unknown}）。この周回が持っているかは判定できません" >&2
    echo "       入口を飛ばしたかどうかは、この周回については分かりません（記録もしません）" >&2
    exit 0
  fi
  # **どちらの場合も、言うことは 1 つである。**
  #
  # **「誰かが別に持っている」を、そのまま危険と読まない。** worker の周回から見れば
  # **master の lease は普段から別の周回が持っている**（並行してよい相手である）——
  # **役が分からないここでは、それが自分の相手かどうかを判断できない**。
  #
  # **判断を `acquire` に渡す。** 取れれば直列化がその場で回復し、
  # **取れなければ「同じ役の周回が走っている」と、そこで正しく分かる**。
  echo "[WARN] この周回は lease を持っていません（入口の acquire を飛ばした可能性）" >&2
  # **貼れば走る形にする** (#244。#257 のレビュー)。**場所取り (`<役>`) を
  # そのまま出すと、bash がリダイレクトとして読み、`loop-lease` 自体が走らない**
  # ——**usage で落ちるより分かりにくい。**
  #
  # **役はここでは分からない**（この検査は役を受け取らない）ので、**両方を出す。**
  #
  # **印は実値で埋めない** (#257 のレビュー)。**あれは「読んだ側が申告する」ことに
  # 意味がある** (#243)——**ディスクから計算して渡すと、突き合わせは必ず一致し、
  # 古い手順書で走っている周回がそのまま lease を取れてしまう。**
  # **この案内が出るのは「入口を飛ばした周回」**で、**古い版が配られた周回が
  # まさにそれ**である——**塞いだ穴を、案内が別の口から開けることになる。**
  #
  # **埋める場所は引用符で囲む。** **貼っても構文では壊れず、usage で
  # 「足りない」と分かる。** **形は `bin/loop-lease.test.ts` が、表示された
  # 文字列を bash へ通して確かめる。**
  echo "       いま取り直してください（役に合うほうを打つ。cwd はリポジトリの根）:" >&2
  for advice_role in worker master; do
    echo "         bin/loop-lease acquire $advice_role \"<手順書の印を埋める>\"" >&2
  done
  echo "       印は、いま読んでいる手順書の冒頭にある \`版:\` の値です（ディスクから取らないこと）" >&2
  echo "       取れないなら、その役の周回が別に走っています——この周回は何もせずに終えること" >&2
  if [[ -n $taken ]]; then
    record_missing "別の周回が保持中: $taken"
  else
    record_missing "どの役も誰も持っていない"
  fi
  exit 0
fi

# **配られた手順書が古くないかを、ここで受ける** (#241 / #243 のレビュー)。
#
# **検査を、検査したい対象の中に置いてはいけない。** **古い版の本文には
# 「印を突き合わせよ」という行が無い**ので、**手順書の側に書いた検査は、
# 古い版が配られた周回では一度も走らない**——**塞ぎたかった当の場面で黙る。**
#
# **`acquire` はどの版の手順書にも冒頭にあり、しかもスクリプト**である。
# **配られたテキストが古くても、走るのは新しいコード**なので、**ここで要求すれば
# 古い版は落ちる**（#228 が `--role` を必須にしたときと同じ形）。
#
# **`busy` / `release` / `check` / `held` へは広げない。** **`busy` は
# `bin/loop-claim` と `bin/loop-stray-branches` が呼んでいる**——**手順書と関係ない
# ところが落ちる。**
#
# **見ているのは「配られたテキスト」と「同期する前のディスク」**である
# （`acquire` は同期より前）。**同期で入れ替わるほうは `bin/loop-procedure-changed`
# の担当**——**2 つは別のものを見ている。**
#
# **`acquire` すら無いほど古い版が配られたら、何も走らない。** **中からは塞げない**
# （**呼ばれなければ、どのスクリプトも動かない**）ので、**そこは受け入れる。**
if [[ $ACTION == "acquire" ]]; then
  # **印を渡さない版のぶんは、こちらで積む** (#244)。**その周回は自分では積めない**
  # ——**「印がずれたら `bin/loop-stall procedure-stale`」という行が、古い本文には
  # 無い**ので、**止まるだけで誰も呼ばれない。** **3 周で `loop/STOP` という経路に
  # 乗らないと、古い版が配られ続ける障害で人が気づく手立てが無い。**
  #
  # **積むのは「印が無い」ときだけ。** **印がずれた側は、呼び直しを 1 回挟んでから
  # 呼ぶ側が積む**（**両方で積むと、1 件の配り間違いが 2 つ数えられる**）。
  #
  # **記録は cwd の作業場へ行く**（`bin/loop-stall` が `git rev-parse` で決める）
  # ——**使い捨てのリポジトリで走らせている試験は、本物のカウンタに触らない** (#240)。
  if [[ $# -eq 2 ]]; then
    echo "[NG] 配られた手順書が古すぎます（印を渡していません）。この周回は何もしません" >&2
    echo "       記録はこちらで積みます（その版には積む行が無いため）" >&2
    # **積めなかったことを飲まない** (#261 のレビュー)。**この枝は、古い版の周回の
    # ぶんを代わりに積むために足したもの**なので、**積めなかったら目的を果たしていない。**
    # **絵空事ではない**——**カウンタは共通ディレクトリに 1 つで、master と worker が
    # 同時に書きにいく**（**ロックを取れなければ `bin/loop-stall` は exit 2**）。
    "${BASH_SOURCE[0]%/*}/loop-stall" procedure-stale >&2
    case "$?" in
      0 | 1) ;;
      3)
        # **記録はできている。** **上限に達したのに `loop/STOP` を配れなかった**
        # ——**人を呼ぶべきなのに仕掛けが動かなかった**ので、黙らない
        echo "[FAIL] 記録はしましたが、停止を配れませんでした（上の理由を読むこと）" >&2
        ;;
      *)
        # **記録できていない**（exit 2）。**設定か環境の誤りの側へ倒す**
        # ——**この周回の停止は数えられていない**ので、**3 周に届かない**
        echo "[FAIL] 手順書が古いことを記録できませんでした。この周回は何もしません" >&2
        exit 2
        ;;
    esac
    exit 3
  fi
  [[ $# -eq 3 ]] || usage
  "${BASH_SOURCE[0]%/*}/loop-procedure-stamp" "$ROLE" "$3"
  case "$?" in
    0) ;;
    1)
      # **exit 2 と分ける** (#244)。**exit 2 は「設定か環境の誤り」で、行き先が
      # 「報告して終わる」**——**こちらは「捨てて呼び直す」**である。
      # **文言でしか見分けられない状態を残さない**（**終了コードで分岐する**）。
      echo "       捨てて呼び直すこと（1 回だけ）。2 回目は bin/loop-stall procedure-stale" >&2
      # **止まった状態から出る道を書く** (#262。AGENTS.md §5 の #184)。
      #
      # **印を変える PR を出した作業場は、次の周回から入れなくなる**——
      # **その PR を直す周回にも入れない**ので、**PR が自分自身で詰む**（#261 で実測）。
      # **これまでの案内は「印を埋めて取り直す」しか言っていない**——
      # **同じ印をもう一度渡しても、ディスクが変わっていないので、また止まる。**
      #
      # **道は「印を持つ木へ入る」ことである。** **その枝なら手順書もスクリプトも揃う**
      # ので、**噛み合わない組み合わせで走ることにはならない**——**素通りではない**
      # （**揃わなければ、ここはまた止まる**）。
      #
      # **案内も、押さえてから入る形にそろえる** (#268 のレビュー 2 周目)。
      # **読むだけの確認と checkout の間に、別の周回が普通の `acquire` を通せる**
      # ——**この案内を実際に読むのは、古い手順書を配られた周回**なので、
      # **ここに古い順序を残すと、直した先とは別の道からその競合が入る。**
      echo "       その印が自分の open PR のものなら、その枝へ入ってから確かめられます:" >&2
      echo "         bin/loop-lease recover $ROLE \"$3\"   # 先に作業場を押さえる（token を控える）" >&2
      echo "         bin/loop-claim pr <PR番号> && gh pr checkout --detach <PR番号>" >&2
      echo "         bin/loop-procedure-stamp $ROLE \"$3\"   # 揃ったか（判定はここ 1 箇所）" >&2
      echo "       揃わなければ返して終わること: bin/loop-lease release $ROLE \"<token>\"" >&2
      exit 3
      ;;
    *)
      echo "[FAIL] 手順書の版を確かめられません。この周回は何もしません" >&2
      exit 2
      ;;
  esac
fi

# **回復のために押さえる** (#268 のレビュー)。
#
# **読むだけの確認では足りない。** **`held` を見てから `gh pr checkout` を打つまでの間に、
# 別の周回が普通の `acquire` を通せる**——**その直後に checkout すると、走っている周回の
# HEAD と作業ツリーを入れ替える**（#68 の形）。**確かめて空けたままにせず、その場で決着させる。**
#
# **素通りの口にはしない。** **印が揃っているならここは使えない**（exit 3）——
# **回復は「ずれている」状態のためだけのもの**である。
#
# **押さえることは、進んでよいという意味ではない。** **揃ったかどうかは、checkout した
# あとに `bin/loop-procedure-stamp` で確かめる**（判定はそこ 1 箇所が持つ。ここには写さない）。
if [[ $ACTION == "recover" ]]; then
  [[ $# -eq 3 ]] || usage
  probe="$("${BASH_SOURCE[0]%/*}/loop-procedure-stamp" "$ROLE" "$3" 2>&1)"
  case "$?" in
    0)
      echo "[NG] 印は揃っています。回復ではなく acquire を使ってください" >&2
      exit 3
      ;;
    1) ;; # ずれている。ここの出番である
    *)
      printf '%s\n' "$probe" >&2
      echo "[FAIL] 手順書の版を確かめられません。この周回は何もしません" >&2
      exit 2
      ;;
  esac
fi

set_role_paths "$ROLE" || exit 2
lock_state || exit 2
# **`release` は引き継がない** (#278 のレビュー)。**「引き継ぎます」の直後に
# 「返します」が出る**と、**文言を直しに来て逆の文言を増やすことになる。**
if [[ $ACTION == "held" || $ACTION == "release" || $ACTION == "mine" ]]; then
  read_lease quiet || exit 2
else
  read_lease || exit 2
fi

case "$ACTION" in
held)
  # **持っているかを読むだけ。** 書かない・奪わない・印も残さない。
  #
  # **見るのは「その単位を誰かが持っているか」**である。**「呼んだ周回自身が
  # 持っているか」を見たいなら `check`**（そちらは周回の印を突き合わせる）。
  [[ $# -eq 2 ]] || usage
  # **答えた範囲を、答えと一緒に出す** (#250)。**worker の lease は作業場ごとに
  # 分かれている**ので、**別の作業場から呼ぶと、そこには誰も居ないぶん、いつでも
  # exit 1 になる**——**master がそれを「解放された」と読んで worker へ伝え、
  # 実際には 7 分ほど取れないままだった**（2026-08-14。**答えは正しく、問いが違っていた**）。
  #
  # **exit 1 のときこそ出す。** **「誰も持っていない」と「この作業場には無い」が、
  # 同じ顔をしているのが本体**である——**終了コードだけでは、読む側が問いを取り違える。**
  #
  # **`SCOPE_LABEL` をそのまま使う。** **範囲の言い方を 2 箇所に持たない**
  # （master は「master」、worker は「この作業場（<パス>）の worker」）。
  if [[ -n $held_token ]]; then
    echo "[INFO] $SCOPE_LABEL の lease を、いま誰かが持っています" >&2
    exit 0
  fi
  echo "[INFO] $SCOPE_LABEL の lease は、誰も持っていません" >&2
  # **行き先を出す** (#250)。**同じ問いに答える口を 2 つ作らない**——
  # **作業場をまたいで見たいなら `busy`** で、そちらは共通ディレクトリを走査する。
  #
  # **worker のときだけ出す** (#283 のレビュー)。**master の記録は 1 つだけ**なので、
  # **`busy master` は `held master` と同じものを見る**——**「別の作業場も見るなら」と
  # 案内しても行き先が同じ**で、**#250 と同じ形（答えは正しく、説明が違う）になる。**
  [[ $ROLE == "worker" ]] && echo "       別の作業場も見るなら: bin/loop-lease busy $ROLE" >&2
  exit 1
  ;;
mine)
  # **この token が、いま握られている lease のものか** (#352 / #355 のレビュー)。
  #
  # **`held` は「誰かが持っているか」**である——**返した直後に別の周回が取っていれば
  # 0 を返す**ので、**順序が崩れたことが消える。** **`check` は「この周回が持っているか」**
  # だが、**見ているのはセッションの印**——**`round_owner` の真上に「同じセッションの中の
  # 別周回は区別できない」と書いてある。**
  #
  # **入口 1.0 が直列化しようとしているのが、まさにその 2 つ**である
  # （**cron の周回と、通知で始めた周回は同じ本体から起きる**）——**そこを
  # 「この周回のものだ」と答えると、塞ぎに来た競合がそのまま残る。**
  #
  # **周回ごとに違う証拠は最初からある**——**`acquire` が返し、`release` が要求する
  # token** である。**資格は token が持つ**（`release` と同じ線）。
  [[ $# -eq 3 ]] || usage
  if [[ -z $held_token && -z $expired_token ]]; then
    switch_to_renamed_state "$3"
    case "$?" in
      0 | 1) ;;
      *) exit 2 ;;
    esac
  fi
  if [[ -n $held_token && $held_token == "$3" ]]; then
    exit 0
  fi
  # **期限が切れていたら、その token のものでも通さない** (#355 のレビュー)。
  #
  # **`release` とは問いが違う。** **あちらは片付け**なので、**既に空きとして
  # 扱われている lease を片付けても、誰の判断も変わらない**（だから #260 で
  # 「切れていても持ち主は返せる」とした）。**こちらの呼び手は抑止を書く**——
  # **`--sent` は `informed` を上げ、以後その状態では 2 通目を出さない。**
  #
  # **期限が切れた瞬間から、その lease は `acquire` にとって空き**である
  # ——**ここで 0 を返してから、呼び手が記録のロックを取るまでに、次の周回が
  # 入って `PENDING` を進められる。** **古い周回はその新しい状態を「送った」ことにする**
  # ——**送っていない通知が、二度と送られなくなる** (#258)。
  #
  # **問いは「順序が崩れたか」ではない。** **「いま書こうとしている記録は、
  # 自分が送ったものか」**である——**切れている間は、そこが保証されない。**
  if [[ -n $expired_token && $expired_token == "$3" ]]; then
    echo "[WARN] $SCOPE_LABEL の lease は期限切れです（${expired_over} 秒超過）。走っている最中に外れました" >&2
    echo "       切れている間は空いて見えるので、別の周回が入っているかもしれません" >&2
    echo "       返すこと自体はできます（bin/loop-lease release）——通さないのは、この token を資格として使うことです" >&2
    exit 1
  fi
  echo "[INFO] $SCOPE_LABEL の lease は、この token のものではありません" >&2
  if [[ -n $held_token ]]; then
    echo "       いまは別の周回が持っています（返したあとに、次の周回が取っています）" >&2
  else
    echo "       誰も持っていません（この周回は、もう返しています）" >&2
  fi
  exit 1
  ;;
acquire | recover)
  # **引数の数は、上の入口で見ている**（印を受けるところ）。**ここには届かない**
  # ので置かない——**残すと、上を外す変異が赤くならない**（#243 のレビュー）。
  #
  # **`recover` も同じ口から取る** (#268 のレビュー)。**違うのは入口の条件だけ**で、
  # **押さえ方・token・返し方は 1 つ**である（**2 箇所に持つと片方だけ直して食い違う**）。
  # **いまの名前で空いていても、前の版の名前で走っていることがある** (#291)。
  #
  # **`release` を直しただけでは、片側しか塞がらない**（#240 / #290）——
  # **名前が変わった直後、`acquire` は新しい名前を見て「空いている」と読む。**
  # **まだ返していない周回がいるのに、もう 1 つ取れる**ので、**同じ作業ツリーで
  # checkout と commit が並行する**（#68 の形）。**直列化そのものが、その瞬間だけ
  # 成り立たない**——**版が入れ替わるのは `gh pr checkout` と 1.1 の同期**で、
  # **周回のたびに通る道**である。
  #
  # **役ごとの前方一致に閉じる**（`release` と同じ形。#290 のレビュー）。
  # **判定は書き写さない**——**`read_lease` を、見に行く記録へ向けて呼ぶ**
  # （**期限の測り方を 2 箇所に持つと、片方だけ直して食い違う**）。
  #
  # **自分のロックは手放さない。** **`lock_state` は fd 9 を使う**ので、
  # **走査は別の fd で取る**——**手放すと、その隙に別の周回がいまの名前で取れる。**
  #
  # **消さない。** **`acquire` は返す口ではない**ので、**跡はそのまま残す**
  # （**消すと、前の版の周回が返しに来たとき「誰も持っていません」に落ちる**——
  # **#290 で塞いだ側が、こちらから開く**）。
  if [[ -z $held_token && -z $expired_token ]]; then
    keep_state="$STATE"
    keep_activity="$ACTIVITY"
    for renamed_state in "$common_dir/valence-loop-lease-$ROLE"*; do
      [[ -f $renamed_state ]] || continue
      [[ $renamed_state != *.lock && $renamed_state != *.tmp ]] || continue
      [[ $renamed_state != "$keep_state" ]] || continue
      STATE="$renamed_state"
      ACTIVITY="$common_dir/valence-loop-activity-${renamed_state##*/valence-loop-lease-}"
      renamed_read=0
      if ! exec 8>"$STATE.lock"; then
        echo "[FAIL] lease のロックを作成できません: $STATE.lock" >&2
        renamed_read=2
      elif ! flock -w "$LOCK_WAIT_SEC" 8; then
        echo "[FAIL] lease のロックを取得できません（${LOCK_WAIT_SEC} 秒待機）: $STATE.lock" >&2
        renamed_read=2
      elif ! read_lease quiet; then
        renamed_read=2
      fi
      exec 8>&-
      STATE="$keep_state"
      ACTIVITY="$keep_activity"
      # **読めなかったら「空いている」に倒さない。** **倒すと、走っている周回の隣で
      # もう 1 つ取れる**——**塞ぎに来た当の状態が、判定不能から戻ってくる。**
      ((renamed_read == 0)) || exit 2
      # **別の作業場のものを、自分のものと読まない** (#291)。**worker の lease は
      # 作業場ごと**なので、**走査で拾った記録が自分のものとは限らない**——
      # **見分けずに止めると、2 人目が走っているだけで 1 人目が取れなくなる**
      # （**既存の試験がこれを捕まえた**）。
      #
      # **名前では照らせない**（**名前の作り方が版で変わるのが、この Issue の前提**）。
      # **記録の 3 行目（作業場）で照らす**——**書いていない版の記録は、自分のものだと
      # 言えない**ので、**止めずに、そう言う**（**黙って通すと、次に読む人が誤解する**）。
      if [[ $ROLE == "worker" && ( -n $held_token || -n $expired_token ) ]]; then
        if [[ -z $held_workspace ]]; then
          echo "[WARN] 作業場の書かれていない lease があります: ${renamed_state##*/}" >&2
          echo "       前の版の記録です。誰のものか読めないので、この判定では飛ばします" >&2
          held_token=""
          expired_token=""
          continue
        fi
        if [[ $held_workspace != "$WORKSPACE_PATH" ]]; then
          held_token=""
          expired_token=""
          continue
        fi
      fi
      if [[ -n $held_token || -n $expired_token ]]; then
        echo "[WARN] $SCOPE_LABEL の lease が、いまと違う名前で置かれています" >&2
        echo "       記録: ${renamed_state##*/}" >&2
        echo "       周回の途中で bin/loop-lease の版が入れ替わっています（名前の作り方が違う）" >&2
        # **切れていたら、これまでどおり引き継ぐ**（**落ちた周回の跡で止まると、
        # その作業場は二度と動けない**）。**言うのはここだけ**なので黙らない。
        [[ -z $expired_token ]] \
          || echo "[WARN] その記録は期限切れでした（${expired_over} 秒超過）。引き継ぎます" >&2
        break
      fi
    done
  fi
  if [[ -n $held_token ]]; then
    # **「走っている」と「返し忘れ」を、この 1 行で見分けられるようにする。**
    # 手順書は「何周も取れないなら返し忘れ」と読ませるが、**活動が見えないと
    # その判断ができない**。
    echo "[FAIL] $SCOPE_LABEL の周回が走っています（$((now - held_since)) 秒前に開始、$(activity_age)、あと $(expires_in) 秒で期限）。この周回は何もしません" >&2
    echo "       待たずに終わるのは、走っている側が同じ状態を読むためです。" >&2
    echo "       読み終えた後だった場合は 1 拍落ちますが、次の周回（保険）が拾います" >&2
    exit 1
  fi
  # token は「返す資格」を表すだけなので、衝突しなければよい。
  if ! token="$(od -An -tx1 -N8 /dev/urandom | tr -d ' \n')" || [[ -z $token ]]; then
    echo "[FAIL] token を生成できません" >&2
    exit 2
  fi
  # **持ち主の印を一緒に書く。** これが無いと、`check` は「誰かが持っている」までしか
  # 言えず、**別の周回が持っているときに黙る**（#161 で直した向きの誤り）。
  # **作れなければ空のまま**——`check` はそれを「分からない」として扱う。
  owner="$(round_owner)" || owner=""
  # **作業場も残す（3 行目）。** **抑止をブランチ単位にするのに要る** (#148)——
  # **どこか 1 つでも走っていれば全部隠す**と、**動いているほど紛失作業が見つからない**。
  # **scope から復元しない**（digest なので、元のパスへ戻せない）。
  workspace=""
  [[ $ROLE != "worker" ]] || workspace="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  printf '%s\t%s\n%s\n%s\n' "$token" "$now" "$owner" "$workspace" >"$STATE" || {
    echo "[FAIL] lease を書き込めません: $STATE" >&2
    exit 2
  }
  # **引き継いだなら、跡を残す** (#278 のレビュー)。**前の持ち主が次に何かを打つのは、
  # 記録が上書きされた後**である——**ここで残さないと、そのとき言うものが無い。**
  [[ -z $expired_token ]] || record_superseded "$expired_token" "$expired_owner"
  # **取り直したら、自分宛ての跡は役目を終える** (#278 のレビュー)。**足したあとに消す**
  # ——**自分の期限切れを自分で引き継いだ跡は、誰にも伝える必要が無い。**
  forget_superseded "$owner"
  # **周回を始めた印。** 失敗しても lease は取れているので止めない——
  # 読む側 (bin/loop-stall) は印が無ければ「分からない」として、これまでどおり数える。
  printf '%s\n' "$now" >"$ROUNDS.tmp" 2>/dev/null && mv -f "$ROUNDS.tmp" "$ROUNDS" 2>/dev/null || {
    rm -f "$ROUNDS.tmp" 2>/dev/null || true
    echo "[WARN] $SCOPE_LABEL の周回の印を書けません: $ROUNDS" >&2
  }
  echo "$token"
  ;;
release)
  [[ $# -eq 3 ]] || usage
  # **記録の名前は、走っているスクリプトが毎回組み立てる** (#240)。**worker は周回の
  # 途中で作業ツリーを入れ替える**（1.1 の同期、`gh pr checkout`）ので、
  # **`bin/loop-lease` 自身もそこで入れ替わる**——**取ったときと返すときで名前の
  # 作り方が違えば、自分が置いた記録が引けない**（`AGENTS.md` §5「名前を変えたら、
  # 古い名前を持つ者を数える」。#185）。**症状は「lease が消えた」だが、消したものは
  # いない**——**記録は前の名前のまま残り、誰も返さない。**
  #
  # **token で引き直す。** **名前ではなく token が資格**である（すぐ下の 2 つの分岐と
  # 同じ線）——**持ち主だけが返せる**ことは変わらない。
  #
  # **黙って通さない。** **名前が変わったことは、次の周回でも起きる**ので、
  # **返せたときこそ言う**（実物の共通ディレクトリには 3 通りの名前が残っている）。
  #
  # **走査するのは自分の役のぶんだけ** (#290 のレビュー)。**役を取り違えて打つと、
  # 別の役の直列化が解ける**——**`release master <worker の token>` が worker の lease を
  # 消して exit 0 になり、しかも「master の lease」と名乗る**（`busy` と同じ前方一致で、
  # `valence-loop-lease-master` と `-worker…` は分かれる）。
  #
  # **`worker-` で切らない。** **いちばん古い版は `worker` の直後が `_`**
  # （パスをそのまま畳んでいた。#98）——**残る側を数える**と 3 通りある
  # （`AGENTS.md` §5。**残る側は自分の diff に出てこない**）。
  #
  # **乗り換えは `switch_to_renamed_state` が持つ** (#355 のレビュー)——**`mine` も
  # 同じものを使う**（**片方だけ引き当てると、返せるのに「持っていない」と言われる**）。
  if [[ -z $held_token && -z $expired_token ]]; then
    switch_to_renamed_state "$3"
    case "$?" in
      0 | 1) ;;
      *) exit 2 ;;
    esac
  fi
  # **期限切れの記録は、持ち主が返せる** (#260)。**返す資格は token が持つ**ので、
  # **切れたことは「返させない理由」にならない**——**断ると、後始末をする者が
  # いなくなる**（記録は残り続ける）。
  #
  # **ただし黙って通さない。** **切れていた間は `acquire` から見て空いていた**ので、
  # **別の周回が入っていた可能性がある**——**それを言うのはここだけ**である。
  #
  # **周回の長さには数えない** (#146)。**切れたまま放置された記録の「長さ」を入れると、
  # `bin/loop-stall` の窓が広がって戻らない**——**測りたいのは実際にかかった周回**である。
  expired_release=""
  if [[ -z $held_token && -n $expired_token ]]; then
    if [[ $expired_token != "$3" ]]; then
      # **「誰も持っていない」でも「重なっている」でもない。** 落ちた別の周回の跡である
      echo "[FAIL] $SCOPE_LABEL には期限切れの記録が残っていますが、この token のものではありません" >&2
      exit 1
    fi
    echo "[WARN] $SCOPE_LABEL の lease は期限切れでした（${expired_over} 秒超過）。返します" >&2
    echo "       切れていた間は空いて見えるので、別の周回が入っていた可能性があります" >&2
    held_token="$expired_token"
    expired_release=1
  fi
  if [[ -z $held_token ]]; then
    # **記録が消えていても、跡で答えられる** (#278 のレビュー)
    if superseded_has "$3" ""; then
      echo "[FAIL] $SCOPE_LABEL の lease は期限切れのあと、別の周回が取り直しています" >&2
      echo "       この周回が走っている間、別の周回も走っていた可能性があります" >&2
      exit 1
    fi
    echo "[FAIL] $SCOPE_LABEL の lease は誰も持っていません" >&2
    exit 1
  fi
  # **他人の lease を返させない。** 引き継がれた後に返すと、走っている周回の
  # 直列化が崩れる（自分は終わったつもりで、相手はまだ走っている）。
  if [[ $held_token != "$3" ]]; then
    # **重なりと、引き継がれた跡を分ける** (#278 のレビュー)。**どちらも「別の token」**
    # だが、**前者は走っている相手**、**後者は自分が外れたこと**である
    if superseded_has "$3" ""; then
      echo "[FAIL] $SCOPE_LABEL の lease は期限切れのあと、別の周回が取り直しています" >&2
      echo "       この周回が走っている間、別の周回も走っていた可能性があります" >&2
      exit 1
    fi
    echo "[FAIL] $SCOPE_LABEL の lease は別の周回が持っています" >&2
    exit 1
  fi
  # **周回の長さを残す。** 「印が古い＝周回が動いていない」の境目を、
  # **この機械で実際にかかった時間から**決めるためのもの（bin/loop-stall）。
  #
  # **いちばん長かったものだけを残していた**（短い周回で上書きすると、長い周回の
  # 途中で「止まっている」と読まれるため）。**その値は下がらない**ので、
  # **詰まった 1 回・異常に長引いた `./task check`・人が止めて放置した 1 回**で
  # **窓が広がり、二度と戻らない**——**死んだ worker の検出が永久に遅れる** (#146)。
  # **実測で 4239 秒（70.7 分）が残っていた**（その日の周回はどれも数分である）。
  #
  # **直近 $RECENT_ROUNDS 回の中の最大**にする。**古い記録が落ちる**のが本体で、
  # **上限は置かない**——**根拠の無い閾値を足さない** (#134)。
  #
  # **回数の根拠。** **1 つの Issue は実装 → PR → レビュー対応 → 確認で 3〜4 周**
  # かかる（#68 は 3 周、#125 は 4 周）。**いま取り組んでいる作業の中でいちばん長かった
  # 周回**は残り、**前の Issue の重さは落ちる**——という境目に合わせてある。
  #
  # **忘れる以上、忘れたあとの 1 回は既定へ戻る。** これは避けられない
  # （**忘れないことと、異常値を引きずらないことは両立しない**）。
  # **下限は `bin/loop-stall` が lease の期限で置く**ので、そこまでしか縮まない。
  round_len=$((now - held_since))
  # **期限切れの記録は数えない** (#260)。**切れたまま放置された時間は「周回の長さ」
  # ではない**——**入れると窓が広がり、二度と戻らない**（#146 と同じ害）。
  if [[ -n $expired_release ]]; then
    round_len=""
  fi
  # **1 行目は「窓に使う値」（＝残しているものの最大）にする。**
  # **記録は版をまたいで共有される**（lease ファイルで 2 度踏んだ）——
  # **古い読み手は 1 行目しか読まない**ので、履歴を先頭に置くと
  # **直近 1 回だけで窓を作ってしまう**。2 行目からが直近の実測（新しい順）である。
  round_history=()
  if [[ -f $ROUND_LEN ]] && mapfile -t stored_lens <"$ROUND_LEN" 2>/dev/null; then
    # **前の版の記録は 1 行だけ**（＝そのときの最大）。履歴が無いので落ちる——
    # **忘れたい値そのもの**なので、移行の一度きりとして受け入れる。
    for line in "${stored_lens[@]:1}"; do
      [[ $line =~ ^[0-9]+$ ]] || continue
      round_history+=("$line")
    done
  fi
  [[ -z $round_len ]] || round_history=("$round_len" "${round_history[@]}")
  round_history=("${round_history[@]:0:$RECENT_ROUNDS}")
  longest_round=0
  for line in "${round_history[@]}"; do
    ((line > longest_round)) && longest_round="$line"
  done
  printf '%s\n' "$longest_round" "${round_history[@]}" >"$ROUND_LEN.tmp" 2>/dev/null \
    && mv -f "$ROUND_LEN.tmp" "$ROUND_LEN" 2>/dev/null || {
    rm -f "$ROUND_LEN.tmp" 2>/dev/null || true
    echo "[WARN] $SCOPE_LABEL の周回の長さを記録できません: $ROUND_LEN" >&2
  }
  rm -f "$STATE" || {
    echo "[FAIL] lease を消せません: $STATE" >&2
    exit 2
  }
  ;;
*)
  usage
  ;;
esac
