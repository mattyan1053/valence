#!/usr/bin/env bash
# 重ねてはいけない周回を直列化する。
#
# **単位は役によって違う。** master は役ごとに 1 つ、worker は作業場ごとに 1 つ。
# 理由は下の `lease_scope` を組み立てるところに書いてある。
#
# 通知で始めた周回と cron の周回が重なると、**同じ作業ツリーで checkout・commit・push が
# 並行する**。実際に一度起きている (#68: ブランチを切った直後に main へ戻され、
# main の上で commit された)。レビュー要求も、判定と投稿の間に割り込まれると
# **同時に 2 件投稿され、枠を一度に使い切る**。
#
#   exit 0 = 取れた (acquire は token を stdout に出す)
#   exit 1 = 走っている周回がある / token が合わない
#   exit 2 = 使い方の誤り / 設定の誤り / 判定不能
#
# **周回をまたいで保持する**ので、flock を持ち続ける形にはできない (1 周は複数の
# コマンドに分かれる)。ファイルに「誰が・いつ」を書き、その読み書きだけを flock で
# 守る。落ちた周回が抱えたままにならないよう、期限を過ぎた lease は引き継ぐ。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# 語彙を固定する。綴り違いで別の lease を取ると、
# **直列化しているつもりで 2 つ走る**。master と worker は互いを待たせない。
readonly ROLES=(master worker)

# 抱えたままの lease を引き継ぐまでの時間。**周回が落ちても、その役のループが
# 二度と動かなくならないようにする。** 1 周が長引くより十分に長く取る。
readonly TTL_SEC="${LOOP_LEASE_TTL_SEC:-1800}"

# 読み書きのロックを待つ時間。ここは一瞬で終わる操作なので短くてよい。
readonly LOCK_WAIT_SEC="${LOOP_LEASE_LOCK_WAIT_SEC:-10}"

usage() {
  echo "使い方: bin/loop-lease acquire <役>" >&2
  echo "        bin/loop-lease release <役> <token>" >&2
  echo "        役: ${ROLES[*]}" >&2
  echo "        master は役ごとに 1 つ（判定を並列にしない）" >&2
  echo "        worker は作業場ごとに 1 つ（作業場が増えたぶん並列になる）" >&2
  exit 2
}

role_is_known() {
  local candidate="$1" role
  for role in "${ROLES[@]}"; do
    [[ $role == "$candidate" ]] && return 0
  done
  return 1
}

[[ $# -ge 2 ]] || usage
readonly ACTION="$1"
readonly ROLE="$2"

if ! role_is_known "$ROLE"; then
  echo "[FAIL] 未知の役: $ROLE" >&2
  echo "       使えるのは次のものだけ: ${ROLES[*]}" >&2
  exit 2
fi

if ! [[ $TTL_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_LEASE_TTL_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi
if ! [[ $LOCK_WAIT_SEC =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_LEASE_LOCK_WAIT_SEC は 0 以上の整数（秒）で指定してください" >&2
  exit 2
fi

# **git の共通ディレクトリに置く。** master は worktree で動くので、作業ツリーごとに
# 置くと同じ役が 2 つ走っても気づけない。`bin/loop-stall` と同じ理由・同じ形。
if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
# worktree からだと相対パスを返すことがある。**物理パスで解決する。**
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリへ移動できません" >&2
  exit 2
}
# **worker はセッションごとに鍵を取る。master は役のまま 1 人。**
#
# worker を役で取ると **2 人目が何もせず終わる**（#74 の直列化が、そのまま並列の
# 妨げになる）。master を並列にしないのは、**判定が並列になるとゲートの意味が薄れる**
# ためである。
#
# **識別子は作業場（worktree の根）から作る。**
#
#   - **毎回変わる値にしない。** 落ちた周回の lease が永遠に残る
#   - **人が付ける名前にしない。** 付け忘れ・付け間違いが「直列化しているつもりで
#     2 つ走る」に化ける
#   - **衝突したら直列になる。** 同じ作業場を共有する 2 つのセッションは、
#     checkout と commit が並行するので**直列でなければならない**。
#     つまり**衝突が正しい答えになる**（人数は前提にしていない。作業場が増えれば
#     そのぶん並列になる）
lease_scope="$ROLE"
SCOPE_LABEL="$ROLE"
if [[ $ROLE == "worker" ]]; then
  if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z $toplevel ]]; then
    echo "[FAIL] 作業場の根を特定できません" >&2
    exit 2
  fi
  toplevel="$(cd "$toplevel" 2>/dev/null && pwd -P)" || {
    echo "[FAIL] 作業場の根へ移動できません" >&2
    exit 2
  }
  # ファイル名にできる形へ畳む。**元のパスが読めるままにする**（どのセッションが
  # 握っているのかを、記録を見るだけで分かるようにする）。
  lease_scope="worker${toplevel//\//_}"
  # **どの単位で弾かれたのかを、出力だけで分かるようにする。** 「worker の周回が
  # 走っています」だと、別の作業場の worker まで止まっているように読める
  SCOPE_LABEL="この作業場（$toplevel）の worker"
fi
readonly lease_scope SCOPE_LABEL
readonly STATE="$common_dir/valence-loop-lease-$lease_scope"

# 判定と書き込みの間に割り込まれると、**両方の周回が「空いている」と読む**。
# ここを守らないと、直列化そのものが成立しない。
exec 9>"$STATE.lock" || {
  echo "[FAIL] lease のロックを作成できません: $STATE.lock" >&2
  exit 2
}
if ! flock -w "$LOCK_WAIT_SEC" 9; then
  echo "[FAIL] lease のロックを取得できません（${LOCK_WAIT_SEC} 秒待機）" >&2
  exit 2
fi

now="$(date +%s)"

# 保持されている lease を読む。期限切れは「誰も持っていない」として扱う。
held_token=""
held_since=""
if [[ -f $STATE ]]; then
  IFS=$'\t' read -r held_token held_since <"$STATE"
  if ! [[ $held_since =~ ^[0-9]+$ ]]; then
    echo "[FAIL] lease の記録を読めません: $STATE" >&2
    exit 2
  fi
  if ((now - held_since >= TTL_SEC)); then
    # **黙って上書きしない。** 期限切れの引き継ぎは、落ちた周回の跡である。
    echo "[WARN] $SCOPE_LABEL の lease が期限切れでした（$((now - held_since)) 秒前に取得）。引き継ぎます" >&2
    held_token=""
  fi
fi

case "$ACTION" in
acquire)
  [[ $# -eq 2 ]] || usage
  if [[ -n $held_token ]]; then
    echo "[FAIL] $SCOPE_LABEL の周回が走っています（$((now - held_since)) 秒前に開始）。この周回は何もしません" >&2
    echo "       待たずに終わるのは、走っている側が同じ状態を読むためです。" >&2
    echo "       読み終えた後だった場合は 1 拍落ちますが、次の周回（保険）が拾います" >&2
    exit 1
  fi
  # token は「返す資格」を表すだけなので、衝突しなければよい。
  if ! token="$(od -An -tx1 -N8 /dev/urandom | tr -d ' \n')" || [[ -z $token ]]; then
    echo "[FAIL] token を生成できません" >&2
    exit 2
  fi
  printf '%s\t%s\n' "$token" "$now" >"$STATE" || {
    echo "[FAIL] lease を書き込めません: $STATE" >&2
    exit 2
  }
  echo "$token"
  ;;
release)
  [[ $# -eq 3 ]] || usage
  if [[ -z $held_token ]]; then
    echo "[FAIL] $SCOPE_LABEL の lease は誰も持っていません" >&2
    exit 1
  fi
  # **他人の lease を返させない。** 引き継がれた後に返すと、走っている周回の
  # 直列化が崩れる（自分は終わったつもりで、相手はまだ走っている）。
  if [[ $held_token != "$3" ]]; then
    echo "[FAIL] $SCOPE_LABEL の lease は別の周回が持っています" >&2
    exit 1
  fi
  rm -f "$STATE" || {
    echo "[FAIL] lease を消せません: $STATE" >&2
    exit 2
  }
  ;;
*)
  usage
  ;;
esac
