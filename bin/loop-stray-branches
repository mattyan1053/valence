#!/usr/bin/env bash
# push されたのに PR が無いブランチと、終わった PR の消し残りを挙げる。
#
#   exit 0 = 無い (何も出さない)
#   exit 1 = ある (標準出力に `<種類>\t<ブランチ>\t<添える値>`)
#   exit 2 = 読めない
#
# **master は open PR を見て、worker は label を見る。どちらも remote のブランチを見ない**
# ので、**PR にならなかったものは、どちらの視界にも入らない** (#148)。
# **実物が 1 日半、誰にも見られずに置かれていた** (365 行の実装と試験)。
#
# **倒れる向きが悪い。** 落ちた周回の残りなら **Issue は `backlog` へ戻っている**ので、
# **次に取った worker はブランチの存在を知らないまま最初から作り直す**——
# **気づく手立てが無いまま静かに捨てられる。**
#
# **2 つを混ぜない。** 拾い手も対処も違う。
#
#   no-pr            … PR が 1 件も無い。**作業が宙に浮いている**ので**人へ渡す**
#                      (救うか捨てるかは中身を見ないと決まらない。**自動で消さない**)
#   beyond-pr        … 終わった PR の**先に積まれている**。**その commit はどの PR にも
#                      入っていない**ので、**人へ渡す** (#177)
#   merged-leftover  … 終わった PR の消し残り。**掃除してよい**
#                      (**先端がその PR の head である**ときだけ。作業は PR に残っている)
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# 列の区切り。**タブにしない**——`IFS` の空白として畳まれ、空の列があるとずれる
# (`bin/loop-handoff` で実際に踏んだ)。
readonly FIELD=$'\037'

usage() {
  echo "使い方: bin/loop-stray-branches" >&2
  echo "        exit 0 = 無い / exit 1 = ある (標準出力) / exit 2 = 読めない" >&2
  exit 2
}

[[ $# -eq 0 ]] || usage

fail_unknown() {
  echo "[FAIL] 読み取れません: $1" >&2
  echo "       宙に浮いたブランチがあるかどうかは、この周回では分かりません" >&2
  exit 2
}

# **remote を直接引く。** ローカルの追跡ブランチは `git fetch` の状態しだいで古い。
if ! refs="$(git ls-remote --heads origin)"; then
  fail_unknown "remote のブランチ"
fi

# **いま作業中のブランチだけを抑える。**
#
# **「どこかで走っているか」では足りない** (#148 のレビュー)。**どこか 1 つでも走って
# いれば全部隠す**と、**worker が途切れず動く環境では紛失した作業が永久に見つからない**
# ——**動いているほど見つからない**という、**向きが逆**の壊れ方になる。
#
# **時間で切らない**——**遅い周回と落ちた周回は、経過時間では分けられない** (#129)。
# **走っている作業場を lease から取り、そこで checkout されているブランチ**を抑える。
declare -A working=()
busy_status=0
busy_out="$("${BASH_SOURCE[0]%/*}/loop-lease" busy worker)" || busy_status=$?
case "$busy_status" in
  0)
    while read -r workspace; do
      [[ -n $workspace ]] || continue
      # **読めなければ、どちらへも倒さない。** 走っているのに触っているブランチが
      # 分からない状態で「宙に浮いている」と言えば誤報、黙れば見落としである。
      if ! branch="$(git -C "$workspace" symbolic-ref --short HEAD 2>/dev/null)"; then
        fail_unknown "走っている作業場のブランチ ($workspace)"
      fi
      working["$branch"]=1
    done <<<"$busy_out"
    ;;
  1) ;; # 走っていない
  *) fail_unknown "走っている周回" ;;
esac

found=0
while read -r sha ref; do
  [[ -n $ref ]] || continue
  branch="${ref#refs/heads/}"
  # **main は見ない。**
  [[ $branch != "main" ]] || continue

  # **ブランチごとに引く。** 一括で取ると **`--limit` を超えた古い PR が「無い」に化ける**
  # (この repo は既に PR が 171 件)。**`--head` なら PR の総数に依らない。**
  #
  # **fork の PR は別物である。** `headRefName` だけをキーにすると、**fork の PR が
  # origin の無関係なブランチに対応付けられ**、**終わっていれば「消してよい」と表示される**
  # ——**PR に残っていない作業を消すことになる** (#148 が塞ごうとした穴を、塞ぐ側が広げる)。
  #
  # **head も取る。** **「終わった PR がある」だけでは、その中身が PR に入っている
  # ことにならない** (#177)。**マージのあとに積んだ commit は、どの PR にも入っていない**
  # ——**消してよいと言うと、その作業が消える**（実物があった。#78 の叩き台）。
  if ! prs="$(gh pr list --head "$branch" --state all --limit 20 \
    --json number,state,isCrossRepository,headRefOid \
    --jq '.[] | "\(.number)\u001f\(.state)\u001f\(.isCrossRepository)\u001f\(.headRefOid)"')"; then
    fail_unknown "PR の一覧 ($branch)"
  fi

  # **同じ head に複数の PR が付きうる** (作り直した場合)。**OPEN があれば作業中**、
  # 無ければ終わったものとして扱う。
  state=""
  number=""
  while IFS="$FIELD" read -r pr_number pr_state pr_cross _pr_oid; do
    [[ -n $pr_number ]] || continue
    # **絞り込みを jq の中に置かない。** **偽の `gh` から作れない形になり、
    # 試験がこの判定を 1 度も通らない** (#159 で踏んだ)。
    [[ $pr_cross != "true" ]] || continue
    # **表示に使うのは 1 件だけ**（どの PR かが分かればよい）
    if [[ $state != "OPEN" ]]; then
      state="$pr_state"
      number="$pr_number"
    fi
  done <<<"$prs"

  # **先端がどの PR に入っているかは、上限に依らない口で尋ねる** (#180 のレビュー 2 周目)。
  #
  # **一覧の `--limit` に根拠は無い。** **上げても、次の誰かが同じ問いを持つ** (#134 の形)
  # ので、**数字を調整せず、判定から外す**——**「この commit を含む PR があるか」は、
  # その head の一覧の何番目にあるかと関係が無い**。
  #
  # **open な PR が含んでいたら、消してはいけない**（PR が壊れる）。**一覧の上限では
  # そこも取りこぼす**ので、**state もこちらから見る**。
  if ! tip_prs="$(gh api --paginate "repos/{owner}/{repo}/commits/$sha/pulls" \
    --jq '.[] | "\(.number)\u001f\(.state)\u001f\(.head.repo.full_name)\u001f\(.base.repo.full_name)"' 2>/dev/null)"; then
    fail_unknown "先端を含む PR ($branch)"
  fi
  tip_in_pr=0
  tip_open=0
  while IFS="$FIELD" read -r tip_number tip_state tip_head_repo tip_base_repo; do
    [[ -n $tip_number ]] || continue
    # **fork の PR は別物である**（上と同じ判断。**絞り込みは jq に置かない**）
    [[ $tip_head_repo == "$tip_base_repo" ]] || continue
    if [[ $tip_state == "open" ]]; then
      tip_open=1
    else
      tip_in_pr=1
    fi
  done <<<"$tip_prs"

  # **作業中である。** 上の `state` は一覧の上限で取りこぼしうるので、こちらでも見る
  ((tip_open == 0)) || continue

  case "$state" in
    OPEN)
      # **作業中である。** 報告すると**毎周回出る警告**になり、読まれなくなる
      # (`bin/loop-merge` の消し残り警告が実際にそうなった)
      ;;
    "")
      # **PR がまだ無い。** いま触っているブランチなら、これから PR になる
      [[ -z ${working[$branch]-} ]] || continue
      printf 'no-pr\t%s\t%s\n' "$branch" "${sha:0:8}"
      found=1
      ;;
    *)
      # MERGED / CLOSED。**中身が PR に残っているかは、先端がその PR の head かで決まる。**
      #
      # **祖先関係では見られない。** squash merge なので、**`main` に入った commit は
      # ブランチ側の commit の祖先にならない**——**「main に入っているか」を尋ねると、
      # 正しくマージされた消し残りまで「入っていない」になる**。
      #
      # **迷ったら人へ渡す側へ倒す。** 読めないとき（head が空）も消してよいと言わない
      if ((tip_in_pr == 1)); then
        printf 'merged-leftover\t%s\t#%s (%s)\n' "$branch" "$number" "$state"
      else
        # **PR の先に積まれている。** その commit は**どの PR にも入っていない**ので、
        # **救うか捨てるかは中身を見ないと決まらない**——`no-pr` と同じ側（人へ渡す）
        printf 'beyond-pr\t%s\t#%s (%s) の先に積まれている: %s\n' \
          "$branch" "$number" "$state" "${sha:0:8}"
      fi
      found=1
      ;;
  esac
done <<<"$refs"

((found == 1)) || exit 0
exit 1
