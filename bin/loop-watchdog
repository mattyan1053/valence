#!/usr/bin/env bash
# **無人運転が止まっていないかを、ループの外から見る** (#670)。
#
#   bin/loop-watchdog [--hours N] [--report]
#
#   exit 0 = 動いている / 見るべき仕事が無い
#   exit 1 = 止まっている（人を呼ぶ）
#   exit 2 = 判定できない（GitHub を読めない / 残せない）
#
# **なぜ外に置くか。** **予定表（cron）は 7 日で切れ、切れたことに気づく仕組み
# （`bin/loop-cadence`）は、切れる側で走っている**——**cron が死ぬと検出器も走らない。**
# **1 つだけ死ぬなら他の役が見つける**が、**全部が同時に死ぬと誰も走らない。**
#
# **実測**（#670。`.git` の共通ディレクトリの記録から）: **2026-09-09 13:47〜13:52 に
# 3 つの作業場が揃って止まり、次の周回は 09-10 20:2x**——**30.6 時間、誰も気づかず、
# 人が戻って突いて再開した。** **通常時の間隔は最大 2.1 時間**である。
#
# **これは GitHub Actions から走らせる**（`.github/workflows/loop-watchdog.yml`）
# ——**VM もセッションも要らない**ので、**ループが全部止まっていても動く。**
#
# **周回そのものは GitHub から見えない**（**記録は VM の中**）。**心拍は足さない**
# ——**見るのは「動くべき仕事が動いていないこと」**である。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# **既定の閾値。** **通常時の最大間隔（2.1 時間）の 5 倍以上**であり、
# **実測した障害（30.6 時間）の半分より短い。** **2 時間ごとに見る**ので、
# **気づくまでは最長 14 時間**である。
HOURS=12
REPORT=0

usage() {
  echo "使い方: bin/loop-watchdog [--hours N] [--report]" >&2
  echo "        exit 0 動いている / exit 1 止まっている / exit 2 判定できない" >&2
  echo "        --report: 止まっていたら Issue に残す（既に立っていれば足さない）" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hours)
      shift
      [[ $# -gt 0 ]] || {
        usage
        exit 2
      }
      HOURS="$1"
      ;;
    --report) REPORT=1 ;;
    *)
      usage
      exit 2
      ;;
  esac
  shift
done

if ! [[ $HOURS =~ ^[0-9]+$ ]] || [[ $HOURS -eq 0 ]]; then
  echo "[FAIL] 設定: --hours は 1 以上の整数で指定してください" >&2
  exit 2
fi
readonly HOURS REPORT

NOW="${LOOP_WATCHDOG_NOW:-$(date +%s)}"
if ! [[ $NOW =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_WATCHDOG_NOW は epoch 秒で指定してください" >&2
  exit 2
fi
readonly NOW

# **止まっているのが正しいものと、動くべきもの**は、下の `waiting` / `moving` が持つ。
# **立てる Issue の題。** **同じことを 2 度立てないための鍵でもある。**
readonly TITLE="無人運転が止まっています（自動検出）"

# **状態 label を付けて立てる** (#675 のレビュー)。**付けないと、この Issue 自身が
# ループを止める**——**`bin/loop-unlisted-issues` は label の無い open Issue を
# `unlisted-issue:<番号>` として毎周回積み**、**3 周で `loop/STOP`** になる
# （**人が予定表だけ直して、この Issue を開いたままにするだけで起きる**）
# ——**見張りが、復旧したループを止める。**
#
# **`blocked` にする。** **`bin/loop-unlisted-issues` が「一覧に載っている」と数える
# 4 つの 1 つ**（`backlog` / `ready` / `in-progress` / `blocked`）であり、
# **`ready` / `in-progress` でも、昇格できる `backlog` でもない**ので、
# **作業が尽きたときの `no-work` はこれまでどおり積まれる**（**第 4 層を殺さない**）。
#
# **`ready` にしない**——**worker が実装しに来る**（**何を実装するのか、が無い**）。
# **`backlog` にもしない**——**昇格の候補として読まれる。**
readonly LABELS=(blocked)

# **リポジトリは実行時に決める** (§1)。**設定に固定しない。**
if ! repo_ref="$(gh repo view --json owner,name --jq '.owner.login, .name')"; then
  echo "[FAIL] GitHub: リポジトリを特定できません" >&2
  exit 2
fi
mapfile -t repo_parts <<<"$repo_ref"

# **区切りは US。** **タブや空白を使わない**——**label 名には空白が入る。**
readonly FIELD=$'\037'

# **件数で打ち切らない** (#328 のレビュー。#675 のレビュー)。**`gh issue list --limit N`
# は「最大 N 件」**なので、**open がそれを超えたリポジトリでは、古いものから
# 検査の外へ出る**——**返ってきた窓が backlog と待ちだけなら「静かでよい」へ倒れ**、
# **止まっているのに黙る。** **内側の connection を明示的に辿る**
# （**`pageInfo` と `after` が無いと `--paginate` は外側しか進めない**）。
#
# **label は 1 行ずつ受ける** (#550。#675 のレビュー)——**繋いでから探さない。**
# **GitHub の label 名にはカンマを入れられる**ので、**`foo,ready,bar` という 1 つの
# label が `,ready,` に部分一致する**（**逆に、本物の `ready` を持つ Issue が
# `foo,parked,bar` で待ち扱いになり、監視から消える**）。
#
# **`--jq` には判定を持たせない**——**形を整えるだけ**である
# （`item<US><番号><US><更新時刻>` と `label<US><名前>`）。**持たせると、
# どのラベルを外すかが試験の外へ出る**（`AGENTS.md` §5）。
#
# **`labels(first:100)` を超えて付いた label は読めない**——**そのとき倒れる先は
# 「数える」側**である（**待ちの label を読み落とすと鳴る**）。**黙る側ではない。**
# **`$owner` などは GraphQL / jq の変数**である——**シェルに展開させない。**
# shellcheck disable=SC2016
readonly SHAPE='.nodes[]
  | "item\u001f\(.number)\u001f\(.updatedAt)", (.labels.nodes[] | "label\u001f\(.name)")'

open_items() {
  local field="$1"
  gh api graphql --paginate \
    -f owner="${repo_parts[0]-}" -f repo="${repo_parts[1]-}" \
    -f query="query(\$owner:String!,\$repo:String!,\$endCursor:String){
      repository(owner:\$owner,name:\$repo){
        $field(states:OPEN, first:100, after:\$endCursor){
          pageInfo{hasNextPage endCursor}
          nodes{number updatedAt labels(first:100){nodes{name}}}}}}" \
    --jq ".data.repository.$field$SHAPE"
}

if ! issues="$(open_items issues)"; then
  echo "[FAIL] GitHub: open な issue を読めませんでした" >&2
  exit 2
fi
if ! prs="$(open_items pullRequests)"; then
  echo "[FAIL] GitHub: open な PR を読めませんでした" >&2
  exit 2
fi

# **待っているのが正しいものか。** **完全一致で見る**（上記）。
#
# **`parked` だけでは待ちにしない** (#675 のレビュー 2 周目)。**人にしか解けないのは
# `parked` と `awaiting-human` の両方**である（`bin/loop-open-work` の 20〜22 行）
# ——**`parked` だけなら、先行 PR を待っているだけでループが解く。**
# **判定を 2 箇所に持たない**（§5）——**あちらと同じ線に揃える。**
#
# **`blocked` は待ち**である（**master が着手済みの作業を止めた状態**）。
# **`waiting-condition` も待ち**である（#312。**完了条件がまだ満たせない**）。
is_waiting() {
  local label parked=0 human=0
  for label in "$@"; do
    case "$label" in
      blocked | waiting-condition) return 0 ;;
      parked) parked=1 ;;
      awaiting-human) human=1 ;;
      *) ;;
    esac
  done
  [[ $parked -eq 1 && $human -eq 1 ]]
}

# **動くべき Issue か。**
#
# **`backlog` も数える** (#675 のレビュー 2 周目)——**`ready` / `in-progress` /
# open PR が無く、`waiting-condition` の付かない `backlog` だけが残る盤面は、
# `bin/loop-handoff` が「master が昇格させる番」と読む状態**である。
# **数えないと、いちばん静かな盤面で見張りが黙る。**
is_moving() {
  local label
  for label in "$@"; do
    case "$label" in
      ready | in-progress | backlog) return 0 ;;
      *) ;;
    esac
  done
  return 1
}

# **待ちの label が付いていないものだけを残す。** **Issue は、そのうえで
# 動くべき label を持つものだけ**である。
work=""
keep() {
  local require_moving="$1"
  local number="" updated="" kind value extra
  local labels=()
  flush() {
    [[ -n $number ]] || return 0
    is_waiting "${labels[@]+"${labels[@]}"}" && return 0
    if [[ $require_moving -eq 1 ]]; then
      is_moving "${labels[@]+"${labels[@]}"}" || return 0
    fi
    work+="$number$FIELD$updated"$'\n'
  }
  while IFS="$FIELD" read -r kind value extra; do
    case "$kind" in
      item)
        flush
        number="$value"
        updated="$extra"
        labels=()
        ;;
      label) labels+=("$value") ;;
      *) ;;
    esac
  done
  flush
}

keep 1 <<<"$issues"
keep 0 <<<"$prs"
work="${work%$'\n'}"

if [[ -z $work ]]; then
  echo "[OK] 動くべき仕事はありません（静かでよい）"
  exit 0
fi

# **いちばん新しい動きを探す。** **1 つでも動いていれば、ループは生きている**
# ——**どれが動いたかではなく、何かが動いたか**を見る。
newest=0
while IFS="$FIELD" read -r number updated; do
  [[ -n $updated ]] || continue
  if ! at="$(date -u -d "$updated" +%s 2>/dev/null)"; then
    echo "[FAIL] GitHub: #$number の更新時刻を読めませんでした" >&2
    exit 2
  fi
  if [[ $at -gt $newest ]]; then
    newest="$at"
  fi
done <<<"$work"

if [[ $newest -eq 0 ]]; then
  echo "[FAIL] GitHub: 更新時刻が 1 つも読めませんでした" >&2
  exit 2
fi

count="$(printf '%s\n' "$work" | grep -c '')"
idle=$((NOW - newest))
readonly idle count
printf -v hours '%.1f' "$(awk -v s="$idle" 'BEGIN { print s / 3600 }')"

if [[ $idle -le $((HOURS * 3600)) ]]; then
  echo "[OK] 動いています（$count 件のうち、いちばん新しい動きは $hours 時間前）"
  exit 0
fi

echo "[FAIL] 止まっています: 動くべき $count 件が、$hours 時間 動いていません" >&2

if [[ $REPORT -eq 0 ]]; then
  exit 1
fi

# **同じことを 2 度立てない** (#248)。**2 時間ごとに走る**ので、
# **毎回立てると、そのうち読まれなくなる。**
if ! open="$(gh issue list --state open --limit 5 --search "in:title \"$TITLE\"" --json number --jq '.[].number')"; then
  echo "[FAIL] GitHub: 既に立っているかを読めませんでした" >&2
  exit 2
fi
if [[ -n $open ]]; then
  echo "[INFO] 既に立っています（足しません）" >&2
  exit 1
fi

body="$(
  cat <<BODY
**動くべき仕事が $count 件あるのに、$hours 時間 どれも動いていません。**

**この Issue は GitHub Actions から立てています**（\`bin/loop-watchdog\`。#670）
——**ループの外から見ている**ので、**ループが全部止まっていても届きます。**

## 見に行くところ

- **各セッションで \`CronList\` を引く**（**引けるのはそのセッション自身だけ**）。
  **空なら \`/loop 30m /loop-worker\` を打ち直す**
- **\`bin/loop-cadence\`** —— **どの作業場が止まっているか**
- **\`loop/STOP\`** —— **人が止めているなら、この Issue は閉じてください**
  （**STOP は GitHub から見えません**）

## 動き出したら、閉じてください

**この Issue は、止まっていることを人へ届けるためだけに在ります。** **周回が戻ったら
閉じてください**——**開いたままでも次のぶんは立ちません**（**同じ題のものが
開いていれば足さない**）が、**盤面には残り続けます。**

## 直したことにしないでください

**入れ直しは応急処置です**（#670）。**7 日後にまた切れます。**
BODY
)"

if ! gh issue create --title "$TITLE" --body "$body" --label "${LABELS[0]}" >/dev/null; then
  echo "[FAIL] GitHub: Issue を立てられませんでした" >&2
  exit 2
fi

exit 1
