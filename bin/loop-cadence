#!/usr/bin/env bash
# **周回が始まっているかを見る** (#378)。
#
#   bin/loop-cadence
#
#   exit 0 = cron の周回が続いている
#   exit 1 = 止まっている作業場がある（cron の周回が来ていない）
#   exit 2 = 判定できない（間隔が分からない / 記録が無い）
#
# **`bin/loop-stall` が数えるのは「止まった周回」**で、**`bin/loop-procedure-changed` の
# ぶんを数えるのが `procedure-churn`** (#367)——**どちらも「周回が始まっている」ことが前提**
# である。**始まってすらいない周回は、その手前**にあり、**印は「周回が始まったとき」に
# 付く**ので、**始まらなければ何も書かれない。**
#
# **実測**（2026-08-22、worker-1）: **要求を出してから 2.5 時間、その作業場は動かず、
# カウンタは 2 つとも 0 だった。** **外からは「周回を始めたばかり」と見える**
# ——**人に突かれて始まった周回も、cron の周回も、同じ印だった**からである。
#
# **だから、cron の周回だけを数える。** **人に突かれたぶんを混ぜると、
# 突かれて動いた日が「健全」に見える**——**それが実測で起きたことである。**
#
# **止めない。** **`loop/STOP` は全ループを止める**ので、**「鳴っていない」で
# 全部止めるのは重い**——**ここは見えるようにするだけ**である（#378 の指示）。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

[[ $# -eq 0 ]] || {
  echo "使い方: bin/loop-cadence   （引数は取らない）" >&2
  echo "        exit 0 続いている / exit 1 止まっている / exit 2 判定できない" >&2
  exit 2
}

# **いま。** **試験のためだけに外から渡せる**——**判定は時刻の差だけで決まる**ので、
# **決まった時刻から見えないと、確かめようがない。**
NOW="${LOOP_CADENCE_NOW:-$(date +%s)}"
if ! [[ $NOW =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_CADENCE_NOW は epoch 秒で指定してください" >&2
  exit 2
fi
readonly NOW

# **間隔は、ループを起動した人が決めたものである** (#378 の完了条件)。
#
# **`/loop <間隔> /loop-worker` の <間隔> がそれ**で、**このリポジトリの中には無い**
# ——**手順書へ数字を書き写さない**（写した瞬間に、起動した人の設定と食い違いうる）。
# **渡されなければ「分からない」と答える**——**「異常なし」へ倒さない** (#304 と同じ向き)。
INTERVAL="${LOOP_CRON_INTERVAL_SEC:-}"
if [[ -n $INTERVAL ]] && { ! [[ $INTERVAL =~ ^[0-9]+$ ]] || ((INTERVAL < 1)); }; then
  echo "[FAIL] 設定: LOOP_CRON_INTERVAL_SEC は 1 以上の整数（秒）で指定してください" >&2
  exit 2
fi
readonly INTERVAL

# **何回ぶん落としたら言うか。** **1 回落としただけでは鳴らさない**
# ——**cron の 1 回のずれ（実行が詰まった、機械が寝ていた）で人を呼ぶと、
# 呼ばれる側がこの出力を読まなくなる。** **2 回続けて来なければ言う。**
readonly MISSED_TICKS=2

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリを解決できません" >&2
  exit 2
}
readonly common_dir

# **居るはずの作業場を並べる** (#381 のレビュー 2 周目)。
#
# **記録だけを並べると、1 度も始まっていない作業場が列に出てこない**——**この仕組みが
# 消しに来たものそのもの**である（**`./task loop:worker:add` で足した直後がそれ**）。
#
# **どこに居るかは `./task` が答える**——**足しているのがあちら**なので、**規則をここへ
# 書き写すと、足す側と数える側で食い違う。**
if ! workspaces="$("$(git rev-parse --show-toplevel)/task" loop:worker:paths 2>/dev/null)"; then
  echo "[WARN] 作業場の一覧を読めません（./task loop:worker:paths）" >&2
  exit 2
fi
if [[ -z $workspaces ]]; then
  echo "[WARN] worker の作業場が 1 つも登録されていません" >&2
  exit 2
fi

# **記録は作業場ごと**である（`bin/loop-lease` が書く。名前の作り方はあちらが持つ）。
found=0
stale=0
undecidable=0
workspace_path=""
scope=""

# その scope の周回が来ているか。**1 行出して、判定を足す。**
#
# **役ごとに 2 通り持たない** (#422)。**master も worker も、見ているのは
# 「最後に cron で始まったのはいつか」**である——**違うのは記録の名前だけ。**
# **止まっている行には、どの作業場かを添える** (#433)。**worker は 2 人いる**ので、
# **役名は 2 つとも `worker`**、**出るのは digest だけ**——**読んだ人は、セッションを
# 順に当たることになる**（**#430 が消したかったのは、まさにその探索**）。
#
# **digest の作り方は変えない**（#433 の範囲外）——**`bin/loop-lease` が同じものを
# 使っている**ので、**読みやすい名前にすると、そちらの記録の置き場所が変わる。**
#
# **行を足す形にする。** **この出力を読むのは `./task loop:status` の `show_cadence`
# だけ**で、**あちらは列を解釈しない**（字下げして出すだけ）——**それでも、
# 既にある行の形は動かさない。**
#
# **止まっている行だけに出す**（**毎回全部の道を出さない**）。
#
# **引けなかったときは、引けないと言う** (#435 のレビュー。`bin/doctor` と同じ形)。
# **行が出ないだけだと「この役には作業場が無い」に見える**——**「読めなかった」が
# 「無かった」に化ける。**
#
# **そこがいちばん要る場面**である——**`./task loop:master:path` が答えないのは、
# worktree が消えた・動いたとき**で、**まさに「どこにあるのか」を知りたい。**
# **案内は「その行の下の workspace= を見る」と言う**ので、**無い行を探させない。**
show_workspace() {
  if [[ -z ${1-} ]]; then
    echo "  workspace=不明（場所を引けません。記録だけが残っています）"
    return 0
  fi
  echo "  workspace=$1"
}

# **記録から、周期を測る** (#438)。**間隔が渡されなかったときの物差し。**
#
# **間隔はリポジトリへ固定しない**（#378 / `AGENTS.md` §1。**起動した人が決めるもの**）
# ——**しかし、実物では誰も渡していなかった**（**渡すのは試験だけ**）ので、
# **足した案内が鳴る場面に到達しない**（**cron が 1 本も無いときを除いて、いつも
# `unknown`**）。
#
# **いちばん短い間を採る。ただし下限を置く。**
#
# **上を採ってはいけない** (#439 のレビュー)——**過去に 1 度落ちていると、その欠落が
# そのまま物差しになる**（**3 時間空いた記録があれば、次の停止は 6 時間 `ok`**）。
# **記録から押し出されるまで続く**ので、**止めるために足したものが、止めなくなる。**
#
# **下限が要る** ——**実測の記録には数十秒の間がある**（`35 49 …`）。**あれは
# 「捨てて呼び直した周回」**で、**同じ cron の中で 2 回 `acquire` している。**
# **周期として読むと窓が数十秒になり、正常な周回で鳴り続ける。**
# **cron の刻みは 1 分より細かくならない**ので、**それより短い間は周期ではない。**
#
# **落とした回は、上へずれるだけ**である——**最小は周期のほうに残る。**
#
# **2 本要る。** **1 本では間が測れない**ので、**そこは「分からない」のまま**である。
readonly SHORTEST_TICK=60

measured_interval() {
  local previous="" at gap shortest=""
  for at in "$@"; do
    if [[ -n $previous ]]; then
      gap=$((at - previous))
      if ((gap >= SHORTEST_TICK)) && { [[ -z $shortest ]] || ((gap < shortest)); }; then
        shortest="$gap"
      fi
    fi
    previous="$at"
  done
  [[ -n $shortest ]] || return 1
  printf '%s' "$shortest"
}

evaluate_scope() {
  local scope="$1" workspace="${2-}"
  local starts last_cron last_poke last_unknown age verdict window longest
  local at trigger _where interval interval_shown cron_at=()
  starts="$common_dir/valence-loop-starts-$scope"
  if [[ ! -f $starts ]]; then
    # **1 度も始まっていない。** **記録が無いことを「異常なし」へ倒さない**
    # ——**足したばかりの worker が、永久に見えなくなる。**
    echo "scope=${scope:0:12} last_cron=- last_poke=- last_unknown=- age=- interval=${INTERVAL:-unknown} never"
    show_workspace "$workspace"
    stale=1
    return 0
  fi
  last_cron="-"
  last_poke="-"
  last_unknown="-"
  # **3 列目（作業場）は読むために置いてある**——**`scope` は digest で、そこからは
  # パスへ戻せない**ので、**記録を人が読むときの手がかりはこれだけ**である。
  while IFS=$'\t' read -r at trigger _where; do
    [[ $at =~ ^[0-9]+$ ]] || continue
    case "$trigger" in
      cron)
        last_cron="$at"
        cron_at+=("$at")
        ;;
      poke) last_poke="$at" ;;
      # **知らない印は「不明」へ入れる**——**cron へ倒さない**（渡し忘れた日から
      # 何も見なくなる）。**綴りが変わったときも、こちらへ落ちる。**
      *) last_unknown="$at" ;;
    esac
  done <"$starts"

  age="-"
  verdict="ok"
  if [[ $last_cron == "-" ]]; then
    # **一度も cron で始まっていない。** **突かれただけの作業場がこれ**である。
    #
    # **間隔は要らない** (#381 のレビュー 3 周目)。**間隔が要るのは「どれだけ経ったら
    # 古いか」だけ**で、**1 本も無いことは、間隔を知らなくても言える**——
    # **ここを `unknown` へ落とすと、人が 1 回突いた作業場が `never` から降りてしまう。**
    verdict="stale"
  else
    age=$((NOW - last_cron))
    ((age < 0)) && age=0
    # **渡されたものが正である** (#378)。**測った値で上書きしない**
    # ——**起動した人が決めたもの**が、いちばん確かである。
    interval="$INTERVAL"
    interval_shown="interval=${INTERVAL:-unknown}"
    if [[ -z $interval ]] && interval="$(measured_interval "${cron_at[@]}")"; then
      # **測ったものだと分かる形で出す**——**渡された値と混ぜない**
      # （**読む人が、どちらで判定したか分かるように**）。
      interval_shown="interval=~$interval"
    fi
    if [[ -z $interval ]]; then
      verdict="unknown"
    else
      # **窓は、実測があれば広げる** (#381 のレビュー 4 周目)。
      #
      # **記録が増えるのは `acquire` が取れたときだけ**である——**前の周回がまだ
      # 走っていると、次の cron は「走っている周回がある」で何もせず終わる**ので、
      # **鳴っていても記録は動かない。** **周回が窓を超えると、cron は来ているのに
      # 「来ていない」と言う**——**「終わっていない」を「来ていない」に化けさせない。**
      #
      # **読むのは `bin/loop-lease` が書いた実測**（**その作業場でいちばん長かった
      # 周回の秒数**。`alive` が同じ問題を同じもので解いている）——**判定は写さず、
      # 実測だけを読む。**
      #
      # **広げるのは「走っていた時間 ＋ 待ち 1 回」まで**である。**次の周回が始まれる
      # のは、前のが終わってから**で、**そこから次の cron までは最大で間隔 1 つ**——
      # **それ以上待っても始まらないなら、鳴っていない。**
      # **「長いかもしれない」で全部を黙らせない。**
      window=$((interval * MISSED_TICKS))
      if [[ -f "$common_dir/valence-loop-roundlen-$scope" ]] &&
        read -r longest <"$common_dir/valence-loop-roundlen-$scope" 2>/dev/null &&
        [[ $longest =~ ^[0-9]+$ ]]; then
        ((longest + interval <= window)) || window=$((longest + interval))
      fi
      ((age > window)) && verdict="stale"
    fi
  fi
  echo "scope=${scope:0:12} last_cron=$last_cron last_poke=$last_poke last_unknown=$last_unknown age=$age ${interval_shown:-interval=${INTERVAL:-unknown}} $verdict"
  [[ $verdict != "stale" ]] || show_workspace "$workspace"
  case "$verdict" in
    stale) stale=1 ;;
    unknown) undecidable=1 ;;
  esac
}

# **worker の作業場を並べる。** **master はここに出てこない**（`./task` が除いている）
# ——**あちらは 1 つしかないので、下で別に見る** (#422)。
while IFS= read -r workspace_path; do
  # **絶対パスで、いま在るものだけを見る。** **`./task` は前置きの警告を stdout へ
  # 出すことがある**ので、**行をそのまま作業場として扱わない**（`bin/loop-stall` も
  # 同じ形で「実在するものだけ」を見ている）。**消された作業場もここで落ちる**
  # ——**一覧に残っていても、回っていないのが正しい。**
  [[ $workspace_path == /* && -d $workspace_path ]] || continue
  # **名前の作り方は `bin/loop-lease` が持つ**（`scope`）——**ここでは訊くだけ。**
  # **中で呼ぶものに標準入力を渡さない**——**`while read` が読むはずの残りを食われると、
  # 2 つ目以降の作業場が黙って落ちる。**
  if ! scope="$(cd "$workspace_path" 2>/dev/null &&
    "${BASH_SOURCE[0]%/*}/loop-lease" scope worker 2>/dev/null </dev/null)" || [[ -z $scope ]]; then
    echo "[WARN] 作業場の名前を作れません: $workspace_path" >&2
    undecidable=1
    continue
  fi
  found=1
  evaluate_scope "$scope" "$workspace_path"
done <<<"$workspaces"

# **master も見る** (#422)。**judge 役が止まると、worker は PR を出せても先へ進めない**
# ——**#421 は「ゲートを回せる」まで揃った状態で 1 時間 44 分止まっていた。**
#
# **居るかどうかは 2 つで見る。** **`./task` が場所を答えれば居る**（**足したばかりで、
# まだ 1 度も回していない master もここで見える**）。**答えなくても記録があれば、
# 回っていた**——**作業場を消したあとも、止まったことは言う。**
#
# **どちらも無いなら、この loop に master は居ない。** **何も言わない**
# ——**居ないものを「止まっている」と言うと、読む人が探しに行く。**
master_path=""
if master_path="$("$(git rev-parse --show-toplevel)/task" loop:master:path 2>/dev/null </dev/null)" &&
  [[ $master_path == /* && -d $master_path ]]; then
  found=1
  evaluate_scope master "$master_path"
elif [[ -f "$common_dir/valence-loop-starts-master" ]]; then
  found=1
  evaluate_scope master
fi

if ((found == 0)); then
  # **記録が無いことと、始まっていないことは同じではない** ——**混ぜない。**
  # **この仕組みが入る前の作業場**も、**一度も周回を回していない作業場**もここへ来る。
  echo "[WARN] 周回が始まった記録がありません（no-record）" >&2
  echo "       この仕組みが入る前の作業場か、まだ一度も回していない作業場です" >&2
  exit 2
fi

# **確定したものが先である** (#381 のレビュー 3 周目)。**見出しは終了コードだけで決まる**
# ので、**「止まっている」を「判定できない」に負けさせると、人は「判定できません」しか
# 読まない**——**列に出ていても、読まれなければ同じ**である。
# **判定を持つところに、次の一手を置く** (#430)。**2026-08-24、3 つの役すべてが
# `stale` になり、3 つのセッションが別々に同じところを探した**——**原因は予定表が
# 空だったこと**（**道具の recurring は 7 日で自動的に期限切れになる**）。
# **master は「cron が 1 度も来ていない」と読み違えて、人へ渡しかけている。**
#
# **限界も同じところに書く。** **この記録から言えるのは「直近の記録に、cron で
# 始まった周回が無い」まで**である——**記録は直近のぶんしか保たない**うえ、
# **走っている最中に鳴った cron は `acquire` が exit 1 で終わり、記録が 1 行も増えない。**
#
# **指す先を、証拠の出どころに合わせる** (#431 のレビュー)。**この道具は全部の役を見る**
# ので、**「このセッション」と書くと、別の役だけが止まっているときに嘘になる**
# ——**読んだ人は自分の予定表を引き、そこは正常なので、そこで止まる。**
#
# **止まっているときだけ言う**（**毎回鳴る案内は、読まれなくなる**）。
# **`./task loop:status` はこの stderr ごと拾う**ので、そちらから読む人にも届く。
if ((stale == 1)); then
  echo "[WARN] まず予定表を引くこと——stale と出た役のセッションで CronList を見る" >&2
  echo "       呼んだ役が健全でも、別の役が stale なら、空なのはそちらの予定表である" >&2
  echo "       どの作業場かは、その行の下の workspace= を見る" >&2
  echo "       interval=~ の行は、記録から測った周期を物差しにしている" >&2
  echo "       （この道具は他のセッションを引けない。入れ直すのもセッション自身）" >&2
  echo "       recurring の予定は 7 日で期限切れになるので、消えていることがある" >&2
  echo "       ここから言えるのは「直近の記録に、cron の周回が無い」まで" >&2
  echo "       走っている最中に鳴った cron は acquire で終わり、記録は増えない" >&2
fi

((stale == 1)) && exit 1
((undecidable == 1)) && exit 2
exit 0
