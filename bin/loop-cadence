#!/usr/bin/env bash
# **周回が始まっているかを見る** (#378)。
#
#   bin/loop-cadence            すべての行を出す
#   bin/loop-cadence --quiet    止まっている行だけを出す（続いていれば何も出さない）
#
#   exit 0 = cron の周回が続いている
#   exit 1 = 止まっている作業場がある（cron の周回が来ていない）
#   exit 2 = 判定できない（間隔が分からない / 記録が無い）
#
# **`bin/loop-stall` が数えるのは「止まった周回」**で、**`bin/loop-procedure-changed` の
# ぶんを数えるのが `procedure-churn`** (#367)——**どちらも「周回が始まっている」ことが前提**
# である。**始まってすらいない周回は、その手前**にあり、**印は「周回が始まったとき」に
# 付く**ので、**始まらなければ何も書かれない。**
#
# **実測**（2026-08-22、worker-1）: **要求を出してから 2.5 時間、その作業場は動かず、
# カウンタは 2 つとも 0 だった。** **外からは「周回を始めたばかり」と見える**
# ——**人に突かれて始まった周回も、cron の周回も、同じ印だった**からである。
#
# **だから、cron の周回だけを数える。** **人に突かれたぶんを混ぜると、
# 突かれて動いた日が「健全」に見える**——**それが実測で起きたことである。**
#
# **止めない。** **`loop/STOP` は全ループを止める**ので、**「鳴っていない」で
# 全部止めるのは重い**——**ここは見えるようにするだけ**である（#378 の指示）。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# **止まっている行だけを出す** (#530)。**周回の出口から毎回呼ぶ**ためである
# ——**平常時にも鳴る検査は、そのうち読まれなくなる**（#248。`bin/loop-stray-branches`
# と同じ考え方）。
#
# **絞るのはここ**である（`AGENTS.md` §5）。**呼ぶ側で `grep` すると、読みが 2 箇所に
# 分かれる**——**行の形を変えた日に、片方だけが古くなる。**
#
# **判定は変えない。** **出すか出さないかだけ**である（**終了コードは同じ**）。
QUIET=0
case "${1-}" in
  "") ;;
  --quiet) QUIET=1 ;;
  *)
    echo "使い方: bin/loop-cadence [--quiet]" >&2
    echo "        exit 0 続いている / exit 1 止まっている / exit 2 判定できない" >&2
    echo "        --quiet: 止まっている行だけを出す（続いていれば何も出さない）" >&2
    exit 2
    ;;
esac
[[ $# -le 1 ]] || {
  echo "使い方: bin/loop-cadence [--quiet]" >&2
  exit 2
}
readonly QUIET

# **いま。** **試験のためだけに外から渡せる**——**判定は時刻の差だけで決まる**ので、
# **決まった時刻から見えないと、確かめようがない。**
NOW="${LOOP_CADENCE_NOW:-$(date +%s)}"
if ! [[ $NOW =~ ^[0-9]+$ ]]; then
  echo "[FAIL] 設定: LOOP_CADENCE_NOW は epoch 秒で指定してください" >&2
  exit 2
fi
readonly NOW

# **間隔は、ループを起動した人が決めたものである** (#378 の完了条件)。
#
# **`/loop <間隔> /loop-worker` の <間隔> がそれ**で、**このリポジトリの中には無い**
# ——**手順書へ数字を書き写さない**（写した瞬間に、起動した人の設定と食い違いうる）。
# **渡されなければ「分からない」と答える**——**「異常なし」へ倒さない** (#304 と同じ向き)。
INTERVAL="${LOOP_CRON_INTERVAL_SEC:-}"
if [[ -n $INTERVAL ]] && { ! [[ $INTERVAL =~ ^[0-9]+$ ]] || ((INTERVAL < 1)); }; then
  echo "[FAIL] 設定: LOOP_CRON_INTERVAL_SEC は 1 以上の整数（秒）で指定してください" >&2
  exit 2
fi
readonly INTERVAL

# **何回ぶん落としたら言うか。** **1 回落としただけでは鳴らさない**
# ——**cron の 1 回のずれ（実行が詰まった、機械が寝ていた）で人を呼ぶと、
# 呼ばれる側がこの出力を読まなくなる。** **2 回続けて来なければ言う。**
readonly MISSED_TICKS=2

if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || [[ -z $common_dir ]]; then
  echo "[FAIL] git の共通ディレクトリを特定できません" >&2
  exit 2
fi
common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || {
  echo "[FAIL] git の共通ディレクトリを解決できません" >&2
  exit 2
}
readonly common_dir

# **居るはずの作業場を並べる** (#381 のレビュー 2 周目)。
#
# **記録だけを並べると、1 度も始まっていない作業場が列に出てこない**——**この仕組みが
# 消しに来たものそのもの**である（**`./task loop:worker:add` で足した直後がそれ**）。
#
# **どこに居るかは `./task` が答える**——**足しているのがあちら**なので、**規則をここへ
# 書き写すと、足す側と数える側で食い違う。**
if ! workspaces="$("$(git rev-parse --show-toplevel)/task" loop:worker:paths 2>/dev/null)"; then
  echo "[WARN] 作業場の一覧を読めません（./task loop:worker:paths）" >&2
  exit 2
fi
if [[ -z $workspaces ]]; then
  echo "[WARN] worker の作業場が 1 つも登録されていません" >&2
  exit 2
fi

# **いま周回を回している作業場** (#444)。**走っている最中に鳴った cron は
# `acquire` が exit 1 で終わる**ので、**記録が 1 行も増えない**——**外からは古く
# 見えるが、止まってはいない**（**実測: 60 分ぶん増えていない worker が `stale` に
# 落ちた**）。
#
# **判定は `bin/loop-lease` が持つ**（`running`）——**期限切れの lease は並ばない**
# ので、**落ちたまま握りっぱなしの周回は、これまでどおり `stale` へ落ちる。**
#
# **読めなければ、空にする**（**「回していない」側へ倒す**）——**読めないことで
# 見張りが黙ると、止まっても言わなくなる。**
running_scopes=""
if ! running_scopes="$("${BASH_SOURCE[0]%/*}/loop-lease" running worker 2>/dev/null </dev/null)"; then
  running_scopes=""
fi
if ! master_running="$("${BASH_SOURCE[0]%/*}/loop-lease" running master 2>/dev/null </dev/null)"; then
  master_running=""
fi
running_scopes="$running_scopes"$'\n'"$master_running"

# その作業場が、いま回しているか。
is_running() {
  [[ -n $1 ]] || return 1
  printf '%s\n' "$running_scopes" | grep -qxF "$1"
}

# **記録は作業場ごと**である（`bin/loop-lease` が書く。名前の作り方はあちらが持つ）。
found=0
stale=0
undecidable=0
workspace_path=""
scope=""

# その scope の周回が来ているか。**1 行出して、判定を足す。**
#
# **役ごとに 2 通り持たない** (#422)。**master も worker も、見ているのは
# 「最後に cron で始まったのはいつか」**である——**違うのは記録の名前だけ。**
# **止まっている行には、どの作業場かを添える** (#433)。**worker は 2 人いる**ので、
# **役名は 2 つとも `worker`**、**出るのは digest だけ**——**読んだ人は、セッションを
# 順に当たることになる**（**#430 が消したかったのは、まさにその探索**）。
#
# **digest の作り方は変えない**（#433 の範囲外）——**`bin/loop-lease` が同じものを
# 使っている**ので、**読みやすい名前にすると、そちらの記録の置き場所が変わる。**
#
# **行を足す形にする。** **この出力を読むのは `./task loop:status` の `show_cadence`
# だけ**で、**あちらは列を解釈しない**（字下げして出すだけ）——**それでも、
# 既にある行の形は動かさない。**
#
# **止まっている行だけに出す**（**毎回全部の道を出さない**）。
#
# **引けなかったときは、引けないと言う** (#435 のレビュー。`bin/doctor` と同じ形)。
# **行が出ないだけだと「この役には作業場が無い」に見える**——**「読めなかった」が
# 「無かった」に化ける。**
#
# **そこがいちばん要る場面**である——**`./task loop:master:path` が答えないのは、
# worktree が消えた・動いたとき**で、**まさに「どこにあるのか」を知りたい。**
# **案内は「その行の下の workspace= を見る」と言う**ので、**無い行を探させない。**
show_workspace() {
  if [[ -z ${1-} ]]; then
    echo "  workspace=不明（場所を引けません。記録だけが残っています）"
    return 0
  fi
  echo "  workspace=$1"
}

# **止まって見える原因は 7 つあり、打つ手が違う** (#497 / #498 / #499 / #575)。
#
# **文面はここに写さない**——**写すと直す先が 2 つになり、片方だけが古くなる**
# （#319 と同じ。**実際、この段落が 2 世代ぶん置き去りになった**。#501）。
# **読みたければ `show_reading` を読む**——**すぐ下にある。**
#
# **数だけは書く。** **数える側が `bin/loop-cadence.test.ts` にある**ので、
# **読みを足して、ここを直し忘れると赤くなる**（**散文は、誰も走らせない**）。
#
# **見分けるのは、cron 以外の周回が窓の中にあるか**である
# （2026-08-25、worker-1 が言語化した）——**cron が生きていれば、突かれずとも
# 記録が増える。** **実際に踏んだ 2 度は、どちらも `last_poke` だけが新しかった**
# （2026-08-24 / 2026-08-25）。**`last_unknown` も見るようになったのは #498 から。**
#
# **判定は増やさない**（#497 の範囲外）。**`ok` / `stale` / `unknown` / `never` は
# そのまま**で、**変えるのは、出したあとに何を読むか**だけである。
#
# **新しいかどうかは、その作業場の窓で見る**——**窓は「これだけ黙っていたら止まって
# いる」**なので、**同じ物差しを突かれた側にも当てる。**
#
# **窓が分からない行では、新しいとも古いとも言わない** (#498 のレビュー)。**窓は
# cron の記録から測る**ので、**cron が 1 本も無い行では決まらない**——**そこで
# 「新しい」と断定すると、`last_poke` を一切見ずに `CronList` へ案内する**
# （**そのセッションが動いていなければ、引くこと自体ができない**）。
#
# **踏むのは、いちばん様子が分からない側である**——**足したばかりの作業場**
# （**`set -u` の落ち方を見つけたのと同じ入力**）が**放っておかれた形**。
#
# **行き先は変えない**——**cron の記録が 1 本も無いことは、窓を知らなくても言える**
# ので、**予定表の側を指す**（`last_cron == "-"` と同じ向き）。**変えるのは断定だけ。**
#
# **動いている証拠は、突かれた周回だけではない** (#498 のレビュー 2 周目)。
# **`--trigger` を渡さない古い手順書から始まった周回は `unknown` に落ちる**ので、
# **`last_poke` しか見ないと、500 秒前に回っていた作業場を「動いていない」と言う。**
#
# **`unknown` を cron と数えないのは変えない**（**渡し忘れた日から何も見なくなる**）
# ——**窓の中にあるなら、原因を判定不能として扱う**（**そのセッションは動いているが、
# その周回が cron だったのかは記録に無い**ので、**予定表が空かは言えない**）。

# その周回が、窓の中にあるか。**記録が無いものは「新しくない」ではなく、無い。**
recorded_round() {
  local at="${1-}"
  [[ -n $at ]] && [[ $at != "-" ]]
}
fresh_round() {
  local at="${1-}" window="${2-}"
  recorded_round "$at" || return 1
  [[ -n $window ]] || return 1
  ((NOW - at <= window))
}

# **枠のとき、この作業場は暇だったか** (#575)。
#
# **`stale` の読みが 2 つに割れていたのは、これがどこにも残っていなかったから**である
# ——**塞がっているセッションでは cron が発火しない**ので、**鳴らなかったことは
# 「予定表が死んでいる」証拠にも「忙しかった」証拠にもなる。**
#
# **握っていた時間なら記録から言える。** **`bin/loop-lease` は周回ごとに
# 「始まり」と「終わり」を組で書く**ので、**ある時刻に握っていたかは、
# その組のどれかに入るかで決まる。**
#
# **数で引き算しない** (#578 のレビュー)——**対応の付かない始まりが 1 本でもあると、
# 「ずっと握っている」へ倒れたまま戻らない**（**鳴ったが走れなかった記録・
# この記録を持たない版が書いた始まり・窓から落ちた終わり**）。**倒れる先は
# 「まだ判らない」＝黙る側**なので、**気づけない。**
#
# **枠の時刻は、最後に鳴った cron から間隔ごと**に置く（**間隔は呼ぶ側が持っている**
# ——**渡されたものか、記録から測ったもの**）。**リポジトリへ固定しない**（#378）。
#
# **数えられないなら `-` を返す**——**0 へ倒さない**（**「暇な枠は無かった」と
# 「分からない」は別**である）。**終わりの記録を持たない版から上げた直後がそれ**で、
# **そこで断定すると、#531 で踏んだ形に戻る。**
# **`loop/STOP` が在った区間**（#584）。**止まっている間は、鳴っても何もしない**
# （**そういう設計**）ので、**その枠を「暇だった」と読むと、止まっていた時間の長さが
# そのまま「予定表が死んでいる」の確信になる**——**長く止まるほど、強く間違える。**
#
# **書くのは `bin/loop-stall`**（**STOP を消す 1 箇所**）。**ここでは読むだけ**である。
#
# **役ではなく作業場でもなく、ループ全体で 1 つ**——**`loop/STOP` は全 worktree へ
# 配られる**ので、**止まっていたのはどの scope も同じ**である。
readonly STOP_SPANS="$common_dir/valence-loop-stop-spans"

# **いま在る `loop/STOP`**（#586 のレビュー）。**記録に行が入るのは再開のとき**なので、
# **止まっている最中は、その区間がどこにも無い**——**そこがいちばん踏みやすい場面**である
# （**止まっているループを調べるときに打つのが `./task loop:status`** で、
# **`show_cadence` は STOP の表示より先に走る**）。
#
# **未完了の区間として扱う**——**始まりは STOP が置かれた時刻、終わりはいま**である。
#
# **置き場所は `./task` が答える**（**配っているのがあちら**）——**規則をここへ写さない。**
# **いちばん古いものを採る**：**配りかけで人が足したぶんもある**ので、
# **短いほうを採ると枠を数え漏らす。**
#
# **読めなければ、無いものとして進む**（**変更前と同じ読み**）——**ここで止めると、
# 見張りそのものが黙る。**
stop_open_from=""
if stop_paths="$("$(git rev-parse --show-toplevel)/task" loop:stop:paths 2>/dev/null)"; then
  while read -r stop_path; do
    [[ -n $stop_path && -f $stop_path ]] || continue
    stop_placed="$(stat -c %Y "$stop_path" 2>/dev/null)" || continue
    [[ $stop_placed =~ ^[0-9]+$ ]] || continue
    [[ -n $stop_open_from ]] && ((stop_open_from <= stop_placed)) || stop_open_from="$stop_placed"
  done <<<"$stop_paths"
fi
readonly stop_open_from

# **その時刻、ループは止まっていたか。**
#
# **記録が無いなら「止まっていなかった」**——**これは推定ではなく、
# 変更前と同じ読み**である（**記録を持たない版から上げた直後がそれ**）。
stopped_at() {
  local at="$1" from to
  # **いま止まっているなら、そこから先は全部この中**である。
  [[ -n $stop_open_from ]] && ((stop_open_from <= at)) && return 0
  [[ -f $STOP_SPANS ]] || return 1
  while IFS=$'\t' read -r from to; do
    [[ $from =~ ^[0-9]+$ && $to =~ ^[0-9]+$ ]] || continue
    ((from <= at && at <= to)) && return 0
  done <"$STOP_SPANS"
  return 1
}

idle_slots() {
  local scope="$1" last_cron="$2" interval="$3"
  local held="$common_dir/valence-loop-held-$scope"
  local rounds="$common_dir/valence-loop-rounds-$scope"
  local from to slot idle=0 busy floor="" running_since="" trigger _where matched
  local starts="$common_dir/valence-loop-starts-$scope"
  local held_from=() held_to=()
  [[ -f $held ]] || { echo "-"; return 0; }
  while IFS=$'\t' read -r from to; do
    [[ $from =~ ^[0-9]+$ && $to =~ ^[0-9]+$ ]] || continue
    held_from+=("$from")
    held_to+=("$to")
    [[ -n $floor ]] && ((floor <= from)) || floor="$from"
  done <"$held"
  # **組が 1 つも無いなら、何も言えない**（**この記録を持たない版から上げた直後**）。
  [[ -n $floor ]] || { echo "-"; return 0; }
  # **返せずに終わった周回があるなら、そこから先は分からない** (#578 のレビュー 2 周目)。
  #
  # **`release` へ到達しない周回では、組が書かれない**（**無音のまま期限切れになって
  # 引き継がれた・context が尽きた・落ちた**）——**その穴を「暇だった」と読むと、
  # 倒れる向きが逆になる**（**実際には旧 lease が塞いでいて cron が発火できなかった**）。
  # **従うと予定が 2 本になる。**
  #
  # **開始の一覧は、穴の検出にだけ使う**——**算術には戻さない**（**戻すと、
  # `cron-blocked` も旧い開始も、また `held` を狂わせる**）。
  #
  # **読めないなら、分からないと言う**（**穴が無いことを確かめられていない**）。
  [[ -f $starts ]] || { echo "-"; return 0; }
  # **いま回している周回は、まだ組になっていない**——**返したときに書かれる**ので、
  # **その始まりは別に見る**（**握っている最中は、暇ではない**）。
  if is_running "$scope" && [[ -f $rounds ]] &&
    read -r running_since <"$rounds" 2>/dev/null &&
    [[ $running_since =~ ^[0-9]+$ ]]; then
    :
  else
    running_since=""
  fi
  while IFS=$'\t' read -r from trigger _where; do
    [[ $from =~ ^[0-9]+$ ]] || continue
    # **鳴ったが走れなかった試行は、周回ではない** (#536)——**組が無くて当然である。**
    [[ $trigger != "cron-blocked" ]] || continue
    # **組が残っている範囲だけを見る**（**それより前は、もともと数えない**）。
    ((from >= floor)) || continue
    # **いま回している周回は、返したときに組になる**——**穴ではない。**
    [[ -z $running_since ]] || ((from != running_since)) || continue
    matched=0
    for i in "${!held_from[@]}"; do
      ((held_from[i] == from)) && matched=1 && break
    done
    ((matched == 1)) || { echo "-"; return 0; }
  done <"$starts"
  for ((slot = last_cron + interval; slot <= NOW; slot += interval)); do
    # **組が残っている範囲だけを見る** (#578 のレビュー)。**それより前は、
    # 握っていたかどうかが分からない**——**刈られたぶんを「暇だった」と読まない。**
    ((slot >= floor)) || continue
    # **止まっていた枠は、暇ではない** (#584)。**入口で戻る周回は
    # `bin/loop-lease acquire` へ到達しない**ので、**組も始まりも書かれない**
    # ——**その穴を「暇だった」と読むと、生きている予定表を死んだと断定する。**
    stopped_at "$slot" && continue
    busy=0
    for i in "${!held_from[@]}"; do
      ((held_from[i] <= slot && slot <= held_to[i])) && busy=1 && break
    done
    [[ -z $running_since ]] || ((running_since > slot)) || busy=1
    ((busy == 1)) || idle=$((idle + 1))
  done
  echo "$idle"
}

show_reading() {
  local last_poke="${1-}" last_unknown="${2-}" window="${3-}" idle="${4-}" last_cron="${5-}"
  local asleep="  読み=どちらの周回も新しくない。そのセッションが動いていない——引く先が居ないので、先に起こす"
  # **cron 以外の周回が 1 つも記録されていない**——**動いている証拠が無い。**
  if ! recorded_round "$last_poke" && ! recorded_round "$last_unknown"; then
    echo "$asleep"
    return 0
  fi
  if [[ -z $window ]]; then
    # **窓が無い理由は 2 つある** (#575)。**混ぜない**（`AGENTS.md` §5）——
    # **「一度も鳴っていない」と「鳴った記録が押し出されて 1 本になった」は、
    # `last_cron=-` になった時点で同じ顔**になる。**その手前で言い分ける。**
    if recorded_round "$last_cron"; then
      echo "  読み=鳴った記録が 1 本しか残っておらず、間隔が測れない。新しいかは言えない——押し出された側である。CronList を引く"
      return 0
    fi
    echo "  読み=cron の周回が 1 本も無い。ほかの周回が新しいかは言えない——そのセッションが居れば CronList を引いて入れ直す"
    return 0
  fi
  # **弱いほうを先に見る** (#499)。**`unknown` は「`--trigger` を渡さずに始まった
  # 周回」**なので、**その中に cron の周回が混ざりうる**（**古い手順書は渡さない**）
  # ——**窓の中に `unknown` があるなら、cron が鳴っていた可能性が残る。**
  #
  # **poke を先に見ると、両方が窓の中にあるとき「予定表が空である」と言い切る**
  # ——**そのとき、確かめていないことを言っている。**
  #
  # **踏むのは、手順書が入れ替わる最中**である（**この repo が毎日やっている**）
  # ——**古い版で始まった周回と、新しい版で始まった周回が、同じ窓に並ぶ。**
  if fresh_round "$last_unknown" "$window"; then
    echo "  読み=どう始まったか分からない周回が新しい。そのセッションは動いているが、予定表が空かは言えない——引いて見る（CronList）"
    return 0
  fi
  if fresh_round "$last_poke" "$window"; then
    # **断定しない** (#531)。**踏んだ**——**この読みに従って「入れ直してください」と
    # 指示が出て、引いたら空ではなかった。** **原因はもう 1 つある**——**cron は
    # セッションが暇なときにしか発火しない**（**道具の説明**）ので、**塞がっている
    # セッションは、生きた予定表を持ったままこの顔になる。**
    #
    # **見分けはこの道具では付かない**（**他のセッションを引けない**——下の但し書き）。
    # **引いた結果で分かれる形にする**（**隣の枝と同じ言い方**）。
    # **暇な枠を跨いだかで倒す** (#575)。**跨いだのに鳴っていないなら、
    # 「塞がっていた」では説明が付かない**——**予定表の側を指す。**
    if [[ $idle =~ ^[0-9]+$ ]] && ((idle > 0)); then
      echo "  読み=突かれた周回だけが新しい。暇な枠を $idle 回跨いだのに鳴っていない——予定表が死んでいる。CronList を引かずに入れ直す"
      return 0
    fi
    # **跨いでいないなら、断定しない** (#531)。**塞がっていただけのことがある。**
    if [[ $idle =~ ^[0-9]+$ ]]; then
      echo "  読み=突かれた周回だけが新しい。暇な枠をまだ跨いでいない——塞がっているだけかもしれない。まだ判らない（暇な枠が来るまで待つ）"
      return 0
    fi
    # **数えられない**（終わりの記録が無い版）——**これまでどおり。**
    echo "  読み=突かれた周回だけが新しい。そのセッションは動いている——引いて見る（CronList）: 空なら入れ直す / 空でなければ塞がっているだけで、いずれ回る"
    return 0
  fi
  echo "$asleep"
}

# **記録から、周期を測る** (#438)。**間隔が渡されなかったときの物差し。**
#
# **間隔はリポジトリへ固定しない**（#378 / `AGENTS.md` §1。**起動した人が決めるもの**）
# ——**しかし、実物では誰も渡していなかった**（**渡すのは試験だけ**）ので、
# **足した案内が鳴る場面に到達しない**（**cron が 1 本も無いときを除いて、いつも
# `unknown`**）。
#
# **いちばん短い間を採る。ただし下限を置く。**
#
# **上を採ってはいけない** (#439 のレビュー)——**過去に 1 度落ちていると、その欠落が
# そのまま物差しになる**（**3 時間空いた記録があれば、次の停止は 6 時間 `ok`**）。
# **記録から押し出されるまで続く**ので、**止めるために足したものが、止めなくなる。**
#
# **下限が要る** ——**実測の記録には数十秒の間がある**（`35 49 …`）。**あれは
# 「捨てて呼び直した周回」**で、**同じ cron の中で 2 回 `acquire` している。**
# **周期として読むと窓が数十秒になり、正常な周回で鳴り続ける。**
# **cron の刻みは 1 分より細かくならない**ので、**それより短い間は周期ではない。**
#
# **落とした回は、上へずれるだけ**である——**最小は周期のほうに残る。**
#
# **2 本要る。** **1 本では間が測れない**ので、**そこは「分からない」のまま**である。
readonly SHORTEST_TICK=60

measured_interval() {
  local previous="" at gap shortest=""
  for at in "$@"; do
    if [[ -n $previous ]]; then
      gap=$((at - previous))
      if ((gap >= SHORTEST_TICK)) && { [[ -z $shortest ]] || ((gap < shortest)); }; then
        shortest="$gap"
      fi
    fi
    previous="$at"
  done
  [[ -n $shortest ]] || return 1
  printf '%s' "$shortest"
}

# **直前の間**（周期の下限より短いものは、周期ではないので飛ばす）。
#
# **周期が伸びたのか、鳴り損ねたのかは、記録からは見分けられない** (#441)——**どちらも
# 「前より長い間が 1 つ空いた」**である。**予定表を 5 分から 30 分へ変えると、前の周期の
# 300 秒が記録に残り**、**窓は 600 秒のまま**——**正しく待っている途中で `stale` になる**
# （**古い記録が押し出されるまで最大 20 回**）。
#
# **鳴りすぎる見張りは読まれなくなる**（#440 / #441）ので、**直前の間が長かったときは、
# その 1 回ぶんを待つ。** **待つのは 1 回ぶんだけ**である——**そのまま止まれば、
# これまでどおり言う。**
#
# **「いちばん短い間を採る」は変えない** (#439 のレビュー)——**過去の欠落で窓が広がる
# のは、こちらが `max` を採らないから防げている。** **短いほうへ変えたときは、最小が
# すぐ追いつく**ので、**黙る側にも倒れない。**
last_gap() {
  local previous="" at gap last=""
  for at in "$@"; do
    if [[ -n $previous ]]; then
      gap=$((at - previous))
      ((gap >= SHORTEST_TICK)) && last="$gap"
    fi
    previous="$at"
  done
  [[ -n $last ]] || return 1
  printf '%s' "$last"
}

evaluate_scope() {
  local scope="$1" workspace="${2-}"
  local starts last_cron last_poke last_unknown age verdict longest
  # **窓は、間隔が分かったときにしか決まらない** ——**空のまま読む道がある**
  # （**cron の記録が 1 本も無い行**）ので、**先に置く**（`set -u`）。
  local window=""
  local at trigger _where interval interval_shown gap running_since cron_at=()
  # **枠のとき暇だったか** (#575)。**数えられない行もある**ので、先に置く（`set -u`）。
  local idle_shown="-"
  starts="$common_dir/valence-loop-starts-$scope"
  if [[ ! -f $starts ]]; then
    # **1 度も始まっていない。** **記録が無いことを「異常なし」へ倒さない**
    # ——**足したばかりの worker が、永久に見えなくなる。**
    # **`never` も止まっている側である**——**`--quiet` でも出す。**
    echo "scope=${scope:0:12} last_cron=- last_poke=- last_unknown=- age=- interval=${INTERVAL:-unknown} never"
    show_workspace "$workspace"
    # **記録が 1 行も無い**——**引く先のセッションが、そもそも居ない。**
    show_reading "-" "-" ""
    stale=1
    return 0
  fi
  last_cron="-"
  last_poke="-"
  last_unknown="-"
  # **鳴ったが走れなかった cron** (#536)。**走っている最中に鳴った cron は
  # `acquire` で終わる**——**前は記録が増えず、忙しい作業場が止まって見えた**
  # （**4 回突かれて、4 回とも予定表は生きていた**）。**鳴った証拠として数える。**
  blocked_rings=0
  # **3 列目（作業場）は読むために置いてある**——**`scope` は digest で、そこからは
  # パスへ戻せない**ので、**記録を人が読むときの手がかりはこれだけ**である。
  while IFS=$'\t' read -r at trigger _where; do
    [[ $at =~ ^[0-9]+$ ]] || continue
    case "$trigger" in
      cron)
        last_cron="$at"
        cron_at+=("$at")
        ;;
      # **鳴ったことは同じである** (#536)——**走れなかっただけ**なので、
      # **予定表が生きている証拠**として、cron と同じ側に置く。
      # **間隔の測りにも入れる**（**鳴った時刻そのもの**である）。
      cron-blocked)
        last_cron="$at"
        cron_at+=("$at")
        blocked_rings=$((blocked_rings + 1))
        ;;
      poke) last_poke="$at" ;;
      # **知らない印は「不明」へ入れる**——**cron へ倒さない**（渡し忘れた日から
      # 何も見なくなる）。**綴りが変わったときも、こちらへ落ちる。**
      *) last_unknown="$at" ;;
    esac
  done <"$starts"

  age="-"
  verdict="ok"
  if [[ $last_cron == "-" ]]; then
    # **一度も cron で始まっていない。** **突かれただけの作業場がこれ**である。
    #
    # **間隔は要らない** (#381 のレビュー 3 周目)。**間隔が要るのは「どれだけ経ったら
    # 古いか」だけ**で、**1 本も無いことは、間隔を知らなくても言える**——
    # **ここを `unknown` へ落とすと、人が 1 回突いた作業場が `never` から降りてしまう。**
    verdict="stale"
  else
    age=$((NOW - last_cron))
    ((age < 0)) && age=0
    # **渡されたものが正である** (#378)。**測った値で上書きしない**
    # ——**起動した人が決めたもの**が、いちばん確かである。
    interval="$INTERVAL"
    interval_shown="interval=${INTERVAL:-unknown}"
    if [[ -z $interval ]] && interval="$(measured_interval "${cron_at[@]}")"; then
      # **測ったものだと分かる形で出す**——**渡された値と混ぜない**
      # （**読む人が、どちらで判定したか分かるように**）。
      interval_shown="interval=~$interval"
    fi
    if [[ -z $interval ]]; then
      verdict="unknown"
    else
      # **窓は、実測があれば広げる** (#381 のレビュー 4 周目)。
      #
      # **記録が増えるのは `acquire` が取れたときだけ**である——**前の周回がまだ
      # 走っていると、次の cron は「走っている周回がある」で何もせず終わる**ので、
      # **鳴っていても記録は動かない。** **周回が窓を超えると、cron は来ているのに
      # 「来ていない」と言う**——**「終わっていない」を「来ていない」に化けさせない。**
      #
      # **読むのは `bin/loop-lease` が書いた実測**（**その作業場でいちばん長かった
      # 周回の秒数**。`alive` が同じ問題を同じもので解いている）——**判定は写さず、
      # 実測だけを読む。**
      #
      # **広げるのは「走っていた時間 ＋ 待ち 1 回」まで**である。**次の周回が始まれる
      # のは、前のが終わってから**で、**そこから次の cron までは最大で間隔 1 つ**——
      # **それ以上待っても始まらないなら、鳴っていない。**
      # **「長いかもしれない」で全部を黙らせない。**
      window=$((interval * MISSED_TICKS))
      # **直前の間が長かったなら、その 1 回ぶんは待つ** (#441)。**周期が伸びたのと、
      # 鳴り損ねたのは、記録からは同じ形に見える**——**待つのは 1 回ぶんだけ**である。
      #
      # **測ったときだけである** (#443 のレビュー)。**渡されたものが正**（#378）なので、
      # **渡されているなら、記録の大きな間で窓を広げない**——**広げると、落ちていた
      # 記録がそのまま「待ってよい時間」になり、止まっても `ok` になる**（**黙る側**）。
      if [[ -z $INTERVAL ]] && gap="$(last_gap "${cron_at[@]}")" &&
        ((gap + interval > window)); then
        window=$((gap + interval))
      fi
      if [[ -f "$common_dir/valence-loop-roundlen-$scope" ]] &&
        read -r longest <"$common_dir/valence-loop-roundlen-$scope" 2>/dev/null &&
        [[ $longest =~ ^[0-9]+$ ]]; then
        ((longest + interval <= window)) || window=$((longest + interval))
      fi
      # **いま回している周回のぶんは待つ** (#444。#446 のレビュー)。**走っている最中に
      # 鳴った cron は `acquire` が exit 1 で終わる**ので、**記録が 1 行も増えない。**
      #
      # **待つのは「その周回の中に入った刻み」だけ**である——**`bin/loop-cadence` は
      # 周回の中から呼ばれる**ので、**呼んだ役は必ず自分の lease を握っている。**
      # **「回っている」と「cron が生きている」は別**で、**2 分前に始まった周回は、
      # 60 分前からの沈黙を説明しない**（**実測: 3 つとも cron が死んで、突かれるだけで
      # 回っていた日がある**）。
      #
      # **始まりは `bin/loop-lease` が書いている**（`valence-loop-rounds-`）。
      # **読めなければ広げない**——**読めないことで黙る見張りにしない。**
      if is_running "$scope" &&
        [[ -f "$common_dir/valence-loop-rounds-$scope" ]] &&
        read -r running_since <"$common_dir/valence-loop-rounds-$scope" 2>/dev/null &&
        [[ $running_since =~ ^[0-9]+$ ]] && ((NOW > running_since)); then
        window=$((window + NOW - running_since))
      fi
      ((age > window)) && verdict="stale"
    fi
  fi
  # **続いている行は、`--quiet` では出さない** (#530)——**毎回鳴る検査は読まれなくなる。**
  # **`ok` 以外は出す**（**`unknown` は「判定できない」で、黙る側へ倒さない**）。
  if ((QUIET == 0)) || [[ $verdict != "ok" ]]; then
    # **鳴ったが走れなかった回数は、あるときだけ出す** (#536)。**毎行に `blocked=0` を
    # 並べても読む人の役に立たない**——**「何回あったか」は、あった作業場でだけ要る。**
    blocked_shown=""
    ((blocked_rings == 0)) || blocked_shown=" blocked=$blocked_rings"
    echo "scope=${scope:0:12} last_cron=$last_cron last_poke=$last_poke last_unknown=$last_unknown age=$age${blocked_shown} ${interval_shown:-interval=${INTERVAL:-unknown}} $verdict"
  fi
  # **`unknown` でも黙らない** (#575)。**`stale` のときだけ読みを出していた**ので、
  # **記録が押し出されて `unknown` へ落ちた瞬間、次の一手がまるごと消えた**
  # （**実測。問題が長引くほど見張りの声が小さくなる**）。**`ok` だけが黙る。**
  [[ $verdict == "ok" ]] || show_workspace "$workspace"
  # **数えるのは、枠が決まる行だけ**（#575）——**間隔が無ければ枠も無い。**
  idle_shown="-"
  [[ $verdict == "ok" || $last_cron == "-" || -z ${interval:-} ]] ||
    idle_shown="$(idle_slots "$scope" "$last_cron" "$interval")"
  [[ $verdict == "ok" ]] ||
    show_reading "$last_poke" "$last_unknown" "$window" "$idle_shown" "$last_cron"
  case "$verdict" in
    stale) stale=1 ;;
    unknown) undecidable=1 ;;
  esac
}

# **worker の作業場を並べる。** **master はここに出てこない**（`./task` が除いている）
# ——**あちらは 1 つしかないので、下で別に見る** (#422)。
while IFS= read -r workspace_path; do
  # **絶対パスで、いま在るものだけを見る。** **`./task` は前置きの警告を stdout へ
  # 出すことがある**ので、**行をそのまま作業場として扱わない**（`bin/loop-stall` も
  # 同じ形で「実在するものだけ」を見ている）。**消された作業場もここで落ちる**
  # ——**一覧に残っていても、回っていないのが正しい。**
  [[ $workspace_path == /* && -d $workspace_path ]] || continue
  # **名前の作り方は `bin/loop-lease` が持つ**（`scope`）——**ここでは訊くだけ。**
  # **中で呼ぶものに標準入力を渡さない**——**`while read` が読むはずの残りを食われると、
  # 2 つ目以降の作業場が黙って落ちる。**
  if ! scope="$(cd "$workspace_path" 2>/dev/null &&
    "${BASH_SOURCE[0]%/*}/loop-lease" scope worker 2>/dev/null </dev/null)" || [[ -z $scope ]]; then
    echo "[WARN] 作業場の名前を作れません: $workspace_path" >&2
    undecidable=1
    continue
  fi
  found=1
  evaluate_scope "$scope" "$workspace_path"
done <<<"$workspaces"

# **master も見る** (#422)。**judge 役が止まると、worker は PR を出せても先へ進めない**
# ——**#421 は「ゲートを回せる」まで揃った状態で 1 時間 44 分止まっていた。**
#
# **居るかどうかは 2 つで見る。** **`./task` が場所を答えれば居る**（**足したばかりで、
# まだ 1 度も回していない master もここで見える**）。**答えなくても記録があれば、
# 回っていた**——**作業場を消したあとも、止まったことは言う。**
#
# **どちらも無いなら、この loop に master は居ない。** **何も言わない**
# ——**居ないものを「止まっている」と言うと、読む人が探しに行く。**
master_path=""
if master_path="$("$(git rev-parse --show-toplevel)/task" loop:master:path 2>/dev/null </dev/null)" &&
  [[ $master_path == /* && -d $master_path ]]; then
  found=1
  evaluate_scope master "$master_path"
elif [[ -f "$common_dir/valence-loop-starts-master" ]]; then
  found=1
  evaluate_scope master
fi

if ((found == 0)); then
  # **記録が無いことと、始まっていないことは同じではない** ——**混ぜない。**
  # **この仕組みが入る前の作業場**も、**一度も周回を回していない作業場**もここへ来る。
  echo "[WARN] 周回が始まった記録がありません（no-record）" >&2
  echo "       この仕組みが入る前の作業場か、まだ一度も回していない作業場です" >&2
  exit 2
fi

# **確定したものが先である** (#381 のレビュー 3 周目)。**見出しは終了コードだけで決まる**
# ので、**「止まっている」を「判定できない」に負けさせると、人は「判定できません」しか
# 読まない**——**列に出ていても、読まれなければ同じ**である。
# **判定を持つところに、次の一手を置く** (#430)。**2026-08-24、3 つの役すべてが
# `stale` になり、3 つのセッションが別々に同じところを探した**——**原因は予定表が
# 空だったこと**（**道具の recurring は 7 日で自動的に期限切れになる**）。
# **master は「cron が 1 度も来ていない」と読み違えて、人へ渡しかけている。**
#
# **限界も同じところに書く。** **この記録から言えるのは「直近の記録に、cron で
# 始まった周回が無い」まで**である——**記録は直近のぶんしか保たない**うえ、
# **走っている最中に鳴った cron は `acquire` が exit 1 で終わり、記録が 1 行も増えない。**
#
# **指す先を、証拠の出どころに合わせる** (#431 のレビュー)。**この道具は全部の役を見る**
# ので、**「このセッション」と書くと、別の役だけが止まっているときに嘘になる**
# ——**読んだ人は自分の予定表を引き、そこは正常なので、そこで止まる。**
#
# **次の一手は、行ごとに違う** (#497)。**`stale` の原因は行ごとに違い、打つ手も違う**ので、
# **ここで 1 つに決めない**——**決めていたぶん（「まず予定表を引くこと」）は、
# 「どちらも古い」行には効かない**（**引く先が居ない**ので、**そこで読む人が止まる**）。
# **判定は `show_reading` が行ごとに出す**ので、**ここはそこへ向けるだけ**である。
#
# **止まっているときだけ言う**（**毎回鳴る案内は、読まれなくなる**）。
# **`./task loop:status` はこの stderr ごと拾う**ので、そちらから読む人にも届く。
if ((stale == 1)); then
  echo "[WARN] 次の一手は、その行の 読み= にある——stale の原因は行ごとに違う" >&2
  echo "       読み= が指すのは stale と出た役のセッションで、呼んだ役ではない" >&2
  echo "       どの作業場かは、その行の下の workspace= を見る" >&2
  echo "       interval=~ の行は、記録から測った周期を物差しにしている" >&2
  echo "       （この道具は他のセッションを引けない。入れ直すのもセッション自身）" >&2
  echo "       recurring の予定は 7 日で期限切れになるので、消えていることがある" >&2
  echo "       ここから言えるのは「直近の記録に、cron の周回が無い」まで" >&2
  echo "       走っている最中に鳴った cron は acquire で終わるが、鳴ったことは残る（blocked=）" >&2
  echo "       塞がっているセッションは cron が発火しない（暇なときにしか鳴らない）" >&2
  echo "       ——発火して走れなかったぶんは blocked= に出る（そちらは予定表が生きている）" >&2
  echo "       ——予定表が生きていても、突かれた周回だけが新しい顔になる（#531）" >&2
fi

((stale == 1)) && exit 1
((undecidable == 1)) && exit 2
exit 0
