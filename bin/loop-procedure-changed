#!/usr/bin/env bash
# その役が実行するものが、この周回の間に入れ替わったかを判定する。
#
#   bin/loop-procedure-changed --role master|worker <前の SHA> [<後の SHA>]
#
#   exit 0 = 変わった (**この周回は捨てる**)
#   exit 1 = 変わっていない (そのまま進んでよい)
#   exit 2 = 判定できない / 使い方の誤り
#
# master は毎周回 `origin/main` へ追随する。**追随そのものは正しい**が、
# 「HEAD が動いた」で打ち切ると、**master が実行するファイルを 1 つも変えていない PR**
# （`src/` だけの変更など）でも周回を捨てる。**マージのたびに必ず起きる**ので、
# 定常的に周回が消える。
#
# **判定はここ 1 箇所に持つ。** 手順書に対象の一覧を書き写すと、ファイルが増えたときに
# 片方だけ直して食い違う (`bin/loop-stall` の停止識別子と同じ理由)。
#
# **判定できないときは「変わった」に倒さない。** 倒すと、判定が壊れているあいだ
# **周回が永久に捨てられる**ことになり、症状が「ループが動かない」だけになる。
# 呼び出し側 (手順書) が exit 2 を「捨てる」へ倒す — **どちらへ倒すかは呼ぶ側の判断**で、
# ここは「分からなかった」ことだけを返す。
#
# -e は使わない。理由を最後まで集めてから 1 回で報告する。
set -uo pipefail

# **master が周回中に読む・実行するもの。** ここに無いものは、入れ替わっても
# master の実行内容を変えない。
#
# `bin/` はまるごと対象にする。master はここのスクリプトを直接呼ぶので、
# 1 本ずつ並べると**足したときに書き漏らす**。
#
# **`AGENTS.md` だけは「守り」ではなく「合図」である。** 共通指示は
# **セッション開始時に読み込まれる**ので、周回を捨てても**読んでいる内容は変わらない**
# （手順書は周回のたびに読み直すので、そこが違う）。捨てた理由の出力に `AGENTS.md` が
# 出ることで、**セッションを開き直すべきだと分かる**——それがここに入っている理由である。
# **「対象に入っているから守られている」と読まないこと。**
# **除くものも同じ配列に入れる。** git の pathspec をそのまま渡すので、
# **`--list` が出すものと、判定に使うものが同じ 1 つ**になる——**判定だけ別の場所で
# 例外にすると、`--list` が嘘をつく**。
#
# **`bin/*.test.ts` は master が実行しない。** `src/` しか触らない PR で捨てないのと
# 同じ理由である。**試験だけを直した PR の直後に、毎回 1 周が空振りしていた**
# （実測 2 回。#152 / #155 のマージ直後）。**打ち切ると呼び直す**ので、
# **空振りのたびに「新しい版が読み込まれる保証は無い」（実測 2 回中 1 回）に賭ける**。
#
# **本体（拡張子なし）は残す。** 判定を緩めて「変わっていない」に倒すと、
# **master が古いスクリプトで走り続ける**——**空振りより危険**である（#93）。
#
# **役ごとに違うのは、読む手順書だけ**である (#227)。**両方を見ると、相手の手順書を
# 直しただけの PR で周回が空振りする**——**その役が実行しないものは、入れ替わっても
# 実行内容を変えない**（`src/` だけの PR で捨てないのと同じ理由）。
readonly COMMON=(
  "AGENTS.md"
  "bin/"
  ":(exclude)bin/*.test.ts"
  "task"
  "loop/README.md"
)



usage() {
  echo "使い方: bin/loop-procedure-changed --role master|worker <前の SHA> [<後の SHA>]" >&2
  echo "       後の SHA を省くと HEAD と比べる" >&2
  echo "       bin/loop-procedure-changed --role … --list   対象の一覧を出す" >&2
  exit 2
}

# **役は必ず書かせる。既定を持たせない** (#228 のレビュー)。**書き忘れが黙って別の役を
# 見張る**——**master の手順書を直した PR で worker が空振りし、worker の手順書を
# 直した PR で捨てない**（**本命の穴**）。**どちらも「それらしい答え」なので赤くならない。**
# **必須なら `exit 2` で、手順書の「1 以外はすべて捨てる」に乗って黙って進まない。**
if [[ ${1-} != "--role" ]]; then
  echo "[FAIL] 役を指定してください (--role master|worker)" >&2
  usage
fi
[[ $# -ge 2 ]] || usage
ROLE="$2"
shift 2
case "$ROLE" in
  master | worker) ;;
  *)
    echo "[FAIL] 役は master か worker です: $ROLE" >&2
    exit 2
    ;;
esac
readonly ROLE
# **入口と本体の両方を見る** (#319)。**本体を別ファイルへ移したので、入口だけを見ると
# 「本体が入れ替わったのに気づかない」へ倒れる**——**周回の途中で手順が入れ替わるのは、
# 移す前と何も変わっていない。** **cron が運ばなくなったのは入口の話**であって、
# **ディスクの本体は同期のたびに入れ替わりうる。**
readonly WATCHED=(
  ".claude/commands/loop-${ROLE}.md"
  "loop/procedure/${ROLE}.md"
  "${COMMON[@]}"
)

# 指定された rev を解決する。**解決できないものを黙って通さない。**
resolve() {
  local rev="$1" resolved
  if ! resolved="$(git rev-parse --verify --quiet "$rev^{commit}")" || [[ -z $resolved ]]; then
    echo "[FAIL] commit を特定できません: $rev" >&2
    exit 2
  fi
  printf '%s' "$resolved"
}

if [[ ${1-} == "--list" ]]; then
  [[ $# -eq 1 ]] || usage
  printf '%s\n' "${WATCHED[@]}"
  exit 0
fi

(($# == 1 || $# == 2)) || usage

# **比較先を渡せるようにする。** マージしても手元の HEAD は動かない
# （GitHub 側でマージするだけ）ので、HEAD と比べると必ず「変わっていない」になり、
# **手順書を変えた PR の直後に古い手順のまま進む**。
BEFORE="$(resolve "$1")"
AFTER="$(resolve "${2:-HEAD}")"
readonly BEFORE AFTER

# **居た場所と、動いた版を混ぜない** (#259)。**知りたいのは「これから実行するものが、
# この周回のあいだに入れ替わったか」**であって、**「作業ツリーがさっき居た場所と、
# いま移った場所が違うか」ではない。**
#
# **PR を checkout した翌周回は、必ず捨てていた。** **前の周回が PR の commit で終わり、
# 冒頭の同期で `origin/main` へ戻ると、その PR 自身の変更が差分に出る**——
# **手順書もスクリプトも何も変わっていないのに**である。**レビュー対応が続くほど当たる**
# ので、**往復が続く局面ほど遅くなる。**
#
# **枝分かれの跡から数える。** **`BEFORE` の側にしか無い変更は「試験中の版を動かして
# いた」ことの跡**で、**`main` が動いたことではない**——**数えるのは `AFTER` の側に
# 入ったぶんだけ**である（`git diff A...B` と同じ形）。
#
# **本当の検知は落とさない。** **同じ系譜の上にいるなら、枝分かれの跡は `BEFORE`
# そのもの**なので、**これまでと 1 ビットも変わらない**——**マージ直後の周回はここを通る。**
# **`origin/main` を基準にする形では、ここが落ちる**（**`refs/remotes` は作業場どうしで
# 共有**なので、**もう一方が先に fetch した周回では「動いていない」に見える**）。
if ! base="$(git merge-base "$BEFORE" "$AFTER" 2>/dev/null)" || [[ -z $base ]]; then
  # **黙って「変わっていない」に倒さない。** 共通の祖先が無いのは、
  # **別の履歴を指している**ということである
  echo "[FAIL] 枝分かれの跡を特定できません: $BEFORE $AFTER" >&2
  exit 2
fi
readonly base

if ! changed="$(git diff --name-only "$base" "$AFTER" -- "${WATCHED[@]}" 2>/dev/null)"; then
  echo "[FAIL] 差分を取得できません" >&2
  exit 2
fi

if [[ -n $changed ]]; then
  # 何が入れ替わったかを出す。**捨てた理由が後から分かるようにする。**
  printf '%s\n' "$changed"
  exit 0
fi
exit 1
