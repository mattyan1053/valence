# このファイルをコピーして .env を作る:  cp .env.example .env
#
# .env は gitignore 済み。ここには「キー名とダミー値」しか書かないこと。
# 実際の値を .env.example に書いてコミットしないこと (このリポジトリは public)。

# ---------------------------------------------------------------- Supabase
# ローカルスタックは `./task db:up` で起動する。接続情報は `./task db:status`。
#
# **ブラウザが行く先と、サーバが叩く先は別である。** 開発では docker の中と外で
# 名前が違うので、**片方へ寄せるとどちらへ寄せても通らない**——
# `localhost:54321` にすると app コンテナが自分自身を叩き、`kong:8000` にすると
# ブラウザが解決できない (`.claude/skills/dev-environment/`「Supabase に繋がらない」)。
# **本番では同じ値でよい。**

# サーバから叩く先。**交換・本人確認・行の読み書きはこちら。** 開発では http://kong:8000
SUPABASE_URL=
# ブラウザが行く先。**認可画面へ送る URL はこちらへ揃える。** 開発では http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=
# 匿名鍵 (publishable)。ブラウザへ出てよい。RLS が「誰が何を読めるか」を決める。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# **secret キーはここに置かない。** あれは RLS を素通りするので、
# 使うと「誰がログインしていても同じものが見える」ことになる (AGENTS.md §6)。
# DB を要求するテストだけが使い、`./task test:db` がローカルスタックから
# 実行時に取ってくる (`SUPABASE_SECRET_KEY` / `SUPABASE_JWT_SECRET`)。

# ---------------------------------------------------------------- 暗号化
# ユーザートークンを、置き場へ入れる前に封じる鍵 (AES-256-GCM)。
# **32 バイトを base64 で入れる。** 短いと使う前に落ちる。
#   openssl rand -base64 32
# 鍵が変わると、保存済みのトークンは読めなくなる (ログインし直しになる)。
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- GitHub App
# https://github.com/settings/apps で作成した GitHub App の値。
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM を 1 行に潰して入れる (改行は \n にエスケープする)。
GITHUB_APP_PRIVATE_KEY=
# Webhook 署名の検証に使う。GitHub App 側の設定と一致させる。
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Webhook 転送
# https://smee.io/new で払い出した URL。`./task smee` で転送を開始する。
# チャンネル URL を知っている人は誰でも Webhook を覗けるので公開しないこと。
SMEE_URL=
