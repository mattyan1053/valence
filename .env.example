# このファイルをコピーして .env を作る:  cp .env.example .env
#
# .env は gitignore 済み。ここには「キー名とダミー値」しか書かないこと。
# 実際の値を .env.example に書いてコミットしないこと (このリポジトリは public)。

# ---------------------------------------------------------------- Supabase
# ローカルスタックは `./task db:up` で起動し、`./task db:status` が出す値を貼る。
#
# NEXT_PUBLIC_ が付く値はブラウザに焼き込まれる。ブラウザから見た URL を書くこと
# (SSH ポートフォワード先の localhost)。コンテナ内の名前を書いても届かない。
# サーバー側から叩く場合は docker network 経由の http://kong:8000 を使う。
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# ブラウザに露出してよいキー (RLS で守る)。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# RLS を貫通するキー。サーバー側でのみ使い、クライアントへ絶対に渡さない。
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- GitHub App
# https://github.com/settings/apps で作成した GitHub App の値。
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM を 1 行に潰して入れる (改行は \n にエスケープする)。
GITHUB_APP_PRIVATE_KEY=
# Webhook 署名の検証に使う。GitHub App 側の設定と一致させる。
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Webhook 転送
# https://smee.io/new で払い出した URL。`./task smee` で転送を開始する。
# チャンネル URL を知っている人は誰でも Webhook を覗けるので公開しないこと。
SMEE_URL=
