#!/usr/bin/env bash
#
# 開発タスクランナー。
#
# ホストに何もインストールしない方針のため、make ではなく素の bash で書いてある
# (bash / docker / git / flock 以外はホストに要求しない)。
# 実処理はすべて開発コンテナ内で走る。
#
#   ./task help
#
set -euo pipefail

# どこから呼ばれてもリポジトリルートで動くようにする。
# `readlink -f` は GNU 依存なので使わない (BSD/macOS の readlink は -f を持たない)。
# CDPATH が設定されていると cd が意図しない場所へ飛ぶため、先に潰しておく。
CDPATH=''
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

# ホストの実値をビルド引数として渡す。これで環境固有の値を .env に書かずに済む。
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
DOCKER_GID="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 999)"
export HOST_UID HOST_GID DOCKER_GID

# **作業場ごとに、compose の project とポートを分ける** (#82)。
#
# **worktree を分けただけでは足りない。** `compose.yaml` は project 名とポートを
# 固定していたので、**2 人目が同じコンテナを掴む**——**後から起きたほうが、
# 相手のコンテナを別の `working_dir` で作り直す**。**master の worktree も同じ**である。
#
# **名前から決める。空きを探さない。** 空き探しは**起動のたびに値が変わる**ので
# 人が繋ぎ直せず、**2 つの `add` が同じ空きを掴む競合**を新しく作る（#74 で塞いだ形）。
# **compose が受け付ける形へ正規化する** (#195 のレビュー 2 周目)。**project 名は
# 「小文字英数字・ハイフン・アンダースコアで、英数字から始まる」**に限られる——
# **`compose.yaml` が `name:` を持っていた間は clone 先に依存しなかった**ので、
# **ここが入れて初めて壊れる**（**`compose()` は入口**なので、`Valence/` へ clone した
# 人は `./task` が 1 つも通らない）。
#
# **弾かずに正規化する。** 弾くと、**そのディレクトリでは何もできなくなる**。
#
# **正規化した名前を、project にもポートにも使う。** 片方だけだと
# **「同じ project は同じポート」が崩れる**。**`Valence` と `valence` が同じ値へ落ちる**
# のは承知のうえ——**`name: valence` を固定していたときは全員が同じだった**ので、
# **退行ではない**。
normalize_workspace_name() {
  local name="$1"
  name="${name,,}"
  name="${name//[^a-z0-9_-]/-}"
  [[ $name =~ ^[a-z0-9] ]] || name="v$name"
  printf '%s' "$name"
}

workspace_name() { normalize_workspace_name "$(basename -- "$PWD")"; }

# 作業場の名前として使えるか。**名前は識別子**なので、**パスに化ける形を通さない**。
worker_name_ok() {
  if [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    return 0
  fi
  echo "==> 名前は英小文字・数字・ハイフンで、英数字から始めること: ${1:-（空）}" >&2
  return 1
}

# そのポートを既に使っている作業場。
#
#   exit 0 = 見つかった（名前を出す） / exit 1 = 無い / exit 2 = 読めない
#
# **「読めない」を「無い」に倒さない** (#195 のレビュー)。**倒すと、読めなかっただけで
# 「衝突なし」になり、そのまま足してしまう**——**弾く仕組みを入れたなら、
# 弾けなかったときに何が起きるかまで見る**（#190 で塞いだのと同じ形）。
workspace_with_port() {
  local want="$1" p other listed
  # **プロセス置換にしない。** **中の終了コードは呼び出し側に伝わらない**ので、
  # **`git worktree list` が落ちるとループが 0 回回り、「無い」と同じ見え方になる**
  if ! listed="$(git worktree list --porcelain)"; then
    return 2
  fi
  while read -r p; do
    [[ -n $p && $p != "$PWD" ]] || continue
    other="$(workspace_port "$(basename -- "$p")")" || return 2
    [[ $other != "$want" ]] || { printf '%s' "$(basename -- "$p")"; return 0; }
  done < <(printf '%s\n' "$listed" | awk '/^worktree /{print $2}')
  # **master の作業場は、登録されていなくても予約する** (#195 のレビュー 2 周目)。
  # **`cmd_loop_setup` は検査を持たない**ので、**`add` を先に、`loop:setup` を後に打つと、
  # master が同じポートで作られる**——**1 人で、順番に踏める**。
  # **登録の有無で見ない**ぶん、**setup 以外の経路で作られても効く。**
  other="$(workspace_port "$(basename -- "${PWD}-master")")" || return 2
  [[ $other != "$want" ]] || { printf '%s' "$(basename -- "${PWD}-master")"; return 0; }
  return 1
}

# 既定の作業場は動かさない（**設定を足さなくても、1 人運用はこれまでどおり**）。
readonly DEFAULT_WORKSPACE=valence
readonly DEFAULT_APP_PORT=3000
# 3001..3999 を作業場に割り当てる（既定の 3000 とぶつからない範囲）。
readonly WORKSPACE_PORT_BASE=3001
readonly WORKSPACE_PORT_SPAN=999

# 名前から決まるポート。**同じ名前なら常に同じ値**（人が繋ぎ直せる）。
# **正規化はここでやる** (#195 のレビュー 3 周目)。**渡す側で正規化すると、
# 増えた 4 箇所目が漏れる**——**実際に 3 箇所とも生の値を渡していて、
# 検査どうしは辻褄が合っているのに、検査と実行の間が合っていなかった。**
#
# **正規化は多対一**なので、**生の名前がぶつからなくても正規化した名前はぶつかりうる**
# ——**そのとき `add` は通り、`up` が「アドレス使用中」で落ちる。**
workspace_port() {
  local name digest
  name="$(normalize_workspace_name "${1:-$(basename -- "$PWD")}")"
  if [[ $name == "$DEFAULT_WORKSPACE" ]]; then
    printf '%s' "$DEFAULT_APP_PORT"
    return 0
  fi
  # **digest は `git` で取る** (#195 のレビュー)。**`sha256sum` はホスト標準ではない**
  # ——**このファイルは 8 行上で「`readlink -f` は GNU 依存なので使わない」と書いている**
  # のに、**入口の `compose()` が GNU 前提**になっていた。**`git` は既に必須**である
  # （このコマンド自身が `git worktree` を使う）。
  if ! digest="$(printf '%s' "$name" | git hash-object --stdin)"; then
    echo "[FAIL] 作業場のポートを決められません: $name" >&2
    return 1
  fi
  printf '%s' "$((WORKSPACE_PORT_BASE + 16#${digest:0:8} % WORKSPACE_PORT_SPAN))"
}

# git の本体（`--git-common-dir`）。**worktree では作業場の外にある** (#80)。
#
# **`.git` はファイルで、中身は「本体を指す絶対パス」**である。**コンテナは `${PWD}`
# しかマウントしていない**ので、**指した先が無い**——**`fatal: not a git repository`。**
# **git を使う試験が 10 件以上ある**ので、**2 人目の作業場では `./task check` を
# 緑にできない**（**push の前に緑を求める手順書と噛み合わず、1 本も出せない**）。
#
# **clone そのものなら `${PWD}/.git` に落ちる**ので、**マウントが重なるだけで害は無い。**
# **訊けないのは「そもそも repo の中に居ない」ときだけ**である。**worktree なら
# 必ず答えが返る**ので、**`${PWD}/.git` へ倒しても、この穴は戻らない。**
# **git そのものが使えないなら `workspace_port` が先に落ちる**（`git hash-object`）。
git_common_dir() {
  local common
  if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" &&
    [[ -n $common ]]; then
    printf '%s' "$common"
    return 0
  fi
  printf '%s' "$PWD/.git"
}

compose() {
  local port
  port="$(workspace_port)" || return 1
  VALENCE_APP_PORT="$port" VALENCE_GIT_COMMON_DIR="$(git_common_dir)" \
    docker compose -p "$(workspace_name)" "$@"
}

# 非対話用。CI や AI エージェントからは TTY がないため -T を付ける。
exec_app() { compose exec -T app "$@"; }

# 人間が対話的に使う用 (シェル、dev サーバー、watch など)。
exec_app_it() {
  local tty_flag=()
  [[ -t 0 ]] || tty_flag=(-T)
  compose exec "${tty_flag[@]}" app "$@"
}

# supabase CLI が作る network を先に用意しておく。
# 同名のものがあれば CLI はそれを再利用するので、先に作っておいて問題ない。
ensure_network() {
  docker network inspect supabase_network_valence >/dev/null 2>&1 \
    || docker network create supabase_network_valence >/dev/null
}

# **毎回 compose に突き合わせさせる** (#295 のレビュー)。**「動いていれば何もしない」
# だと、`compose.yaml` を変えても動いているコンテナには届かない**——**直したのに
# 直らず、しかも何も言わない**（**残る側は自分の diff に出てこない**。`AGENTS.md` §5）。
# **`up -d` は設定が同じなら何もしない**ので、**差分があるときだけ作り直る。**
ensure_up() {
  ensure_network
  compose up -d app
}

# 開発コンテナを起動する = アプリが起動する (冪等)
cmd_up() { ensure_network; compose up -d app; }

# 開発コンテナを停止する
cmd_down() { compose down; }

# 開発イメージを再ビルドする
cmd_build() { compose build app; }

# コンテナとボリュームを破棄する
cmd_clean() { compose down --volumes --remove-orphans; }

# 開発コンテナのシェルに入る
cmd_sh() { ensure_up; exec_app_it bash; }

# 依存をインストールする (lockfile 準拠)
cmd_install() { ensure_up; exec_app pnpm install --frozen-lockfile; }

# 開発サーバーのログを追う (コンテナ起動時から動いている)
cmd_dev() {
  ensure_up
  compose logs -f app
}

# 開発サーバーを再起動する
cmd_restart() { ensure_up; compose restart app; }

# 任意の pnpm コマンドを流す 例: ./task pnpm add zod
cmd_pnpm() { ensure_up; exec_app pnpm "$@"; }

# lint + typecheck + 依存方向 + テスト をまとめて実行する
# **最後の 1 行で「走り終えた」と「合否」を同時に言う** (#147)。
#
# **途中で殺されると、終了コードが取れないまま出力だけが残る**——**その出力は、
# 成功したときの出力の途中まで**なので、**目で見ると緑に見える**。実際に踏んだ
# (2026-08-11、PR #142 の周回)。**#121 が入れたのは「出力ではなく終了コードで決める」**で、
# **「終了コードが存在しない」は守っていない**——**その隣の穴**である。
#
# **印は走り終えた証拠でもある。** 途中で殺されればここまで来ないので出ない。
# **印だけで緑と読ませない**ため、**印に合否そのものを入れる**。
cmd_check() {
  ensure_up
  # **走っていることを、走る前に記録する** (#375)。**印は終わったときにしか出ない**
  # ——**足りなかったのは、読む側を強いるもの**である（**2 つの作業場が、別々の日に
  # 「終わったこと」を読み違えて赤いものを push した**）。
  #
  # **殺された周回は `done` を書けない**ので、**記録は「走っている」のまま残る**
  # ——**`bin/loop-commit-guard` がそこで止める。**
  #
  # **記録できなくても、検査は走らせる** (#270 と同じ判断)——**言うことと、
  # 止めることは別**である（**commit の側は「読めない」で止まる**）。
  # **走るたびに 1 つ置く** (#130 と同じ形)——**2 本走ったときに、後から終わったほうが
  # 上書きしない**（**まだ走っている側が見えなくなる**）。**id はこの `./task` の PID**
  local run_id="$$"
  ./bin/loop-check-state running "$run_id" || echo "[WARN] check の記録を残せませんでした" >&2
  local status=0
  exec_app pnpm check || status=$?
  echo "check-exit=$status"
  ./bin/loop-check-state finished "$run_id" "$status" ||
    echo "[WARN] check の合否を残せませんでした" >&2
  return "$status"
}

# Biome で lint する
cmd_lint() { ensure_up; exec_app pnpm lint; }

# 自動修正できるものを直す (Biome)
cmd_fix() { ensure_up; exec_app pnpm fix; }

# 型検査する
cmd_typecheck() { ensure_up; exec_app pnpm typecheck; }

# レイヤ間の依存方向を検査する
cmd_depcruise() { ensure_up; exec_app pnpm depcruise; }

# テストを実行する
cmd_test() { ensure_up; exec_app pnpm test "$@"; }

# テストを watch モードで実行する
cmd_test_watch() { ensure_up; exec_app_it pnpm test:watch; }

# Supabase CLI は docker socket とホストのネットワーク名前空間を必要とする。
# それを app に持たせたくないので、専用の使い捨てコンテナで実行する。
supabase_cli() {
  local tty_flag=()
  [[ -t 0 ]] || tty_flag=(-T)
  compose run --rm --quiet-pull "${tty_flag[@]}" supabase-cli "$@"
}

# **決定: Supabase のスタックは 1 つを全作業場で共有し、DB を触るコマンドは直列化する**
# (#82 / #210)。**worker も叩いてよい**（叩かない、ではなくなった）。
#
# **理由: 分ける側を検証できない。** **worker はいま 1 人**なので、**作業場ごとに
# 分けても、分かれていることを試す相手がいない**——**検証できない設定を入れない**
# (`AGENTS.md` §5)。**一方、直列化のほうは 1 人でも要る**——**`db:reset` は
# スタックを作り直す**ので、**通知で始めた周回と cron の周回が重なるだけで、
# 走っている試験の足元から DB が消える**（#68 と同じ重なり方）。
#
# **待ち時間は捨てない。** **取れなければ黙って進まず、待って、諦めたら理由を言う**
# ——**「取れなかったから並行で走った」は、直列化していないのと同じ**である。
#
# **次の引き金:** **worker が 2 人になったとき (#85)。** そこで初めて
# 「作業場ごとに分ける」を検証できるようになる。

# 直列化に使うロックの置き場。**`--git-common-dir` は worktree 間で共有される**ので、
# **`~/valence` と `~/valence-master` が同じ 1 個を奪い合う**（`show_missing_lease`
# と同じ置き方）。
db_lock_path() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [[ -n $common ]] || return 1
  printf '%s' "$common/valence-db.lock"
}

# **この直列化は `flock` が要る。前提は Linux で、macOS / BSD は対象外**である (#220)。
#
# **`flock` は macOS / BSD の標準環境に無い**が、**`AGENTS.md` §2 は「ホストには何も
# インストールしない」**なので、**入れて回避する道も無い。** **代わりを手作りすると、
# 「止まった状態から出られるか」を自分で用意することになる**（#184 の形）——
# **踏んでいないうちに先回りで作らない**（§5）。
#
# **`task:14` が BSD / macOS を避けると書いているのは、そこの `readlink -f` の話**である。
# **ここは避けきれていない**ので、**避けているふりをせず、対象外だと書く。**
#
# **諦めるまでの待ち時間（秒）。** `db:reset` と DB 試験の合計より長く取る。
DB_LOCK_WAIT_SECONDS="${DB_LOCK_WAIT_SECONDS:-900}"

# **DB を触るコマンドを、1 つずつ通す。**
#
# **入れ子にしない。** 同じプロセスが同じファイルを別の fd で 2 度 flock すると、
# **自分の解放を自分で待つ**。**掛けるのは `cmd_*` の入口だけ**にする。
with_db_lock() {
  local path lock_fd
  if ! path="$(db_lock_path)"; then
    echo "==> DB の直列化に使うロックを置く場所がありません (git リポジトリの中で実行すること)" >&2
    return 1
  fi
  if ! exec {lock_fd}>>"$path"; then
    echo "==> DB の直列化に使うロックを開けません: $path" >&2
    return 1
  fi
  # **無いことと、待って取れなかったことを分ける** (#220)。**`flock` が無いと
  # `command not found`（127）になり、まとめて扱うと「別の作業場が使っています」に化ける**
  # ——**誰も掴んでいないのに、である**（**判定不能が、別の理由に化ける**形）。
  if ! command -v flock >/dev/null 2>&1; then
    echo "==> flock がありません。DB を触るコマンドは flock で直列化します" >&2
    echo "    ホストに要るのは bash / docker / git / flock です（既定で無い macOS / BSD は対象外）" >&2
    return 1
  fi
  local locked=0
  flock -w "$DB_LOCK_WAIT_SECONDS" "$lock_fd" || locked=$?
  if ((locked == 1)); then
    # **待ち時間の超過は `flock` の 1 だけ**である
    echo "==> 別の作業場が DB を使っています (${DB_LOCK_WAIT_SECONDS} 秒待って諦めました): $path" >&2
    return 1
  fi
  if ((locked != 0)); then
    # **知らない終わり方を、掴まれていることにしない**——**分からないと言う**
    echo "==> ロックを取れたか分かりません (flock が $locked で終わりました): $path" >&2
    return 1
  fi
  "$@"
}

# Supabase ローカルスタックを起動する
cmd_db_up() { with_db_lock db_up; }
# **起動した設定を控える** (#247)。**置換が起きるのはこの瞬間だけ**なので、
# **ここで控えないと、あとから「何で走っているか」を知る術が無い**。
#
# **起動に失敗したら控えない。** **控えると、上がっていないコンテナの設定を
# 「これで走っている」と記録する**——**次に上げたときに食い違いが消える。**
#
# **既に走っていたときも控えない** (#282 のレビュー)。**`supabase start` は
# 既に走っていても成功する**——**そのときコンテナは作り直されない**ので、
# **控え直すと記録だけが新しくなり、`.env` を直しただけの人には「一致」と答える**
# （**この Issue が塞ぎに来た状態が、恒久的に隠れる**）。
# **起動の前後でスタックを見比べる**——**判定は `--unless` の側が持つ。**
db_up() {
  # **「停まっている」と「読めない」を潰さない** (#282 のレビュー 2 周目)。
  # **`|| before=""` は両方を空にする**ので、**前だけ `docker ps` が落ちて後で復旧すると、
  # 「already running」の成功のあとに、実在の ID が空文字と食い違って上書きする**
  # ——**スクリプト側で塞いだ穴が、呼ぶ側から開く。**
  local before="" seen=0
  before="$(./bin/db-config-drift stack-id)" || seen=$?
  ensure_up
  supabase_cli pnpm supabase start
  if ((seen > 1)); then
    # **判定できないなら控えない**——**倒れる向きが安全**である（スクリプトと同じ判断）
    echo "[WARN] 起動前のスタックを読めませんでした。設定は控えません" >&2
    return 0
  fi
  ./bin/db-config-drift record --unless "$before"
}

# Supabase ローカルスタックを停止する
cmd_db_down() { with_db_lock supabase_cli pnpm supabase stop; }

# ローカル DB をマイグレーションから作り直す
cmd_db_reset() { with_db_lock db_reset; }
db_reset() { ensure_up; supabase_cli pnpm supabase db reset; }

# ローカルスタックの接続情報を表示する (.env に貼る値) 例: ./task db:status -o env
cmd_db_status() { with_db_lock supabase_cli pnpm supabase status "$@"; }

# ローカル DB に psql で入る 例: ./task db:psql -c "select 1"
#
# **ここだけ直列化しない。** **人が対話で入る口**なので、**ロックを持たせると、
# psql を開いたまま席を立った人が、周回を 15 分止める**——**直列化が守ろうとした
# 「進むこと」を、直列化自身が壊す。** **壊す側は `db:reset` であり、
# それはこの口からは出てこない。**
cmd_db_psql() {
  # コンテナ名は config.toml の project_id から決まる
  local exec_flags=(-i)
  [[ -t 0 ]] && exec_flags+=(-t)
  supabase_cli docker exec "${exec_flags[@]}" supabase_db_valence \
    psql -U postgres -d postgres "$@"
}

# `supabase status -o env` の 1 行から値だけを取り出す (`KEY="値"` の形)
supabase_env_value() {
  local name="$1" env_lines="$2" line
  line="$(grep -m1 "^${name}=" <<<"$env_lines")" || return 1
  line="${line#*=}"
  line="${line%\"}"
  line="${line#\"}"
  [[ -n $line ]] || return 1
  printf '%s' "$line"
}

# 環境変数を足して app コンテナで実行する 例: exec_app_env FOO=1 -- pnpm test
exec_app_env() {
  local env_flags=()
  while [[ $# -gt 0 && $1 != "--" ]]; do
    env_flags+=(-e "$1")
    shift
  done
  shift || true
  compose exec -T "${env_flags[@]}" app "$@"
}

# DB を要求するテストを実行する (Supabase を作り直してから走らせる)
cmd_test_db() { with_db_lock run_db_tests "$@"; }

# **マイグレーションから作り直してから走らせる。** **いま在るスキーマではなく、
# `supabase/migrations/` が作るスキーマ**を試す——**手で足した列や、消し忘れた
# ポリシーの上で緑になっても、CI と本番では同じものが無い。**
#
# **接続情報は毎回スタックから取る。** **リポジトリにも `.env` にも書かない**
# （`AGENTS.md` §6）。**ここで渡るのはローカル既定の鍵**で、どの機械でも同じ値である
# ——**本番の値をこの経路へ渡さない。**
#
# **URL はホストのものを使わない。** **app コンテナは supabase の network に
# 繋いである**ので、**コンテナ名で引く**（`compose.yaml`）。
run_db_tests() {
  ensure_up
  db_reset || return 1
  local env_lines publishable secret jwt
  if ! env_lines="$(supabase_cli pnpm supabase status -o env)"; then
    echo "==> Supabase の接続情報を取得できません (./task db:up は通っていますか)" >&2
    return 1
  fi
  if ! publishable="$(supabase_env_value PUBLISHABLE_KEY "$env_lines")" \
    || ! secret="$(supabase_env_value SECRET_KEY "$env_lines")" \
    || ! jwt="$(supabase_env_value JWT_SECRET "$env_lines")"; then
    echo "==> Supabase の接続情報に鍵が含まれていません (CLI の出力の形が変わった?)" >&2
    return 1
  fi
  exec_app_env \
    "SUPABASE_URL=http://kong:8000" \
    "SUPABASE_PUBLISHABLE_KEY=$publishable" \
    "SUPABASE_SECRET_KEY=$secret" \
    "SUPABASE_JWT_SECRET=$jwt" \
    -- pnpm test:db "$@"
}

# GitHub Webhook の転送を開始する (.env の SMEE_URL が必要)
cmd_smee() {
  # 未設定のまま起動すると smee-client が npm のエラーで落ち、原因が分かりにくい
  if [[ -z "${SMEE_URL:-}" ]] && ! grep -qE '^SMEE_URL=.+' .env 2>/dev/null; then
    echo "SMEE_URL が未設定です。https://smee.io/new で払い出して .env に書いてください。" >&2
    exit 1
  fi
  ensure_up
  # フォアグラウンドで起動する。-d で起こしてログだけ追うと、Ctrl-C で
  # 止まるのはログ追跡だけで、Webhook の転送は裏で動き続けてしまう。
  compose --profile webhook up smee
}

# master 用の worktree と label を用意する
cmd_loop_setup() {
  local wt="${PWD}-master"
  if [[ -d $wt ]]; then
    # 作った時点の commit に固定されたままだと、master は古いゲートと古い手順で
    # 判定し続ける。main にマージした修正が反映されない。毎回追いつかせる。
    if ! git worktree list --porcelain | grep -qxF "worktree $wt"; then
      echo "==> $wt は worktree として登録されていません。中身を確認してください" >&2
      return 1
    fi
    if [[ -n "$(git -C "$wt" status --porcelain)" ]]; then
      echo "==> $wt に未コミットの変更があります。master は読み取り専用のはずです" >&2
      return 1
    fi
    git fetch origin main --quiet
    git -C "$wt" checkout --detach --quiet origin/main
    echo "==> worktree を origin/main へ更新: $wt ($(git -C "$wt" rev-parse --short HEAD))"
  else
    # detached で作る。ブランチとして main を掴むと worker 側が main を
    # checkout できなくなり、worker の main 最新化が毎周失敗する。
    # master は判定役で、ブランチを進める必要がない。
    git worktree add --detach "$wt" main
    echo "==> worktree を作成: $wt"
  fi
  # master は判定役。実装側の操作を settings で塞いでおく。
  # このファイルは worktree ごとに別で、gitignore されている。
  mkdir -p "$wt/.claude"
  cat > "$wt/.claude/settings.local.json" <<'JSON'
{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)"
    ]
  }
}
JSON
  echo "==> master 側の deny を設定: $wt/.claude/settings.local.json"

  local label
  # ループが使うものに加え、**Issue テンプレートが付ける label** も用意する。
  # 存在しない label を書いても GitHub はエラーにせず黙って落とすため、
  # 起票が候補から漏れたことに誰も気づけない。
  for label in backlog ready in-progress blocked parked waiting-condition awaiting-human changes-requested deferred-finding bug; do
    if gh label list --limit 200 --json name --jq '.[].name' | grep -qxF "$label"; then
      echo "==> label は既にある: $label"
    else
      gh label create "$label" && echo "==> label を作成: $label"
    fi
  done

  echo
  echo "次の 2 つの端末で起動する:"
  echo "  cd $wt && claude   → /loop /loop-master"
  echo "  cd $PWD && claude  → /loop /loop-worker"
}

# worktree は作業ツリーが独立しているので、loop/STOP は共有されない。
# 片方に置いただけでは、もう片方のループは走り続ける。全 worktree へ配る。
loop_stop_paths() {
  git worktree list --porcelain | awk '/^worktree /{print $2 "/loop/STOP"}'
}

# 全ループを次の周回の冒頭で停止させる
cmd_loop_stop() {
  local reason="${1:-手動停止}" p paths found=0
  # **先に受けて、取れたことを確かめる** (#190)。**プロセス置換の終了状態は `while` へ
  # 伝わらない**ので、`done < <(...)` のままだと**取得の失敗が 0 件と区別できない**——
  # **1 つも作らずに最終行だけを出して、終了コード 0 で終わる**。
  # **ここは第 4 層が人を呼ぶ経路**なので、**黙って失敗すると誰も止まらないまま
  # 「止めた」だけが残る。**
  if ! paths="$(loop_stop_paths)"; then
    echo "==> 停止の置き場所を取得できません。どのループも止めていません" >&2
    return 1
  fi
  while read -r p; do
    [[ -n $p ]] || continue
    # **どこまで止まったかを言えるようにする** (#191 のレビュー)。**途中で落ちると、
    # そこまでは止まっている**ので、**「1 つも止めていない」とは違う状態**になる
    if ! mkdir -p "$(dirname "$p")" || ! printf '%s\n' "$reason" > "$p"; then
      echo "==> 作成できません: $p（ここまでに ${found} 個は作成済み）" >&2
      return 1
    fi
    echo "==> 作成: $p"
    found=$((found + 1))
  done <<<"$paths"
  # **1 つも作れなかったら、止めたと言わない。** 取得が成功しても、
  # **worktree が 1 つも返らなければ結果は同じ**である
  if ((found == 0)); then
    echo "==> 止める先が 1 つもありません。どのループも止めていません" >&2
    return 1
  fi
  echo "全ループが次の周回の冒頭で停止する"
}

# loop/STOP の置き場所を 1 行ずつ出す (bin/loop-stall が撤去に使う。読むだけ)
cmd_loop_stop_paths() {
  loop_stop_paths
}

# worker の作業場を増やす 例: ./task loop:worker:add b
cmd_loop_worker_add() {
  local name="${1:-}" wt port existing found
  if ! worker_name_ok "$name"; then return 1; fi
  wt="${PWD}-worker-${name}"
  if [[ -e $wt ]]; then
    echo "==> 既にあります: $wt（名前が識別子なので、重複は誤りです）" >&2
    return 1
  fi
  port="$(workspace_port "$(basename -- "$wt")")" || return 1
  # **ポートが重なる名前は、足す前に弾く** (#82)。**名前は決定論的にポートへ写る**ので、
  # **別の名前が同じポートへ落ちることはある**——**足したあとに `up` が
  # 「アドレス使用中」で落ちる形にすると、原因が名前だと分からない。**
  # **`set -e` があるので、非ゼロを受けるときは `||` で受ける**（そうしないと、
  # **「衝突なし」を返した瞬間にコマンドごと落ちる**）
  local found=0
  existing="$(workspace_with_port "$port")" || found=$?
  case $found in
    0)
      echo "==> ポート $port が $existing と重なります。別の名前にしてください" >&2
      return 1
      ;;
    1) ;;
    *)
      # **読めなかったなら足さない。** **待つ必要は無い**——**足してから
      # 「アドレス使用中」で落ちるより、足さないほうが戻せる**
      echo "==> 他の作業場のポートを読めないので、足しません（同じポートかもしれません）" >&2
      return 1
      ;;
  esac
  # **detached で作る。** ブランチとして main を掴むと、他の作業場が main を
  # checkout できなくなる（master の worktree と同じ理由）。
  git worktree add --detach "$wt" HEAD || return 1
  echo "==> 作業場を作成: $wt (compose project=$(basename -- "$wt") port=$port)"
}

# worker の作業場を減らす 例: ./task loop:worker:remove b
cmd_loop_worker_remove() {
  local name="${1:-}" wt
  if ! worker_name_ok "$name"; then return 1; fi
  wt="${PWD}-worker-${name}"
  if [[ ! -d $wt ]]; then
    echo "==> そんな作業場はありません: $wt" >&2
    return 1
  fi
  # **コンテナを先に落とす。** worktree を消してから落とそうとすると、
  # **compose がファイルを読めず、コンテナだけが残る**
  (cd "$wt" && compose down --remove-orphans) || return 1
  # **`--force` を付けない** (#195 のレビュー)。**`--force` は「dirty でも locked でも
  # 消す」**で、**worker の作業場はほぼ常に dirty**——**commit していない実装が、
  # 確認なしに消える。戻せない。**
  #
  # **`git worktree remove` は dirty なら自分で拒む。** **拒まれたら、何をすればよいかを出す。**
  if ! git worktree remove "$wt"; then
    echo "==> 消せませんでした: $wt" >&2
    echo "    未コミットの変更が残っているなら、commit するか、了解のうえで" >&2
    echo "    git worktree remove --force $wt を手で叩くこと" >&2
    return 1
  fi
  echo "==> 作業場を削除: $wt"
}

# 停止を解除する
cmd_loop_resume() {
  # **人が打つのは、このコマンド 1 つだけにする。** 空転カウンタを消さないと、
  # **再開した直後に同じ条件でもう 1 回で止まり直す**（実測 6 回。毎回、人が手で
  # `bin/loop-stall --reset` も打っていた）。**手順書に「2 つ打つこと」と書き足す形は
  # 採らない**——書いてあっても飛ばす（#143 と同じ理由）。
  #
  # **消えるのは数だけである。** 直っていなければ、これまでどおりの周回数で止まる。
  #
  # **カウンタを消すことと STOP を消すことは、同じ排他区間で行う** (#151)。
  # **順番だけでは足りない**——**ロックの外に隙間が残り、そこへ入った周回が上限に
  # 達して STOP を作ると、その直後の削除がそれを消す**（**止まるべきなのに再開する**）。
  #
  # **区間を持っているのは `bin/loop-stall`** なので、**削除もそちらで行う。**
  # ここで消さないのは、**ロックを 2 人に持たせないため**である。
  ./bin/loop-stall --resumed
}

# **入口を飛ばした周回の記録を見せる。** `bin/loop-handoff` が積む
# （出口で lease を持っていなかった周回。#143）。
#
# **記録するだけでは終わらない。** 誰も読まない場所に積むと、「あとから分かる」が
# **「探し方を知っている人にだけ分かる」**になる——**気づけないこと**が、この記録が
# 塞ごうとしている当のものである。**周回のたびに読む場所へ出す。**
#
# **無ければ何も言わない。** 静かなときに騒ぐと、**騒いでいることが普通**になる。
show_missing_lease() {
  local common record count
  common="$(git rev-parse --git-common-dir 2>/dev/null)" || return 0
  [[ -n $common ]] || return 0
  record="$common/valence-loop-lease-missing"
  [[ -f $record ]] || return 0
  # **「1 度も飛ばしていない」と「読めない」を同じ静けさにしない。**
  #
  # **書けなかった場合は、ここでは分からない**——**分かるのは書こうとした瞬間だけ**
  # なので、そこで言う（`bin/loop-lease check`）。**2 箇所で同じことを見張らない。**
  # ここで分かるのは**「ファイルはあるのに読めない」**までである。
  if ! count="$(wc -l <"$record" 2>/dev/null)"; then
    echo "lease 無しの実行の記録を読めません: $record"
    return 0
  fi
  ((count > 0)) || return 0
  # **数えているものを、そのまま名前にする** (#192)。**これは「周回が入口を飛ばした」
  # ではなく「lease 無しでスクリプトが動いた」**である——**診断のために人が
  # `bin/loop-gate` を手で叩いたものが、そのまま混ざる**（実測で 18 件中 7 件）。
  #
  # **見分けは取れない。** **飛ばした周回も、診断の人も、同じコマンドを叩く**——
  # **違うのは呼び手の役**で、**それを知る唯一の手段が lease** である。
  # **その lease が無いときの話**なので、**コマンド名を残しても分けられない。**
  #
  # **実在しない違反を数えると、読んだ人が原因を探して空振りする**（実際に 1 回起きた）。
  # **気づかせるための表示が、調べる仕事を増やしていた。**
  echo "lease 無しでの実行: ${count} 件 (周回が入口を飛ばした場合と、診断で手で叩いた場合が混ざる)"
  tail -3 "$record" | sed 's/^/  /'
}

# **人の判断待ちの PR を見せる。** 保留にしてループは進めるが、
# **待っていること自体は見えていないといけない**——**見えない待ちは、忘れられた待ち**である
# （#109。`.claude/commands/loop-master.md` の「human — 人を呼ぶ」で付く）。
show_awaiting_human() {
  local rows
  # **label 検索を使わない。** 索引は遅れる（実測：**付けた直後は 0 件、外した直後は 1 件**）——
  # **人待ちにした直後に見ると、その PR が出ない**。**忘れられない側を担う唯一の経路**が、
  # **いちばん見たい瞬間に黙る**ことになる。**全件を取ってから絞る**
  # （master のステップ 6 が `parked` を数えるときと同じ形）。
  #
  # **読めなければ、そう言う。** 失敗を「0 件」に倒すと、**唯一の経路が黙って消える**
  if ! rows="$(gh pr list --state open --limit 200 --json number,title,labels \
    --jq '.[] | select(.labels | map(.name) | index("awaiting-human")) | "  #\(.number) \(.title)"')"; then
    echo "人の判断待ちを読めません（GitHub の一覧を取得できませんでした）"
    return 0
  fi
  [[ -n $rows ]] || return 0
  echo "人の判断待ち (parked。人が awaiting-human と parked を外すと再開する):"
  printf '%s\n' "$rows"
}

# 理由の無い保留を見せる (人待ちにしたが、理由を投稿できていない PR)
#
# **判定はここに書かない。** `bin/loop-handoff` も同じことを見るので、
# **2 箇所に置くと片方だけ直して食い違う** (#159 で踏んだ形)。
#
# **人待ちの一覧とは別に出す。** 一覧に混ぜると **「人待ちが 1 件ある」と読まれて終わる**——
# **中身が空だとは思わない**。**理由が無いこと**まで言って初めて拾える。
show_silent_park() {
  local parks status=0
  parks="$(bin/loop-silent-park 2>/dev/null)" || status=$?
  case $status in
    0) return 0 ;;
    1) ;;
    *)
      # **「0 件」と「読めなかった」を同じ静けさにしない** (`show_missing_lease` と同じ)
      echo "理由の無い保留があるかどうかを読めません (GitHub の状態を取得できませんでした)"
      return 0
      ;;
  esac
  echo "理由の無い保留 (人待ちにしたが、理由が投稿されていない。投稿し直すか、保留を戻すこと):"
  printf '%s\n' "$parks" | sed 's/^/  #/'
}

# 宙に浮いたブランチを見せる (push されたのに PR が無い / 終わった PR の消し残り)
#
# **判定はここに書かない。** master の周回の出口も同じことを見るので、
# **2 箇所に置くと片方だけ直して食い違う** (#159 で踏んだ形)。
#
# **人が読む場所にも出す。** **master が止まっていると、出口は回らない**——
# **どちらか片方では届かない** (#163 / #167 と同じ判断)。
show_stray_branches() {
  local strays status=0
  strays="$(bin/loop-stray-branches 2>/dev/null)" || status=$?
  case $status in
    0) return 0 ;;
    1) ;;
    *)
      # **「0 件」と「読めなかった」を同じ静けさにしない**
      echo "宙に浮いたブランチがあるかどうかを読めません (remote / PR の一覧を取得できませんでした)"
      return 0
      ;;
  esac
  echo "PR の無いブランチ / 消し残り (no-pr と beyond-pr は人の判断待ち。merged-leftover は消してよい):"
  printf '%s\n' "$strays" | sed 's/^/  /'
}

# ループの現在地を表示する (open PR / Issue / STOP)
cmd_loop_status() {
  show_missing_lease
  show_awaiting_human
  show_silent_park
  show_stray_branches
  if [[ -f loop/STOP ]]; then
    echo "STOP: あり"
    sed 's/^/  /' loop/STOP
  else
    echo "STOP: なし"
  fi
  echo "open PR:"
  gh pr list --state open --limit 200 \
    --json number,title,isDraft --jq '.[] | "  #\(.number) \(.title)\(if .isDraft then " (draft)" else "" end)"'
  echo "Issue:"
  gh issue list --limit 100 --json number,title,labels \
    --jq '.[] | "  #\(.number) [\(.labels | map(.name) | join(","))] \(.title)"'
}

# 使えるコマンドの一覧を表示する
cmd_help() {
  echo "使い方: ./task <コマンド> [引数...]"
  echo
  # 各 cmd_* 定義の直前のコメント行を説明として拾う
  awk '
    /^# / { desc = substr($0, 3); next }
    /^cmd_[a-z_]+\(\)/ {
      name = $1
      sub(/\(\)$/, "", name)
      sub(/^cmd_/, "", name)
      gsub(/_/, ":", name)
      if (desc != "") printf "  \033[36m%-15s\033[0m %s\n", name, desc
      desc = ""
      next
    }
    { desc = "" }
  ' "$0"
}

# **周回が生きていることを記録する。** lease の期限は「取得からの経過」ではなく
# 「最後に何かが起きてからの経過」で測る (bin/loop-lease)。長い処理はすべてここを
# 通るので、**打つ場所をここ 1 つにすれば、書き忘れる経路が無い**。
#
# **打つのはコマンドの前だけである。** つまり **打つ間隔は「いちばん長い ./task
# コマンド」で決まる**——ここが lease の期限に対して十分短いことに賭けている。
#
#   いちばん長いコマンド … `./task check` の 8〜10 分 (実測)
#   lease の期限         … 30 分 (LOOP_LEASE_TTL_SEC の既定)
#   余裕                 … 3 倍。test/slow-machine.ts の MARGIN と同じ考え方
#
# **TTL に近づくコマンドを足したら、この賭けは破れる。** そのコマンドが動いている
# 最中に期限が切れ、**同じ作業ツリーへ別の周回が入る** (#68 の形)。
# **縮んだことは、期限切れが起きるまで分からない。**
#
# **そうなったら、実行中にも打つ形が要る** (見ているプロセスが死んだら止まる
# 背景処理)。**いまは入れない**——踏めない穴を塞ぐために、孤児プロセスと後始末と
# シグナルという**新しい失敗モードを持ち込むほうが高くつく** (AGENTS.md §5)。
#
# **打てなくてもコマンドは止めない。** ループと関係なく `./task` を使うときに、
# lease の都合でコマンドが落ちてはいけない。**ただし黙らない**——打てていない状態は
# 「安全な側」ではなく、**期限が取得時刻だけで決まる元の壊れ方**である。
# 標準エラーはそのまま通す。
heartbeat() {
  ./bin/loop-lease heartbeat worker >/dev/null || true
}

# **main の上での commit を止める hook を有効にする** (#68)。
#
# **git の hook は、リポジトリに置いただけでは走らない。** `core.hooksPath` を
# 向けるまで `.git/hooks` (追跡されない) を見るので、**clone した先では無効**である。
#
# **人の手順にしない。** 「最初に 1 回これを打つ」は忘れられるし、
# **忘れたことは main へ commit が通ってから分かる**——止めたい事故そのものである。
# **`./task` は必ず通る**ので、ここで毎回揃えておく。
#
# **コマンドは止めない。** hook を有効にできないことと、いま打とうとしている
# コマンドが実行できないことは別である。**ただし黙らない**——
# **黙ると、止まっているつもりで何も止まっていない状態**になる。
ensure_commit_guard() {
  local current
  current="$(git config --get core.hooksPath 2>/dev/null || true)"
  [[ $current != ".githooks" ]] || return 0
  git config core.hooksPath .githooks 2>/dev/null \
    || echo "[WARN] core.hooksPath を設定できません (main の上での commit を止められません)" >&2
}

# **走っているコンテナが古い設定のままなら言う** (#247)。
#
# **`config.toml` の `env()` は `supabase start` の瞬間にしか置換されない**ので、
# **`.env` を直しても走っているコンテナには入らない**——**5 日間、古い値で動いていて
# 誰にも見えなかった**（症状は「GitHub が 404」で、**疑う先が実装へ向かう**）。
#
# **別のコマンドを覚えさせない。** **`./task` は必ず通る**ので、ここで見る。
# **正常なら何も出さない**（**毎回鳴る警告は、そのうち読まれなくなる**）。
#
# **コマンドは止めない。** `ensure_commit_guard` と同じ判断である——
# **古い設定で走っていることと、いま打とうとしているコマンドが実行できないことは別。**
#
# **直さない** (#247 の「やらないこと」)。**`db:down` は DB の中身を消す**ので、
# **走っている作業を巻き込む**——**気づかせるところまで**である。
warn_stale_containers() {
  ./bin/db-config-drift check || true
}

main() {
  local raw="${1:-help}"
  shift || true
  # `db:up` のようなコロン区切りを関数名へ変換する
  local fn="cmd_${raw//:/_}"
  fn="${fn//-/_}"

  if ! declare -F "$fn" >/dev/null; then
    echo "不明なコマンド: ${raw}" >&2
    echo >&2
    cmd_help >&2
    exit 1
  fi

  heartbeat
  ensure_commit_guard
  warn_stale_containers
  "$fn" "$@"
}

# **実行されたときだけ走らせる。** `source` して関数だけを試せるようにしておく——
# ここが無いと、**読み込んだ瞬間に help を出して終わる**ので、
# **`./task` の中身は試験から触れない**（触れないものは、壊れても気づけない）。
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
