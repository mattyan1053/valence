#!/usr/bin/env bash
#
# 開発タスクランナー。
#
# ホストに何もインストールしない方針のため、make ではなく素の bash で書いてある
# (bash / docker / git 以外はホストに要求しない)。
# 実処理はすべて開発コンテナ内で走る。
#
#   ./task help
#
set -euo pipefail

# どこから呼ばれてもリポジトリルートで動くようにする。
# `readlink -f` は GNU 依存なので使わない (BSD/macOS の readlink は -f を持たない)。
# CDPATH が設定されていると cd が意図しない場所へ飛ぶため、先に潰しておく。
CDPATH=''
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

# ホストの実値をビルド引数として渡す。これで環境固有の値を .env に書かずに済む。
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
DOCKER_GID="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 999)"
export HOST_UID HOST_GID DOCKER_GID

compose() { docker compose "$@"; }

# 非対話用。CI や AI エージェントからは TTY がないため -T を付ける。
exec_app() { compose exec -T app "$@"; }

# 人間が対話的に使う用 (シェル、dev サーバー、watch など)。
exec_app_it() {
  local tty_flag=()
  [[ -t 0 ]] || tty_flag=(-T)
  compose exec "${tty_flag[@]}" app "$@"
}

# supabase CLI が作る network を先に用意しておく。
# 同名のものがあれば CLI はそれを再利用するので、先に作っておいて問題ない。
ensure_network() {
  docker network inspect supabase_network_valence >/dev/null 2>&1 \
    || docker network create supabase_network_valence >/dev/null
}

ensure_up() {
  ensure_network
  if [[ -z "$(compose ps -q app 2>/dev/null)" ]] || \
     [[ -z "$(docker ps -q --filter "id=$(compose ps -q app)" 2>/dev/null)" ]]; then
    compose up -d app
  fi
}

# 開発コンテナを起動する = アプリが起動する (冪等)
cmd_up() { ensure_network; compose up -d app; }

# 開発コンテナを停止する
cmd_down() { compose down; }

# 開発イメージを再ビルドする
cmd_build() { compose build app; }

# コンテナとボリュームを破棄する
cmd_clean() { compose down --volumes --remove-orphans; }

# 開発コンテナのシェルに入る
cmd_sh() { ensure_up; exec_app_it bash; }

# 依存をインストールする (lockfile 準拠)
cmd_install() { ensure_up; exec_app pnpm install --frozen-lockfile; }

# 開発サーバーのログを追う (コンテナ起動時から動いている)
cmd_dev() {
  ensure_up
  compose logs -f app
}

# 開発サーバーを再起動する
cmd_restart() { ensure_up; compose restart app; }

# 任意の pnpm コマンドを流す 例: ./task pnpm add zod
cmd_pnpm() { ensure_up; exec_app pnpm "$@"; }

# lint + typecheck + 依存方向 + テスト をまとめて実行する
cmd_check() { ensure_up; exec_app pnpm check; }

# Biome で lint する
cmd_lint() { ensure_up; exec_app pnpm lint; }

# 自動修正できるものを直す (Biome)
cmd_fix() { ensure_up; exec_app pnpm fix; }

# 型検査する
cmd_typecheck() { ensure_up; exec_app pnpm typecheck; }

# レイヤ間の依存方向を検査する
cmd_depcruise() { ensure_up; exec_app pnpm depcruise; }

# テストを実行する
cmd_test() { ensure_up; exec_app pnpm test "$@"; }

# テストを watch モードで実行する
cmd_test_watch() { ensure_up; exec_app_it pnpm test:watch; }

# Supabase CLI は docker socket とホストのネットワーク名前空間を必要とする。
# それを app に持たせたくないので、専用の使い捨てコンテナで実行する。
supabase_cli() {
  local tty_flag=()
  [[ -t 0 ]] || tty_flag=(-T)
  compose run --rm --quiet-pull "${tty_flag[@]}" supabase-cli "$@"
}

# Supabase ローカルスタックを起動する
cmd_db_up() { ensure_up; supabase_cli pnpm supabase start; }

# Supabase ローカルスタックを停止する
cmd_db_down() { supabase_cli pnpm supabase stop; }

# ローカル DB をマイグレーションから作り直す
cmd_db_reset() { ensure_up; supabase_cli pnpm supabase db reset; }

# ローカルスタックの接続情報を表示する (.env に貼る値)
cmd_db_status() { supabase_cli pnpm supabase status; }

# ローカル DB に psql で入る 例: ./task db:psql -c "select 1"
cmd_db_psql() {
  # コンテナ名は config.toml の project_id から決まる
  local exec_flags=(-i)
  [[ -t 0 ]] && exec_flags+=(-t)
  supabase_cli docker exec "${exec_flags[@]}" supabase_db_valence \
    psql -U postgres -d postgres "$@"
}

# GitHub Webhook の転送を開始する (.env の SMEE_URL が必要)
cmd_smee() {
  # 未設定のまま起動すると smee-client が npm のエラーで落ち、原因が分かりにくい
  if [[ -z "${SMEE_URL:-}" ]] && ! grep -qE '^SMEE_URL=.+' .env 2>/dev/null; then
    echo "SMEE_URL が未設定です。https://smee.io/new で払い出して .env に書いてください。" >&2
    exit 1
  fi
  ensure_up
  # フォアグラウンドで起動する。-d で起こしてログだけ追うと、Ctrl-C で
  # 止まるのはログ追跡だけで、Webhook の転送は裏で動き続けてしまう。
  compose --profile webhook up smee
}

# master 用の worktree と label を用意する
cmd_loop_setup() {
  local wt="${PWD}-master"
  if [[ -d $wt ]]; then
    echo "==> worktree は既にある: $wt"
  else
    git worktree add "$wt" main
    echo "==> worktree を作成: $wt"
  fi
  # master は判定役。実装側の操作を settings で塞いでおく。
  # このファイルは worktree ごとに別で、gitignore されている。
  mkdir -p "$wt/.claude"
  cat > "$wt/.claude/settings.local.json" <<'JSON'
{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)"
    ]
  }
}
JSON
  echo "==> master 側の deny を設定: $wt/.claude/settings.local.json"

  local label
  for label in ready in-progress blocked; do
    if gh label list --limit 200 --json name --jq '.[].name' | grep -qxF "$label"; then
      echo "==> label は既にある: $label"
    else
      gh label create "$label" && echo "==> label を作成: $label"
    fi
  done

  echo
  echo "次の 2 つの端末で起動する:"
  echo "  cd $wt && claude   → /loop /loop-master"
  echo "  cd $PWD && claude  → /loop /loop-worker"
}

# worktree は作業ツリーが独立しているので、loop/STOP は共有されない。
# 片方に置いただけでは、もう片方のループは走り続ける。全 worktree へ配る。
loop_stop_paths() {
  git worktree list --porcelain | awk '/^worktree /{print $2 "/loop/STOP"}'
}

# 全ループを次の周回の冒頭で停止させる
cmd_loop_stop() {
  local reason="${1:-手動停止}" p
  while read -r p; do
    mkdir -p "$(dirname "$p")"
    printf '%s\n' "$reason" > "$p"
    echo "==> 作成: $p"
  done < <(loop_stop_paths)
  echo "全ループが次の周回の冒頭で停止する"
}

# 停止を解除する
cmd_loop_resume() {
  local p found=0
  while read -r p; do
    if [[ -f $p ]]; then rm "$p"; echo "==> 削除: $p"; found=1; fi
  done < <(loop_stop_paths)
  ((found == 1)) || echo "==> STOP は無い（停止していない）"
}

# ループの現在地を表示する (open PR / Issue / STOP)
cmd_loop_status() {
  if [[ -f loop/STOP ]]; then
    echo "STOP: あり"
    sed 's/^/  /' loop/STOP
  else
    echo "STOP: なし"
  fi
  echo "open PR:"
  gh pr list --state open --limit 200 \
    --json number,title,isDraft --jq '.[] | "  #\(.number) \(.title)\(if .isDraft then " (draft)" else "" end)"'
  echo "Issue:"
  gh issue list --limit 100 --json number,title,labels \
    --jq '.[] | "  #\(.number) [\(.labels | map(.name) | join(","))] \(.title)"'
}

# 使えるコマンドの一覧を表示する
cmd_help() {
  echo "使い方: ./task <コマンド> [引数...]"
  echo
  # 各 cmd_* 定義の直前のコメント行を説明として拾う
  awk '
    /^# / { desc = substr($0, 3); next }
    /^cmd_[a-z_]+\(\)/ {
      name = $1
      sub(/\(\)$/, "", name)
      sub(/^cmd_/, "", name)
      gsub(/_/, ":", name)
      if (desc != "") printf "  \033[36m%-12s\033[0m %s\n", name, desc
      desc = ""
      next
    }
    { desc = "" }
  ' "$0"
}

main() {
  local raw="${1:-help}"
  shift || true
  # `db:up` のようなコロン区切りを関数名へ変換する
  local fn="cmd_${raw//:/_}"
  fn="${fn//-/_}"

  if ! declare -F "$fn" >/dev/null; then
    echo "不明なコマンド: ${raw}" >&2
    echo >&2
    cmd_help >&2
    exit 1
  fi

  "$fn" "$@"
}

main "$@"
