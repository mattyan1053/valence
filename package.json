{
  "name": "valence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "biome check . --max-diagnostics=none --error-on-warnings",
    "lint:shell": "bin/lint-shell",
    "fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "depcruise": "depcruise src",
    "test": "vitest run --project '!db'",
    "test:watch": "vitest --project '!db'",
    "test:coverage": "vitest run --coverage --project '!db'",
    "test:db": "vitest run --project db",
    "check": "pnpm lint && pnpm lint:shell && pnpm typecheck && pnpm depcruise && pnpm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
